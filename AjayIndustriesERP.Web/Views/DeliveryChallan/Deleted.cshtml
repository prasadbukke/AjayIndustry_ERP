@model List<AjayIndustriesERP.Domain.Entities.DeliveryChallan>

@{
    ViewData["Title"] = "Deleted Delivery Challans";
}

@*
============================================================
File: Deleted.cshtml

Purpose:
Displays soft-deleted Delivery Challans.

Responsibilities:
- Show deleted Draft Challans.
- Display Challan, Customer and Item summary.
- Allow Restore action.
- Provide navigation back to active Challans.

Important:
- Only Draft Challans can be deleted/restored.
- Restore quantity validation is handled by
  DeliveryChallanService.
============================================================
*@


@* =========================================================
   Page Header
   ========================================================= *@

<div class="d-flex justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Delivery Challans
        </h2>

        <div class="text-muted">
            Restore previously deleted Draft Delivery Challans.
        </div>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Back to Delivery Challans

    </a>

</div>


@* =========================================================
   Deleted Challans
   ========================================================= *@

<div class="card shadow-sm">

    <div class="card-header bg-light">

        <div class="d-flex justify-content-between
                    align-items-center
                    flex-wrap
                    gap-2">

            <h5 class="mb-0">
                Deleted Challans
            </h5>

            <span class="text-muted small">
                Total Records: @Model.Count
            </span>

        </div>

    </div>

    <div class="card-body p-0">

        @if (Model.Count == 0)
        {
            <div class="p-4">

                <div class="alert alert-info mb-0">
                    No deleted Delivery Challans found.
                </div>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover
                              align-middle
                              mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Challan No.
                            </th>

                            <th>
                                Challan Date
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Dispatch Items
                            </th>

                            <th>
                                Dispatch Qty
                            </th>

                            <th>
                                Transport / Vehicle
                            </th>

                            <th>
                                Deleted On
                            </th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var challan in Model)
                        {
                            var items =
                                challan.Items?
                                    .Where(x =>
                                        !x.IsDeleted)
                                    .OrderBy(x =>
                                        x.SequenceNumber)
                                    .ToList()
                                ?? new List<AjayIndustriesERP.Domain.Entities.DeliveryChallanItem>();

                            var totalDispatchQuantity =
                                items.Sum(x =>
                                    x.DispatchQuantity);

                            <tr>

                                @* =================================
                                   Challan
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @challan.Code
                                    </div>

                                    <div class="text-muted small">
                                        Draft
                                    </div>

                                </td>


                                @* =================================
                                   Date
                                   ================================= *@

                                <td class="text-nowrap">

                                    @challan.ChallanDate.ToString("dd-MM-yyyy")

                                </td>


                                @* =================================
                                   Customer
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @challan.CustomerName
                                    </div>

                                </td>


                                @* =================================
                                   Items
                                   ================================= *@

                                <td>

                                    @if (items.Count == 0)
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                    else if (items.Count == 1)
                                    {
                                        var item =
                                            items[0];

                                        <div class="fw-semibold">
                                            @item.ItemName
                                        </div>

                                        <div class="text-muted small">
                                            @item.PreDispatchInspectionCode
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            item.ProductReference))
                                        {
                                            <div class="text-muted small">
                                                Product ID:
                                                @item.ProductReference
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="fw-semibold">
                                            @items.Count Items
                                        </div>

                                        <div class="text-muted small">
                                            Multiple PDI dispatch lines
                                        </div>
                                    }

                                </td>


                                @* =================================
                                   Quantity
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @(totalDispatchQuantity.ToString("0.###"))
                                    </div>

                                    @if (
                                        items.Count == 1 &&
                                        !string.IsNullOrWhiteSpace(
                                            items[0].UnitName)
                                    )
                                    {
                                        <div class="text-muted small">
                                            @items[0].UnitName
                                        </div>
                                    }

                                </td>


                                @* =================================
                                   Transport
                                   ================================= *@

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        challan.TransporterName))
                                    {
                                        <div>
                                            @challan.TransporterName
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        challan.VehicleNumber))
                                    {
                                        <div class="text-muted small">
                                            Vehicle:
                                            @challan.VehicleNumber
                                        </div>
                                    }

                                    @if (
                                        string.IsNullOrWhiteSpace(
                                            challan.TransporterName) &&
                                        string.IsNullOrWhiteSpace(
                                            challan.VehicleNumber)
                                    )
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   Deleted On
                                   ================================= *@

                                <td class="text-nowrap">

                                    @if (challan.ModifiedOn.HasValue)
                                    {
                                        @challan.ModifiedOn.Value.ToString("dd-MM-yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   Restore
                                   ================================= *@

                                <td class="text-end">

                                    <form asp-action="Restore"
                                          asp-route-id="@challan.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                onclick="return confirm('Restore this Delivery Challan?');">

                                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>