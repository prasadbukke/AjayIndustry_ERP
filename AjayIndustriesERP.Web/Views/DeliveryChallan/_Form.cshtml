@* =========================================================
   Dispatch Items Header
   ========================================================= *@

<div class="d-flex justify-content-between
            align-items-center
            flex-wrap
            gap-2
            mb-3">

    <div>

        <h5 class="mb-1">
            Dispatch Items
        </h5>

        <div class="text-muted small">
            Select Finalized PDI and enter dispatch information.
        </div>

    </div>


    <button type="button"
            class="btn btn-outline-primary"
            id="btnAddDeliveryChallanItem">

        <i class="bi bi-plus-lg me-1"></i>
        Add PDI Item

    </button>

</div>


@* =========================================================
   Dispatch Items Container
   ========================================================= *@

<div id="deliveryChallanItemsContainer"
     data-get-pdi-url="@Url.Action("GetPdiData", "DeliveryChallan")"
     data-challan-id="@Model.Id">

    @for (var i = 0; i < Model.Items.Count; i++)
    {
        <div class="card shadow-sm mb-4 delivery-challan-item"
             data-item-index="@i">

            <div class="card-header bg-light">

                <div class="d-flex justify-content-between
                                align-items-center
                                gap-2">

                    <div class="fw-semibold">

                        Dispatch Line

                        <span class="delivery-line-number">
                            @(i + 1)
                        </span>

                    </div>


                    <button type="button"
                            class="btn btn-sm btn-outline-danger btn-remove-delivery-item"
                            title="Remove Item">

                        <i class="bi bi-trash"></i>

                    </button>

                </div>

            </div>


            <div class="card-body">

                @* =========================================
                   Hidden Line Fields
                   ========================================= *@

                <input asp-for="Items[i].Id"
                       type="hidden"
                       class="item-id" />

                <input asp-for="Items[i].SequenceNumber"
                       type="hidden"
                       class="sequence-number" />

                <input asp-for="Items[i].ProductionJobId"
                       type="hidden"
                       class="production-job-id" />

                <input asp-for="Items[i].CustomerPurchaseOrderItemId"
                       type="hidden"
                       class="customer-po-item-id" />

                <input asp-for="Items[i].ItemId"
                       type="hidden"
                       class="item-master-id" />

                <input asp-for="Items[i].CustomerDrawingId"
                       type="hidden"
                       class="customer-drawing-id" />


                @* =========================================
                   PDI / Product / HSN
                   ========================================= *@

                <div class="row g-3 mb-3">

                    <div class="col-md-4">

                        <label asp-for="Items[i].PreDispatchInspectionId"
                               class="form-label">
                        </label>

                        <select asp-for="Items[i].PreDispatchInspectionId"
                                asp-items="Model.AvailablePdis"
                                class="form-select pdi-select">
                        </select>

                        <span asp-validation-for="Items[i].PreDispatchInspectionId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="Items[i].ProductReference"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].ProductReference"
                               class="form-control product-reference"
                               placeholder="Enter Product ID" />

                        <span asp-validation-for="Items[i].ProductReference"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="Items[i].HsnNumber"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].HsnNumber"
                               class="form-control hsn-number"
                               placeholder="Enter HSN No." />

                        <span asp-validation-for="Items[i].HsnNumber"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                @* =========================================
                   Item / Production Information
                   ========================================= *@

                <div class="row g-3 mb-3">

                    <div class="col-md-4">

                        <label asp-for="Items[i].ItemName"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].ItemName"
                               class="form-control item-name"
                               readonly />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="Items[i].PreDispatchInspectionCode"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].PreDispatchInspectionCode"
                               class="form-control pdi-code"
                               readonly />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="Items[i].ProductionJobCode"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].ProductionJobCode"
                               class="form-control production-job-code"
                               readonly />

                    </div>

                </div>


                @* =========================================
                   PO Information
                   ========================================= *@

                <div class="row g-3 mb-3">

                    <div class="col-md-4">

                        <label asp-for="Items[i].CustomerPurchaseOrderNumber"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].CustomerPurchaseOrderNumber"
                               class="form-control customer-po-number"
                               readonly />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="Items[i].ItemCode"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].ItemCode"
                               class="form-control item-code"
                               readonly />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="Items[i].CustomerItemCode"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].CustomerItemCode"
                               class="form-control customer-item-code"
                               readonly />

                    </div>

                </div>


                @* =========================================
                   Part / Drawing Information
                   ========================================= *@

                <div class="row g-3 mb-3">

                    <div class="col-md-4">

                        <label asp-for="Items[i].PartNumber"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].PartNumber"
                               class="form-control part-number"
                               readonly />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="Items[i].CustomerDrawingNumber"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].CustomerDrawingNumber"
                               class="form-control customer-drawing-number"
                               readonly />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="Items[i].CustomerDrawingRevision"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].CustomerDrawingRevision"
                               class="form-control customer-drawing-revision"
                               readonly />

                    </div>

                </div>


                @* =========================================
                   Quantity Information
                   ========================================= *@

                <div class="row g-3">

                    <div class="col-md-3">

                        <label asp-for="Items[i].PdiAcceptedQuantity"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].PdiAcceptedQuantity"
                               class="form-control pdi-accepted-quantity"
                               readonly />

                    </div>


                    <div class="col-md-3">

                        <label asp-for="Items[i].AlreadyDispatchedQuantity"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].AlreadyDispatchedQuantity"
                               class="form-control already-dispatched-quantity"
                               readonly />

                    </div>


                    <div class="col-md-3">

                        <label asp-for="Items[i].AvailableQuantity"
                               class="form-label">
                        </label>

                        <input asp-for="Items[i].AvailableQuantity"
                               class="form-control available-quantity"
                               readonly />

                    </div>


                    <div class="col-md-3">

                        <label asp-for="Items[i].DispatchQuantity"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group">

                            <input asp-for="Items[i].DispatchQuantity"
                                   class="form-control dispatch-quantity"
                                   min="0.001"
                                   step="0.001" />

                            <span class="input-group-text unit-name">
                                @Model.Items[i].UnitName
                            </span>

                        </div>

                        <span asp-validation-for="Items[i].DispatchQuantity"
                              class="text-danger">
                        </span>

                        <input asp-for="Items[i].UnitName"
                               type="hidden"
                               class="unit-name-value" />

                    </div>

                </div>

            </div>

        </div>
    }

</div>


@* =========================================================
   No Items Message
   ========================================================= *@

<div id="deliveryChallanNoItemsMessage"
     class="alert alert-info d-none">

    At least one Finalized PDI item is required.

</div>


@* =========================================================
   Dynamic Dispatch Item Template
   ========================================================= *@

<template id="deliveryChallanItemTemplate">

    <div class="card shadow-sm mb-4 delivery-challan-item"
         data-item-index="__index__">

        <div class="card-header bg-light">

            <div class="d-flex justify-content-between
                        align-items-center
                        gap-2">

                <div class="fw-semibold">

                    Dispatch Line

                    <span class="delivery-line-number">
                        __lineNumber__
                    </span>

                </div>


                <button type="button"
                        class="btn btn-sm btn-outline-danger btn-remove-delivery-item"
                        title="Remove Item">

                    <i class="bi bi-trash"></i>

                </button>

            </div>

        </div>


        <div class="card-body">

            @* =============================================
               Hidden Fields
               ============================================= *@

            <input type="hidden"
                   name="Items[__index__].Id"
                   value="0"
                   class="item-id" />

            <input type="hidden"
                   name="Items[__index__].SequenceNumber"
                   value="__lineNumber__"
                   class="sequence-number" />

            <input type="hidden"
                   name="Items[__index__].ProductionJobId"
                   value="0"
                   class="production-job-id" />

            <input type="hidden"
                   name="Items[__index__].CustomerPurchaseOrderItemId"
                   value="0"
                   class="customer-po-item-id" />

            <input type="hidden"
                   name="Items[__index__].ItemId"
                   value="0"
                   class="item-master-id" />

            <input type="hidden"
                   name="Items[__index__].CustomerDrawingId"
                   value=""
                   class="customer-drawing-id" />

            <input type="hidden"
                   name="Items[__index__].UnitName"
                   value=""
                   class="unit-name-value" />


            @* =============================================
               PDI / Product / HSN
               ============================================= *@

            <div class="row g-3 mb-3">

                <div class="col-md-4">

                    <label class="form-label">
                        PDI Report
                    </label>

                    <select name="Items[__index__].PreDispatchInspectionId"
                            class="form-select pdi-select">

                        @foreach (var pdi in Model.AvailablePdis)
                        {
                            <option value="@pdi.Value">
                                @pdi.Text
                            </option>
                        }

                    </select>

                    <span class="text-danger field-validation-valid"
                          data-valmsg-for="Items[__index__].PreDispatchInspectionId"
                          data-valmsg-replace="true">
                    </span>

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Product ID
                    </label>

                    <input type="text"
                           name="Items[__index__].ProductReference"
                           class="form-control product-reference"
                           maxlength="100"
                           placeholder="Enter Product ID" />

                    <span class="text-danger field-validation-valid"
                          data-valmsg-for="Items[__index__].ProductReference"
                          data-valmsg-replace="true">
                    </span>

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        HSN No.
                    </label>

                    <input type="text"
                           name="Items[__index__].HsnNumber"
                           class="form-control hsn-number"
                           maxlength="50"
                           placeholder="Enter HSN No." />

                    <span class="text-danger field-validation-valid"
                          data-valmsg-for="Items[__index__].HsnNumber"
                          data-valmsg-replace="true">
                    </span>

                </div>

            </div>


            @* =============================================
               Item / Production
               ============================================= *@

            <div class="row g-3 mb-3">

                <div class="col-md-4">

                    <label class="form-label">
                        Item / Product
                    </label>

                    <input type="text"
                           name="Items[__index__].ItemName"
                           class="form-control item-name"
                           readonly />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        PDI No.
                    </label>

                    <input type="text"
                           name="Items[__index__].PreDispatchInspectionCode"
                           class="form-control pdi-code"
                           readonly />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Production Job
                    </label>

                    <input type="text"
                           name="Items[__index__].ProductionJobCode"
                           class="form-control production-job-code"
                           readonly />

                </div>

            </div>


            @* =============================================
               PO Information
               ============================================= *@

            <div class="row g-3 mb-3">

                <div class="col-md-4">

                    <label class="form-label">
                        Customer PO No.
                    </label>

                    <input type="text"
                           name="Items[__index__].CustomerPurchaseOrderNumber"
                           class="form-control customer-po-number"
                           readonly />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Item Code
                    </label>

                    <input type="text"
                           name="Items[__index__].ItemCode"
                           class="form-control item-code"
                           readonly />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Customer Item Code
                    </label>

                    <input type="text"
                           name="Items[__index__].CustomerItemCode"
                           class="form-control customer-item-code"
                           readonly />

                </div>

            </div>


            @* =============================================
               Part / Drawing
               ============================================= *@

            <div class="row g-3 mb-3">

                <div class="col-md-4">

                    <label class="form-label">
                        Part No.
                    </label>

                    <input type="text"
                           name="Items[__index__].PartNumber"
                           class="form-control part-number"
                           readonly />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Customer Drawing No.
                    </label>

                    <input type="text"
                           name="Items[__index__].CustomerDrawingNumber"
                           class="form-control customer-drawing-number"
                           readonly />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Revision
                    </label>

                    <input type="text"
                           name="Items[__index__].CustomerDrawingRevision"
                           class="form-control customer-drawing-revision"
                           readonly />

                </div>

            </div>


            @* =============================================
               Quantities
               ============================================= *@

            <div class="row g-3">

                <div class="col-md-3">

                    <label class="form-label">
                        PDI Accepted Qty
                    </label>

                    <input type="number"
                           name="Items[__index__].PdiAcceptedQuantity"
                           class="form-control pdi-accepted-quantity"
                           step="0.001"
                           readonly />

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Already Dispatched Qty
                    </label>

                    <input type="number"
                           name="Items[__index__].AlreadyDispatchedQuantity"
                           class="form-control already-dispatched-quantity"
                           step="0.001"
                           readonly />

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Available Qty
                    </label>

                    <input type="number"
                           name="Items[__index__].AvailableQuantity"
                           class="form-control available-quantity"
                           step="0.001"
                           readonly />

                </div>


                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Dispatch Qty
                    </label>

                    <div class="input-group">

                        <input type="number"
                               name="Items[__index__].DispatchQuantity"
                               class="form-control dispatch-quantity"
                               min="0.001"
                               step="0.001"
                               value="0" />

                        <span class="input-group-text unit-name">
                        </span>

                    </div>

                    <span class="text-danger field-validation-valid"
                          data-valmsg-for="Items[__index__].DispatchQuantity"
                          data-valmsg-replace="true">
                    </span>

                </div>

            </div>

        </div>

    </div>

</template>