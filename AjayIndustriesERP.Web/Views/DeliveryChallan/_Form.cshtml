                       placeholder="Auto Generated" />

            </div>


            <div class="col-md-3">

                <label asp-for="ChallanDate"
                       class="form-label">
                </label>

                <input asp-for="ChallanDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="ChallanDate"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-3">

                <label asp-for="LpgNumber"
                       class="form-label">
                </label>

                <input asp-for="LpgNumber"
                       class="form-control"
                       placeholder="Enter L.P.G. No." />

                <span asp-validation-for="LpgNumber"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-3">

                <label asp-for="CustomerName"
