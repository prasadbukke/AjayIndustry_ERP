@model AjayIndustriesERP.Web.ViewModels.DeliveryChallan.DeliveryChallanFormViewModel

@*
============================================================
File: _Form.cshtml

Purpose:
Shared Delivery Challan form used by Create and Edit.

Responsibilities:
- Display Challan header information.
- Accept manually entered L.P.G. No.
- Display Customer information.
- Display editable Customer delivery address.
- Display Company / Workshop information.
- Display transport / dispatch information.
- Manage one or more Finalized PDI dispatch lines.
- Display trusted PDI snapshot information.
- Accept manual Product ID.
- Accept manual HSN No.
- Display Accepted / Already Dispatched / Available Qty.
- Accept Dispatch Quantity.

Important:
- Parent Create/Edit view owns the <form> element.
- Complex JavaScript belongs in:
  wwwroot/js/delivery-challan-form.js
- Customer address is auto-loaded but editable.
- Company / Workshop fields are read-only.
- Product ID is manually entered.
- HSN No. is manually entered for now.
============================================================
*@


@* =========================================================
   Hidden Header Fields
   ========================================================= *@

<input asp-for="Id"
       type="hidden" />

<input asp-for="Status"
       type="hidden" />

<input asp-for="CustomerId"
       type="hidden" />

<input asp-for="CompanyId"
       type="hidden"
       class="company-id" />


@* =========================================================
   Validation Summary
   ========================================================= *@

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger mb-4"
     role="alert">
</div>


