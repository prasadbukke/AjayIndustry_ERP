@model AjayIndustriesERP.Web.ViewModels.DeliveryChallan.DeliveryChallanFormViewModel

@{
    ViewData["Title"] = "Create Delivery Challan";
}

@*
============================================================
File: Create.cshtml

Purpose:
Create screen for Delivery Challan.

Responsibilities:
- Own Create form.
- Render shared Delivery Challan form partial.
- Provide Save Draft and Back actions.
- Load validation scripts.
- Load separate Delivery Challan form JavaScript.

Important:
- Shared form fields belong in _Form.cshtml.
- Complex JavaScript belongs in:
  wwwroot/js/delivery-challan-form.js
============================================================
*@


@* =========================================================
   Page Header
   ========================================================= *@

<div class="d-flex justify-content-between
            align-items-center
            flex-wrap
            gap-2
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Create Delivery Challan
        </h2>

        <div class="text-muted">
            Create a new dispatch challan from Finalized PDI.
        </div>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Back to List

    </a>

</div>


@* =========================================================
   Create Form
   ========================================================= *@

<form asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()


    @* =====================================================
       Shared Form
       ===================================================== *@

    <partial name="_Form"
             model="Model" />


    @* =====================================================
       Form Actions
       ===================================================== *@

    <div class="d-flex justify-content-end
                align-items-center
                gap-2
                mb-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Cancel

        </a>

        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-save me-1"></i>
            Save Draft

        </button>

    </div>

</form>


@* =========================================================
   Scripts
   ========================================================= *@

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/delivery-challan-form.js"
            asp-append-version="true">
    </script>
}