@*
    ============================================================
    File: Index.cshtml

    Purpose:
    Displays Delivery Challans.

    Responsibilities:
    - Display Delivery Challans with Search and Pagination.
    - Display Customer, Item and Dispatch Quantity.
    - Display Draft / Finalized Status.
    - Open Delivery Challan Details.
    - Edit Draft Challan.
    - Delete Draft Challan.
    - Navigate to Deleted Challans.

    Important:
    - Product ID is intentionally not displayed on Index.
    - Draft Challan can be edited and deleted.
    - Finalized Challan is locked.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.DeliveryChallan>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] =
        "Delivery Challans";

    var pageNumber =
        (int)ViewBag.PageNumber;

    var pageSize =
        (int)ViewBag.PageSize;

    var totalRecords =
        (int)ViewBag.TotalRecords;

    var serialNumber =
        ((pageNumber - 1) * pageSize) + 1;
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Delivery Challans
        </h2>

        <p class="text-muted mb-0">
            Manage customer dispatch and Delivery Challans.
        </p>

    </div>


    <div class="d-flex
                align-items-center
                gap-2
                flex-wrap">

        <a asp-action="Deleted"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-trash-can me-1"></i>

            Deleted Challans

        </a>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus me-1"></i>

            Create Delivery Challan

        </a>

    </div>

</div>


<!-- =========================================================
     REGION 2 — SEARCH
========================================================== -->

<partial name="Components/_SearchBar"
         model='@(ViewBag.SearchText as string ?? "")' />


<!-- =========================================================
     REGION 3 — DELIVERY CHALLAN TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="width:55px;">
                            #
                        </th>

                        <th>
                            Challan No.
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Customer
                        </th>

                        <th>
                            Item
                        </th>

                        <th>
                            Dispatch Qty
                        </th>

                        

                        <th class="text-center">
                            Status
                        </th>

                        <th class="text-center"
                            style="width:140px;">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                         Model.Any())
                    {
                        @foreach (var challan in Model)
                        {
                            var items =
                                challan.Items?
                                    .Where(x =>
                                        !x.IsDeleted)
                                    .OrderBy(x =>
                                        x.SequenceNumber)
                                    .ToList()
                                ?? new List<AjayIndustriesERP.Domain.Entities.DeliveryChallanItem>();


                            var totalDispatchQuantity =
                                items.Sum(x =>
                                    x.DispatchQuantity);


                            var isDraft =
                                challan.Status ==
                                DeliveryChallanStatus.Draft;


                            <tr>

                                <!-- SERIAL NUMBER -->

                                <td>
                                    @serialNumber
                                </td>


                                <!-- CHALLAN NUMBER -->

                                <td class="text-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@challan.Id"
                                       class="fw-semibold
                                              text-decoration-none">

                                        @challan.Code

                                    </a>

                                </td>


                                <!-- DATE -->

                                <td class="text-nowrap">

                                    @(
                                        challan.ChallanDate
                                            .ToString("dd-MM-yyyy")
                                    )

                                </td>


                                <!-- CUSTOMER -->

                                <td>

                                    <div class="fw-semibold">
                                        @challan.CustomerName
                                    </div>

                                </td>


                                <!-- ITEM -->

                                <td>

                                    @if (items.Count == 1)
                                    {
                                        var item =
                                            items[0];

                                        <div class="fw-semibold">
                                            @item.ItemName
                                        </div>

                                        <div class="small text-muted">
                                            @item.PreDispatchInspectionCode
                                        </div>
                                    }
                                    else if (items.Count > 1)
                                    {
                                        <div class="fw-semibold">
                                            @items.Count Items
                                        </div>

                                        <div class="small text-muted">
                                            Multiple PDI Lines
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- DISPATCH QUANTITY -->

                                <td>

                                    <span class="fw-semibold">

                                        @(
                                            totalDispatchQuantity
                                                .ToString("0.###")
                                        )

                                    </span>


                                    @if (
                                        items.Count == 1 &&
                                        !string.IsNullOrWhiteSpace(
                                            items[0].UnitName)
                                    )
                                    {
                                        <span class="text-muted">
                                            @items[0].UnitName
                                        </span>
                                    }

                                </td>


                                


                                <!-- STATUS -->

                                <td class="text-center">

                                    @switch (challan.Status)
                                    {
                                        case DeliveryChallanStatus.Draft:

                                            <span class="badge bg-secondary">
                                                Draft
                                            </span>

                                            break;


                                        case DeliveryChallanStatus.Finalized:

                                            <span class="badge bg-success">
                                                Finalized
                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-center">

                                    <div class="d-flex
                                                justify-content-center
                                                gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@challan.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-info"
                                           title="View Delivery Challan">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>


                                        @if (isDraft)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@challan.Id"
                                               class="btn
                                                      btn-sm
                                                      btn-outline-warning"
                                               title="Edit Draft Delivery Challan">

                                                <i class="fa-solid fa-pen"></i>

                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn
                                                           btn-sm
                                                           btn-outline-warning"
                                                    disabled
                                                    title="Finalized Delivery Challan cannot be edited.">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>
                                        }


                                        @if (isDraft)
                                        {
                                            <button type="button"
                                                    class="btn
                                                           btn-sm
                                                           btn-outline-danger"
                                                    title="Delete Draft Delivery Challan"
                                                    onclick="confirmDelete(
                                                        '@Url.Action(
                                                            "Delete",
                                                            "DeliveryChallan",
                                                            new
                                                            {
                                                                id = challan.Id
                                                            })')">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn
                                                           btn-sm
                                                           btn-outline-danger"
                                                    disabled
                                                    title="Finalized Delivery Challan cannot be deleted.">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9"
                                class="text-center
                                       py-5
                                       text-muted">

                                <i class="fa-solid
                                          fa-truck
                                          fa-2x
                                          mb-3">
                                </i>

                                <div class="fw-semibold mb-1">
                                    No Delivery Challans Found
                                </div>

                                <div class="small">
                                    Create a Delivery Challan from a Finalized PDI.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — PAGINATION
========================================================== -->

@if (totalRecords > 0)
{
    <div class="mt-3">

        <partial name="Components/_Pagination"
                 model='(
                     (int)ViewBag.PageNumber,
                     (int)ViewBag.PageSize
                 )' />

    </div>
}