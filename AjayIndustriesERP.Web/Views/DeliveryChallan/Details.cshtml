@model AjayIndustriesERP.Web.ViewModels.DeliveryChallan.DeliveryChallanDetailsViewModel

@using AjayIndustriesERP.Domain.Enums

@*
============================================================
File: Details.cshtml

Purpose:
Displays Delivery Challan details.

Responsibilities:
- Display Challan header and status.
- Display Customer snapshot information.
- Display saved Customer delivery address.
- Display Company / Workshop snapshot information.
- Display ERP dispatch / transport information.
- Display Delivery Challan items.
- Display Product ID and HSN No.
- Display internal PDI / PO / Drawing traceability.
- Allow Draft Edit / Finalize.
- Allow Finalized PDF download.

Important:
- Customer address shown here is the saved Challan snapshot.
- Company information comes from saved Company snapshot.
- Finalized Challan is read-only.
- Transport and Drawing information may remain visible in
  ERP Details even though current PDF will not show them.
============================================================
*@

@{
    ViewData["Title"] = "Delivery Challan Details";

    var isDraft =
        Model.Status ==
        DeliveryChallanStatus.Draft;

    var isFinalized =
        Model.Status ==
        DeliveryChallanStatus.Finalized;
}


@* =========================================================
   Page Header
   ========================================================= *@

<div class="d-flex justify-content-between
            align-items-center
            flex-wrap
            gap-2
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Delivery Challan Details
        </h2>

        <div class="text-muted">
            @Model.Code
        </div>

    </div>


    <div class="d-flex
                align-items-center
                flex-wrap
                gap-2">

        @if (isDraft)
        {
            <span class="badge bg-warning text-dark">
                Draft
            </span>
        }
        else
        {
            <span class="badge bg-success text-white">
                Finalized
            </span>
        }


        @if (isFinalized)
        {
            <a asp-action="DownloadPdf"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">

                <i class="bi bi-file-earmark-pdf me-1"></i>
                Download Challan

            </a>
        }


        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back

        </a>

    </div>

</div>


@* =========================================================
   Challan Information
   ========================================================= *@

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <h5 class="mb-0">
            Challan Information
        </h5>

    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-3">

                <div class="text-muted small">
                    Challan No.
                </div>

                <div class="fw-semibold">
                    @Model.Code
                </div>

            </div>


            <div class="col-md-3">

                <div class="text-muted small">
                    Challan Date
                </div>

                <div class="fw-semibold">
                    @Model.ChallanDate.ToString("dd-MM-yyyy")
                </div>

            </div>


            <div class="col-md-3">

                <div class="text-muted small">
                    L.P.G. No.
                </div>

                <div class="fw-semibold">

                    @(string.IsNullOrWhiteSpace(Model.LpgNumber)
                                        ? "-"
                                        : Model.LpgNumber)

                </div>

            </div>


            <div class="col-md-3">

                <div class="text-muted small">
                    Status
                </div>

                <div>

                    @if (isDraft)
                    {
                        <span class="badge bg-warning text-dark">
                            Draft
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success text-white">
                            Finalized
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


