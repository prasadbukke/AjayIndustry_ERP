                <div class="fw-semibold">

                    @(string.IsNullOrWhiteSpace(Model.TransporterName)
                                        ? "-"
                                        : Model.TransporterName)

                </div>

            </div>


            <div class="col-md-4">

                <div class="text-muted small">
                    Vehicle No.
                </div>

                <div class="fw-semibold">

                    @(string.IsNullOrWhiteSpace(Model.VehicleNumber)
                                        ? "-"
                                        : Model.VehicleNumber)

                </div>

            </div>


            <div class="col-md-4">

                <div class="text-muted small">
                    LR / Transport Reference
                </div>

                <div class="fw-semibold">

                    @(string.IsNullOrWhiteSpace(Model.TransportReference)
                                        ? "-"
                                        : Model.TransportReference)

                </div>

            </div>


            <div class="col-md-6">

                <div class="text-muted small">
                    Dispatch From
                </div>

                <div class="fw-semibold">

                    @(string.IsNullOrWhiteSpace(Model.DispatchFrom)
                                        ? "-"
                                        : Model.DispatchFrom)

                </div>

            </div>


            <div class="col-md-6">

                <div class="text-muted small">
                    Destination
                </div>

                <div class="fw-semibold">

                    @(string.IsNullOrWhiteSpace(Model.Destination)
                                        ? "-"
                                        : Model.Destination)

                </div>

            </div>

        </div>

    </div>

</div>


@* =========================================================
   Dispatch Items
   ========================================================= *@

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <h5 class="mb-0">
            Dispatch Items
        </h5>

    </div>

    <div class="card-body">

        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-info mb-0">
                No dispatch items found.
            </div>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <div class="border rounded p-3 mb-3">

                    <div class="d-flex justify-content-between
                                        align-items-center
                                        flex-wrap
                                        gap-2
                                        mb-3">

                        <div class="fw-bold">
                            Dispatch Line @item.SequenceNumber
                        </div>

                        <span class="badge bg-secondary">
                            @item.DispatchQuantity.ToString("0.###")
                            @item.UnitName
                        </span>

                    </div>


                    @* =====================================
                       Main Item Information
                       ===================================== *@

                    <div class="row g-3 mb-3">

                        <div class="col-md-3">

                            <div class="text-muted small">
                                PDI No.
                            </div>

                            <div class="fw-semibold">
                                @item.PreDispatchInspectionCode
                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="text-muted small">
                                Product ID
                            </div>

                            <div class="fw-semibold">

                                @(string.IsNullOrWhiteSpace(item.ProductReference)
                                                        ? "-"
                                                        : item.ProductReference)

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="text-muted small">
                                HSN No.
                            </div>

                            <div class="fw-semibold">

                                @(string.IsNullOrWhiteSpace(item.HsnNumber)
                                                        ? "-"
                                                        : item.HsnNumber)

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="text-muted small">
                                Item / Product
                            </div>

                            <div class="fw-semibold">
                                @item.ItemName
                            </div>

                        </div>

                    </div>


                    @* =====================================
                       Production / PO Information
                       ===================================== *@

                    <div class="row g-3 mb-3">

                        <div class="col-md-3">

                            <div class="text-muted small">
                                Production Job
                            </div>

                            <div class="fw-semibold">
                                @item.ProductionJobCode
                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="text-muted small">
                                Customer PO No.
                            </div>

                            <div class="fw-semibold">
                                @item.CustomerPurchaseOrderNumber
                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="text-muted small">
                                Item Code
                            </div>

                            <div class="fw-semibold">
                                @item.ItemCode
                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="text-muted small">
                                Customer Item Code
                            </div>

                            <div class="fw-semibold">

                                @(string.IsNullOrWhiteSpace(item.CustomerItemCode)
                                                        ? "-"
                                                        : item.CustomerItemCode)

                            </div>

                        </div>

                    </div>


                    @* =====================================
                       Internal Traceability
                       ===================================== *@

                    <div class="row g-3 mb-3">

                        <div class="col-md-3">

                            <div class="text-muted small">
                                Part No.
                            </div>

                            <div class="fw-semibold">

                                @(string.IsNullOrWhiteSpace(item.PartNumber)
                                                        ? "-"
                                                        : item.PartNumber)

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="text-muted small">
                                Customer Drawing No.
                            </div>

                            <div class="fw-semibold">

                                @(string.IsNullOrWhiteSpace(item.CustomerDrawingNumber)
                                                        ? "-"
                                                        : item.CustomerDrawingNumber)

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="text-muted small">
                                Drawing Revision
                            </div>

                            <div class="fw-semibold">

                                @(string.IsNullOrWhiteSpace(item.CustomerDrawingRevision)
                                                        ? "-"
                                                        : item.CustomerDrawingRevision)

                            </div>

                        </div>

                        <div class="col-md-3">

                            <div class="text-muted small">
                                PDI Accepted Qty
                            </div>

                            <div class="fw-semibold">
                                @item.PdiAcceptedQuantity.ToString("0.###")
                                @item.UnitName
                            </div>

                        </div>

                    </div>


                    @* =====================================
                       Quantity
                       ===================================== *@

                    <div class="row g-3">

                        
                        <div class="col-md-3">

                            <div class="text-muted small">
                                Dispatch Qty
                            </div>

                            <div class="fw-semibold">
                                @item.DispatchQuantity.ToString("0.###")
                                @item.UnitName
                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="text-muted small">
                                UOM
                            </div>

                            <div class="fw-semibold">

                                @(string.IsNullOrWhiteSpace(item.UnitName)
                                                        ? "-"
                                                        : item.UnitName)

                    </div>

                        </div>

                    </div>

                </div>
                }
        }

    </div>

</div>


@* =========================================================
   Remarks
   ========================================================= *@

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <h5 class="mb-0">
            Remarks
        </h5>

    </div>

    <div class="card-body">

        @if (string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <span class="text-muted">
                No remarks.
            </span>
        }
        else
        {
            <div>
                @Model.Remarks
            </div>
        }

    </div>

</div>


@* =========================================================
   Finalization Information
   ========================================================= *@

@if (isFinalized)
{
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">

            <h5 class="mb-0">
                Finalization Information
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <div class="text-muted small">
                        Status
                    </div>

                    <div>
                        <span class="badge bg-success text-white">
                            Finalized
                        </span>
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        Finalized On
                    </div>

                    <div class="fw-semibold">

                        @(Model.FinalizedOn.HasValue
                                            ? Model.FinalizedOn.Value.ToString("dd-MM-yyyy HH:mm")
                                            : "-")

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        Finalized By
                    </div>

                    <div class="fw-semibold">

                        @(string.IsNullOrWhiteSpace(Model.FinalizedBy)
                                            ? "-"
                                            : Model.FinalizedBy)

                </div>

                </div>

            </div>

        </div>

    </div>
}


@* =========================================================
   Draft Actions
   ========================================================= *@

@if (isDraft)
{
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex
                            justify-content-end
                            flex-wrap
                            gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">

                    <i class="bi bi-pencil-square me-1"></i>
                    Edit Draft

                </a>


                <form asp-action="Finalize"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success"
                            onclick="return confirm('Finalize this Delivery Challan? After Finalization it cannot be edited.');">

                        <i class="bi bi-check-circle me-1"></i>
                        Finalize

                    </button>

                </form>

            </div>

        </div>

    </div>
}