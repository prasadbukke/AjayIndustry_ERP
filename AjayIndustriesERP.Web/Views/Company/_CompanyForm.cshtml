@model AjayIndustriesERP.Web.ViewModels.Company.CompanyViewModel


<!-- =========================================================
     REGION 1 — Validation Summary
     ========================================================= -->

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger">
</div>


<div class="row">


    <!-- =====================================================
         REGION 2 — Company Basic Information
         ===================================================== -->

    <div class="col-md-6 mb-3">

        <label asp-for="CompanyCode"
               class="form-label">
        </label>

        <input asp-for="CompanyId"
               type="hidden" />

        <input asp-for="CompanyCode"
               class="form-control"
               readonly />

        <span asp-validation-for="CompanyCode"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6 mb-3">

        <label asp-for="CompanyName"
               class="form-label">
        </label>

        <input asp-for="CompanyName"
               class="form-control" />

        <span asp-validation-for="CompanyName"
              class="text-danger">
        </span>

    </div>


    <!-- =====================================================
         REGION 3 — Tax Information
         ===================================================== -->

    <div class="col-md-6 mb-3">

        <label asp-for="GstNumber"
               class="form-label">

            GST Number

            <span class="text-muted small">
                (Optional)
            </span>

        </label>

        <input asp-for="GstNumber"
               class="form-control"
               placeholder="Enter GST Number if applicable" />

        <span asp-validation-for="GstNumber"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6 mb-3">

        <label asp-for="PanNumber"
               class="form-label">
        </label>

        <input asp-for="PanNumber"
               class="form-control" />

        <span asp-validation-for="PanNumber"
              class="text-danger">
        </span>

    </div>

    @* =========================================================
   ISO Certification
   ========================================================= *@

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">
            <h5 class="mb-0">
                ISO Certification
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <label asp-for="IsoCertificationNumber"
                           class="form-label">
                    </label>

                    <input asp-for="IsoCertificationNumber"
                           class="form-control" />

                    <span asp-validation-for="IsoCertificationNumber"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>

    <!-- =====================================================
         REGION 4 — Contact Information
         ===================================================== -->

    <div class="col-md-6 mb-3">

        <label asp-for="PhoneNumber"
               class="form-label">
        </label>

        <input asp-for="PhoneNumber"
               class="form-control" />

        <span asp-validation-for="PhoneNumber"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6 mb-3">

        <label asp-for="Email"
               class="form-label">
        </label>

        <input asp-for="Email"
               class="form-control" />

        <span asp-validation-for="Email"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6 mb-3">

        <label asp-for="Website"
               class="form-label">
        </label>

        <input asp-for="Website"
               class="form-control" />

        <span asp-validation-for="Website"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6 mb-3">

        <label asp-for="ContactPerson"
               class="form-label">
        </label>

        <input asp-for="ContactPerson"
               class="form-control" />

        <span asp-validation-for="ContactPerson"
              class="text-danger">
        </span>

    </div>


    <!-- =====================================================
         REGION 5 — Address
         ===================================================== -->

    <div class="col-12 mb-3">

        <label asp-for="Address"
               class="form-label">
        </label>

        <textarea asp-for="Address"
                  class="form-control"
                  rows="3">
        </textarea>

        <span asp-validation-for="Address"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-3 mb-3">

        <label asp-for="City"
               class="form-label">
        </label>

        <input asp-for="City"
               class="form-control" />

        <span asp-validation-for="City"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-3 mb-3">

        <label asp-for="State"
               class="form-label">
        </label>

        <input asp-for="State"
               class="form-control" />

        <span asp-validation-for="State"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-3 mb-3">

        <label asp-for="Country"
               class="form-label">
        </label>

        <input asp-for="Country"
               class="form-control" />

        <span asp-validation-for="Country"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-3 mb-3">

        <label asp-for="PostalCode"
               class="form-label">
        </label>

        <input asp-for="PostalCode"
               class="form-control" />

        <span asp-validation-for="PostalCode"
              class="text-danger">
        </span>

    </div>

    @* =========================================================
   Bank Details
   ========================================================= *@

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">
            <h5 class="mb-0">
                Bank Details
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <label asp-for="BankName"
                           class="form-label">
                    </label>

                    <input asp-for="BankName"
                           class="form-control" />

                    <span asp-validation-for="BankName"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-4">

                    <label asp-for="BankAccountHolderName"
                           class="form-label">
                    </label>

                    <input asp-for="BankAccountHolderName"
                           class="form-control" />

                    <span asp-validation-for="BankAccountHolderName"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-4">

                    <label asp-for="BankAccountNumber"
                           class="form-label">
                    </label>

                    <input asp-for="BankAccountNumber"
                           class="form-control" />

                    <span asp-validation-for="BankAccountNumber"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-4">

                    <label asp-for="BankIfscCode"
                           class="form-label">
                    </label>

                    <input asp-for="BankIfscCode"
                           class="form-control text-uppercase" />

                    <span asp-validation-for="BankIfscCode"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-4">

                    <label asp-for="BankBranchName"
                           class="form-label">
                    </label>

                    <input asp-for="BankBranchName"
                           class="form-control" />

                    <span asp-validation-for="BankBranchName"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-4">

                    <label asp-for="BankAccountType"
                           class="form-label">
                    </label>

                    <input asp-for="BankAccountType"
                           class="form-control"
                           placeholder="e.g. Current Account" />

                    <span asp-validation-for="BankAccountType"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>

    @* =========================================================
   Terms And Conditions
   ========================================================= *@

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">
            <h5 class="mb-0">
                Terms &amp; Conditions
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="PurchaseOrderTermsAndConditions"
                           class="form-label">
                    </label>

                    <textarea asp-for="PurchaseOrderTermsAndConditions"
                              class="form-control"
                              rows="7"
                              placeholder="Default terms and conditions for Purchase Orders"></textarea>

                    <span asp-validation-for="PurchaseOrderTermsAndConditions"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="InvoiceTermsAndConditions"
                           class="form-label">
                    </label>

                    <textarea asp-for="InvoiceTermsAndConditions"
                              class="form-control"
                              rows="7"
                              placeholder="Default terms and conditions for Invoices"></textarea>

                    <span asp-validation-for="InvoiceTermsAndConditions"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         REGION 7 — Active Status
         ===================================================== -->

    <div class="col-12 mb-4">

        <div class="form-check form-switch">

            <input asp-for="IsActive"
                   class="form-check-input" />

            <label asp-for="IsActive"
                   class="form-check-label">
            </label>

        </div>

    </div>


    <!-- =====================================================
         REGION 8 — Actions
         ===================================================== -->

    <div class="col-12">

        <hr />

        <div class="d-flex
                    justify-content-end">

            <a asp-action="Index"
               class="btn btn-secondary me-2">

                Cancel

            </a>


            <button type="submit"
                    class="btn btn-primary">

                <i class="fa-solid
                          fa-floppy-disk
                          me-1">
                </i>

                @(Model.CompanyId == 0
                                ? "Save Company"
                                : "Update Company")

            </button>

        </div>

    </div>


</div>