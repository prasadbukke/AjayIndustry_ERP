@*
    ============================================================
    File: Deleted.cshtml

    Purpose:
    Displays soft-deleted Customer Purchase Orders.

    Responsibilities:
    - Display all deleted Customer POs.
    - Preserve original PO Status.
    - Allow deleted Customer PO restoration.
    - Keep deleted records separate from normal Customer PO Index.

    Important:
    Restore does not create a new Customer PO.
    The original record, code, items and transaction status
    are restored.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.CustomerPurchaseOrder>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] =
        "Deleted Customer Purchase Orders";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Customer Purchase Orders
        </h2>

        <p class="text-muted mb-0">
            Restore previously deleted Customer Purchase Orders.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid
                  fa-arrow-left
                  me-1">
        </i>

        Back to Customer POs

    </a>

</div>


<!-- =========================================================
     REGION 2 — DELETED ORDER LIST
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="width:55px;">
                            #
                        </th>

                        <th>
                            Internal No
                        </th>

                        <th>
                            Customer
                        </th>

                        <th>
                            Customer PO No
                        </th>

                        <th class="text-nowrap">
                            PO Date
                        </th>

                        <th class="text-nowrap">
                            Delivery Date
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                        <th class="text-center"
                            style="width:110px;">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Any())
                    {
                        var serialNumber = 1;


                        @foreach (var order in Model)
                        {
                            <tr>

                                <td>
                                    @serialNumber
                                </td>


                                <td class="fw-semibold text-nowrap">
                                    @order.Code
                                </td>


                                <td>
                                    @order.CustomerName
                                </td>


                                <td>
                                    @order.CustomerPurchaseOrderNumber
                                </td>


                                <td class="text-nowrap">
                                    @(order.CustomerPurchaseOrderDate.ToString("dd-MM-yyyy"))
                                </td>


                                <td class="text-nowrap">
                                    @(order.RequiredDeliveryDate.ToString("dd-MM-yyyy"))
                                </td>


                                <td class="text-center">

                                    @switch (order.Status)
                                    {
                                        case CustomerPurchaseOrderStatus.Draft:

                                            <span class="badge bg-secondary">
                                                Draft
                                            </span>

                                            break;


                                        case CustomerPurchaseOrderStatus.Confirmed:

                                            <span class="badge bg-primary">
                                                Confirmed
                                            </span>

                                            break;


                                        case CustomerPurchaseOrderStatus.Closed:

                                            <span class="badge bg-success">
                                                Closed
                                            </span>

                                            break;


                                        case CustomerPurchaseOrderStatus.Cancelled:

                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>

                                            break;
                                    }

                                </td>


                                <td class="text-center">

                                    <form asp-action="Restore"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@order.Id" />


                                        <button type="submit"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-success"
                                                title="Restore Customer PO">

                                            <i class="fa-solid
                                                      fa-rotate-left
                                                      me-1">
                                            </i>

                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>

                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center
                                       py-5
                                       text-muted">

                                <i class="fa-solid
                                          fa-trash-can
                                          fa-2x
                                          mb-2">
                                </i>

                                <div class="fw-semibold">
                                    No Deleted Customer Purchase Orders
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>