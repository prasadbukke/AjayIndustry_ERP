@*
    ============================================================
    File: Create.cshtml

    Purpose:
    Creates a new Draft Customer Purchase Order.

    Responsibilities:
    - Own the Create form.
    - Render reusable Customer PO _Form.
    - Enable client-side validation.
    - Display validation errors through shared Toast.

    Important:
    Newly created Customer PO is always Draft.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.CustomerPurchaseOrder.CustomerPurchaseOrderFormViewModel

@{
    ViewData["Title"] = "Create Customer PO";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Create Customer Purchase Order
        </h2>

        <p class="text-muted mb-0">
            Register a Purchase Order received from a Customer.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back

    </a>

</div>


<!-- =========================================================
     REGION 2 — CREATE FORM
========================================================== -->

<form asp-action="Create"
      method="post"
      id="customerPurchaseOrderForm">

    @Html.AntiForgeryToken()


    <partial name="_Form"
             model="Model" />


    <!-- =====================================================
         REGION 3 — FORM ACTIONS
    ====================================================== -->

    <div class="d-flex
                justify-content-end
                gap-2
                mb-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-primary">

            <i class="fa-solid fa-floppy-disk me-1"></i>

            Save Customer PO

        </button>

    </div>

</form>


<!-- =========================================================
     REGION 4 — VALIDATION SCRIPTS
========================================================== -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        $(function () {

            $("#customerPurchaseOrderForm")
                .on(
                    "invalid-form.validate",
                    function (
                        event,
                        validator) {

                        const messages =
                            [
                                ...new Set(
                                    validator.errorList
                                        .map(
                                            x =>
                                                x.message
                                        )
                                )
                            ];


                        if (
                            window.showAppToast &&
                            messages.length > 0
                        ) {

                            window.showAppToast(
                                "error",
                                messages.join(
                                    " • "
                                )
                            );
                        }
                    }
                );

        });

    </script>
}