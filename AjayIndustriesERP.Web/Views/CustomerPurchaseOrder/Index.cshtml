@*
    ============================================================
    File: Index.cshtml

    Purpose:
    Displays active Customer Purchase Orders.

    Responsibilities:
    - Display active Customer Purchase Orders only.
    - Provide shared Search.
    - Provide shared Pagination.
    - Display Customer PO Priority and Status.
    - Provide Details action.
    - Allow Edit only for Draft Customer POs.
    - Allow Confirm only for Draft Customer POs.
    - Allow soft-delete for Draft and Confirmed Customer POs.
    - Provide navigation to Deleted Customer Purchase Orders.
    - Reuse the existing global Delete Confirmation system.

    Important:
    - Deleted Customer POs must NOT appear on this page.
    - Deleted Customer POs are displayed separately in Deleted.cshtml.
    - Delete uses the existing global confirmDelete() function.
    - No module-specific Delete Modal or Delete JavaScript is used.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.CustomerPurchaseOrder>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] =
        "Customer Purchase Orders";

    var pageNumber =
        (int)ViewBag.PageNumber;

    var pageSize =
        (int)ViewBag.PageSize;

    var totalRecords =
        (int)ViewBag.TotalRecords;

    var serialNumber =
        ((pageNumber - 1) * pageSize) + 1;
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Customer Purchase Orders
        </h2>

        <p class="text-muted mb-0">
            Manage Purchase Orders received from Customers.
        </p>

    </div>


    <div class="d-flex
                gap-2
                flex-wrap">

        <!-- DELETED ORDERS -->

        <a asp-action="Deleted"
           class="btn btn-outline-secondary">

            <i class="fa-solid
                      fa-trash-can-arrow-up
                      me-1">
            </i>

            Deleted Orders

        </a>


        <!-- ADD CUSTOMER PO -->

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid
                      fa-plus
                      me-1">
            </i>

            Add Customer PO

        </a>

    </div>

</div>


<!-- =========================================================
     REGION 2 — SEARCH
========================================================== -->

<partial name="Components/_SearchBar"
         model='@(ViewBag.SearchText as string ?? "")' />


<!-- =========================================================
     REGION 3 — CUSTOMER PO TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0"
                   style="min-width: 1200px;">

                <thead class="table-light">

                    <tr>

                        <th style="width:55px;"
                            class="text-nowrap">

                            #

                        </th>


                        <th class="text-nowrap">
                            Internal No
                        </th>


                        <th style="min-width:180px;">
                            Customer
                        </th>


                        <th class="text-nowrap">
                            Customer PO No
                        </th>


                        <th class="text-nowrap">
                            PO Date
                        </th>


                        <th class="text-nowrap">
                            Received Date
                        </th>


                        <th class="text-nowrap">
                            Delivery Date
                        </th>


                        <th class="text-center text-nowrap">
                            Priority
                        </th>


                        <th class="text-center text-nowrap">
                            Status
                        </th>


                        <th class="text-center"
                            style="min-width:180px;">

                            Actions

                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                         Model.Any())
                    {
                        @foreach (var order in Model)
                        {
                            var isDraft =
                                order.Status ==
                                CustomerPurchaseOrderStatus.Draft;


                            <tr>

                                <!-- =================================
                                     SERIAL NUMBER
                                ================================== -->

                                <td>
                                    @serialNumber
                                </td>


                                <!-- =================================
                                     INTERNAL CPO NUMBER
                                ================================== -->

                                <td class="text-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="fw-semibold
                                              text-decoration-none">

                                        @order.Code

                                    </a>

                                </td>


                                <!-- =================================
                                     CUSTOMER
                                ================================== -->

                                <td>

                                    <div class="fw-semibold">
                                        @order.CustomerName
                                    </div>


                                    @if (order.Customer != null)
                                    {
                                        <div class="small
                                                    text-muted">

                                            @order.Customer.Code

                                        </div>
                                    }

                                </td>


                                <!-- =================================
                                     CUSTOMER PO NUMBER
                                ================================== -->

                                <td class="text-nowrap">

                                    @order.CustomerPurchaseOrderNumber

                                </td>


                                <!-- =================================
                                     CUSTOMER PO DATE
                                ================================== -->

                                <td class="text-nowrap">

                                    @(
                                        order
                                            .CustomerPurchaseOrderDate
                                            .ToString("dd-MM-yyyy")
                                    )

                                </td>


                                <!-- =================================
                                     RECEIVED DATE
                                ================================== -->

                                <td class="text-nowrap">

                                    @(
                                        order
                                            .ReceivedDate
                                            .ToString("dd-MM-yyyy")
                                    )

                                </td>


                                <!-- =================================
                                     DELIVERY DATE
                                ================================== -->

                                <td class="text-nowrap">

                                    @(
                                        order
                                            .RequiredDeliveryDate
                                            .ToString("dd-MM-yyyy")
                                    )

                                </td>


                                <!-- =================================
                                     PRIORITY
                                ================================== -->

                                <td class="text-center">

                                    @switch (order.Priority)
                                    {
                                        case CustomerPurchaseOrderPriority.Normal:

                                            <span class="badge
                                                         bg-secondary">

                                                Normal

                                            </span>

                                            break;


                                        case CustomerPurchaseOrderPriority.High:

                                            <span class="badge
                                                         bg-warning
                                                         text-dark">

                                                High

                                            </span>

                                            break;


                                        case CustomerPurchaseOrderPriority.Urgent:

                                            <span class="badge
                                                         bg-warning
                                                         text-dark">

                                                Urgent

                                            </span>

                                            break;


                                        case CustomerPurchaseOrderPriority.Critical:

                                            <span class="badge
                                                         bg-danger">

                                                Critical

                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- =================================
                                     STATUS
                                ================================== -->

                                <td class="text-center">

                                    @switch (order.Status)
                                    {
                                        case CustomerPurchaseOrderStatus.Draft:

                                            <span class="badge
                                                         bg-secondary">

                                                Draft

                                            </span>

                                            break;


                                        case CustomerPurchaseOrderStatus.Confirmed:

                                            <span class="badge
                                                         bg-primary">

                                                Confirmed

                                            </span>

                                            break;


                                        case CustomerPurchaseOrderStatus.Closed:

                                            <span class="badge
                                                         bg-success">

                                                Closed

                                            </span>

                                            break;


                                        case CustomerPurchaseOrderStatus.Cancelled:

                                            <span class="badge
                                                         bg-danger">

                                                Cancelled

                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- =================================
                                     ACTIONS
                                ================================== -->

                                <td class="text-center">

                                    <div class="d-flex
                                                justify-content-center
                                                align-items-center
                                                gap-1">


                                        <!-- =========================
                                             DETAILS
                                        ========================== -->

                                        <a asp-action="Details"
                                           asp-route-id="@order.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-info"
                                           title="View Details">

                                            <i class="fa-solid
                                                      fa-eye">
                                            </i>

                                        </a>


                                        <!-- =========================
                                             EDIT
                                        ========================== -->

                                        @if (isDraft)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@order.Id"
                                               class="btn
                                                      btn-sm
                                                      btn-outline-warning"
                                               title="Edit Customer PO">

                                                <i class="fa-solid
                                                          fa-pen">
                                                </i>

                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn
                                                           btn-sm
                                                           btn-outline-warning"
                                                    title="Only Draft Customer POs can be edited."
                                                    disabled>

                                                <i class="fa-solid
                                                          fa-pen">
                                                </i>

                                            </button>
                                        }


                                        <!-- =========================
                                             CONFIRM
                                        ========================== -->

                                        @if (isDraft)
                                        {
                                            <form asp-action="Confirm"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()


                                                <input type="hidden"
                                                       name="id"
                                                       value="@order.Id" />


                                                <button type="submit"
                                                        class="btn
                                                               btn-sm
                                                               btn-outline-success"
                                                        title="Confirm Customer PO"
                                                        onclick="return confirm(
                                                            'Confirm this Customer Purchase Order? After confirmation it cannot be edited.')">

                                                    <i class="fa-solid
                                                              fa-circle-check">
                                                    </i>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn
                                                           btn-sm
                                                           btn-outline-success"
                                                    title="Customer PO is already processed."
                                                    disabled>

                                                <i class="fa-solid
                                                          fa-circle-check">
                                                </i>

                                            </button>
                                        }


                                        <!-- =========================
                                             DELETE
                                             
                                             Important:
                                             Delete remains enabled
                                             even after confirmation.

                                             Existing common
                                             confirmDelete() is reused.
                                        ========================== -->

                                        <button type="button"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-danger"
                                                title="Delete Customer PO"
                                                onclick="confirmDelete(
                                                    '@Url.Action(
                                                        "Delete",
                                                        "CustomerPurchaseOrder",
                                                        new
                                                        {
                                                            id = order.Id
                                                        })')">

                                            <i class="fa-solid
                                                      fa-trash">
                                            </i>

                                        </button>

                                    </div>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <!-- ===================================
                             EMPTY STATE
                        ==================================== -->

                        <tr>

                            <td colspan="10"
                                class="text-center
                                       py-5">

                                <div class="text-muted">

                                    <i class="fa-solid
                                              fa-file-circle-xmark
                                              fa-2x
                                              mb-3">
                                    </i>


                                    <div class="fw-semibold
                                                mb-1">

                                        No Customer Purchase Orders Found

                                    </div>


                                    <div class="small">

                                        Add a Customer Purchase Order
                                        or change your search.

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — TOTAL RECORDS + PAGINATION
========================================================== -->

@if (totalRecords > 0)
{
    <div class="mt-3">

        <partial name="Components/_Pagination"
                 model='(
                     (int)ViewBag.PageNumber,
                     (int)ViewBag.PageSize
                 )' />

    </div>
}