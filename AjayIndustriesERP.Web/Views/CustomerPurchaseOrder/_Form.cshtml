                        <option value="">
                            -- Select Item --
                        </option>


                        @foreach (var option
                            in Model.AvailableItems)
                        {
                            <option value="@option.Value">
                                @option.Text
                            </option>
                        }

                    </select>


                    <span class="text-danger small field-validation-valid"
                          data-valmsg-for="Items[__index__].ItemId"
                          data-valmsg-replace="true">
                    </span>

                </div>


                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Item Code
                    </label>

                    <input type="text"
                           class="form-control
                                  item-code-display"
                           readonly />

                </div>


                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Unit
                    </label>

                    <input type="text"
                           class="form-control
                                  item-unit-display"
                           readonly />

                </div>


                <div class="col-12">

                    <label class="form-label fw-semibold">
                        Specification
                    </label>

                    <textarea class="form-control
                                     item-specification-display"
                              rows="2"
                              readonly></textarea>

                </div>

                <!-- =========================================
     CURRENT ITEM DRAWING
========================================== -->

