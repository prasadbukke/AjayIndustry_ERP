@*
    ============================================================
    File: _Form.cshtml

    Purpose:
    Reusable Customer Purchase Order form used by Create/Edit.

    Responsibilities:
    - Display Customer PO header information.
    - Load Customer Master selection.
    - Manage multiple Customer PO Item rows.
    - Support searchable Item selection.
    - Load trusted Item Master information through AJAX.
    - Display current Item Drawing information.
    - Prevent duplicate Items in the same Customer PO.
    - Show similar Customer PO Number warnings.
    - Allow Customer-specific Item / Drawing references.
    - Allow Ordered Quantity entry.
    - Allow optional line Delivery Date override.
    - Allow optional line Priority override.
    - Support dynamic Add / Remove Item operations.

    Important:
    - This partial DOES NOT contain a <form> tag.
    - Create.cshtml and Edit.cshtml own the actual <form>.
    - Existing Customer Master and Item Master are reused.
    - Item display snapshots posted from browser are NOT trusted.
      Application Service reloads Item Master before saving.
    - Same Item cannot appear more than once in the same
      Customer Purchase Order.
    - Raw Material Items are excluded by Repository.
    - Client-side functionality belongs in
      customer-purchase-order-form.js.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.CustomerPurchaseOrder.CustomerPurchaseOrderFormViewModel

@using AjayIndustriesERP.Domain.Enums

@{
    var isEditMode =
        Model.Id > 0;
}


<!-- =========================================================
     REGION 1 — CUSTOMER PO INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-file-lines me-1"></i>

            Customer Purchase Order Information

        </span>

    </div>


    <div class="card-body">

        <div class="row g-3">


            <!-- =============================================
                 INTERNAL ORDER NUMBER
            ============================================== -->

            @if (isEditMode)
            {
                <div class="col-lg-4 col-md-6">

                    <label asp-for="Code"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Code"
                           class="form-control"
                           readonly />

                </div>


                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Status"
                           readonly />

                </div>
            }


            <!-- =============================================
                 CUSTOMER
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="CustomerId"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">
                    *
                </span>

                <select asp-for="CustomerId"
                        asp-items="Model.Customers"
                        class="form-select">

                    <option value="">
                        -- Select Customer --
                    </option>

                </select>

                <span asp-validation-for="CustomerId"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 CUSTOMER PO NUMBER
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="CustomerPurchaseOrderNumber"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">
                    *
                </span>

                <input asp-for="CustomerPurchaseOrderNumber"
                       class="form-control"
                       autocomplete="off"
                       maxlength="100"
                       placeholder="Enter Customer PO Number"
                       data-similar-url="@Url.Action(
                           "CheckCustomerPurchaseOrderNumber",
                           "CustomerPurchaseOrder")"
                       data-exclude-id="@Model.Id" />

                <span asp-validation-for="CustomerPurchaseOrderNumber"
                      class="text-danger small">
                </span>

                <div class="form-text">
                    Similar Customer PO Numbers will appear while typing.
                </div>

            </div>


            <!-- =============================================
                 CUSTOMER PO DATE
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="CustomerPurchaseOrderDate"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">
                    *
                </span>

                <input asp-for="CustomerPurchaseOrderDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="CustomerPurchaseOrderDate"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 RECEIVED DATE
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="ReceivedDate"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">
                    *
                </span>

                <input asp-for="ReceivedDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="ReceivedDate"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 REQUIRED DELIVERY DATE
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="RequiredDeliveryDate"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">
                    *
                </span>

                <input asp-for="RequiredDeliveryDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="RequiredDeliveryDate"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 PRIORITY
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="Priority"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">
                    *
                </span>

                <select asp-for="Priority"
                        asp-items="Html.GetEnumSelectList<CustomerPurchaseOrderPriority>()"
                        class="form-select">
                </select>

                <span asp-validation-for="Priority"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 CUSTOMER REFERENCE
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="CustomerReference"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="CustomerReference"
                       class="form-control"
                       maxlength="200"
                       placeholder="Optional customer reference" />

                <span asp-validation-for="CustomerReference"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 REMARKS
            ============================================== -->

            <div class="col-lg-8 col-md-12">

                <label asp-for="Remarks"
                       class="form-label fw-semibold">
                </label>

                <textarea asp-for="Remarks"
                          class="form-control"
                          rows="2"
                          maxlength="1000"
                          placeholder="Enter remarks"></textarea>

                <span asp-validation-for="Remarks"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 2 — SIMILAR CUSTOMER PO WARNING
========================================================== -->

<div id="similarCustomerPoWarning"
     class="alert alert-warning d-none">

    <div class="fw-semibold mb-2">

        <i class="fa-solid
                  fa-triangle-exclamation
                  me-1">
        </i>

        Similar Customer PO Numbers Found

    </div>


    <p class="mb-2">

        Check whether the Customer PO already exists or
        whether there is a spelling mistake.

    </p>


    <ul id="similarCustomerPoList"
        class="mb-3">
    </ul>


    <div id="customerPoExactDuplicateMessage"
         class="text-danger
                fw-semibold
                d-none
                mb-2">

        The same Customer PO Number already exists
        for the selected Customer.

    </div>


    <div id="customerPoSimilarConfirmationContainer"
         class="form-check d-none">

        <input type="checkbox"
               id="ConfirmSimilarCustomerPoNumber"
               class="form-check-input" />

        <label for="ConfirmSimilarCustomerPoNumber"
               class="form-check-label">

            I checked the similar Customer PO Numbers
            and still want to continue.

        </label>

    </div>

</div>


<!-- =========================================================
     REGION 3 — CUSTOMER PO ITEMS
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header
                bg-light
                d-flex
                justify-content-between
                align-items-center
                flex-wrap
                gap-2">

        <span class="fw-semibold">

            <i class="fa-solid
                      fa-boxes-stacked
                      me-1">
            </i>

            Customer PO Items

        </span>


        <button type="button"
                id="btnAddItem"
                class="btn btn-sm btn-primary">

            <i class="fa-solid fa-plus me-1"></i>

            Add Item

        </button>

    </div>


    <div class="card-body">


        <!-- =================================================
             REGION 4 — EXISTING / POSTED ITEM ROWS
        ================================================== -->

        <div id="customerPoItemsContainer"
             data-item-data-url="@Url.Action(
                 "GetItemData",
                 "CustomerPurchaseOrder")">

            @for (var i = 0;
                  i < Model.Items.Count;
                  i++)
            {
                <div class="customer-po-item-row
                            border
                            rounded
                            p-3
                            mb-3"
                     data-index="@i">


                    <!-- =====================================
                         ITEM ROW HEADER
                    ====================================== -->

                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                gap-2
                                item-row-header">

                        <button type="button"
                                class="btn
                                       btn-link
                                       text-decoration-none
                                       text-start
                                       p-0
                                       flex-grow-1
                                       item-toggle-button">

                            <span class="fw-semibold
                                         item-row-title">

                                Item @(i + 1)

                            </span>


                            <span class="text-muted
                                         small
                                         ms-2
                                         item-row-summary">

                                @if (!string.IsNullOrWhiteSpace(
                                    Model.Items[i].ItemName))
                                {
                                    @($"{Model.Items[i].ItemCode} - {Model.Items[i].ItemName}")
                                }

                            </span>


                            <i class="fa-solid
                                      fa-chevron-down
                                      ms-2
                                      item-toggle-icon">
                            </i>

                        </button>


                        <button type="button"
                                class="btn
                                       btn-sm
                                       btn-outline-danger
                                       btn-remove-item"
                                title="Remove Item">

                            <i class="fa-solid fa-trash"></i>

                        </button>

                    </div>


                    <!-- =====================================
                         ITEM ROW BODY
                    ====================================== -->

                    <div class="item-row-body mt-3">


                        <!-- =================================
                             HIDDEN LINE DATA
                        ================================== -->

                        <input asp-for="Items[i].Id"
                               type="hidden"
                               class="item-line-id" />


                        <input asp-for="Items[i].ItemCode"
                               type="hidden"
                               class="item-code-hidden" />


                        <input asp-for="Items[i].ItemName"
                               type="hidden"
                               class="item-name-hidden" />


                        <input asp-for="Items[i].Specification"
                               type="hidden"
                               class="item-specification-hidden" />


                        <input asp-for="Items[i].UnitName"
                               type="hidden"
                               class="item-unit-hidden" />


                        <!-- =================================
                             ITEM MASTER INFORMATION
                        ================================== -->

                        <div class="row g-3">


                            <!-- ITEM -->

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label fw-semibold">
                                    Item
                                </label>

                                <span class="text-danger">
                                    *
                                </span>


                                <select asp-for="Items[i].ItemId"
                                        asp-items="Model.AvailableItems"
                                        class="form-select
                                               item-select
                                               js-customer-po-item-select">

                                    <option value="">
                                        -- Select Item --
                                    </option>

                                </select>


                                <span asp-validation-for="Items[i].ItemId"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- ITEM CODE -->

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label fw-semibold">
                                    Item Code
                                </label>

                                <input type="text"
                                       class="form-control
                                              item-code-display"
                                       value="@Model.Items[i].ItemCode"
                                       readonly />

                            </div>


                            <!-- UNIT -->

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label fw-semibold">
                                    Unit
                                </label>

                                <input type="text"
                                       class="form-control
                                              item-unit-display"
                                       value="@Model.Items[i].UnitName"
                                       readonly />

                            </div>


                            <!-- SPECIFICATION -->

                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Specification
                                </label>

                                <textarea class="form-control
                                                 item-specification-display"
                                          rows="2"
                                          readonly>@Model.Items[i].Specification</textarea>

                            </div>


                            <!-- =================================
                                 CURRENT ITEM DRAWING
                            ================================== -->

                            <div class="col-12">

                                <div class="border
                                            rounded
                                            p-3
                                            bg-light">

                                    <div class="d-flex
                                                justify-content-between
                                                align-items-center
                                                flex-wrap
                                                gap-2
                                                mb-3">

                                        <div class="fw-semibold">

                                            <i class="fa-solid
                                                      fa-file-lines
                                                      me-1">
                                            </i>

                                            Current Item Drawing

                                        </div>


                                        <span class="badge
                                                     bg-light
                                                     text-dark
                                                     border
                                                     item-drawing-status">

                                            No Drawing

                                        </span>

                                    </div>


                                    <div class="row g-3">


                                        <!-- DRAWING NUMBER -->

                                        <div class="col-lg-4 col-md-6">

                                            <div class="small text-muted mb-1">
                                                Drawing Number
                                            </div>

                                            <div class="fw-semibold
                                                        item-drawing-number">
                                                -
                                            </div>

                                        </div>


                                        <!-- REVISION -->

                                        <div class="col-lg-2 col-md-6">

                                            <div class="small text-muted mb-1">
                                                Revision
                                            </div>

                                            <div class="fw-semibold
                                                        item-drawing-revision">
                                                -
                                            </div>

                                        </div>


                                        <!-- DRAWING NAME -->

                                        <div class="col-lg-3 col-md-6">

                                            <div class="small text-muted mb-1">
                                                Drawing Name
                                            </div>

                                            <div class="item-drawing-name">
                                                -
                                            </div>

                                        </div>


                                        <!-- DRAWING TYPE -->

                                        <div class="col-lg-3 col-md-6">

                                            <div class="small text-muted mb-1">
                                                Drawing Type
                                            </div>

                                            <div class="item-drawing-type">
                                                -
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================
                             CUSTOMER ITEM REFERENCES
                        ================================== -->

                        <div class="row g-3 mt-1">


                            <!-- CUSTOMER ITEM CODE -->

                            <div class="col-lg-4 col-md-6">

                                <label asp-for="Items[i].CustomerItemCode"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Items[i].CustomerItemCode"
                                       class="form-control"
                                       maxlength="100"
                                       placeholder="Optional" />

                                <span asp-validation-for="Items[i].CustomerItemCode"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- CUSTOMER DRAWING -->

                            <div class="col-lg-4 col-md-6">

                                <label asp-for="Items[i].CustomerDrawingNumber"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Items[i].CustomerDrawingNumber"
                                       class="form-control"
                                       maxlength="150"
                                       placeholder="Optional" />

                                <span asp-validation-for="Items[i].CustomerDrawingNumber"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- CUSTOMER REVISION -->

                            <div class="col-lg-4 col-md-6">

                                <label asp-for="Items[i].Revision"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Items[i].Revision"
                                       class="form-control"
                                       maxlength="50"
                                       placeholder="Optional" />

                                <span asp-validation-for="Items[i].Revision"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- =================================
                             QUANTITY / DELIVERY / PRIORITY
                        ================================== -->

                        <div class="row g-3 mt-1">


                            <!-- ORDERED QUANTITY -->

                            <div class="col-lg-4 col-md-6">

                                <label asp-for="Items[i].OrderedQuantity"
                                       class="form-label fw-semibold">
                                </label>

                                <span class="text-danger">
                                    *
                                </span>

                                <input asp-for="Items[i].OrderedQuantity"
                                       type="number"
                                       min="0.001"
                                       step="0.001"
                                       class="form-control
                                              item-quantity-input"
                                       placeholder="Enter quantity" />

                                <span asp-validation-for="Items[i].OrderedQuantity"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- REQUIRED DELIVERY DATE -->

                            <div class="col-lg-4 col-md-6">

                                <label asp-for="Items[i].RequiredDeliveryDate"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Items[i].RequiredDeliveryDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="Items[i].RequiredDeliveryDate"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">
                                    Leave blank to use PO delivery date.
                                </div>

                            </div>


                            <!-- PRIORITY -->

                            <div class="col-lg-4 col-md-6">

                                <label asp-for="Items[i].Priority"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="Items[i].Priority"
                                        asp-items="Html.GetEnumSelectList<CustomerPurchaseOrderPriority>()"
                                        class="form-select">

                                    <option value="">
                                        Use PO Priority
                                    </option>

                                </select>

                                <span asp-validation-for="Items[i].Priority"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- REMARKS -->

                            <div class="col-12">

                                <label asp-for="Items[i].Remarks"
                                       class="form-label fw-semibold">
                                </label>

                                <textarea asp-for="Items[i].Remarks"
                                          class="form-control"
                                          rows="2"
                                          maxlength="1000"
                                          placeholder="Optional item remarks"></textarea>

                                <span asp-validation-for="Items[i].Remarks"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- =================================================
             REGION 5 — EMPTY ITEM MESSAGE
        ================================================== -->

        <div id="emptyItemMessage"
             class="text-center
                    text-muted
                    py-4
                    d-none">

            <i class="fa-solid
                      fa-box-open
                      fa-2x
                      mb-2">
            </i>

            <div>
                No Items added.
            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 6 — NEW ITEM TEMPLATE
========================================================== -->

<template id="customerPoItemTemplate">

    <div class="customer-po-item-row
                border
                rounded
                p-3
                mb-3"
         data-index="__index__">


        <!-- =============================================
             TEMPLATE HEADER
        ============================================== -->

        <div class="d-flex
                    justify-content-between
                    align-items-center
                    gap-2
                    item-row-header">

            <button type="button"
                    class="btn
                           btn-link
                           text-decoration-none
                           text-start
                           p-0
                           flex-grow-1
                           item-toggle-button">

                <span class="fw-semibold
                             item-row-title">

                    Item __number__

                </span>


                <span class="text-muted
                             small
                             ms-2
                             item-row-summary">
                </span>


                <i class="fa-solid
                          fa-chevron-down
                          ms-2
                          item-toggle-icon">
                </i>

            </button>


            <button type="button"
                    class="btn
                           btn-sm
                           btn-outline-danger
                           btn-remove-item"
                    title="Remove Item">

                <i class="fa-solid fa-trash"></i>

            </button>

        </div>


        <!-- =============================================
             TEMPLATE BODY
        ============================================== -->

        <div class="item-row-body mt-3">


            <!-- =========================================
                 HIDDEN FIELDS
            ========================================== -->

            <input type="hidden"
                   name="Items[__index__].Id"
                   value="0"
                   class="item-line-id" />


            <input type="hidden"
                   name="Items[__index__].ItemCode"
                   class="item-code-hidden" />


            <input type="hidden"
                   name="Items[__index__].ItemName"
                   class="item-name-hidden" />


            <input type="hidden"
                   name="Items[__index__].Specification"
                   class="item-specification-hidden" />


            <input type="hidden"
                   name="Items[__index__].UnitName"
                   class="item-unit-hidden" />


            <!-- =========================================
                 ITEM MASTER
            ========================================== -->

            <div class="row g-3">


                <!-- ITEM -->

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Item
                    </label>

                    <span class="text-danger">
                        *
                    </span>


                    <select name="Items[__index__].ItemId"
                            class="form-select
                                   item-select
                                   js-customer-po-item-select"
                            data-val="true"
                            data-val-range="Please select an Item."
                            data-val-range-min="1"
                            data-val-range-max="2147483647">

                        <option value="">
                            -- Select Item --
                        </option>


                        @foreach (var option
                            in Model.AvailableItems)
                        {
                            <option value="@option.Value">
                                @option.Text
                            </option>
                        }

                    </select>


                    <span class="text-danger
                                 small
                                 field-validation-valid"
                          data-valmsg-for="Items[__index__].ItemId"
                          data-valmsg-replace="true">
                    </span>

                </div>


                <!-- ITEM CODE -->

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Item Code
                    </label>

                    <input type="text"
                           class="form-control
                                  item-code-display"
                           readonly />

                </div>


                <!-- UNIT -->

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Unit
                    </label>

                    <input type="text"
                           class="form-control
                                  item-unit-display"
                           readonly />

                </div>


                <!-- SPECIFICATION -->

                <div class="col-12">

                    <label class="form-label fw-semibold">
                        Specification
                    </label>

                    <textarea class="form-control
                                     item-specification-display"
                              rows="2"
                              readonly></textarea>

                </div>


                <!-- =========================================
                     CURRENT ITEM DRAWING
                ========================================== -->

                <div class="col-12">

                    <div class="border
                                rounded
                                p-3
                                bg-light">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-center
                                    flex-wrap
                                    gap-2
                                    mb-3">

                            <div class="fw-semibold">

                                <i class="fa-solid
                                          fa-file-lines
                                          me-1">
                                </i>

                                Current Item Drawing

                            </div>


                            <span class="badge
                                         bg-light
                                         text-dark
                                         border
                                         item-drawing-status">

                                No Drawing

                            </span>

                        </div>


                        <div class="row g-3">


                            <!-- DRAWING NUMBER -->

                            <div class="col-lg-4 col-md-6">

                                <div class="small text-muted mb-1">
                                    Drawing Number
                                </div>

                                <div class="fw-semibold
                                            item-drawing-number">
                                    -
                                </div>

                            </div>


                            <!-- REVISION -->

                            <div class="col-lg-2 col-md-6">

                                <div class="small text-muted mb-1">
                                    Revision
                                </div>

                                <div class="fw-semibold
                                            item-drawing-revision">
                                    -
                                </div>

                            </div>


                            <!-- DRAWING NAME -->

                            <div class="col-lg-3 col-md-6">

                                <div class="small text-muted mb-1">
                                    Drawing Name
                                </div>

                                <div class="item-drawing-name">
                                    -
                                </div>

                            </div>


                            <!-- DRAWING TYPE -->

                            <div class="col-lg-3 col-md-6">

                                <div class="small text-muted mb-1">
                                    Drawing Type
                                </div>

                                <div class="item-drawing-type">
                                    -
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================================
                 CUSTOMER ITEM REFERENCES
            ========================================== -->

            <div class="row g-3 mt-1">


                <!-- CUSTOMER ITEM CODE -->

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Customer Item Code
                    </label>

                    <input name="Items[__index__].CustomerItemCode"
                           class="form-control"
                           maxlength="100"
                           placeholder="Optional" />

                </div>


                <!-- CUSTOMER DRAWING -->

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Customer Drawing Number
                    </label>

                    <input name="Items[__index__].CustomerDrawingNumber"
                           class="form-control"
                           maxlength="150"
                           placeholder="Optional" />

                </div>


                <!-- CUSTOMER REVISION -->

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Revision
                    </label>

                    <input name="Items[__index__].Revision"
                           class="form-control"
                           maxlength="50"
                           placeholder="Optional" />

                </div>

            </div>


            <!-- =========================================
                 QUANTITY / DELIVERY / PRIORITY
            ========================================== -->

            <div class="row g-3 mt-1">


                <!-- ORDERED QUANTITY -->

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Ordered Quantity
                    </label>

                    <span class="text-danger">
                        *
                    </span>


                    <input name="Items[__index__].OrderedQuantity"
                           type="number"
                           min="0.001"
                           step="0.001"
                           class="form-control
                                  item-quantity-input"
                           placeholder="Enter quantity"
                           data-val="true"
                           data-val-range="Ordered Quantity must be greater than zero."
                           data-val-range-min="0.001"
                           data-val-range-max="999999999999999.999" />


                    <span class="text-danger
                                 small
                                 field-validation-valid"
                          data-valmsg-for="Items[__index__].OrderedQuantity"
                          data-valmsg-replace="true">
                    </span>

                </div>


                <!-- REQUIRED DELIVERY DATE -->

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Required Delivery Date
                    </label>

                    <input name="Items[__index__].RequiredDeliveryDate"
                           type="date"
                           class="form-control" />

                    <div class="form-text">
                        Leave blank to use PO delivery date.
                    </div>

                </div>


                <!-- PRIORITY -->

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Priority
                    </label>


                    <select name="Items[__index__].Priority"
                            class="form-select">

                        <option value="">
                            Use PO Priority
                        </option>


                        @foreach (var priority
                            in Html.GetEnumSelectList<CustomerPurchaseOrderPriority>())
                        {
                            <option value="@priority.Value">
                                @priority.Text
                            </option>
                        }

                    </select>

                </div>


                <!-- REMARKS -->

                <div class="col-12">

                    <label class="form-label fw-semibold">
                        Remarks
                    </label>

                    <textarea name="Items[__index__].Remarks"
                              class="form-control"
                              rows="2"
                              maxlength="1000"
                              placeholder="Optional item remarks"></textarea>

                </div>

            </div>

        </div>

    </div>

</template>