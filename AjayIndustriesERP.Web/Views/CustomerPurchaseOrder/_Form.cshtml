                           data-val-range-max="999999999999999.999" />


                    <span class="text-danger small field-validation-valid"
                          data-valmsg-for="Items[__index__].OrderedQuantity"
                          data-valmsg-replace="true">
                    </span>

                </div>


                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Required Delivery Date
                    </label>

                    <input name="Items[__index__].RequiredDeliveryDate"
                           type="date"
                           class="form-control" />

                    <div class="form-text">
                        Leave blank to use PO delivery date.
                    </div>

                </div>


                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Priority
                    </label>


                    <select name="Items[__index__].Priority"
                            class="form-select">

                        <option value="">
                            Use PO Priority
                        </option>


                        @foreach (var priority
                            in Html.GetEnumSelectList<CustomerPurchaseOrderPriority>())
                        {
                            <option value="@priority.Value">
                                @priority.Text
                            </option>
                        }

                    </select>

                </div>


                <div class="col-12">

                    <label class="form-label fw-semibold">
                        Remarks
                    </label>

                    <textarea name="Items[__index__].Remarks"
                              class="form-control"
                              rows="2"
                              maxlength="1000"
                              placeholder="Optional item remarks"></textarea>

                </div>

            </div>

        </div>

    </div>

</template>


<!-- =========================================================
     REGION 7 — ITEM FORM SCRIPT
========================================================== -->

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            // =================================================
            // REGION 7.1 — ELEMENT REFERENCES
            // =================================================

            const container =
                document.getElementById(
                    "customerPoItemsContainer"
                );

            const template =
                document.getElementById(
                    "customerPoItemTemplate"
                );

            const addButton =
                document.getElementById(
                    "btnAddItem"
                );

            const emptyMessage =
                document.getElementById(
                    "emptyItemMessage"
                );


            if (!container ||
                !template ||
                !addButton ||
                !emptyMessage) {

                return;
            }


            // =================================================
            // REGION 7.2 — EMPTY STATE
            // =================================================

            function updateEmptyState() {

                const rows =
                    container.querySelectorAll(
                        ".customer-po-item-row"
                    );


                if (rows.length === 0) {

                    emptyMessage.classList.remove(
                        "d-none"
                    );
                }
                else {

                    emptyMessage.classList.add(
                        "d-none"
                    );
                }
            }


            // =================================================
            // REGION 7.3 — COLLAPSE / EXPAND
            // =================================================

            function collapseRow(
                row) {

                if (!row) {
                    return;
                }


                row.classList.add(
                    "is-collapsed"
                );
            }


            function expandRow(
                row) {

                if (!row) {
                    return;
                }


                row.classList.remove(
                    "is-collapsed"
                );
            }


            function collapseAllExcept(
                activeRow) {

                const rows =
                    container.querySelectorAll(
                        ".customer-po-item-row"
                    );


                rows.forEach(
                    function (row) {

                        if (row === activeRow) {

                            expandRow(row);
                        }
                        else {

                            collapseRow(row);
                        }
                    }
                );
            }


            // =================================================
            // REGION 7.4 — ITEM SUMMARY
            // =================================================

            function updateRowSummary(
                row,
                itemCode,
                itemName) {

                const summary =
                    row.querySelector(
                        ".item-row-summary"
                    );


                if (!summary) {
                    return;
                }


                if (!itemCode &&
                    !itemName) {

                    summary.textContent =
                        "";

                    return;
                }


                if (itemCode &&
                    itemName) {

                    summary.textContent =
                        itemCode +
                        " - " +
                        itemName;
                }
                else {

                    summary.textContent =
                        itemCode ||
                        itemName ||
                        "";
                }
            }


            // =================================================
            // REGION 7.5 — REINDEX ITEM ROWS
            // =================================================

            function reindexRows() {

                const rows =
                    container.querySelectorAll(
                        ".customer-po-item-row"
                    );


                rows.forEach(
                    function (
                        row,
                        index) {

                        row.dataset.index =
                            index;


                        // =====================================
                        // TITLE
                        // =====================================

                        const title =
                            row.querySelector(
                                ".item-row-title"
                            );


                        if (title) {

                            title.textContent =
                                "Item " +
                                (index + 1);
                        }


                        // =====================================
                        // NAME ATTRIBUTES
                        // =====================================

                        row.querySelectorAll(
                            "[name]"
                        ).forEach(
                            function (element) {

                                element.name =
                                    element.name.replace(
                                        /Items\[\d+\]/g,
                                        "Items[" +
                                        index +
                                        "]"
                                    );
                            }
                        );


                        // =====================================
                        // ID ATTRIBUTES
                        // =====================================

                        row.querySelectorAll(
                            "[id]"
                        ).forEach(
                            function (element) {

                                element.id =
                                    element.id.replace(
                                        /Items_\d+__/g,
                                        "Items_" +
                                        index +
                                        "__"
                                    );
                            }
                        );


                        // =====================================
                        // LABEL FOR ATTRIBUTES
                        // =====================================

                        row.querySelectorAll(
                            "label[for]"
                        ).forEach(
                            function (label) {

                                label.htmlFor =
                                    label.htmlFor.replace(
                                        /Items_\d+__/g,
                                        "Items_" +
                                        index +
                                        "__"
                                    );
                            }
                        );


                        // =====================================
                        // VALIDATION MESSAGE TARGETS
                        // =====================================

                        row.querySelectorAll(
                            "[data-valmsg-for]"
                        ).forEach(
                            function (element) {

                                const current =
                                    element.getAttribute(
                                        "data-valmsg-for"
                                    );


                                if (!current) {
                                    return;
                                }


                                element.setAttribute(
                                    "data-valmsg-for",
                                    current.replace(
                                        /Items\[\d+\]/g,
                                        "Items[" +
                                        index +
                                        "]"
                                    )
                                );
                            }
                        );
                    }
                );


                updateEmptyState();
            }


            // =================================================
            // REGION 7.6 — REPARSE VALIDATION
            // =================================================

            function reparseValidation() {

                if (
                    typeof $ === "undefined" ||
                    !$.validator ||
                    !$.validator.unobtrusive
                ) {

                    return;
                }


                const form =
                    document.getElementById(
                        "customerPurchaseOrderForm"
                    );


                if (!form) {
                    return;
                }


                $(form)
                    .removeData(
                        "validator"
                    )
                    .removeData(
                        "unobtrusiveValidation"
                    );


                $.validator
                    .unobtrusive
                    .parse(form);
            }


            // =================================================
            // REGION 7.7 — LOAD ITEM DATA
            // =================================================

            async function loadItemData(
                row,
                itemId) {

                const codeDisplay =
                    row.querySelector(
                        ".item-code-display"
                    );

                const unitDisplay =
                    row.querySelector(
                        ".item-unit-display"
                    );

                const specificationDisplay =
                    row.querySelector(
                        ".item-specification-display"
                    );


                const codeHidden =
                    row.querySelector(
                        ".item-code-hidden"
                    );

                const nameHidden =
                    row.querySelector(
                        ".item-name-hidden"
                    );

                const specificationHidden =
                    row.querySelector(
                        ".item-specification-hidden"
                    );

                const unitHidden =
                    row.querySelector(
                        ".item-unit-hidden"
                    );

                    const drawingStatus =
    row.querySelector(
        ".item-drawing-status"
    );

const drawingNumber =
    row.querySelector(
        ".item-drawing-number"
    );

const drawingRevision =
    row.querySelector(
        ".item-drawing-revision"
    );

const drawingName =
    row.querySelector(
        ".item-drawing-name"
    );

const drawingType =
    row.querySelector(
        ".item-drawing-type"
    );


                if (!itemId) {

                    codeDisplay.value =
                        "";

                    unitDisplay.value =
                        "";

                    specificationDisplay.value =
                        "";


                    codeHidden.value =
                        "";

                    nameHidden.value =
                        "";

                    specificationHidden.value =
                        "";

                    unitHidden.value =
                        "";

                        if (drawingStatus) {

    drawingStatus.textContent =
        "No Drawing";
}


if (drawingNumber) {

    drawingNumber.textContent =
        "-";
}


if (drawingRevision) {

    drawingRevision.textContent =
        "-";
}


if (drawingName) {

    drawingName.textContent =
        "-";
}


if (drawingType) {

    drawingType.textContent =
        "-";
}

                    updateRowSummary(
                        row,
                        "",
                        ""
                    );


                    return;
                }


                try {

                    const response =
                        await fetch(
                            '@Url.Action(
                                "GetItemData",
                                "CustomerPurchaseOrder")'
                            +
                            "?itemId=" +
                            encodeURIComponent(
                                itemId
                            )
                        );


                    const data =
                        await response.json();


                    if (!data.success) {

                        if (window.showAppToast) {

                            window.showAppToast(
                                "error",
                                data.message ||
                                "Unable to load Item."
                            );
                        }


                        return;
                    }


                    // =========================================
                    // DISPLAY VALUES
                    // =========================================

                    codeDisplay.value =
                        data.itemCode || "";

                    unitDisplay.value =
                        data.unitName || "";

                    specificationDisplay.value =
                        data.specification || "";

                        // =========================================
// CURRENT ITEM DRAWING
// =========================================

const hasDrawing =
    Boolean(
        data.drawingId &&
        data.drawingNumber
    );


if (drawingStatus) {

    drawingStatus.textContent =
        hasDrawing
            ? "Current"
            : "No Drawing";
}


if (drawingNumber) {

    drawingNumber.textContent =
        data.drawingNumber ||
        "-";
}


if (drawingRevision) {

    drawingRevision.textContent =
        data.drawingRevision ||
        "-";
}


if (drawingName) {

    drawingName.textContent =
        data.drawingName ||
        "-";
}


if (drawingType) {

    drawingType.textContent =
        data.drawingType ||
        "-";
}


                    // =========================================
                    // HIDDEN POST VALUES
                    // =========================================

                    codeHidden.value =
                        data.itemCode || "";

                    nameHidden.value =
                        data.itemName || "";

                    specificationHidden.value =
                        data.specification || "";

                    unitHidden.value =
                        data.unitName || "";


                    // =========================================
                    // COLLAPSED ROW SUMMARY
                    // =========================================

                    updateRowSummary(
                        row,
                        data.itemCode || "",
                        data.itemName || ""
                    );
                }
                catch (error) {

                    if (window.showAppToast) {

                        window.showAppToast(
                            "error",
                            "Unable to load Item information."
                        );
                    }
                }
            }


            // =================================================
            // REGION 7.8 — ADD ITEM
            // =================================================

            function addItemRow() {

                const rowsBeforeAdd =
                    container.querySelectorAll(
                        ".customer-po-item-row"
                    );


                const index =
                    rowsBeforeAdd.length;


                const number =
                    index + 1;


                const html =
                    template.innerHTML
                        .replaceAll(
                            "__index__",
                            index
                        )
                        .replaceAll(
                            "__number__",
                            number
                        );


                container.insertAdjacentHTML(
                    "beforeend",
                    html
                );


                reindexRows();


                const rows =
                    container.querySelectorAll(
                        ".customer-po-item-row"
                    );


                const newRow =
                    rows[
                        rows.length - 1
                    ];


                /*
                 * Important UX:
                 *
                 * New Item add केल्यावर previous
                 * Item blocks collapse होतील.
                 *
                 * फक्त latest/new Item open राहील.
                 */

                collapseAllExcept(
                    newRow
                );


                reparseValidation();


                if (newRow) {

                    newRow.scrollIntoView({
                        behavior:
                            "smooth",

                        block:
                            "nearest"
                    });
                }
            }


            // =================================================
            // REGION 7.9 — ADD BUTTON
            // =================================================

            addButton.addEventListener(
                "click",
                function () {

                    addItemRow();
                }
            );


            // =================================================
            // REGION 7.10 — ITEM ROW CLICK EVENTS
            // =================================================

            container.addEventListener(
                "click",
                function (event) {

                    // =========================================
                    // COLLAPSE / EXPAND
                    // =========================================

                    const toggleButton =
                        event.target.closest(
                            ".item-toggle-button"
                        );


                    if (toggleButton) {

                        const row =
                            toggleButton.closest(
                                ".customer-po-item-row"
                            );


                        if (!row) {
                            return;
                        }


                        if (
                            row.classList.contains(
                                "is-collapsed"
                            )
                        ) {

                            collapseAllExcept(
                                row
                            );
                        }
                        else {

                            collapseRow(
                                row
                            );
                        }


                        return;
                    }


                    // =========================================
                    // REMOVE ITEM
                    // =========================================

                    const removeButton =
                        event.target.closest(
                            ".btn-remove-item"
                        );


                    if (!removeButton) {
                        return;
                    }


                    const row =
                        removeButton.closest(
                            ".customer-po-item-row"
                        );


                    if (!row) {
                        return;
                    }


                    row.remove();


                    reindexRows();

                    reparseValidation();


                    const remainingRows =
                        container.querySelectorAll(
                            ".customer-po-item-row"
                        );


                    if (
                        remainingRows.length > 0
                    ) {

                        const lastRow =
                            remainingRows[
                                remainingRows.length - 1
                            ];


                        collapseAllExcept(
                            lastRow
                        );
                    }
                }
            );


            // =================================================
            // REGION 7.11 — ITEM SELECTION CHANGE
            // =================================================

            container.addEventListener(
                "change",
                function (event) {

                    if (
                        !event.target.classList.contains(
                            "item-select"
                        )
                    ) {

                        return;
                    }


                    const row =
                        event.target.closest(
                            ".customer-po-item-row"
                        );


                    if (!row) {
                        return;
                    }


                    loadItemData(
                        row,
                        event.target.value
                    );
                }
            );


            // =================================================
            // REGION 7.12 — INITIALIZATION
            // =================================================

            let initialRows =
                container.querySelectorAll(
                    ".customer-po-item-row"
                );


            /*
             * Create page:
             * No row from server → create one blank row.
             */

            if (initialRows.length === 0) {

                addItemRow();

                return;
            }


            /*
             * Edit / validation-return page:
             *
             * Existing rows remain in the model.
             * Previous rows collapse.
             * Last row stays open.
             */

            const lastInitialRow =
                initialRows[
                    initialRows.length - 1
                ];


            collapseAllExcept(
                lastInitialRow
            );


            reindexRows();

            updateEmptyState();

        }
    );

</script>