@*
    ============================================================
    File: _Form.cshtml

    Purpose:
    Reusable Customer Purchase Order form used by Create/Edit.

    Responsibilities:
    - Display Customer PO header information.
    - Load Customer Master selection.
    - Manage multiple Customer PO Item rows.
    - Load trusted Item Master display information through AJAX.
    - Allow Customer-specific Item / Drawing references.
    - Allow Ordered Quantity entry.
    - Allow optional line Delivery Date override.
    - Allow optional line Priority override.
    - Collapse previously entered Item blocks to reduce scrolling.
    - Support dynamic Add / Remove Item operations.

    Important:
    - This partial DOES NOT contain a <form> tag.
    - Create.cshtml and Edit.cshtml own the actual <form>.
    - Existing Customer Master and Item Master are reused.
    - Item display snapshots posted from browser are NOT trusted.
      Application Service reloads Item Master before saving.
    - Same Item may appear on multiple PO lines because Revision,
      Delivery Date or Customer Drawing may differ.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.CustomerPurchaseOrder.CustomerPurchaseOrderFormViewModel

@using AjayIndustriesERP.Domain.Enums

@{
    var isEditMode = Model.Id > 0;
}


<!-- =========================================================
     REGION 1 — ITEM COLLAPSE STYLE
========================================================== -->

<style>

    .customer-po-item-row {
        transition: all 0.2s ease;
    }

    .customer-po-item-row.is-collapsed {
        padding-top: 0.85rem !important;
        padding-bottom: 0.85rem !important;
    }

    .customer-po-item-row.is-collapsed .item-row-body {
        display: none;
    }

    .item-toggle-button {
        color: inherit;
        min-width: 0;
    }

    .item-toggle-button:hover,
    .item-toggle-button:focus {
        color: inherit;
    }

    .item-row-summary {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .item-toggle-icon {
        transition: transform 0.2s ease;
    }

    .customer-po-item-row:not(.is-collapsed)
    .item-toggle-icon {
        transform: rotate(180deg);
    }

</style>


<!-- =========================================================
     REGION 2 — CUSTOMER PO INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-file-lines me-1"></i>

            Customer Purchase Order Information

        </span>

    </div>


    <div class="card-body">

        <div class="row g-3">


            <!-- =============================================
                 INTERNAL ORDER NUMBER
            ============================================== -->

            @if (isEditMode)
            {
                <div class="col-lg-4 col-md-6">

                    <label asp-for="Code"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Code"
                           class="form-control"
                           readonly />

                </div>


                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Status"
                           readonly />

                </div>
            }


            <!-- =============================================
                 CUSTOMER
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="CustomerId"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <select asp-for="CustomerId"
                        asp-items="Model.Customers"
                        class="form-select">

                    <option value="">
                        -- Select Customer --
                    </option>

                </select>

                <span asp-validation-for="CustomerId"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 CUSTOMER PO NUMBER
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="CustomerPurchaseOrderNumber"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="CustomerPurchaseOrderNumber"
                       class="form-control"
                       maxlength="100"
                       placeholder="Enter Customer PO Number" />

                <span asp-validation-for="CustomerPurchaseOrderNumber"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 CUSTOMER PO DATE
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="CustomerPurchaseOrderDate"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="CustomerPurchaseOrderDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="CustomerPurchaseOrderDate"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 RECEIVED DATE
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="ReceivedDate"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="ReceivedDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="ReceivedDate"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 REQUIRED DELIVERY DATE
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="RequiredDeliveryDate"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="RequiredDeliveryDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="RequiredDeliveryDate"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 PRIORITY
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="Priority"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <select asp-for="Priority"
                        asp-items="Html.GetEnumSelectList<CustomerPurchaseOrderPriority>()"
                        class="form-select">
                </select>

                <span asp-validation-for="Priority"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 CUSTOMER REFERENCE
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="CustomerReference"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="CustomerReference"
                       class="form-control"
                       maxlength="200"
                       placeholder="Optional customer reference" />

                <span asp-validation-for="CustomerReference"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 REMARKS
            ============================================== -->

            <div class="col-lg-8 col-md-12">

                <label asp-for="Remarks"
                       class="form-label fw-semibold">
                </label>

                <textarea asp-for="Remarks"
                          class="form-control"
                          rows="2"
                          maxlength="1000"
                          placeholder="Enter remarks"></textarea>

                <span asp-validation-for="Remarks"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 3 — CUSTOMER PO ITEMS
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header
                bg-light
                d-flex
                justify-content-between
                align-items-center
                flex-wrap
                gap-2">

        <span class="fw-semibold">

            <i class="fa-solid
                      fa-boxes-stacked
                      me-1">
            </i>

            Customer PO Items

        </span>


        <button type="button"
                id="btnAddItem"
                class="btn btn-sm btn-primary">

            <i class="fa-solid fa-plus me-1"></i>

            Add Item

        </button>

    </div>


    <div class="card-body">

        <!-- =================================================
             REGION 4 — EXISTING / POSTED ITEM ROWS
        ================================================== -->

        <div id="customerPoItemsContainer">

            @for (var i = 0; i < Model.Items.Count; i++)
            {
                <div class="customer-po-item-row
                            border
                            rounded
                            p-3
                            mb-3"
                     data-index="@i">


                    <!-- =====================================
                         ITEM ROW HEADER
                    ====================================== -->

                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                gap-2
                                item-row-header">

                        <button type="button"
                                class="btn
                                       btn-link
                                       text-decoration-none
                                       text-start
                                       p-0
                                       flex-grow-1
                                       item-toggle-button">

                            <span class="fw-semibold
                                         item-row-title">

                                Item @(i + 1)

                            </span>


                            <span class="text-muted
                                         small
                                         ms-2
                                         item-row-summary">

                                @if (!string.IsNullOrWhiteSpace(
                                    Model.Items[i].ItemName))
                                {
                                    @($"{Model.Items[i].ItemCode} - {Model.Items[i].ItemName}")
                                }

                            </span>


                            <i class="fa-solid
                                      fa-chevron-down
                                      ms-2
                                      item-toggle-icon">
                            </i>

                        </button>


                        <button type="button"
                                class="btn
                                       btn-sm
                                       btn-outline-danger
                                       btn-remove-item"
                                title="Remove Item">

                            <i class="fa-solid fa-trash"></i>

                        </button>

                    </div>


                    <!-- =====================================
                         ITEM ROW BODY
                    ====================================== -->

                    <div class="item-row-body mt-3">


                        <!-- =================================
                             HIDDEN LINE DATA
                        ================================== -->

                        <input asp-for="Items[i].Id"
                               type="hidden"
                               class="item-line-id" />


                        <input asp-for="Items[i].ItemCode"
                               type="hidden"
                               class="item-code-hidden" />


                        <input asp-for="Items[i].ItemName"
                               type="hidden"
                               class="item-name-hidden" />


                        <input asp-for="Items[i].Specification"
                               type="hidden"
                               class="item-specification-hidden" />


                        <input asp-for="Items[i].UnitName"
                               type="hidden"
                               class="item-unit-hidden" />


                        <!-- =================================
                             ITEM MASTER INFORMATION
                        ================================== -->

                        <div class="row g-3">

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label fw-semibold">
                                    Item
                                </label>

                                <span class="text-danger">*</span>

                                <select asp-for="Items[i].ItemId"
                                        asp-items="Model.AvailableItems"
                                        class="form-select item-select">

                                    <option value="">
                                        -- Select Item --
                                    </option>

                                </select>

                                <span asp-validation-for="Items[i].ItemId"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-lg-4 col-md-6">

                                <label class="form-label fw-semibold">
                                    Item Code
                                </label>

                                <input type="text"
                                       class="form-control
                                              item-code-display"
                                       value="@Model.Items[i].ItemCode"
                                       readonly />

                            </div>


                            <div class="col-lg-4 col-md-6">

                                <label class="form-label fw-semibold">
                                    Unit
                                </label>

                                <input type="text"
                                       class="form-control
                                              item-unit-display"
                                       value="@Model.Items[i].UnitName"
                                       readonly />

                            </div>


                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Specification
                                </label>

                                <textarea class="form-control
                                                 item-specification-display"
                                          rows="2"
                                          readonly>@Model.Items[i].Specification</textarea>

                            </div>

                            <!-- =================================
     CURRENT ITEM DRAWING
================================== -->

<div class="col-12">

    <div class="border rounded p-3 bg-light">

        <div class="d-flex
                    justify-content-between
                    align-items-center
                    flex-wrap
                    gap-2
                    mb-3">

            <div class="fw-semibold">

                <i class="fa-solid
