                          ms-2
                          item-toggle-icon">
                </i>

            </button>


            <button type="button"
                    class="btn
                           btn-sm
                           btn-outline-danger
                           btn-remove-item"
                    title="Remove Item">

                <i class="fa-solid fa-trash"></i>

            </button>

        </div>


        <!-- =============================================
             TEMPLATE BODY
        ============================================== -->

        <div class="item-row-body mt-3">


            <!-- =========================================
                 HIDDEN FIELDS
            ========================================== -->

            <input type="hidden"
                   name="Items[__index__].Id"
                   value="0"
                   class="item-line-id" />


            <input type="hidden"
                   name="Items[__index__].ItemCode"
                   class="item-code-hidden" />


            <input type="hidden"
                   name="Items[__index__].ItemName"
                   class="item-name-hidden" />


            <input type="hidden"
                   name="Items[__index__].Specification"
                   class="item-specification-hidden" />


            <input type="hidden"
                   name="Items[__index__].UnitName"
                   class="item-unit-hidden" />


            <!-- =========================================
                 ITEM MASTER
            ========================================== -->

            <div class="row g-3">

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-semibold">
                        Item
