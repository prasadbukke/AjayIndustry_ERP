@model AjayIndustriesERP.Domain.Entities.Warehouse

@{
    ViewData["Title"] = "Warehouse Details";
}

<div class="card shadow-sm">

    <div class="card-header">

        <h4>Warehouse Details</h4>

    </div>

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9">@Model.WarehouseCode</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.WarehouseName</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.WarehouseType</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Default</dt>
            <dd class="col-sm-9">
                @(Model.IsDefault ? "Yes" : "No")
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @(Model.IsActive ? "Active" : "Inactive")
            </dd>

        </dl>

        <hr />

        <a asp-action="Edit"
           asp-route-id="@Model.WarehouseId"
           class="btn btn-warning">

            Edit

        </a>

        <a asp-action="Index"
           class="btn btn-secondary">

            Back

        </a>

    </div>

</div>