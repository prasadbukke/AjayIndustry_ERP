@model List<AjayIndustriesERP.Domain.Entities.ItemCategory>

@{
    ViewData["Title"] = "ItemCategory Management";
}

<div class="container-fluid">

    <!-- =============================================== -->
    <!-- Header -->
    <!-- =============================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                ItemCategory Management
            </h2>

            <p class="text-muted mb-0">
                Manage ItemCategory information.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus"></i>

            Add ItemCategory

        </a>

    </div>

    <!-- =============================================== -->
    <!-- Search -->
    <!-- =============================================== -->

    <partial name="Components/_SearchBar"
             model='@(ViewBag.SearchText as string ?? "")' />

    <!-- =============================================== -->
    <!-- List -->
    <!-- =============================================== -->

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th width="70">#</th>

                        <th>Code</th>

                        <th>Category Name</th>

                        

                        <th>Status</th>

                        <th width="160">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        int srNo =
                            ((ViewBag.PageNumber - 1) * ViewBag.PageSize) + 1;

                        foreach (var category in Model)
                        {
                            <tr>

                                <td>@srNo</td>

                                <td>@category.CategoryCode</td>

                                <td>@category.CategoryName</td>
                                                             

                                <td>

                                    @if (category.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@category.ItemCategoryId"
                                       class="btn btn-sm btn-outline-info">

                                        <i class="fa-solid fa-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@category.ItemCategoryId"
                                       class="btn btn-sm btn-outline-warning">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="confirmDelete('@Url.Action("Delete", "ItemCategory", new { id = category.ItemCategoryId })')">

                                        <i class="fa-solid fa-trash"></i>

                                    </button>

                                </td>

                            </tr>

                            srNo++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center py-4">

                                No ItemCategory Found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <partial name="Components/_Pagination"
             model='((int)ViewBag.PageNumber, (int)ViewBag.PageSize)' />

</div>