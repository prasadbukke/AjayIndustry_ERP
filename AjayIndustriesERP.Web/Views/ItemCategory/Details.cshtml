@model AjayIndustriesERP.Domain.Entities.ItemCategory

@{
    ViewData["Title"] = "Category Details";
}

<div class="container-fluid">

    <div class="card shadow-sm">

        <div class="card-header">

            <h4>Category Details</h4>

        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Category Code
                </dt>

                <dd class="col-sm-9">
                    @Model.CategoryCode
                </dd>

                <dt class="col-sm-3">
                    Category Name
                </dt>

                <dd class="col-sm-9">
                    @Model.CategoryName
                </dd>

                <dt class="col-sm-3">
                    Description
                </dt>

                <dd class="col-sm-9">
                    @Model.Description
                </dd>

                <dt class="col-sm-3">
                    Status
                </dt>

                <dd class="col-sm-9">

                    @(Model.IsActive ? "Active" : "Inactive")

                </dd>

            </dl>

            <hr />

            <a asp-action="Edit"
               asp-route-id="@Model.ItemCategoryId"
               class="btn btn-warning">

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

</div>