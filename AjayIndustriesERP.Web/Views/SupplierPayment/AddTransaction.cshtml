@*
=============================================================
File: AddTransaction.cshtml
Module: Supplier Payment
Layer: Web - View

Purpose:
Adds another actual payment transaction under an existing
Supplier Payment number.

Example:

Purchase Invoice Total = ₹30,000

AI/SPAY/26-27/00001
    ├── First Payment  = ₹10,000
    ├── Second Payment = ₹10,000
    └── Third Payment  = ₹10,000

All transactions remain under:
AI/SPAY/26-27/00001

Important Business Rules:
- This screen NEVER generates a new Supplier Payment No.
- Payment is added to the existing Supplier Payment.
- Payment Amount must be greater than zero.
- Payment Amount cannot exceed current Outstanding.
- Full Amount button fills current Outstanding.
- Company and Supplier cannot be changed here.
- Completed payment cannot accept another transaction.
- Backend revalidates Outstanding before saving.
=============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.SupplierPayment.SupplierPaymentAddTransactionViewModel

@{
    ViewData["Title"] = "Add Supplier Payment";

    var isCompleted =
        Model.OutstandingAmount <= 0m ||
        Model.PaymentStatus == "Completed";
}


@* =========================================================
   PAGE HEADER
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-start
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Add Payment
        </h2>

        <div class="text-muted">

            Payment No:

            <strong class="text-dark">
                @Model.PaymentCode
            </strong>

        </div>

    </div>


    <div class="d-flex
                flex-wrap
                gap-2">

        <a asp-action="Details"
           asp-route-id="@Model.SupplierPaymentId"
           class="btn
                  btn-outline-secondary">

            <i class="fa-solid
                      fa-arrow-left
                      me-1">
            </i>

            Back to Details

        </a>

    </div>

</div>


@* =========================================================
   VALIDATION SUMMARY
   ========================================================= *@

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly"
         class="alert
                    alert-danger
                    mb-4">
    </div>
}


@* =========================================================
   INVOICE INFORMATION
   ========================================================= *@

<div class="card
            shadow-sm
            border-0
            mb-4">

    <div class="card-header
                bg-white
                py-3">

        <h5 class="fw-semibold mb-0">

            <i class="fa-solid
                      fa-file-invoice-dollar
                      me-2">
            </i>

            Purchase Invoice

        </h5>

    </div>


    <div class="card-body">

        <div class="row g-4">

            @* =================================================
               ERP PURCHASE INVOICE
               ================================================= *@

            <div class="col-xl-4 col-md-6">

                <div class="text-muted small mb-1">
                    ERP Invoice No.
                </div>

                <div>

                    <a asp-controller="PurchaseInvoice"
                       asp-action="Details"
                       asp-route-id="@Model.PurchaseInvoiceId"
                       class="fw-semibold
                              text-decoration-none">

                        @Model.PurchaseInvoiceCode

                    </a>

                </div>

            </div>


            @* =================================================
               SUPPLIER INVOICE NUMBER
               ================================================= *@

            <div class="col-xl-4 col-md-6">

                <div class="text-muted small mb-1">
                    Supplier Invoice No.
                </div>

                <div class="fw-semibold">

                    @if (!string.IsNullOrWhiteSpace(
                                        Model.SupplierInvoiceNumber))
                    {
                        @Model.SupplierInvoiceNumber
                    }
                    else
                    {
                        <span class="text-muted">
                            -
                        </span>
                    }

                </div>

            </div>


            @* =================================================
               SUPPLIER
               ================================================= *@

            <div class="col-xl-4 col-md-6">

                <div class="text-muted small mb-1">
                    Supplier
                </div>

                <div class="fw-semibold">
                    @Model.SupplierName
                </div>

            </div>


            @* =================================================
               PURCHASE INVOICE DATE
               ================================================= *@

            <div class="col-xl-4 col-md-6">

                <div class="text-muted small mb-1">
                    Purchase Invoice Date
                </div>

                <div class="fw-semibold">

                    @(Model.PurchaseInvoiceDate.ToString("dd-MM-yyyy"))

                </div>

            </div>


            @* =================================================
               DUE DATE
               ================================================= *@

            <div class="col-xl-4 col-md-6">

                <div class="text-muted small mb-1">
                    Due Date
                </div>

                <div class="fw-semibold">

                    @if (Model.DueDate.HasValue)
                    {
                        @(Model.DueDate.Value.ToString("dd-MM-yyyy"))
                    }
                    else
                    {
                        <span class="text-muted">
                            -
                        </span>
                    }

                </div>

            </div>


            @* =================================================
               STATUS
               ================================================= *@

            <div class="col-xl-4 col-md-6">

                <div class="text-muted small mb-1">
                    Payment Status
                </div>

                <div>

                    @if (Model.PaymentStatus == "Completed")
                    {
                        <span class="badge
                                         bg-success">

                            <i class="fa-solid
                                          fa-circle-check
                                          me-1">
                            </i>

                            Completed

                        </span>
                    }
                    else if (Model.PaymentStatus == "Partially Paid")
                    {
                        <span class="badge
                                         bg-warning
                                         text-dark">

                            Partially Paid

                        </span>
                    }
                    else
                    {
                        <span class="badge
                                         bg-secondary">

                            Pending

                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


@* =========================================================
   PAYMENT POSITION
   ========================================================= *@

<div class="row g-3 mb-4">

    @* =====================================================
       INVOICE TOTAL
       ===================================================== *@

    <div class="col-lg-4">

        <div class="card
                    shadow-sm
                    border-0
                    h-100">

            <div class="card-body">

                <div class="text-muted small mb-1">
                    Invoice Total
                </div>

                <div class="fs-4 fw-bold">
                    ₹ @(Model.InvoiceTotal.ToString("N2"))
                </div>

            </div>

        </div>

    </div>


    @* =====================================================
       TOTAL PAID
       ===================================================== *@

    <div class="col-lg-4">

        <div class="card
                    shadow-sm
                    border-0
                    h-100">

            <div class="card-body">

                <div class="text-muted small mb-1">
                    Total Paid
                </div>

                <div class="fs-4
                            fw-bold
                            text-success">

                    ₹ @(Model.PaidAmount.ToString("N2"))

                </div>

            </div>

        </div>

    </div>


    @* =====================================================
       CURRENT OUTSTANDING
       ===================================================== *@

    <div class="col-lg-4">

        <div class="card
                    shadow-sm
                    border-0
                    h-100">

            <div class="card-body">

                <div class="text-muted small mb-1">
                    Current Outstanding
                </div>

                @if (isCompleted)
                {
                    <div class="fs-4
                                    fw-bold
                                    text-success">

                        ₹ 0.00

                    </div>
                }
                else
                {
                    <div class="fs-4
                                    fw-bold
                                    text-danger">

                        ₹ @(Model.OutstandingAmount.ToString("N2"))

                    </div>
                }

            </div>

        </div>

    </div>

</div>


@* =========================================================
   COMPLETED MESSAGE
   ========================================================= *@

@if (isCompleted)
{
    <div class="alert
                    alert-success">

        <div class="d-flex
                        align-items-center
                        gap-2">

            <i class="fa-solid
                          fa-circle-check
                          fs-5">
            </i>


            <div>

                <strong>
                    Payment Completed
                </strong>

                <div>
                    This Purchase Invoice is fully paid.
                    No additional payment can be added.
                </div>

            </div>

        </div>

    </div>
}
else
{
    @* =====================================================
       ADD TRANSACTION FORM
       ===================================================== *@

    <form asp-action="AddTransaction"
          asp-route-id="@Model.SupplierPaymentId"
          method="post"
          id="supplierPaymentAddTransactionForm"
          data-outstanding="@Model.OutstandingAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">

        @Html.AntiForgeryToken()


        @* =================================================
           HIDDEN PAYMENT ID
           ================================================= *@

        <input asp-for="SupplierPaymentId"
               type="hidden" />


        @* =================================================
           TRANSACTION CARD
           ================================================= *@

        <div class="card
                        shadow-sm
                        border-0
                        mb-4">

            <div class="card-header
                            bg-white
                            py-3">

                <div class="d-flex
                                justify-content-between
                                align-items-center
                                flex-wrap
                                gap-2">

                    <div>

                        <h5 class="fw-semibold mb-1">

                            <i class="fa-solid
                                          fa-money-bill-transfer
                                          me-2">
                            </i>

                            New Payment Transaction

                        </h5>


                        <div class="text-muted small">

                            This transaction will be added under

                            <strong>
                                @Model.PaymentCode
                            </strong>

                        </div>

                    </div>


                    <div class="text-end">

                        <div class="text-muted small">
                            Maximum Payment
                        </div>

                        <div class="fw-bold
                                        text-danger"
                             id="supplierPaymentMaximumAmount">

                            ₹ @(Model.OutstandingAmount.ToString("N2"))

                        </div>

                    </div>

                </div>

            </div>


            <div class="card-body">

                <div class="row g-3">

                    @* =========================================
                       PAYMENT DATE
                       ========================================= *@

                    <div class="col-xl-4 col-md-6">

                        <label asp-for="Transaction.PaymentDate"
                               class="form-label
                                          fw-semibold">

                            Payment Date
                            <span class="text-danger">*</span>

                        </label>


                        <input asp-for="Transaction.PaymentDate"
                               type="date"
                               value="@(Model.Transaction.PaymentDate.ToString("yyyy-MM-dd"))"
                               class="form-control" />


                        <span asp-validation-for="Transaction.PaymentDate"
                              class="text-danger small">
                        </span>

                    </div>


                    @* =========================================
                       PAYMENT MODE
                       ========================================= *@

                    <div class="col-xl-4 col-md-6">

                        <label asp-for="Transaction.PaymentMode"
                               class="form-label
                                          fw-semibold">

                            Payment Mode
                            <span class="text-danger">*</span>

                        </label>


                        <select asp-for="Transaction.PaymentMode"
                                asp-items="Model.PaymentModes"
                                id="supplierPaymentPaymentMode"
                                class="form-select">
                        </select>


                        <span asp-validation-for="Transaction.PaymentMode"
                              class="text-danger small">
                        </span>

                    </div>


                    @* =========================================
                       PAYMENT AMOUNT
                       ========================================= *@

                    <div class="col-xl-4 col-md-6">

                        <label asp-for="Transaction.Amount"
                               class="form-label
                                          fw-semibold">

                            Payment Amount
                            <span class="text-danger">*</span>

                        </label>


                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>


                            <input asp-for="Transaction.Amount"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   max="@Model.OutstandingAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   id="supplierPaymentAmount"
                                   class="form-control"
                                   autocomplete="off" />


                            <button type="button"
                                    id="supplierPaymentFullAmountButton"
                                    class="btn
                                               btn-outline-secondary"
                                    data-full-amount="@Model.OutstandingAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">

                                Full Amount

                            </button>

                        </div>


                        <span asp-validation-for="Transaction.Amount"
                              class="text-danger small">
                        </span>


                        <div class="form-text">

                            You can pay maximum

                            <strong>
                                ₹ @(Model.OutstandingAmount.ToString("N2"))
                            </strong>

                            in this transaction.

                        </div>

                    </div>


                    @* =========================================
                       BANK NAME
                       ========================================= *@

                    <div class="col-xl-4 col-md-6">

                        <label asp-for="Transaction.BankName"
                               class="form-label">
                        </label>


                        <input asp-for="Transaction.BankName"
                               id="supplierPaymentBankName"
                               class="form-control"
                               maxlength="150"
                               placeholder="Bank name" />


                        <span asp-validation-for="Transaction.BankName"
                              class="text-danger small">
                        </span>

                    </div>


                    @* =========================================
                       REFERENCE NUMBER
                       ========================================= *@

                    <div class="col-xl-4 col-md-6">

                        <label asp-for="Transaction.ReferenceNumber"
                               class="form-label">
                        </label>


                        <input asp-for="Transaction.ReferenceNumber"
                               class="form-control"
                               maxlength="150"
                               placeholder="UTR / Cheque / Transaction No." />


                        <span asp-validation-for="Transaction.ReferenceNumber"
                              class="text-danger small">
                        </span>

                    </div>


                    @* =========================================
                       REMARKS
                       ========================================= *@

                    <div class="col-xl-4 col-md-12">

                        <label asp-for="Transaction.Remarks"
                               class="form-label">
                        </label>


                        <textarea asp-for="Transaction.Remarks"
                                  class="form-control"
                                  rows="1"
                                  maxlength="1000"
                                  placeholder="Optional remarks"></textarea>


                        <span asp-validation-for="Transaction.Remarks"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        @* =================================================
           FORM ACTIONS
           ================================================= *@

        <div class="d-flex
                        justify-content-end
                        flex-wrap
                        gap-2">

            <a asp-action="Details"
               asp-route-id="@Model.SupplierPaymentId"
               class="btn
                          btn-outline-secondary">

                Cancel

            </a>


            <button type="submit"
                    class="btn
                               btn-success">

                <i class="fa-solid
                              fa-plus
                              me-1">
                </i>

                Add Payment

            </button>

        </div>

    </form>
}


@* =========================================================
   SCRIPTS
   ========================================================= *@

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/supplier-payment.js"
            asp-append-version="true">
    </script>
}