@model List<AjayIndustriesERP.Domain.Entities.Shape>

@*
==============================================================

File : Index.cshtml

Purpose :
Displays searchable and paginated Shape Master records.

==============================================================
*@

@{
    ViewData["Title"] = "Shape Management";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Shape Management
            </h2>

            <p class="text-muted mb-0">
                Manage material and Item Shapes.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus me-1"></i>

            Add Shape

        </a>

    </div>

    <partial name="Components/_SearchBar"
             model='@(ViewBag.SearchText as string ?? "")' />

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover
                              align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Code</th>
                            <th>Shape Name</th>
                            <th>Description</th>
                            <th>Status</th>

                            <th class="text-center"
                                style="width: 160px;">

                                Actions

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            var pageNumber =
                                (int)ViewBag.PageNumber;

                            var pageSize =
                                (int)ViewBag.PageSize;

                            var serialNumber =
                                ((pageNumber - 1) * pageSize) + 1;

                            foreach (var shape in Model)
                            {
                                <tr>

                                    <td>
                                        @serialNumber
                                    </td>

                                    <td>

                                        <span class="fw-semibold">
                                            @shape.ShapeCode
                                        </span>

                                    </td>

                                    <td>
                                        @shape.ShapeName
                                    </td>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            shape.Description)
                                                ? "-"
                                                : shape.Description)

                                    </td>

                                    <td>

                                        @if (shape.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Details"
                                           asp-route-id="@shape.ShapeId"
                                           class="btn btn-sm
                                                  btn-outline-info"
                                           title="View">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@shape.ShapeId"
                                           class="btn btn-sm
                                                  btn-outline-warning"
                                           title="Edit">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>

                                        <button type="button"
                                                class="btn btn-sm
                                                       btn-outline-danger"
                                                title="Delete"
                                                onclick="confirmDelete(
                                                    '@Url.Action(
                                                        "Delete",
                                                        "Shape",
                                                        new
                                                        {
                                                            id = shape.ShapeId
                                                        })')">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </td>

                                </tr>

                                serialNumber++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center
                                           text-muted py-5">

                                    <i class="fa-solid
                                              fa-shapes
                                              fa-2x mb-2">
                                    </i>

                                    <div>
                                        No Shape records found.
                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <partial name="Components/_Pagination"
             model='(
                 (int)ViewBag.PageNumber,
                 (int)ViewBag.PageSize
             )' />

</div>