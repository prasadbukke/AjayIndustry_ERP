@model AjayIndustriesERP.Domain.Entities.Shape

@*
==============================================================

File : Details.cshtml

Purpose :
Displays Shape Master details.

==============================================================
*@

@{
    ViewData["Title"] = "Shape Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Shape Details
            </h2>

            <p class="text-muted mb-0">
                View Shape Master information.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back

        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-md-3 mb-3">
                    Shape Code
                </dt>

                <dd class="col-md-9 mb-3">
                    @Model.ShapeCode
                </dd>

                <dt class="col-md-3 mb-3">
                    Shape Name
                </dt>

                <dd class="col-md-9 mb-3">
                    @Model.ShapeName
                </dd>

                <dt class="col-md-3 mb-3">
                    Description
                </dt>

                <dd class="col-md-9 mb-3">

                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "-"
                        : Model.Description)

                </dd>

                <dt class="col-md-3 mb-3">
                    Status
                </dt>

                <dd class="col-md-9 mb-3">

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactive
                        </span>
                    }

                </dd>

                <dt class="col-md-3 mb-3">
                    Created On
                </dt>

                <dd class="col-md-9 mb-3">

                    @Model.CreatedOn
                        .ToLocalTime()
                        .ToString("dd-MMM-yyyy hh:mm tt")

                </dd>

                <dt class="col-md-3 mb-3">
                    Created By
                </dt>

                <dd class="col-md-9 mb-3">
                    @Model.CreatedBy
                </dd>

                @if (Model.ModifiedOn.HasValue)
                {
                    <dt class="col-md-3 mb-3">
                        Modified On
                    </dt>

                    <dd class="col-md-9 mb-3">

                        @Model.ModifiedOn.Value
                            .ToLocalTime()
                            .ToString("dd-MMM-yyyy hh:mm tt")

                    </dd>
                }

            </dl>

        </div>

        <div class="card-footer bg-white text-end">

            <a asp-action="Edit"
               asp-route-id="@Model.ShapeId"
               class="btn btn-warning">

                <i class="fa-solid fa-pen me-1"></i>

                Edit

            </a>

        </div>

    </div>

</div>