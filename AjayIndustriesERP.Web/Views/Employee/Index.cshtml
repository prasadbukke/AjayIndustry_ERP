@model List<AjayIndustriesERP.Domain.Entities.Employee>

@{
    ViewData["Title"] = "Employee Management";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">Employee Management</h2>

            <p class="text-muted mb-0">
                Manage employee information.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus"></i>

            Add Employee

        </a>

    </div>

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row">

                    <div class="col-md-4">

                        <input type="text"
                               name="searchText"
                               class="form-control"
                               placeholder="Search Employee..." />

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="d-flex justify-content-end mb-3">

    <form asp-action="Index" method="get">

        <select name="pageSize"
                class="form-select"
                style="width:120px;"
                onchange="this.form.submit()">

                           
            <option value="10" selected="@(ViewBag.PageSize == 10)">10</option>

            <option value="25" selected="@(ViewBag.PageSize == 25)">25</option>

            <option value="50" selected="@(ViewBag.PageSize == 50)">50</option>

        </select>

    </form>

</div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>#</th>

                        <th>Code</th>

                        <th>Name</th>

                        <th>Mobile</th>

                        <th>Email</th>

                        <th>Status</th>

                        <th width="160">Action</th>

                    </tr>

                </thead>

                <tbody>

@if (Model.Any())
{
    int srNo = 1;

    foreach (var item in Model)
    {
        <tr>

            <td>@srNo</td>

            <td>@item.EmployeeCode</td>

            <td>@($"{item.FirstName} {item.LastName}")</td>

            <td>@item.MobileNumber</td>

            <td>@item.Email</td>

            <td>

                @if (item.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }

            </td>

            <td>

                <a asp-action="Details"
                   asp-route-id="@item.EmployeeId"
                   class="btn btn-sm btn-outline-info">

                    <i class="fa-solid fa-eye"></i>

                </a>

                <a asp-action="Edit"
                   asp-route-id="@item.EmployeeId"
                   class="btn btn-sm btn-outline-warning">

                    <i class="fa-solid fa-pen"></i>

                </a>

                <form asp-action="Delete"
                      asp-route-id="@item.EmployeeId"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-sm btn-outline-danger"
                            onclick="return confirm('Are you sure you want to delete this employee?')">

                        <i class="fa-solid fa-trash"></i>

                    </button>

                </form>

            </td>

        </tr>

        srNo++;
    }
}
else
{
    <tr>

        <td colspan="7"
            class="text-center py-4">

            No Employee Found.

        </td>

    </tr>
}

</tbody>

            </table>

        </div>

    </div>

</div>