@model AjayIndustriesERP.Domain.Entities.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">Employee Details</h2>

            <p class="text-muted">
                View employee information.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left"></i>

            Back

        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Employee Code</label>
                    <div class="form-control bg-light">@Model.EmployeeCode</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">First Name</label>
                    <div class="form-control bg-light">@Model.FirstName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Last Name</label>
                    <div class="form-control bg-light">@Model.LastName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Gender</label>
                    <div class="form-control bg-light">@Model.Gender</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Date Of Birth</label>
                    <div class="form-control bg-light">@Model.DateOfBirth.ToString("dd-MMM-yyyy")</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Joining Date</label>
                    <div class="form-control bg-light">@Model.JoiningDate.ToString("dd-MMM-yyyy")</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Mobile Number</label>
                    <div class="form-control bg-light">@Model.MobileNumber</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Email</label>
                    <div class="form-control bg-light">@Model.Email</div>
                </div>

                <div class="col-12 mb-3">
                    <label class="fw-semibold">Address</label>
                    <div class="form-control bg-light">@Model.Address</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Salary</label>
                    <div class="form-control bg-light">@Model.Salary</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Status</label>

                    <div>

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }

                    </div>

                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Created On</label>
                    <div class="form-control bg-light">@Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Created By</label>
                    <div class="form-control bg-light">@Model.CreatedBy</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Modified On</label>
                    <div class="form-control bg-light">
                        @(Model.ModifiedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold">Modified By</label>
                    <div class="form-control bg-light">
                        @(string.IsNullOrWhiteSpace(Model.ModifiedBy) ? "-" : Model.ModifiedBy)
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>