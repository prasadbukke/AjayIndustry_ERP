@*
    ============================================================
    File: Edit.cshtml

    Purpose:
    Edits a Draft Item Process Routing.

    Responsibilities:
    - Own the Edit form.
    - Preserve Routing Id.
    - Render reusable Routing _Form partial.
    - Update Header and Routing Steps.
    - Enable client-side validation.

    Important:
    - Only Draft Routing reaches this page.
    - Item cannot be changed.
    - Released / Superseded Routing is read-only.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.ItemProcessRouting.ItemProcessRoutingFormViewModel

@{
    ViewData["Title"] =
        "Edit Item Process Routing";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Edit Item Process Routing
        </h2>

        <p class="text-muted mb-0">

            @Model.Code
            · Revision @Model.RevisionNumber

        </p>

    </div>


    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back to Details

    </a>

</div>


<!-- =========================================================
     REGION 2 — EDIT FORM
========================================================== -->

<form asp-controller="ItemProcessRouting"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      id="itemProcessRoutingForm">

    @Html.AntiForgeryToken()


    <input asp-for="Id"
           type="hidden" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <partial name="_Form"
             model="@Model" />


    <!-- =====================================================
         REGION 3 — ACTIONS
    ====================================================== -->

    <div class="d-flex
                justify-content-end
                gap-2
                mb-4">

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-warning">

            <i class="fa-solid
                      fa-floppy-disk
                      me-1">
            </i>

            Update Draft Routing

        </button>

    </div>

</form>


<!-- =========================================================
     REGION 4 — VALIDATION
========================================================== -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}