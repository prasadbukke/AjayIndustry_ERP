@*
    ============================================================
    File: Deleted.cshtml

    Purpose:
    Displays soft-deleted Draft Item Process Routings.

    Responsibilities:
    - Keep deleted Routings separate from main Index.
    - Display Item / Routing / Revision information.
    - Allow deleted Draft Routing restoration.

    Important:
    - Only Draft Routing can currently be deleted.
    - Restore does not generate a new Routing.
    - Original Routing Code and Revision are preserved.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.ItemProcessRouting>

@{
    ViewData["Title"] =
        "Deleted Item Process Routings";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Item Process Routings
        </h2>

        <p class="text-muted mb-0">
            Restore previously deleted Draft Routings.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back to Routings

    </a>

</div>


<!-- =========================================================
     REGION 2 — DELETED ROUTING TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0"
                   style="min-width: 850px;">

                <thead class="table-light">

                    <tr>

                        <th style="width:55px;">
                            #
                        </th>

                        <th class="text-nowrap">
                            Routing Code
                        </th>

                        <th class="text-nowrap">
                            Item Code
                        </th>

                        <th>
                            Item Name
                        </th>

                        <th class="text-center">
                            Revision
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                        <th class="text-center"
                            style="width:130px;">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                                        Model.Any())
                    {
                        var serialNumber = 1;


                        @foreach (var routing in Model)
                        {
                            <tr>

                                <td>
                                    @serialNumber
                                </td>


                                <td class="fw-semibold
                                                   text-nowrap">

                                    @routing.Code

                                </td>


                                <td class="text-nowrap">

                                    @routing.Item?.ItemCode

                                </td>


                                <td class="fw-semibold">

                                    @routing.Item?.ItemName

                                </td>


                                <td class="text-center">

                                    <span class="badge
                                                         bg-light
                                                         text-dark
                                                         border">

                                        Rev @routing.RevisionNumber

                                    </span>

                                </td>


                                <td class="text-center">

                                    <span class="badge bg-secondary">
                                        Draft
                                    </span>

                                </td>


                                <td class="text-center">

                                    <form asp-action="Restore"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="id"
                                               value="@routing.Id" />


                                        <button type="submit"
                                                class="btn
                                                               btn-sm
                                                               btn-outline-success"
                                                title="Restore Routing">

                                            <i class="fa-solid
                                                              fa-rotate-left
                                                              me-1">
                                            </i>

                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center
                                           py-5">

                                <div class="text-muted">

                                    <i class="fa-solid
                                                  fa-trash-can
                                                  fa-2x
                                                  mb-3">
                                    </i>


                                    <div class="fw-semibold mb-1">
                                        No Deleted Routings
                                    </div>


                                    <div class="small">
                                        Deleted Draft Routings will appear here.
                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>