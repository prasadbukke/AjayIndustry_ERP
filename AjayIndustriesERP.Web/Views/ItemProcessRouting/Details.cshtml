@*
    ============================================================
    File: Details.cshtml

    Purpose:
    Displays complete read-only Item Process Routing information.

    Responsibilities:
    - Display Routing Code, Item, Revision and Status.
    - Display ordered Routing Steps.
    - Display Operation and Default Machine.
    - Display Setup / Cycle Time estimates.
    - Allow Draft Routing Edit / Release / Delete.
    - Allow New Revision from current Released Routing.
    - Display Superseded Routing as historical read-only data.

    Important:
    - Draft Routing is editable.
    - Released Routing is approved for Production use.
    - Superseded Routing is historical and read-only.
    - Delete uses the existing global confirmDelete() function.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.ItemProcessRouting.ItemProcessRoutingDetailsViewModel

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] = "Item Process Routing Details";

    var isDraft =
        Model.Status ==
        ItemProcessRoutingStatus.Draft;

    var isReleased =
        Model.Status ==
        ItemProcessRoutingStatus.Released;

    var isSuperseded =
        Model.Status ==
        ItemProcessRoutingStatus.Superseded;
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Item Process Routing
        </h2>

        <p class="text-muted mb-0">

            @Model.Code
            · Revision @Model.RevisionNumber

        </p>

    </div>


    <div class="d-flex
                gap-2
                flex-wrap">


        <!-- =============================================
             DRAFT ACTIONS
        ============================================== -->

        @if (isDraft)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="fa-solid fa-pen me-1"></i>

                Edit Draft

            </a>


            <form asp-action="Release"
                  method="post"
                  class="d-inline"
                  onsubmit="return confirm(
                      'Release this Routing? After Release it cannot be edited directly.')">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="id"
                       value="@Model.Id" />


                <button type="submit"
                        class="btn btn-success">

                    <i class="fa-solid
                              fa-circle-check
                              me-1">
                    </i>

                    Release

                </button>

            </form>


            <button type="button"
                    class="btn btn-outline-danger"
                    onclick="confirmDelete(
                        '@Url.Action(
                            "Delete",
                            "ItemProcessRouting",
                            new
                            {
                                id = Model.Id
                            })')">

                <i class="fa-solid fa-trash me-1"></i>

                Delete

            </button>
        }


        <!-- =============================================
             RELEASED ACTION
        ============================================== -->

        @if (isReleased)
        {
            <form asp-action="CreateRevision"
                  method="post"
                  class="d-inline"
                  onsubmit="return confirm(
                      'Create a new Draft Revision from this Released Routing?')">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="id"
                       value="@Model.Id" />


                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa-solid
                              fa-code-branch
                              me-1">
                    </i>

                    New Revision

                </button>

            </form>
        }


        <!-- =============================================
             BACK
        ============================================== -->

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back

        </a>

    </div>

</div>


<!-- =========================================================
     REGION 2 — STATUS INFORMATION
========================================================== -->

@if (isSuperseded)
{
    <div class="alert
                alert-secondary
                border
                mb-4">

        <div class="d-flex
                    align-items-start
                    gap-2">

            <i class="fa-solid
                      fa-clock-rotate-left
                      mt-1">
            </i>

            <div>

                <div class="fw-semibold">
                    Superseded Routing Revision
                </div>

                <div class="small">
                    This is an older Routing revision.
                    A newer Released revision has replaced it.
                    This revision is retained for production history.
                </div>

            </div>

        </div>

    </div>
}


<!-- =========================================================
     REGION 3 — ROUTING HEADER
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-route me-1"></i>

            Routing Information

        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">


            <!-- ROUTING CODE -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Routing Code
                </div>

                <div class="fw-semibold">
                    @Model.Code
                </div>

            </div>


            <!-- ITEM -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Item
                </div>

                <div class="fw-semibold">
                    @Model.ItemCode
                </div>

                <div class="small text-muted">
                    @Model.ItemName
                </div>

            </div>


            <!-- REVISION -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Revision
                </div>

                <div class="fw-semibold">
                    @Model.RevisionNumber
                </div>

            </div>


            <!-- STATUS -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Status
                </div>

                <div>

                    @switch (Model.Status)
                    {
                        case ItemProcessRoutingStatus.Draft:

                            <span class="badge bg-secondary">
                                Draft
                            </span>

                            break;


                        case ItemProcessRoutingStatus.Released:

                            <span class="badge bg-success">
                                Released
                            </span>

                            break;


                        case ItemProcessRoutingStatus.Superseded:

                            <span class="badge bg-dark">
                                Superseded
                            </span>

                            break;
                    }

                </div>

            </div>


            <!-- EFFECTIVE FROM -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Effective From
                </div>

                <div class="fw-semibold">

                    @(
                        Model.EffectiveFrom.HasValue
                            ? Model.EffectiveFrom.Value
                                .ToString("dd-MM-yyyy")
                            : "-"
                    )

                </div>

            </div>


            <!-- TOTAL STEPS -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Total Process Steps
                </div>

                <div class="fw-semibold">
                    @Model.Steps.Count
                </div>

            </div>

        </div>


        @if (!string.IsNullOrWhiteSpace(
            Model.Remarks))
        {
            <hr />


            <div>

                <div class="text-muted small mb-1">
                    Routing Remarks
                </div>

                <div style="white-space: pre-wrap;">
                    @Model.Remarks
                </div>

            </div>
        }

    </div>

</div>


<!-- =========================================================
     REGION 4 — PROCESS ROUTING
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header
                bg-light
                d-flex
                justify-content-between
                align-items-center">

        <span class="fw-semibold">

            <i class="fa-solid
                      fa-diagram-project
                      me-1">
            </i>

            Manufacturing Process

        </span>


        <span class="badge bg-secondary">

            @Model.Steps.Count Steps

        </span>

    </div>


    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0"
                   style="min-width: 1100px;">

                <thead class="table-light">

                    <tr>

                        <th class="text-center"
                            style="width:80px;">
                            Seq
                        </th>

                        <th style="min-width:210px;">
                            Operation
                        </th>

                        <th style="min-width:210px;">
                            Default Machine
                        </th>

                        <th class="text-end text-nowrap">
                            Setup Time
                        </th>

                        <th class="text-end text-nowrap">
                            Cycle / Piece
                        </th>

                        <th style="min-width:260px;">
                            Instruction
                        </th>

                        <th style="min-width:220px;">
                            Remarks
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Steps.Any())
                    {
                        @foreach (var step
                            in Model.Steps
                                .OrderBy(x =>
                                    x.SequenceNumber))
                        {
                            <tr>

                                <!-- SEQUENCE -->

                                <td class="text-center">

                                    <span class="badge
                                                 bg-light
                                                 text-dark
                                                 border">

                                        @step.SequenceNumber

                                    </span>

                                </td>


                                <!-- OPERATION -->

                                <td>

                                    <div class="fw-semibold">
                                        @step.OperationName
                                    </div>

                                    <div class="small text-muted">
                                        @step.OperationCode
                                    </div>


                                    @if (
                                        step.OperationType ==
                                        ProductionOperationType.Inspection
                                    )
                                    {
                                        <span class="badge
                                                     bg-info
                                                     text-dark
                                                     mt-1">

                                            Inspection

                                        </span>
                                    }

                                </td>


                                <!-- MACHINE -->

                                <td>

                                    @if (
                                        step.DefaultMachineId.HasValue
                                    )
                                    {
                                        <div class="fw-semibold">
                                            @step.DefaultMachineName
                                        </div>

                                        <div class="small text-muted">
                                            @step.DefaultMachineCode
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No Default Machine
                                        </span>
                                    }

                                </td>


                                <!-- SETUP -->

                                <td class="text-end text-nowrap">

                                    @if (
                                        step.SetupTimeMinutes.HasValue
                                    )
                                    {
                                        <span>
                                            @(step.SetupTimeMinutes.Value.ToString("0.###")) min
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- CYCLE -->

                                <td class="text-end text-nowrap">

                                    @if (
                                        step.CycleTimeMinutes.HasValue
                                    )
                                    {
                                        <span>
                                            @(step.CycleTimeMinutes.Value.ToString("0.###")) min
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- INSTRUCTION -->

                                <td>

                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            step.OperationInstruction)
                                    )
                                    {
                                        <div style="white-space: pre-wrap;">
                                            @step.OperationInstruction
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- REMARKS -->

                                <td>

                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            step.Remarks)
                                    )
                                    {
                                        <div style="white-space: pre-wrap;">
                                            @step.Remarks
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center
                                       py-5
                                       text-muted">

                                No Routing Steps found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 5 — WORKFLOW NOTE
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-circle-info me-1"></i>

            Routing Usage

        </span>

    </div>


    <div class="card-body">

        @if (isDraft)
        {
            <div class="text-muted">

                This Routing is currently a Draft.
                Complete the process definition and Release it
                before it can be used for Production Jobs.

            </div>
        }
        else if (isReleased)
        {
            <div class="text-muted">

                This is the current approved Routing revision.
                Future Production Jobs for this Item will use
                this process template.

            </div>
        }
        else
        {
            <div class="text-muted">

                This revision has been replaced by a newer
                Released Routing. It is retained only for
                historical traceability.

            </div>
        }

    </div>

</div>