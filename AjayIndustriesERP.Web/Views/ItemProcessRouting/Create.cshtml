@*
    ============================================================
    File: Create.cshtml

    Purpose:
    Creates the first Draft Process Routing for an Item.

    Responsibilities:
    - Own the Create form.
    - Render reusable Routing _Form partial.
    - Submit Routing Header and Steps.
    - Enable client-side validation.

    Important:
    - One first Routing is created per Item.
    - Further changes after Release use New Revision workflow.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.ItemProcessRouting.ItemProcessRoutingFormViewModel

@{
    ViewData["Title"] =
        "Create Item Process Routing";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Create Item Process Routing
        </h2>

        <p class="text-muted mb-0">
            Define the manufacturing process for an Item.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back

    </a>

</div>


<!-- =========================================================
     REGION 2 — CREATE FORM
========================================================== -->

<form asp-controller="ItemProcessRouting"
      asp-action="Create"
      method="post"
      id="itemProcessRoutingForm">

    @Html.AntiForgeryToken()


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <partial name="_Form"
             model="@Model" />


    <!-- =====================================================
         REGION 3 — ACTIONS
    ====================================================== -->

    <div class="d-flex
                justify-content-end
                gap-2
                mb-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-primary">

            <i class="fa-solid
                      fa-floppy-disk
                      me-1">
            </i>

            Save Draft Routing

        </button>

    </div>

</form>


<!-- =========================================================
     REGION 4 — VALIDATION
========================================================== -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}