@*
    ============================================================
    File: Details.cshtml

    Purpose:
    Displays complete read-only Customer Master information.

    Responsibilities:
    - Display Customer identity.
    - Display Tax information.
    - Display Primary Contact information.
    - Display Primary Address information.
    - Display Commercial information.
    - Display Other information.
    - Provide Back and Edit navigation.

    Important:
    This page is read-only.
    Future Customer PO / Production summaries can be added here.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.Customer.CustomerDetailsViewModel

@{
    ViewData["Title"] = "Customer Details";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Customer Details
        </h2>

        <p class="text-muted mb-0">
            @Model.Code
        </p>

    </div>


    <div class="d-flex gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>
            Back

        </a>


        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-outline-warning">

            <i class="fa-solid fa-pen me-1"></i>
            Edit

        </a>

    </div>

</div>


<!-- =========================================================
     REGION 2 — CUSTOMER INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-building me-1"></i>
            Customer Information
        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Customer Code
                </div>

                <div class="fw-semibold">
                    @Model.Code
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Customer Name
                </div>

                <div class="fw-semibold">
                    @Model.CustomerName
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Legal Name
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.LegalName)
                                        ? "-"
                                        : Model.LegalName)
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 3 — TAX INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-file-invoice me-1"></i>
            Tax Information
        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    GSTIN
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.GSTIN)
                                        ? "-"
                                        : Model.GSTIN)
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    PAN
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.PAN)
                                        ? "-"
                                        : Model.PAN)
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — PRIMARY CONTACT
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-address-book me-1"></i>
            Primary Contact
        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Contact Person
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.ContactPerson)
                                        ? "-"
                                        : Model.ContactPerson)
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Mobile Number
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.MobileNumber)
                                        ? "-"
                                        : Model.MobileNumber)
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Alternate Mobile
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.AlternateMobileNumber)
                                        ? "-"
                                        : Model.AlternateMobileNumber)
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Email
                </div>

                <div class="fw-semibold">

                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <a href="mailto:@Model.Email"
                           class="text-decoration-none">
                            @Model.Email
                        </a>
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 5 — PRIMARY ADDRESS
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-location-dot me-1"></i>
            Primary Address
        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Address Line 1
                </div>

                <div class="fw-semibold">
                    @Model.AddressLine1
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Address Line 2
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.AddressLine2)
                                        ? "-"
                                        : Model.AddressLine2)
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    City
                </div>

                <div class="fw-semibold">
                    @Model.City
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    District
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.District)
                                        ? "-"
                                        : Model.District)
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    State
                </div>

                <div class="fw-semibold">
                    @Model.State
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Pincode
                </div>

                <div class="fw-semibold">
                    @Model.Pincode
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Country
                </div>

                <div class="fw-semibold">
                    @Model.Country
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 6 — COMMERCIAL INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-handshake me-1"></i>
            Commercial Information
        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Payment Terms
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.PaymentTerms)
                                        ? "-"
                                        : Model.PaymentTerms)
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Credit Days
                </div>

                <div class="fw-semibold">
                    @(Model.CreditDays.HasValue
                                        ? $"{Model.CreditDays.Value} Days"
                                        : "-")
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 7 — OTHER INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-circle-info me-1"></i>
            Other Information
        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Website
                </div>

                <div class="fw-semibold">

                    @if (!string.IsNullOrWhiteSpace(Model.Website))
                    {
                        <span>
                            @Model.Website
                        </span>
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <div class="col-lg-8 col-md-6">

                <div class="text-muted small">
                    Remarks
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.Remarks)
                                        ? "-"
                                        : Model.Remarks)
                </div>

            </div>

        </div>

    </div>

</div>