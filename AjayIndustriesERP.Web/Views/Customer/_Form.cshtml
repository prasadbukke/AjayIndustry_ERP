@*
    ============================================================
    File: _Form.cshtml

    Purpose:
    Reusable Customer Master form used by Create and Edit pages.

    Responsibilities:
    - Display Customer identity information.
    - Display Tax information.
    - Display Primary Contact information.
    - Display Primary Address information.
    - Display Commercial information.
    - Display Other information.
    - Provide field-level validation messages.

    Important:
    - This partial DOES NOT contain a <form> element.
    - Create.cshtml and Edit.cshtml own the actual <form>.
    - Customer Code is system generated and read-only.
    - Phase 1 supports one primary contact and one primary address.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.Customer.CustomerFormViewModel

@{
    var isEditMode = Model.Id > 0;
}


<!-- =========================================================
     REGION 1 — CUSTOMER INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-building me-1"></i>
            Customer Information
        </span>

    </div>

    <div class="card-body">

        <div class="row g-3">

            @if (isEditMode)
            {
                <div class="col-lg-4 col-md-6">

                    <label asp-for="Code"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Code"
                           class="form-control"
                           readonly />

                    <div class="form-text">
                        System generated customer code.
                    </div>

                </div>
            }

            <div class="col-lg-4 col-md-6">

                <label asp-for="CustomerName"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="CustomerName"
                       class="form-control"
                       placeholder="Enter customer name" />

                <span asp-validation-for="CustomerName"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="LegalName"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="LegalName"
                       class="form-control"
                       placeholder="Enter legal / registered name" />

                <span asp-validation-for="LegalName"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 2 — TAX INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-file-invoice me-1"></i>
            Tax Information
        </span>

    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-lg-4 col-md-6">

                <label asp-for="GSTIN"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="GSTIN"
                       class="form-control text-uppercase"
                       maxlength="15"
                       oninput="this.value = this.value.toUpperCase();"
                       placeholder="Enter GSTIN" />

                <span asp-validation-for="GSTIN"
                      class="text-danger small">
                </span>

                <div class="form-text">
                    Optional. GSTIN must be unique when provided.
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="PAN"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="PAN"
                       class="form-control text-uppercase"
                       maxlength="10"
                       oninput="this.value = this.value.toUpperCase();"
                       placeholder="Enter PAN" />

                <span asp-validation-for="PAN"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 3 — PRIMARY CONTACT
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-address-book me-1"></i>
            Primary Contact
        </span>

    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-lg-4 col-md-6">

                <label asp-for="ContactPerson"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="ContactPerson"
                       class="form-control"
                       placeholder="Enter contact person" />

                <span asp-validation-for="ContactPerson"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="MobileNumber"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="MobileNumber"
                       class="form-control"
                       maxlength="10"
                       inputmode="numeric"
                       placeholder="Enter mobile number" />

                <span asp-validation-for="MobileNumber"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="AlternateMobileNumber"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="AlternateMobileNumber"
                       class="form-control"
                       placeholder="Enter alternate mobile" />

                <span asp-validation-for="AlternateMobileNumber"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="Email"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Enter email address" />

                <span asp-validation-for="Email"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — PRIMARY ADDRESS
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-location-dot me-1"></i>
            Primary Address
        </span>

    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-lg-4 col-md-6">

                <label asp-for="AddressLine1"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="AddressLine1"
                       class="form-control"
                       placeholder="Enter address line 1" />

                <span asp-validation-for="AddressLine1"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="AddressLine2"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="AddressLine2"
                       class="form-control"
                       placeholder="Enter address line 2" />

                <span asp-validation-for="AddressLine2"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="City"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="City"
                       class="form-control"
                       placeholder="Enter city" />

                <span asp-validation-for="City"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="District"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="District"
                       class="form-control"
                       placeholder="Enter district" />

                <span asp-validation-for="District"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="State"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="State"
                       class="form-control"
                       placeholder="Enter state" />

                <span asp-validation-for="State"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="Pincode"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="Pincode"
                       class="form-control"
                       placeholder="Enter pincode" />

                <span asp-validation-for="Pincode"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="Country"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="Country"
                       class="form-control"
                       placeholder="Enter country" />

                <span asp-validation-for="Country"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 5 — COMMERCIAL INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-handshake me-1"></i>
            Commercial Information
        </span>

    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-lg-4 col-md-6">

                <label asp-for="PaymentTerms"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="PaymentTerms"
                       class="form-control"
                       placeholder="Example: Net 30 Days" />

                <span asp-validation-for="PaymentTerms"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-4 col-md-6">

                <label asp-for="CreditDays"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="CreditDays"
                       type="number"
                       min="0"
                       class="form-control"
                       placeholder="Enter credit days" />

                <span asp-validation-for="CreditDays"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 6 — OTHER INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">
            <i class="fa-solid fa-circle-info me-1"></i>
            Other Information
        </span>

    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-lg-4 col-md-6">

                <label asp-for="Website"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="Website"
                       class="form-control"
                       placeholder="Enter website" />

                <span asp-validation-for="Website"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-lg-8 col-md-6">

                <label asp-for="Remarks"
                       class="form-label fw-semibold">
                </label>

                <textarea asp-for="Remarks"
                          class="form-control"
                          rows="3"
                          placeholder="Enter remarks">
                </textarea>

                <span asp-validation-for="Remarks"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>