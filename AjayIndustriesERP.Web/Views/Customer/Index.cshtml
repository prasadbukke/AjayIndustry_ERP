@*
    ============================================================
    File: Index.cshtml

    Purpose:
    Displays Customer Master records.

    Responsibilities:
    - Display Customer list.
    - Provide shared Search.
    - Provide shared Pagination.
    - Display Details / Edit / Delete actions.
    - Display Delete Confirmation Modal.
    - Display empty state when no Customers are available.

    Important:
    - Search and Pagination are handled by CustomerController.
    - Delete performs soft-delete through CustomerService.
    - Business messages are displayed through shared Toast.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.Customer>

@{
    ViewData["Title"] = "Customer Management";

    var serialNumber =
        (((int)ViewBag.PageNumber - 1) *
        (int)ViewBag.PageSize) + 1;
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Customer Management
        </h2>

        <p class="text-muted mb-0">
            Manage customers used in Customer PO and Sales workflows.
        </p>

    </div>


    <a asp-action="Create"
       class="btn btn-primary">

        <i class="fa-solid fa-plus me-1"></i>
        Add Customer

    </a>

</div>


<!-- =========================================================
     REGION 2 — SEARCH
========================================================== -->

<div class="mb-3">

    <partial name="Components/_SearchBar"
             model='@(ViewBag.SearchText as string ?? "")' />

</div>


<!-- =========================================================
     REGION 3 — CUSTOMER TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="width:60px;">
                            #
                        </th>

                        <th class="text-nowrap">
                            Customer Code
                        </th>

                        <th>
                            Customer
                        </th>

                        <th>
                            Contact Person
                        </th>

                        <th class="text-nowrap">
                            Mobile
                        </th>

                        <th>
                            City
                        </th>

                        <th>
                            State
                        </th>

                        <th class="text-nowrap">
                            GSTIN
                        </th>

                        <th class="text-center"
                            style="min-width:140px;">

                            Actions

                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                         Model.Any())
                    {
                        @foreach (var customer in Model)
                        {
                            <tr>

                                <!-- ===========================
                                     SERIAL
                                ============================ -->

                                <td>
                                    @serialNumber
                                </td>


                                <!-- ===========================
                                     CUSTOMER CODE
                                ============================ -->

                                <td class="text-nowrap">

                                    <span class="fw-semibold">
                                        @customer.Code
                                    </span>

                                </td>


                                <!-- ===========================
                                     CUSTOMER NAME
                                ============================ -->

                                <td>

                                    <div class="fw-semibold">
                                        @customer.CustomerName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        customer.LegalName))
                                    {
                                        <div class="small text-muted">
                                            @customer.LegalName
                                        </div>
                                    }

                                </td>


                                <!-- ===========================
                                     CONTACT PERSON
                                ============================ -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        customer.ContactPerson)
                                        ? "-"
                                        : customer.ContactPerson)

                                </td>


                                <!-- ===========================
                                     MOBILE
                                ============================ -->

                                <td class="text-nowrap">

                                    @(string.IsNullOrWhiteSpace(
                                        customer.MobileNumber)
                                        ? "-"
                                        : customer.MobileNumber)

                                </td>


                                <!-- ===========================
                                     CITY
                                ============================ -->

                                <td>
                                    @customer.City
                                </td>


                                <!-- ===========================
                                     STATE
                                ============================ -->

                                <td>
                                    @customer.State
                                </td>


                                <!-- ===========================
                                     GSTIN
                                ============================ -->

                                <td class="text-nowrap">

                                    @(string.IsNullOrWhiteSpace(
                                        customer.GSTIN)
                                        ? "-"
                                        : customer.GSTIN)

                                </td>


                                <!-- ===========================
                                     ACTIONS
                                ============================ -->

                                <td>

                                    <div class="d-flex
                                                justify-content-center
                                                gap-1">

                                        <!-- DETAILS -->

                                        <a asp-action="Details"
                                           asp-route-id="@customer.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-info"
                                           title="Details">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>


                                        <!-- EDIT -->

                                        <a asp-action="Edit"
                                           asp-route-id="@customer.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-warning"
                                           title="Edit">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>


                                        <!-- DELETE -->

                                        <button type="button"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-danger
                                                       btn-delete-customer"
                                                data-customer-id="@customer.Id"
                                                data-customer-name="@customer.CustomerName"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteCustomerModal"
                                                title="Delete">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>

                            serialNumber++;
                        }
                    }
                    else
                    {
                        <!-- ===================================
                             EMPTY STATE
                        ==================================== -->

                        <tr>

                            <td colspan="9"
                                class="text-center
                                       py-5">

                                <div class="text-muted">

                                    <i class="fa-solid
                                              fa-users
                                              fa-2x
                                              mb-3">
                                    </i>

                                    <div class="fw-semibold mb-1">
                                        No Customers Found
                                    </div>

                                    <div class="small">
                                        Add a customer or change your search.
                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — PAGINATION
========================================================== -->

@if ((int)ViewBag.TotalRecords > 0)
{
    <div class="mt-3">

        <partial name="Components/_Pagination"
                 model='(
                     (int)ViewBag.PageNumber,
                     (int)ViewBag.PageSize
                 )' />

    </div>
}


<!-- =========================================================
     REGION 5 — DELETE CONFIRMATION MODAL
========================================================== -->

<div class="modal fade"
     id="deleteCustomerModal"
     tabindex="-1"
     aria-labelledby="deleteCustomerModalLabel"
     aria-hidden="true">

    <div class="modal-dialog
                modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="deleteCustomerModalLabel">

                    <i class="fa-solid
                              fa-triangle-exclamation
                              text-danger
                              me-1">
                    </i>

                    Delete Customer

                </h5>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <p class="mb-2">
                    Are you sure you want to delete this customer?
                </p>

                <div class="fw-semibold"
                     id="deleteCustomerName">
                </div>

                <div class="small
                            text-muted
                            mt-2">

                    This customer will be soft-deleted from the ERP.

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <form asp-action="Delete"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="deleteCustomerId"
                           name="id" />


                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-trash me-1"></i>
                        Delete

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 6 — DELETE MODAL SCRIPT
========================================================== -->

@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const deleteButtons =
                    document.querySelectorAll(
                        ".btn-delete-customer"
                    );

                const customerIdInput =
                    document.getElementById(
                        "deleteCustomerId"
                    );

                const customerNameElement =
                    document.getElementById(
                        "deleteCustomerName"
                    );


                deleteButtons.forEach(
                    function (button) {

                        button.addEventListener(
                            "click",
                            function () {

                                const customerId =
                                    this.getAttribute(
                                        "data-customer-id"
                                    );

                                const customerName =
                                    this.getAttribute(
                                        "data-customer-name"
                                    );


                                customerIdInput.value =
                                    customerId;

                                customerNameElement.textContent =
                                    customerName;
                            }
                        );

                    }
                );

            }
        );

    </script>
}