            </table>

        </div>

    </div>


    <div class="col-lg-6">

        <div class="dashboard-panel">

            <h4 class="panel-title">
                Recent Sales
            </h4>


            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>
                            Invoice
                        </th>

                        <th>
                            Customer
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <tr>

                        <td>
                            INV-1001
                        </td>

                        <td>
                            L&T Engineering
                        </td>

                    </tr>


                    <tr>

                        <td>
                            INV-1002
                        </td>

                        <td>
                            Kirloskar
                        </td>

                    </tr>


                    <tr>

                        <td>
                            INV-1003
                        </td>

                        <td>
                            Precision Industries
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>


@* =========================================================
   RECENT ACTIVITIES
   ========================================================= *@

<div class="row mt-4">

    <div class="col-lg-12">

        <div class="dashboard-panel">

            <h4 class="panel-title">
                Recent Activities
            </h4>


            <ul class="notification-list">

                <li>

                    <i class="bi
                              bi-person-plus-fill
                              text-primary">
                    </i>

                    New Customer Added

                </li>


                <li>

                    <i class="bi
                              bi-cart-check-fill
                              text-success">
                    </i>

                    Purchase Order Approved

                </li>


                <li>

                    <i class="bi
                              bi-box-fill
                              text-warning">
                    </i>

                    Stock Updated

                </li>


                <li>

                    <i class="bi
                              bi-receipt-cutoff
                              text-info">
                    </i>

                    Sales Invoice Generated

                </li>

            </ul>

        </div>

    </div>

</div>


@* =========================================================
   SUPPLIER PAYMENT DUE POPUP

   Partial renders only when alerts exist.
   JavaScript opens modal automatically.
   ========================================================= *@

<partial name="_SupplierPaymentDueModal"
         model="Model" />


@* =========================================================
   PAGE JAVASCRIPT
   ========================================================= *@

@section Scripts
{
    <script src="~/js/home-dashboard.js"
            asp-append-version="true">
    </script>
}