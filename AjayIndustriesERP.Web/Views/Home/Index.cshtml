<div class="row mt-4">

    <div class="col-lg-6">

        <div class="dashboard-panel">

            <h4 class="panel-title">
                Low Stock Items
            </h4>


            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>
                            Item
                        </th>

