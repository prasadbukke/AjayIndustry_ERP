@*
============================================================
File: Create.cshtml

Purpose:
Creates a new Pre-Dispatch / Final Inspection Report.

Responsibilities:
- Own the Create form.
- Render shared PDI form partial.
- Save PDI as Draft.
- Load PDI form JavaScript.
- Load client-side validation.

Important:
- Business validation belongs in Application Service.
- Production Job source data is trusted by backend.
- Finalization is performed separately from Details.
============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.PreDispatchInspection.PreDispatchInspectionFormViewModel

@{
    ViewData["Title"] = "Create PDI Report";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Create PDI Report
        </h2>

        <div class="text-muted">
            Pre-Dispatch / Final Inspection Report
        </div>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid
                  fa-arrow-left
                  me-1">
        </i>

        PDI Reports

    </a>

</div>


<!-- =========================================================
     REGION 2 — CREATE FORM
========================================================== -->

<form asp-action="Create"
      method="post"
      id="preDispatchInspectionForm">

    @Html.AntiForgeryToken()


    <partial name="_Form"
             model="Model" />


    <!-- =====================================================
         REGION — FORM ACTIONS
    ====================================================== -->

    <div class="d-flex
                justify-content-end
                align-items-center
                gap-2
                flex-wrap
                mb-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-primary">

            <i class="fa-solid
                      fa-floppy-disk
                      me-1">
            </i>

            Save Draft PDI

        </button>

    </div>

    <!-- =====================================================
         END REGION
    ====================================================== -->

</form>


<!-- =========================================================
     REGION 3 — SCRIPTS
========================================================== -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/pre-dispatch-inspection-form.js"
            asp-append-version="true">
    </script>
}