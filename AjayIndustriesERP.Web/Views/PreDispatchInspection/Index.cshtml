@*
============================================================
File: Index.cshtml

Purpose:
Displays Pre-Dispatch / Final Inspection Reports.

Responsibilities:
- Display PDI Reports.
- Provide Search and Pagination.
- Display Customer / PO / Item source.
- Display Inspection Quantity.
- Display PDI Status.
- Display Overall Result.
- Open PDI Details.
- Edit Draft PDI Reports.
- Delete Draft PDI Reports.
- Navigate to Deleted PDI Reports.

Important:
- Draft PDI Reports can be edited.
- Finalized PDI Reports are read-only.
- Finalized PDI Reports cannot be deleted.
============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.PreDispatchInspection>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] =
        "PDI Reports";

    var pageNumber =
        (int)ViewBag.PageNumber;

    var pageSize =
        (int)ViewBag.PageSize;

    var totalRecords =
        (int)ViewBag.TotalRecords;

    var serialNumber =
        ((pageNumber - 1) * pageSize) + 1;
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            PDI Reports
        </h2>

        <p class="text-muted mb-0">
            Pre-Dispatch / Final Inspection Reports.
        </p>

    </div>


    <div class="d-flex
                align-items-center
                gap-2
                flex-wrap">

        <a asp-action="Deleted"
           class="btn btn-outline-secondary">

            <i class="fa-solid
                      fa-trash-can
                      me-1">
            </i>

            Deleted Reports

        </a>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid
                      fa-plus
                      me-1">
            </i>

            Create PDI Report

        </a>

    </div>

</div>


<!-- =========================================================
     REGION 2 — SEARCH
========================================================== -->

<partial name="Components/_SearchBar"
         model='@(ViewBag.SearchText as string ?? "")' />


<!-- =========================================================
     REGION 3 — PDI REPORT TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="text-nowrap">
                            #
                        </th>

                        <th class="text-nowrap">
                            PDI Report
                        </th>

                        <th class="text-nowrap">
                            Inspection Date
                        </th>

                        <th>
                            Customer / PO
                        </th>

                        <th>
                            Item
                        </th>

                        <th class="text-nowrap">
                            Production Job
                        </th>

                        <th class="text-end text-nowrap">
                            Inspection Qty
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                        <th class="text-center">
                            Result
                        </th>

                        <th class="text-center text-nowrap">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                        Model.Any())
                    {
                        @foreach (var report in Model)
                        {
                            var isDraft =
                                report.Status ==
                                PreDispatchInspectionStatus.Draft;


                            <tr>

                                <!-- SERIAL -->

                                <td>
                                    @serialNumber
                                </td>


                                <!-- PDI CODE -->

                                <td class="text-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@report.Id"
                                       class="fw-semibold
                                              text-decoration-none">

                                        @report.Code

                                    </a>

                                </td>


                                <!-- INSPECTION DATE -->

                                <td class="text-nowrap">

                                    @(report.InspectionDate
                                        .ToString("dd-MM-yyyy"))

                                </td>


                                <!-- CUSTOMER / PO -->

                                <td>

                                    <div class="fw-semibold">
                                        @report.CustomerName
                                    </div>

                                    <div class="small text-muted">

                                        PO:

                                        @(string.IsNullOrWhiteSpace(
                                            report.CustomerPurchaseOrderNumber)
                                            ? "-"
                                            : report.CustomerPurchaseOrderNumber)

                                    </div>

                                </td>


                                <!-- ITEM -->

                                <td>

                                    <div class="fw-semibold">
                                        @report.ItemCode
                                    </div>

                                    <div class="small text-muted">
                                        @report.ItemName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        report.PartNumber))
                                    {
                                        <div class="small text-muted">

                                            Part No:
                                            @report.PartNumber

                                        </div>
                                    }

                                </td>


                                <!-- PRODUCTION JOB -->

                                <td class="text-nowrap">

                                    @report.ProductionJobCode

                                </td>


                                <!-- INSPECTION QUANTITY -->

                                <td class="text-nowrap">

                                    <span class="fw-semibold">

                                        @(report.InspectionQuantity
                                            .ToString("0.###"))

                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(
                                        report.UnitName))
                                    {
                                        <span class="text-muted">
                                            @report.UnitName
                                        </span>
                                    }

                                </td>


                                <!-- STATUS -->

                                <td class="text-center">

                                    @switch (report.Status)
                                    {
                                        case PreDispatchInspectionStatus.Draft:

                                            <span class="badge bg-secondary">
                                                Draft
                                            </span>

                                            break;


                                        case PreDispatchInspectionStatus.Finalized:

                                            <span class="badge bg-primary">
                                                Finalized
                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- RESULT -->

                                <td class="text-center">

                                    @switch (report.Result)
                                    {
                                        case PreDispatchInspectionResult.Pending:

                                            <span class="badge
                                                         bg-light
                                                         text-dark
                                                         border">

                                                Pending

                                            </span>

                                            break;


                                        case PreDispatchInspectionResult.Pass:

                                            <span class="badge bg-success">
                                                Pass
                                            </span>

                                            break;


                                        case PreDispatchInspectionResult.Fail:

                                            <span class="badge bg-danger">
                                                Fail
                                            </span>

                                            break;


                                        case PreDispatchInspectionResult.Partial:

                                            <span class="badge
                                                         bg-warning
                                                         text-dark">

                                                Partial

                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-center">

                                    <div class="d-flex
                                                justify-content-center
                                                align-items-center
                                                gap-1
                                                flex-nowrap">

                                        <!-- DETAILS -->

                                        <a asp-action="Details"
                                           asp-route-id="@report.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-primary"
                                           title="Details">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>


                                        <!-- EDIT DRAFT -->

                                       <!-- EDIT -->

@if (isDraft)
{
    <a asp-action="Edit"
       asp-route-id="@report.Id"
       class="btn
              btn-sm
              btn-outline-secondary"
       title="Edit">

        <i class="fa-solid fa-pen"></i>

    </a>
}
else
{
    <button type="button"
            class="btn
                   btn-sm
                   btn-outline-secondary"
            title="Finalized PDI Report cannot be edited"
            disabled>

        <i class="fa-solid fa-pen"></i>

    </button>
}

                                        <!-- DELETE DRAFT -->

                                        @if (isDraft)
                                        {
                                            <button type="button"
                                                    class="btn
                                                           btn-sm
                                                           btn-outline-danger"
                                                    title="Delete"
                                                    onclick="confirmDelete('@Url.Action(
                                                        "Delete",
                                                        "PreDispatchInspection",
                                                        new
                                                        {
                                                            id = report.Id
                                                        })')">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>
                                        }

<!-- DELETE -->

@if (isDraft)
{
    <button type="button"
            class="btn
                   btn-sm
                   btn-outline-danger"
            title="Delete"
            onclick="confirmDelete('@Url.Action(
                "Delete",
                "PreDispatchInspection",
                new
                {
                    id = report.Id
                })')">

        <i class="fa-solid fa-trash"></i>

    </button>
}
else
{
    <button type="button"
            class="btn
                   btn-sm
                   btn-outline-danger"
            title="Finalized PDI Report cannot be deleted"
            disabled>

        <i class="fa-solid fa-trash"></i>

    </button>
}
                                    </div>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="10"
                                class="text-center
                                       text-muted
                                       py-5">

                                <i class="fa-solid
                                          fa-clipboard-check
                                          fa-2x
                                          mb-3">
                                </i>


                                <div class="fw-semibold mb-1">
                                    No PDI Reports Found
                                </div>

                                <div class="small">

                                    Create a PDI Report from a
                                    completed Production Job.

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — PAGINATION
========================================================== -->

@if (totalRecords > 0)
{
    <div class="mt-3">

        <partial name="Components/_Pagination"
                 model='(
                     (int)ViewBag.PageNumber,
                     (int)ViewBag.PageSize
                 )' />

    </div>
}