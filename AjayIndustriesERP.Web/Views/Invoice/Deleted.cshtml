@model List<AjayIndustriesERP.Domain.Entities.Invoice>

@using AjayIndustriesERP.Domain.Enums

@*
============================================================
File: Deleted.cshtml

Module:
Invoice

Purpose:
Displays soft-deleted Invoice records.

Responsibilities:
- Display deleted Invoice list.
- Display Invoice No., Date and Customer.
- Display Delivery Challan references.
- Display Grand Total.
- Restore deleted Draft Invoice.
- Navigate back to active Invoice list.

Important:
- Only Draft Invoice can be deleted.
- Restore is allowed only when required Delivery Challan
  quantities are still available.
- Final restore validation is performed by InvoiceService.
============================================================
*@

@{
    ViewData["Title"] =
        "Deleted Invoices";

    var serialNumber =
        1;
}


@* =========================================================
   Page Header
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Invoices
        </h2>

        <p class="text-muted mb-0">
            View and restore deleted Draft Invoices.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back to Invoices

    </a>

</div>


@* =========================================================
   Deleted Invoice List
   ========================================================= *@

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="text-nowrap">
                            #
                        </th>

                        <th class="text-nowrap">
                            Invoice No.
                        </th>

                        <th class="text-nowrap">
                            Invoice Date
                        </th>

                        <th>
                            Customer
                        </th>

                        <th>
                            Delivery Challan
                        </th>

                        <th class="text-end text-nowrap">
                            Grand Total
                        </th>

                        <th class="text-center text-nowrap">
                            Status
                        </th>

                        <th class="text-center text-nowrap">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                                        Model.Any())
                    {
                        @foreach (var invoice in Model)
                        {
                            var deliveryChallanCodes =
                            invoice.Items
                            .Where(x =>
                            !x.IsDeleted)
                            .Select(x =>
                            x.DeliveryChallanCode)
                            .Where(x =>
                            !string.IsNullOrWhiteSpace(x))
                            .Distinct()
                            .ToList();


                            <tr>

                                @* =========================
                                   Serial Number
                                   ========================= *@

                                <td>
                                    @serialNumber
                                </td>


                                @* =========================
                                   Invoice Number
                                   ========================= *@

                                <td class="text-nowrap">

                                    <span class="fw-semibold">
                                        @invoice.Code
                                    </span>

                                </td>


                                @* =========================
                                   Invoice Date
                                   ========================= *@

                                <td class="text-nowrap">

                                    @invoice.InvoiceDate
                                    .ToString("dd-MM-yyyy")

                                </td>


                                @* =========================
                                   Customer
                                   ========================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @invoice.CustomerName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                                                invoice.PlaceOfSupply))
                                    {
                                        <div class="small text-muted">

                                            Place of Supply:
                                            @invoice.PlaceOfSupply

                                        </div>
                                    }

                                </td>


                                @* =========================
                                   Delivery Challans
                                   ========================= *@

                                <td>

                                    @if (deliveryChallanCodes.Any())
                                    {
                                        @foreach (var challanCode
                                                                    in deliveryChallanCodes)
                                        {
                                            <div class="text-nowrap">
                                                @challanCode
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                @* =========================
                                   Grand Total
                                   ========================= *@

                                <td class="text-end text-nowrap">

                                    <span class="fw-semibold">

                                        ₹
                                        @invoice.GrandTotal
                                        .ToString("N2")

                                    </span>

                                </td>


                                @* =========================
                                   Status
                                   ========================= *@

                                <td class="text-center">

                                    @if (invoice.Status ==
                                                                InvoiceStatus.Draft)
                                    {
                                        <span class="badge
                                                                 bg-warning
                                                                 text-dark">

                                            Draft

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge
                                                                 bg-secondary">

                                            @invoice.Status

                                        </span>
                                    }

                                </td>


                                @* =========================
                                   Restore Action
                                   ========================= *@

                                <td class="text-center">

                                    <form asp-action="Restore"
                                          asp-route-id="@invoice.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()


                                        <button type="submit"
                                                class="btn
                                                               btn-sm
                                                               btn-outline-success"
                                                onclick="return confirm(
                                                            'Restore this Invoice? Quantity availability will be checked again.');">

                                            <i class="fa-solid
                                                              fa-rotate-left
                                                              me-1">
                                            </i>

                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center
                                           text-muted
                                           py-5">

                                <i class="fa-solid
                                              fa-trash-can
                                              fa-2x
                                              mb-3">
                                </i>


                                <div class="fw-semibold mb-1">
                                    No Deleted Invoices
                                </div>


                                <div class="small">
                                    Deleted Draft Invoices will appear here.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>