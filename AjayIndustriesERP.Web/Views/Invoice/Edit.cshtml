@model AjayIndustriesERP.Web.ViewModels.Invoice.InvoiceFormViewModel

@*
============================================================
File: Edit.cshtml

Module:
Invoice

Purpose:
Edits an existing Draft Invoice.

Responsibilities:
- Own the HTML <form>.
- Render shared Invoice _Form partial.
- Submit Invoice Edit request.
- Load client validation.
- Load Invoice form JavaScript.

Important:
- Only Draft Invoice can be edited.
- Finalized Invoice is locked by InvoiceService.
- _Form.cshtml must not contain its own <form>.
============================================================
*@

@{
    ViewData["Title"] =
        "Edit Invoice";
}


@* =========================================================
   Page Header
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-2
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Edit Invoice
        </h2>

        <div class="text-muted">
            @Model.Code
        </div>

    </div>


    <div class="d-flex
                align-items-center
                gap-2">

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back

        </a>

    </div>

</div>


@* =========================================================
   Edit Form
   ========================================================= *@

<form asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()


    <partial name="_Form"
             model="Model" />


    @* =====================================================
       Actions
       ===================================================== *@

    <div class="d-flex
                justify-content-end
                gap-2
                mb-4">

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-warning">

            <i class="fa-solid fa-floppy-disk me-1"></i>

            Update Draft

        </button>

    </div>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/invoice-form.js"
            asp-append-version="true">
    </script>
}