@model AjayIndustriesERP.Domain.Entities.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Supplier Details
            </h2>

            <p class="text-muted mb-0">
                View complete Supplier information.
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.SupplierId"
               class="btn btn-warning">

                <i class="fa-solid fa-pen me-1"></i>

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="fa-solid fa-arrow-left me-1"></i>

                Back

            </a>

        </div>

    </div>

    <!-- Basic Information -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">

            <div class="fw-semibold">
                Basic Information
            </div>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">

                    <div class="small text-muted">
                        Supplier Code
                    </div>

                    <div class="fw-semibold">
                        @Model.SupplierCode
                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <div class="small text-muted">
                        Supplier Name
                    </div>

                    <div class="fw-semibold">
                        @Model.SupplierName
                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <div class="small text-muted">
                        Contact Person
                    </div>

                    <div>
                        @(string.IsNullOrWhiteSpace(Model.ContactPerson)
                                                ? "-"
                                                : Model.ContactPerson)
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Contact + Tax -->

    <div class="row">

        <div class="col-lg-6 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-light">

                    <div class="fw-semibold">
                        Contact Information
                    </div>

                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-5 mb-3">
                            Mobile
                        </dt>

                        <dd class="col-sm-7 mb-3">
                            @(Model.MobileNumber ?? "-")
                        </dd>

                        <dt class="col-sm-5 mb-3">
                            Alternate Mobile
                        </dt>

                        <dd class="col-sm-7 mb-3">
                            @(Model.AlternateMobileNumber ?? "-")
                        </dd>

                        <dt class="col-sm-5 mb-3">
                            Email
                        </dt>

                        <dd class="col-sm-7 mb-3">
                            @(Model.Email ?? "-")
                        </dd>

                    </dl>

                </div>

            </div>

        </div>

        <div class="col-lg-6 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-light">

                    <div class="fw-semibold">
                        Tax Information
                    </div>

                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-4 mb-3">
                            GSTIN
                        </dt>

                        <dd class="col-sm-8 mb-3">
                            @(Model.Gstin ?? "-")
                        </dd>

                        <dt class="col-sm-4 mb-3">
                            PAN
                        </dt>

                        <dd class="col-sm-8 mb-3">
                            @(Model.Pan ?? "-")
                        </dd>

                    </dl>

                </div>

            </div>

        </div>

    </div>

    <!-- Address -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">

            <div class="fw-semibold">
                Address
            </div>

        </div>

        <div class="card-body">

            <div>

                @if (!string.IsNullOrWhiteSpace(Model.AddressLine1))
                {
                    <div>@Model.AddressLine1</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
                {
                    <div>@Model.AddressLine2</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.City) ||
                                !string.IsNullOrWhiteSpace(Model.State) ||
                                !string.IsNullOrWhiteSpace(Model.Pincode))
                {
                    <div>

                        @string.Join(
                        ", ",
                                        new[]
                                        {
                                        Model.City,
                                        Model.State,
                                        Model.Pincode
                                        }
                                        .Where(x =>
                                        !string.IsNullOrWhiteSpace(x)))

                </div>
                                }

                @if (string.IsNullOrWhiteSpace(Model.AddressLine1) &&
                                string.IsNullOrWhiteSpace(Model.AddressLine2) &&
                                string.IsNullOrWhiteSpace(Model.City) &&
                                string.IsNullOrWhiteSpace(Model.State) &&
                                string.IsNullOrWhiteSpace(Model.Pincode))
                {
                    <span class="text-muted">
                        -
                    </span>
                }

            </div>

        </div>

    </div>

    <!-- Commercial -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">

            <div class="fw-semibold">
                Commercial Information
            </div>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">

                    <div class="small text-muted">
                        Payment Terms
                    </div>

                    <div>

                        @if (Model.PaymentTermsDays.HasValue)
                        {
                            if (Model.PaymentTermsDays.Value == 0)
                            {
                                <span>Immediate</span>
                            }
                            else
                            {
                                <span>
                                    @Model.PaymentTermsDays.Value Days
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }

                    </div>

                </div>

                <div class="col-md-8 mb-3">

                    <div class="small text-muted">
                        Description
                    </div>

                    <div>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                                                ? "-"
                                                : Model.Description)
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Status / Audit -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-light">

            <div class="fw-semibold">
                Status & Audit
            </div>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3 mb-3">

                    <div class="small text-muted">
                        Status
                    </div>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactive
                        </span>
                    }

                </div>

                <div class="col-md-3 mb-3">

                    <div class="small text-muted">
                        Created On
                    </div>

                    <div>
                        @Model.CreatedOn
                        .ToLocalTime()
                        .ToString("dd-MMM-yyyy hh:mm tt")
                    </div>

                </div>

                <div class="col-md-3 mb-3">

                    <div class="small text-muted">
                        Created By
                    </div>

                    <div>
                        @Model.CreatedBy
                    </div>

                </div>

                <div class="col-md-3 mb-3">

                    <div class="small text-muted">
                        Modified On
                    </div>

                    <div>

                        @(Model.ModifiedOn.HasValue
                                                ? Model.ModifiedOn.Value
                                                .ToLocalTime()
                                                .ToString("dd-MMM-yyyy hh:mm tt")
                                                : "-")

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>