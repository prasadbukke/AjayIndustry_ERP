@model AjayIndustriesERP.Web.ViewModels.Specification.SpecificationViewModel

@{
    ViewData["Title"] = "Edit Specification";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Edit Specification
        </h2>

        <p class="text-muted mb-0">
            Update Specification Master information.
        </p>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Edit"
                  method="post">

                <partial name="_Form"
                         model="Model" />

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/specification-form.js"
            asp-append-version="true"></script>
}