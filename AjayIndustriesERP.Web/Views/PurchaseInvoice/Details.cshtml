@* =========================================================
   PURCHASE INVOICE ITEMS
   ========================================================= *@

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">

        <h5 class="fw-semibold mb-1">

            <i class="fa-solid fa-boxes-stacked me-2"></i>

            Invoice Items

        </h5>


        <div class="text-muted small">

            Purchase Order → GRN → Supplier Challan → Purchase Invoice

        </div>

    </div>


    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="text-center"
                            style="width:55px;">
                            #
                        </th>

                        <th style="min-width:125px;">
                            GRN
                        </th>

                        <th style="min-width:130px;">
                            Challan
                        </th>

                        <th style="min-width:240px;">
                            Item
                        </th>

                        <th style="min-width:95px;">
                            HSN
                        </th>

                        <th class="text-end"
                            style="min-width:100px;">
                            PO Qty
                        </th>

                        <th class="text-end"
                            style="min-width:100px;">
                            GRN Qty
                        </th>

                        <th class="text-end"
                            style="min-width:110px;">
                            Invoice Qty
                        </th>

                        <th class="text-end"
                            style="min-width:105px;">
                            Rate
                        </th>

                        <th class="text-end"
                            style="min-width:80px;">
                            GST %
                        </th>

                        <th class="text-end"
                            style="min-width:125px;">
                            Taxable
                        </th>

                        <th class="text-end"
                            style="min-width:125px;">
                            Tax
                        </th>

                        <th class="text-end"
                            style="min-width:135px;">
                            Line Total
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Items.Count == 0)
                    {
                        <tr>

                            <td colspan="13"
                                class="text-center text-muted py-5">

                                No Purchase Invoice items found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>

                                @* =================================
                                   SEQUENCE
                                   ================================= *@

                                <td class="text-center text-muted">

                                    @item.SequenceNumber

                                </td>


                                @* =================================
                                   GRN
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @item.GoodsReceiptNoteCode
                                    </div>


                                    @if (item.GoodsReceiptNoteDate.HasValue)
                                    {
                                        <div class="text-muted small">

                                            @(item.GoodsReceiptNoteDate.Value
                                                .ToString("dd-MM-yyyy"))

                                        </div>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(
                                        item.MaterialStatus))
                                    {
                                        <div class="mt-1">

                                            @if (item.MaterialStatus ==
                                                 "Approved")
                                            {
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                            }
                                            else if (item.MaterialStatus ==
                                                     "Rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                            }
                                            else if (item.MaterialStatus ==
                                                     "Failure")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Failure
                                                </span>
                                            }
                                            else if (item.MaterialStatus ==
                                                     "Return")
                                            {
                                                <span class="badge bg-secondary">
                                                    Return
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">

                                                    @item.MaterialStatus

                                                </span>
                                            }

                                        </div>
                                    }

                                </td>


                                @* =================================
                                   SUPPLIER CHALLAN
                                   ================================= *@

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.SupplierChallanNumber))
                                    {
                                        <div class="fw-semibold">
                                            @item.SupplierChallanNumber
                                        </div>


                                        @if (item.SupplierChallanDate.HasValue)
                                        {
                                            <div class="text-muted small">

                                                @(item.SupplierChallanDate.Value
                                                    .ToString("dd-MM-yyyy"))

                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   ITEM
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @item.ItemName
                                    </div>


                                    <div class="text-muted small">
                                        @item.ItemCode
                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        item.Specification))
                                    {
                                        <div class="small mt-1">

                                            <span class="text-muted">
                                                Spec:
                                            </span>

                                            @item.Specification

                                        </div>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(
                                        item.DrawingNumber))
                                    {
                                        <div class="small">

                                            <span class="text-muted">
                                                Drawing:
                                            </span>

                                            @item.DrawingNumber


                                            @if (!string.IsNullOrWhiteSpace(
                                                item.DrawingRevision))
                                            {
                                                <span>

                                                    / Rev:
                                                    @item.DrawingRevision

                                                </span>
                                            }

                                        </div>
                                    }

                                </td>


                                @* =================================
                                   HSN
                                   ================================= *@

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        item.HsnCode)
                                        ? "-"
                                        : item.HsnCode)

                                </td>


                                @* =================================
                                   PO QUANTITY
                                   ================================= *@

                                <td class="text-end">

                                    @(item.PurchaseOrderQuantity
                                        .ToString("N3"))

                                    <div class="text-muted small">
                                        @item.UnitName
                                    </div>

                                </td>


                                @* =================================
                                   GRN QUANTITY
                                   ================================= *@

                                <td class="text-end">

                                    @(item.GoodsReceiptQuantity
                                        .ToString("N3"))

                                </td>


                                @* =================================
                                   PURCHASE INVOICE QUANTITY
                                   ================================= *@

                                <td class="text-end fw-semibold">

                                    @(item.PurchaseInvoiceQuantity
                                        .ToString("N3"))

                                </td>


                                @* =================================
                                   ACTUAL SUPPLIER RATE
                                   ================================= *@

                                <td class="text-end">

                                    ₹ @(item.Rate.ToString("N2"))

                                </td>


                                @* =================================
                                   GST RATE
                                   ================================= *@

                                <td class="text-end">

                                    @(item.GstRate.ToString("N2"))

                                </td>


                                @* =================================
                                   TAXABLE
                                   ================================= *@

                                <td class="text-end">

                                    ₹ @(item.TaxableAmount.ToString("N2"))

                                </td>


                                @* =================================
                                   GST AMOUNT
                                   ================================= *@

                                <td class="text-end">

                                    @if (Model.IsInterState)
                                    {
                                        <div>

                                            ₹ @(item.IgstAmount.ToString("N2"))

                                        </div>

                                        <div class="text-muted small">
                                            IGST
                                        </div>
                                    }
                                    else
                                    {
                                        <div>

                                            ₹ @(item.TotalTaxAmount.ToString("N2"))

                                        </div>


                                        <div class="text-muted small">

                                            CGST:
                                            @(item.CgstAmount.ToString("N2"))

                                            +

                                            SGST:
                                            @(item.SgstAmount.ToString("N2"))

                                        </div>
                                    }

                                </td>


                                @* =================================
                                   LINE TOTAL
                                   ================================= *@

                                <td class="text-end fw-bold">

                                    ₹ @(item.LineTotal.ToString("N2"))

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@* =========================================================
   REMARKS + INVOICE SUMMARY
   ========================================================= *@

<div class="row g-4 mb-4">

    @* =====================================================
       REMARKS / AUDIT / WORKFLOW
       ===================================================== *@

    <div class="col-xl-7">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-white py-3">

                <h5 class="fw-semibold mb-0">
                    Additional Information
                </h5>

            </div>


            <div class="card-body">

                @* =============================================
                   REMARKS
                   ============================================= *@

                <div class="mb-4">

                    <div class="text-muted small mb-1">
                        Remarks
                    </div>

                    <div>

                        @(string.IsNullOrWhiteSpace(
                            Model.Remarks)
                            ? "-"
                            : Model.Remarks)

                    </div>

                </div>


                <hr />


                @* =============================================
                   AUDIT INFORMATION
                   ============================================= *@

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="text-muted small">
                            Created On
                        </div>

                        <div>

                            @(Model.CreatedOn
                                .ToString("dd-MM-yyyy HH:mm"))

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small">
                            Created By
                        </div>

                        <div>

                            @(string.IsNullOrWhiteSpace(
                                Model.CreatedBy)
                                ? "-"
                                : Model.CreatedBy)

                        </div>

                    </div>


                    @if (Model.ModifiedOn.HasValue)
                    {
                        <div class="col-md-6">

                            <div class="text-muted small">
                                Last Modified
                            </div>

                            <div>

                                @(Model.ModifiedOn.Value
                                    .ToString("dd-MM-yyyy HH:mm"))

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-muted small">
                                Modified By
                            </div>

                            <div>

                                @(string.IsNullOrWhiteSpace(
                                    Model.ModifiedBy)
                                    ? "-"
                                    : Model.ModifiedBy)

                            </div>

                        </div>
                    }


                    @if (isFinalized)
                    {
                        <div class="col-12">
                            <hr />
                        </div>


                        <div class="col-md-6">

                            <div class="text-muted small">
                                Finalized On
                            </div>

                            <div class="fw-semibold text-success">

                                @(Model.FinalizedOn.HasValue
                                    ? Model.FinalizedOn.Value.ToString("dd-MM-yyyy HH:mm")
                                    : "-")

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-muted small">
                                Finalized By
                            </div>

                            <div class="fw-semibold text-success">

                                @(string.IsNullOrWhiteSpace(
                                    Model.FinalizedBy)
                                    ? "-"
                                    : Model.FinalizedBy)

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    @* =====================================================
       FINANCIAL SUMMARY
       ===================================================== *@

    <div class="col-xl-5">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-white py-3">

                <h5 class="fw-semibold mb-0">
                    Invoice Summary
                </h5>

            </div>


            <div class="card-body">

                <table class="table
                              table-sm
                              align-middle
                              mb-0">

                    <tbody>

                        <tr>

                            <td>
                                Gross Amount
                            </td>

                            <td class="text-end fw-semibold">

                                ₹ @(Model.GrossAmount.ToString("N2"))

                            </td>

                        </tr>


                        @if (Model.DiscountAmount != 0m)
                        {
                            <tr>

                                <td>
                                    Discount
                                </td>

                                <td class="text-end">

                                    ₹ @(Model.DiscountAmount.ToString("N2"))

                                </td>

                            </tr>
                        }


                        <tr>

                            <td>
                                Taxable Amount
                            </td>

                            <td class="text-end fw-semibold">

                                ₹ @(Model.TaxableAmount.ToString("N2"))

                            </td>

                        </tr>


                        @if (Model.IsInterState)
                        {
                            <tr>

                                <td>
                                    IGST
                                </td>

                                <td class="text-end">

                                    ₹ @(Model.IgstAmount.ToString("N2"))

                                </td>

                            </tr>
                        }
                        else
                        {
                            <tr>

                                <td>
                                    CGST
                                </td>

                                <td class="text-end">

                                    ₹ @(Model.CgstAmount.ToString("N2"))

                                </td>

                            </tr>


                            <tr>

                                <td>
                                    SGST
                                </td>

                                <td class="text-end">

                                    ₹ @(Model.SgstAmount.ToString("N2"))

                                </td>

                            </tr>
                        }


                        <tr>

                            <td>
                                Transport Charges
                            </td>

                            <td class="text-end">

                                ₹ @(Model.TransportCharges.ToString("N2"))

                            </td>

                        </tr>


                        <tr>

                            <td>
                                Other Charges
                            </td>

                            <td class="text-end">

                                ₹ @(Model.OtherCharges.ToString("N2"))

                            </td>

                        </tr>


                        <tr>

                            <td>
                                Round Off
                            </td>

                            <td class="text-end">

                                ₹ @(Model.RoundOffAmount.ToString("N2"))

                            </td>

                        </tr>


                        <tr class="border-top">

                            <td class="fs-5 fw-bold pt-3">
                                Grand Total
                            </td>

                            <td class="text-end
                                       fs-5
                                       fw-bold
                                       text-primary
                                       pt-3">

                                ₹ @(Model.GrandTotal.ToString("N2"))

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>