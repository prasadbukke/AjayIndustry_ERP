@model AjayIndustriesERP.Web.ViewModels.PurchaseInvoice.PurchaseInvoiceDetailsViewModel

@{
    ViewData["Title"] =
        "Purchase Invoice Details";

    var isDraft =
        string.Equals(
            Model.Status,
            "Draft",
            StringComparison.OrdinalIgnoreCase);

    var isFinalized =
        string.Equals(
            Model.Status,
            "Finalized",
            StringComparison.OrdinalIgnoreCase);
}


@* =========================================================
   SUCCESS / ERROR MESSAGES
   ========================================================= *@

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@* =========================================================
   PAGE HEADER
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-start
            flex-wrap
            gap-3
            mb-4">

    <div>

        <div class="d-flex
                    align-items-center
                    flex-wrap
                    gap-2
                    mb-1">

            <h2 class="fw-bold mb-0">
                Purchase Invoice
            </h2>


            @if (isDraft)
            {
                <span class="badge bg-warning text-dark">
                    Draft
                </span>
            }
            else if (isFinalized)
            {
                <span class="badge bg-success">
                    Finalized
                </span>
            }
            else
            {
                <span class="badge bg-secondary">
                    @Model.Status
                </span>
            }

        </div>


        <div class="text-muted">

            <span class="fw-semibold">
                @Model.Code
            </span>

            <span class="mx-2">
                •
            </span>

            @(Model.PurchaseInvoiceDate.ToString("dd-MM-yyyy"))

        </div>

    </div>


    @* =====================================================
       ACTION BUTTONS
       ===================================================== *@

    @* =====================================================
   ACTION BUTTONS

   RULE:

   Back
     -> Always Enabled

   Edit
     -> Draft Enabled
     -> Finalized Disabled

   Approve
     -> Draft Enabled
     -> Finalized Disabled

   Delete
     -> Always Enabled

   Delete is Soft Delete.
   Draft and Finalized invoices can both be restored.
   ===================================================== *@

<div class="d-flex
            flex-wrap
            gap-2">

    @* =================================================
       BACK
       ================================================= *@

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back

    </a>


    @* =================================================
       EDIT

       Only Draft Purchase Invoice can be edited.
       Button remains visible after Finalization,
       but becomes disabled.
       ================================================= *@

    @if (isDraft)
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">

            <i class="fa-solid fa-pen-to-square me-1"></i>

            Edit

        </a>
    }
    else
    {
        <button type="button"
                class="btn btn-outline-primary"
                title="Finalized Purchase Invoice cannot be edited"
                disabled>

            <i class="fa-solid fa-pen-to-square me-1"></i>

            Edit

        </button>
    }


    @* =================================================
       APPROVE

       UI Label:
       Approve

       Backend Action:
       Finalize

       Internal Status:
       Draft -> Finalized
       ================================================= *@

    @if (isDraft)
    {
        <form asp-action="Finalize"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline"
              onsubmit="return confirm('Approve this Purchase Invoice? After approval financial information cannot be edited.');">

            @Html.AntiForgeryToken()


            <button type="submit"
                    class="btn btn-success">

                <i class="fa-solid fa-circle-check me-1"></i>

                Approve

            </button>

        </form>
    }
    else
    {
        <button type="button"
                class="btn btn-success"
                title="Purchase Invoice is already approved"
                disabled>

            <i class="fa-solid fa-circle-check me-1"></i>

            Approve

        </button>
    }


    @* =================================================
       DELETE

       Always Enabled for:
       - Draft
       - Finalized

       This is Soft Delete only.

       Supplier Invoice PDF remains stored.
       Invoice can be restored from Deleted list.
       ================================================= *@

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post"
          class="d-inline"
          onsubmit="return confirm('Delete this Purchase Invoice? It can be restored later.');">

        @Html.AntiForgeryToken()


        <button type="submit"
                class="btn btn-outline-danger">

            <i class="fa-solid fa-trash me-1"></i>

            Delete

        </button>

    </form>

</div>

</div>


@* =========================================================
   PURCHASE INVOICE INFORMATION
   ========================================================= *@

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">

        <h5 class="fw-semibold mb-0">

            <i class="fa-solid fa-file-invoice me-2"></i>

            Invoice Information

        </h5>

    </div>


    <div class="card-body">

        <div class="row g-4">

            @* =================================================
               ERP PURCHASE INVOICE NUMBER
               ================================================= *@

            <div class="col-xl-3 col-md-6">

                <div class="text-muted small">
                    ERP Purchase Invoice No.
                </div>

                <div class="fw-bold fs-5">
                    @Model.Code
                </div>

            </div>


            @* =================================================
               ERP PURCHASE INVOICE DATE
               ================================================= *@

            <div class="col-xl-3 col-md-6">

                <div class="text-muted small">
                    Purchase Invoice Date
                </div>

                <div class="fw-semibold">

                    @(Model.PurchaseInvoiceDate
                        .ToString("dd-MM-yyyy"))

                </div>

            </div>


            @* =================================================
               SUPPLIER INVOICE NUMBER
               ================================================= *@

            <div class="col-xl-3 col-md-6">

                <div class="text-muted small">
                    Supplier Invoice No.
                </div>

                <div class="fw-bold text-primary">
                    @Model.SupplierInvoiceNumber
                </div>

            </div>


            @* =================================================
               SUPPLIER INVOICE DATE
               ================================================= *@

            <div class="col-xl-3 col-md-6">

                <div class="text-muted small">
                    Supplier Invoice Date
                </div>

                <div class="fw-semibold">

                    @(Model.SupplierInvoiceDate
                        .ToString("dd-MM-yyyy"))

                </div>

            </div>


            @* =================================================
               PURCHASE ORDER
               ================================================= *@

            <div class="col-xl-3 col-md-6">

                <div class="text-muted small">
                    Purchase Order
                </div>

                <div>

                    <a asp-controller="PurchaseOrder"
                       asp-action="Details"
                       asp-route-id="@Model.PurchaseOrderId"
                       class="fw-semibold text-decoration-none">

                        @Model.PurchaseOrderCode

                    </a>

                </div>

            </div>


            @* =================================================
               PAYMENT TERMS
               ================================================= *@

            <div class="col-xl-3 col-md-6">

                <div class="text-muted small">
                    Payment Terms
                </div>

                <div class="fw-semibold">

                    @(string.IsNullOrWhiteSpace(
                        Model.PaymentTerms)
                        ? "-"
                        : Model.PaymentTerms)

                </div>

            </div>


            @* =================================================
               CREDIT DAYS
               ================================================= *@

            <div class="col-xl-3 col-md-6">

                <div class="text-muted small">
                    Credit Days
                </div>

                <div class="fw-semibold">

                    @(Model.CreditDays.HasValue
                        ? Model.CreditDays.Value.ToString()
                        : "-")

                </div>

            </div>


            @* =================================================
               DUE DATE
               ================================================= *@

            <div class="col-xl-3 col-md-6">

                <div class="text-muted small">
                    Due Date
                </div>

                <div class="fw-semibold">

                    @(Model.DueDate.HasValue
                        ? Model.DueDate.Value.ToString("dd-MM-yyyy")
                        : "-")

                </div>

            </div>

        </div>

    </div>

</div>


@* =========================================================
   SUPPLIER INVOICE PDF
   ========================================================= *@

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">

        <h5 class="fw-semibold mb-0">

            <i class="fa-solid fa-file-pdf me-2 text-danger"></i>

            Supplier Invoice Document

        </h5>

    </div>


    <div class="card-body">

        @if (Model.HasSupplierInvoicePdf)
        {
            <div class="row
                        align-items-center
                        g-3">

                @* =================================================
                   PDF INFORMATION
                   ================================================= *@

                <div class="col-lg-7">

                    <div class="d-flex
                                align-items-start
                                gap-3">

                        <div>

                            <i class="fa-solid
                                      fa-file-pdf
                                      fa-2x
                                      text-danger">
                            </i>

                        </div>


                        <div>

                            <div class="text-muted small">
                                Attached Supplier Invoice
                            </div>


                            <div class="fw-semibold text-break">

                                @(string.IsNullOrWhiteSpace(
                                    Model.SupplierInvoicePdfOriginalName)
                                    ? "Supplier Invoice.pdf"
                                    : Model.SupplierInvoicePdfOriginalName)

                            </div>


                            @if (Model.SupplierInvoicePdfUploadedOn.HasValue)
                            {
                                <div class="text-muted small mt-1">

                                    Uploaded:

                                    @(Model.SupplierInvoicePdfUploadedOn.Value
                                        .ToString("dd-MM-yyyy HH:mm"))

                                </div>
                            }

                        </div>

                    </div>

                </div>


                @* =================================================
                   PDF ACTIONS
                   ================================================= *@

                <div class="col-lg-5">

                    <div class="d-flex
                                justify-content-lg-end
                                flex-wrap
                                gap-2">

                        <a asp-action="ViewSupplierInvoicePdf"
                           asp-route-id="@Model.Id"
                           target="_blank"
                           class="btn btn-outline-primary">

                            <i class="fa-solid fa-eye me-1"></i>

                            View PDF

                        </a>


                        <a asp-action="DownloadSupplierInvoicePdf"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary">

                            <i class="fa-solid fa-download me-1"></i>

                            Download

                        </a>

                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="d-flex
                        align-items-center
                        justify-content-between
                        flex-wrap
                        gap-3">

                <div>

                    <div class="text-muted">

                        <i class="fa-solid fa-circle-info me-1"></i>

                        No Supplier Invoice PDF is attached.

                    </div>

                </div>


                @if (isDraft)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-sm btn-outline-primary">

                        <i class="fa-solid fa-paperclip me-1"></i>

                        Attach PDF

                    </a>
                }

            </div>
        }

    </div>

</div>


