@model AjayIndustriesERP.Web.ViewModels.PurchaseInvoice.PurchaseInvoiceFormViewModel

@{
    ViewData["Title"] =
        "Edit Purchase Invoice";
}


@* =========================================================
   PAGE HEADER
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <div class="d-flex
                    align-items-center
                    flex-wrap
                    gap-2
                    mb-1">

            <h2 class="fw-bold mb-0">
                Edit Purchase Invoice
            </h2>


            @if (!string.IsNullOrWhiteSpace(
                Model.Status))
            {
                <span class="badge bg-warning text-dark">

                    @Model.Status

                </span>
            }

        </div>


        <div class="text-muted">

            @if (!string.IsNullOrWhiteSpace(
                Model.Code))
            {
                <span class="fw-semibold">

                    @Model.Code

                </span>
            }


            @if (!string.IsNullOrWhiteSpace(
                Model.SupplierInvoiceNumber))
            {
                <span class="mx-2">
                    •
                </span>

                <span>

                    Supplier Invoice:
                    <strong>
                        @Model.SupplierInvoiceNumber
                    </strong>

                </span>
            }

        </div>

    </div>


    <div class="d-flex
                flex-wrap
                gap-2">

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back to Details

        </a>

    </div>

</div>


@* =========================================================
   EDIT FORM

   enctype="multipart/form-data" is REQUIRED because:
   - existing PDF can be preserved
   - Draft can optionally upload a replacement PDF
   ========================================================= *@

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      enctype="multipart/form-data"
      autocomplete="off">

    @Html.AntiForgeryToken()


    @* =====================================================
       SHARED PURCHASE INVOICE FORM
       ===================================================== *@

    <partial name="_Form"
             model="Model" />

</form>


@* =========================================================
   PAGE SCRIPTS
   ========================================================= *@

@section Scripts
{
    @* Client-side ASP.NET validation *@

    <partial name="_ValidationScriptsPartial" />


    @* Purchase Invoice calculations / behaviour *@

    <script src="~/js/purchase-invoice-form.js"
            asp-append-version="true">
    </script>
}