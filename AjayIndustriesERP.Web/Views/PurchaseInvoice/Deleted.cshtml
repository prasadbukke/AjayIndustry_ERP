@model IEnumerable<AjayIndustriesERP.Domain.Entities.PurchaseInvoice>

@{
    ViewData["Title"] =
        "Deleted Purchase Invoices";
}


@* =========================================================
   SUCCESS / ERROR MESSAGES
   ========================================================= *@

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@* =========================================================
   PAGE HEADER
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Purchase Invoices
        </h2>

        <div class="text-muted">

            Restore previously deleted Draft Purchase Invoices.

        </div>

    </div>


    <div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back to Purchase Invoices

        </a>

    </div>

</div>


@* =========================================================
   DELETED PURCHASE INVOICE LIST
   ========================================================= *@

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="min-width:165px;">
                            ERP Invoice
                        </th>

                        <th style="min-width:120px;">
                            Date
                        </th>

                        <th style="min-width:190px;">
                            Supplier Invoice
                        </th>

                        <th style="min-width:220px;">
                            Supplier
                        </th>

                        <th style="min-width:160px;">
                            Purchase Order
                        </th>

                        <th class="text-center"
                            style="min-width:90px;">
                            PDF
                        </th>

                        <th class="text-end"
                            style="min-width:145px;">
                            Grand Total
                        </th>

                        <th style="min-width:155px;">
                            Deleted On
                        </th>

                        <th class="text-center"
                            style="min-width:120px;">
                            Status
                        </th>

                        <th class="text-end"
                            style="min-width:125px;">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model == null ||
                         !Model.Any())
                    {
                        <tr>

                            <td colspan="10"
                                class="text-center
                                       text-muted
                                       py-5">

                                <i class="fa-solid
                                          fa-trash-can
                                          fa-2x
                                          d-block
                                          mb-3">
                                </i>

                                No deleted Purchase Invoices found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                @* =================================
                                   ERP PURCHASE INVOICE
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @item.Code
                                    </div>

                                </td>


                                @* =================================
                                   PURCHASE INVOICE DATE
                                   ================================= *@

                                <td>

                                    @(item.PurchaseInvoiceDate
                                        .ToString("dd-MM-yyyy"))

                                </td>


                                @* =================================
                                   SUPPLIER INVOICE
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">

                                        @item.SupplierInvoiceNumber

                                    </div>


                                    <div class="text-muted small">

                                        @(item.SupplierInvoiceDate
                                            .ToString("dd-MM-yyyy"))

                                    </div>

                                </td>


                                @* =================================
                                   SUPPLIER
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @item.SupplierName
                                    </div>

                                </td>


                                @* =================================
                                   PURCHASE ORDER
                                   ================================= *@

                                <td>

                                    <a asp-controller="PurchaseOrder"
                                       asp-action="Details"
                                       asp-route-id="@item.PurchaseOrderId"
                                       class="text-decoration-none">

                                        @item.PurchaseOrderCode

                                    </a>

                                </td>


                                @* =================================
                                   SUPPLIER INVOICE PDF

                                   PDF remains physically stored during
                                   soft delete so it is available after
                                   Restore.
                                   ================================= *@

                                <td class="text-center">

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.SupplierInvoicePdfPath))
                                    {
                                        <span class="text-success"
                                              title="PDF attached">

                                            <i class="fa-solid fa-file-pdf"></i>

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   GRAND TOTAL
                                   ================================= *@

                                <td class="text-end fw-semibold">

                                    ₹ @(item.GrandTotal.ToString("N2"))

                                </td>


                                @* =================================
                                   DELETED DATE

                                   Current BaseEntity has no separate
                                   DeletedOn property, therefore latest
                                   ModifiedOn is displayed.
                                   ================================= *@

                                <td>

                                    @if (item.ModifiedOn.HasValue)
                                    {
                                        <div>

                                            @(item.ModifiedOn.Value
                                                .ToString("dd-MM-yyyy"))

                                        </div>


                                        <div class="text-muted small">

                                            @(item.ModifiedOn.Value
                                                .ToString("HH:mm"))

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   STATUS
                                   ================================= *@

                                <td class="text-center">

                                    <span class="badge bg-secondary">

                                        Deleted Draft

                                    </span>

                                </td>


                                @* =================================
                                   RESTORE
                                   ================================= *@

                                <td>

                                    <div class="d-flex
                                                justify-content-end">

                                        <form asp-action="Restore"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              onsubmit="return confirm('Restore this Purchase Invoice? GRN available quantity and Supplier Invoice Number will be validated again.');">

                                            @Html.AntiForgeryToken()


                                            <button type="submit"
                                                    class="btn
                                                           btn-sm
                                                           btn-outline-success">

                                                <i class="fa-solid
                                                          fa-trash-can-arrow-up
                                                          me-1">
                                                </i>

                                                Restore

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>