@model IEnumerable<AjayIndustriesERP.Domain.Entities.PurchaseInvoice>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] =
        "Deleted Purchase Invoices";
}


@* =========================================================
   SUCCESS / ERROR MESSAGES
   ========================================================= *@

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert
                alert-success
                alert-dismissible
                fade
                show"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert
                alert-danger
                alert-dismissible
                fade
                show"
         role="alert">

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@* =========================================================
   PAGE HEADER
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Purchase Invoices
        </h2>


        <div class="text-muted">

            Restore soft-deleted Draft or Finalized
            Purchase Invoices.

        </div>

    </div>


    <div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid
                      fa-arrow-left
                      me-1">
            </i>

            Back to Purchase Invoices

        </a>

    </div>

</div>


@* =========================================================
   INFORMATION
   ========================================================= *@

<div class="alert alert-light border mb-4">

    <div class="d-flex gap-2">

        <i class="fa-solid
                  fa-circle-info
                  text-primary
                  mt-1">
        </i>


        <div class="small">

            Restoring a Purchase Invoice will revalidate its
            Supplier Invoice Number and available GRN quantity.

            <strong>
                Original status is preserved.
            </strong>

            A deleted Draft returns as Draft and a deleted
            Finalized invoice returns as Finalized.

        </div>

    </div>

</div>


@* =========================================================
   DELETED PURCHASE INVOICE LIST
   ========================================================= *@

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="min-width:170px;">
                            ERP Invoice
                        </th>

                        <th style="min-width:120px;">
                            PI Date
                        </th>

                        <th style="min-width:180px;">
                            Supplier Invoice
                        </th>

                        <th style="min-width:120px;">
                            Supplier Inv. Date
                        </th>

                        <th style="min-width:220px;">
                            Supplier
                        </th>

                        <th style="min-width:160px;">
                            Purchase Order
                        </th>

                        <th class="text-center"
                            style="min-width:80px;">
                            PDF
                        </th>

                        <th class="text-end"
                            style="min-width:140px;">
                            Grand Total
                        </th>

                        <th style="min-width:150px;">
                            Deleted On
                        </th>

                        <th class="text-center"
                            style="min-width:145px;">
                            Status
                        </th>

                        <th class="text-center"
                            style="min-width:120px;">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model == null ||
                         !Model.Any())
                    {
                        <tr>

                            <td colspan="11"
                                class="text-center
                                       text-muted
                                       py-5">

                                <i class="fa-solid
                                          fa-trash-can
                                          fa-2x
                                          d-block
                                          mb-3">
                                </i>

                                No deleted Purchase Invoices found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var wasDraft =
                                item.Status ==
                                PurchaseInvoiceStatus.Draft;


                            var wasFinalized =
                                item.Status ==
                                PurchaseInvoiceStatus.Finalized;


                            <tr>

                                @* =================================
                                   ERP PURCHASE INVOICE
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @item.Code
                                    </div>

                                </td>


                                @* =================================
                                   PURCHASE INVOICE DATE
                                   ================================= *@

                                <td>

                                    @(item.PurchaseInvoiceDate
                                        .ToString("dd-MM-yyyy"))

                                </td>


                                @* =================================
                                   SUPPLIER INVOICE NUMBER
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">

                                        @item.SupplierInvoiceNumber

                                    </div>

                                </td>


                                @* =================================
                                   SUPPLIER INVOICE DATE
                                   ================================= *@

                                <td>

                                    @(item.SupplierInvoiceDate
                                        .ToString("dd-MM-yyyy"))

                                </td>


                                @* =================================
                                   SUPPLIER
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">

                                        @item.SupplierName

                                    </div>

                                </td>


                                @* =================================
                                   PURCHASE ORDER
                                   ================================= *@

                                <td>

                                    <a asp-controller="PurchaseOrder"
                                       asp-action="Details"
                                       asp-route-id="@item.PurchaseOrderId"
                                       class="text-decoration-none">

                                        @item.PurchaseOrderCode

                                    </a>

                                </td>


                                @* =================================
                                   SUPPLIER INVOICE PDF

                                   PDF is not physically deleted during
                                   Purchase Invoice soft delete.

                                   We only show attachment availability
                                   here because normal PDF View action
                                   loads active Purchase Invoices.
                                   ================================= *@

                                <td class="text-center">

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.SupplierInvoicePdfPath))
                                    {
                                        <span class="text-success"
                                              title="Supplier Invoice PDF retained">

                                            <i class="fa-solid
                                                      fa-file-pdf
                                                      fa-lg">
                                            </i>

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted"
                                              title="No PDF attached">

                                            —

                                        </span>
                                    }

                                </td>


                                @* =================================
                                   GRAND TOTAL
                                   ================================= *@

                                <td class="text-end fw-semibold">

                                    ₹ @(item.GrandTotal.ToString("N2"))

                                </td>


                                @* =================================
                                   DELETED ON

                                   BaseEntity currently has no separate
                                   DeletedOn property.

                                   Delete operation updates ModifiedOn,
                                   therefore ModifiedOn is displayed here.
                                   ================================= *@

                                <td>

                                    @if (item.ModifiedOn.HasValue)
                                    {
                                        <div>

                                            @(item.ModifiedOn.Value
                                                .ToString("dd-MM-yyyy"))

                                        </div>


                                        <div class="text-muted small">

                                            @(item.ModifiedOn.Value
                                                .ToString("HH:mm"))

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   ORIGINAL STATUS

                                   IMPORTANT:
                                   Delete does NOT change workflow status.

                                   Draft -> Deleted Draft
                                   Finalized -> Deleted Finalized
                                   ================================= *@

                                <td class="text-center">

                                    @if (wasDraft)
                                    {
                                        <span class="badge
                                                     bg-warning
                                                     text-dark">

                                            Deleted Draft

                                        </span>
                                    }
                                    else if (wasFinalized)
                                    {
                                        <span class="badge bg-success">

                                            Deleted Finalized

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            Deleted @item.Status

                                        </span>
                                    }

                                </td>


                                @* =================================
                                   RESTORE

                                   Enabled for both:
                                   - Deleted Draft
                                   - Deleted Finalized

                                   Backend performs:
                                   - Supplier Invoice duplicate check
                                   - GRN quantity availability check
                                   - Original status preservation
                                   ================================= *@

                                <td class="text-center">

                                    <form asp-action="Restore"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Restore this Purchase Invoice? Supplier Invoice Number and GRN available quantity will be validated again.');">

                                        @Html.AntiForgeryToken()


                                        <button type="submit"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-success"
                                                title="Restore Purchase Invoice">

                                            <i class="fa-solid
                                                      fa-trash-can-arrow-up
                                                      me-1">
                                            </i>

                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>