@model AjayIndustriesERP.Application.Common.PagedResult<AjayIndustriesERP.Domain.Entities.PurchaseInvoice>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] = "Purchase Invoices";

    var searchText =
        ViewBag.SearchText as string
        ?? string.Empty;

    var pageSize =
        ViewBag.PageSize != null
            ? Convert.ToInt32(ViewBag.PageSize)
            : 10;
}


@* =========================================================
   SUCCESS / ERROR MESSAGES
   ========================================================= *@

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@* =========================================================
   PAGE HEADER
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Purchase Invoices
        </h2>

        <div class="text-muted">
            Supplier bills recorded against received GRN material.
        </div>

    </div>


    <div class="d-flex flex-wrap gap-2">

        <a asp-action="Deleted"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-trash-can-arrow-up me-1"></i>

            Deleted

        </a>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus me-1"></i>

            New Purchase Invoice

        </a>

    </div>

</div>


@* =========================================================
   COMPACT SEARCH
   ========================================================= *@

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body py-3">

        <form asp-action="Index"
              method="get">

            @* Preserve current Page Size while searching *@

            <input type="hidden"
                   name="pageSize"
                   value="@pageSize" />


            <div class="d-flex
                        align-items-end
                        flex-wrap
                        gap-2">

                @* =================================================
                   SEARCH BOX
                   ================================================= *@

                <div style="width: 420px; max-width: 100%;">

                    <label class="form-label fw-semibold">
                        Search
                    </label>


                    <input type="text"
                           name="searchText"
                           value="@searchText"
                           class="form-control"
                           placeholder="Invoice No. / Supplier / PO / Date" />

                </div>


                @* =================================================
                   SEARCH BUTTON
                   ================================================= *@

                <div>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-magnifying-glass me-1"></i>

                        Search

                    </button>

                </div>


                @* =================================================
                   CLEAR BUTTON
                   ================================================= *@

                <div>

                    <a asp-action="Index"
                       asp-route-pageSize="@pageSize"
                       class="btn btn-outline-secondary"
                       title="Clear Search">

                        <i class="fa-solid fa-xmark"></i>

                    </a>

                </div>

            </div>

        </form>

    </div>

</div>


@* =========================================================
   PURCHASE INVOICE LIST
   ========================================================= *@

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="min-width:155px;">
                            ERP Invoice
                        </th>

                        <th style="min-width:105px;">
                            PI Date
                        </th>

                        <th style="min-width:155px;">
                            Supplier Invoice
                        </th>

                        <th style="min-width:115px;">
                            Supplier Inv. Date
                        </th>

                        <th style="min-width:180px;">
                            Supplier
                        </th>

                        <th style="min-width:150px;">
                            Purchase Order
                        </th>

                        <th style="min-width:110px;">
                            Due Date
                        </th>

                        <th class="text-center"
                            style="width:65px;">
                            PDF
                        </th>

                        <th class="text-end"
                            style="min-width:125px;">
                            Grand Total
                        </th>

                        <th class="text-center"
                            style="width:100px;">
                            Status
                        </th>

                        <th class="text-center"
                            style="min-width:190px;">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Items == null ||
                                        Model.Items.Count == 0)
                    {
                        <tr>

                            <td colspan="11"
                                class="text-center
                                           text-muted
                                           py-5">

                                <i class="fa-solid
                                              fa-file-invoice
                                              fa-2x
                                              d-block
                                              mb-3">
                                </i>

                                No Purchase Invoices found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            var isDraft =
                            item.Status ==
                            PurchaseInvoiceStatus.Draft;


                            var isFinalized =
                            item.Status ==
                            PurchaseInvoiceStatus.Finalized;


                            <tr>

                                @* =================================
                                   ERP INVOICE
                                   ================================= *@

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="fw-semibold text-decoration-none">

                                        @item.Code

                                    </a>

                                </td>


                                @* =================================
                                   PURCHASE INVOICE DATE
                                   ================================= *@

                                <td>

                                    @(item.PurchaseInvoiceDate
                                                                .ToString("dd-MM-yyyy"))

                                </td>


                                @* =================================
                                   SUPPLIER INVOICE NUMBER
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @item.SupplierInvoiceNumber
                                    </div>

                                </td>


                                @* =================================
                                   SUPPLIER INVOICE DATE
                                   ================================= *@

                                <td>

                                    @(item.SupplierInvoiceDate
                                                                .ToString("dd-MM-yyyy"))

                                </td>


                                @* =================================
                                   SUPPLIER
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">
                                        @item.SupplierName
                                    </div>

                                </td>


                                @* =================================
                                   PURCHASE ORDER
                                   ================================= *@

                                <td>

                                    <a asp-controller="PurchaseOrder"
                                       asp-action="Details"
                                       asp-route-id="@item.PurchaseOrderId"
                                       class="text-decoration-none">

                                        @item.PurchaseOrderCode

                                    </a>

                                </td>


                                @* =================================
                                   DUE DATE
                                   ================================= *@

                                <td>

                                    @(item.DueDate.HasValue
                                                                ? item.DueDate.Value.ToString("dd-MM-yyyy")
                                                                : "-")

                        </td>


                                @* =================================
                                   PDF
                                   ================================= *@

                                <td class="text-center">

                            @if (!string.IsNullOrWhiteSpace(
                                                        item.SupplierInvoicePdfPath))
                                    {
                                        <a asp-action="ViewSupplierInvoicePdf"
                                           asp-route-id="@item.Id"
                                           target="_blank"
                                           class="btn
                                                              btn-sm
                                                              btn-outline-danger"
                                           title="View Supplier Invoice PDF">

                                            <i class="fa-solid fa-file-pdf"></i>

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   GRAND TOTAL
                                   ================================= *@

                                <td class="text-end fw-semibold">

                                    ₹ @(item.GrandTotal.ToString("N2"))

                                </td>


                                @* =================================
                                   STATUS
                                   ================================= *@

                                <td class="text-center">

                                    @if (isDraft)
                                    {
                                        <span class="badge
                                                                 bg-warning
                                                                 text-dark">

                                            Draft

                                        </span>
                                    }
                                    else if (isFinalized)
                                    {
                                        <span class="badge bg-success">

                                            Finalized

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            @item.Status

                                        </span>
                                    }

                                </td>


                                @* =================================
                                   ACTIONS

                                   Details  -> Always Enabled
                                   Edit     -> Draft Only
                                   Approve  -> Draft Only
                                   Delete   -> Always Enabled
                                   ================================= *@

                                <td>

                                    <div class="d-flex
                                                        justify-content-center
                                                        align-items-center
                                                        flex-nowrap
                                                        gap-1">

                                        @* =========================
                                           DETAILS
                                           ========================= *@

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn
                                                          btn-sm
                                                          btn-outline-secondary"
                                           title="Details">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>


                                        @* =========================
                                           EDIT
                                           ========================= *@

                                        @if (isDraft)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn
                                                                  btn-sm
                                                                  btn-outline-primary"
                                               title="Edit">

                                                <i class="fa-solid
                                                                      fa-pen-to-square">
                                                </i>

                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn
                                                                       btn-sm
                                                                       btn-outline-primary"
                                                    title="Finalized Invoice cannot be edited"
                                                    disabled>

                                                <i class="fa-solid
                                                                      fa-pen-to-square">
                                                </i>

                                            </button>
                                        }


                                        @* =========================
                                           APPROVE
                                           ========================= *@

                                        @if (isDraft)
                                        {
                                            <form asp-action="Finalize"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Approve this Purchase Invoice? After approval financial information cannot be edited.');">

                                                @Html.AntiForgeryToken()


                                                <button type="submit"
                                                        class="btn
                                                                           btn-sm
                                                                           btn-outline-success"
                                                        title="Approve">

                                                    <i class="fa-solid
                                                                          fa-circle-check">
                                                    </i>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn
                                                                       btn-sm
                                                                       btn-outline-success"
                                                    title="Already Approved"
                                                    disabled>

                                                <i class="fa-solid
                                                                      fa-circle-check">
                                                </i>

                                            </button>
                                        }


                                        @* =========================
                                           DELETE - ALWAYS ENABLED
                                           ========================= *@

                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete this Purchase Invoice? It can be restored later.');">

                                            @Html.AntiForgeryToken()


                                            <button type="submit"
                                                    class="btn
                                                                   btn-sm
                                                                   btn-outline-danger"
                                                    title="Delete">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>


    @* =====================================================
       FOOTER

       Left:
       Page / Total Records

       Center:
       Pagination

       Right:
       Page Size
       ===================================================== *@

    @if (Model.TotalRecords > 0)
    {
        <div class="card-footer bg-white py-3">

            <div class="d-flex
                            align-items-center
                            justify-content-between
                            flex-wrap
                            gap-3">

                @* =============================================
                   PAGE INFORMATION - LEFT
                   ============================================= *@

                <div class="text-muted small">

                    Page

                    <strong>
                        @Model.PageNumber
                    </strong>

                    of

                    <strong>
                        @Model.TotalPages
                    </strong>

                    <span class="mx-1">
                        •
                    </span>

                    Total Records:

                    <strong>
                        @Model.TotalRecords
                    </strong>

                </div>


                @* =============================================
                   PAGINATION - CENTER
                   ============================================= *@

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Purchase Invoice Pagination">

                        <ul class="pagination
                                           pagination-sm
                                           mb-0">

                            @* ==============================
                               PREVIOUS
                               ============================== *@

                            <li class="page-item
                                        @(Model.HasPrevious
                                                                    ? ""
                                                                    : "disabled")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-searchText="@searchText"
                           asp-route-pageSize="@pageSize"
                           asp-route-pageNumber="@(Model.PageNumber - 1)">

                                    Previous

                                </a>

                            </li>


                    @{
                                var startPage =
                                Math.Max(
                                1,
                                Model.PageNumber - 2);

                                var endPage =
                                Math.Min(
                                Model.TotalPages,
                                Model.PageNumber + 2);
                            }


                            @* ==============================
                               FIRST PAGE
                               ============================== *@

                            @if (startPage > 1)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-searchText="@searchText"
                                       asp-route-pageSize="@pageSize"
                                       asp-route-pageNumber="1">

                                        1

                                    </a>

                                </li>


                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">

                                        <span class="page-link">
                                            ...
                                        </span>

                                    </li>
                                }
                            }


                            @* ==============================
                               CURRENT PAGE RANGE

                               IMPORTANT:
                               pageNo used intentionally.
                               Do not use variable named page.
                               ============================== *@

                            @for (var pageNo = startPage;
                                                pageNo <= endPage;
                                                pageNo++)
                            {
                                <li class="page-item
                                                @(pageNo == Model.PageNumber
                                                                            ? "active"
                                                                            : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-searchText="@searchText"
                           asp-route-pageSize="@pageSize"
                           asp-route-pageNumber="@pageNo">

                                        @pageNo

                                    </a>

                                </li>
                                        }


                            @* ==============================
                               LAST PAGE
                               ============================== *@

                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage <
                                                    Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">

                                        <span class="page-link">
                                            ...
                                        </span>

                                    </li>
                                }


                                <li class="page-item">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-searchText="@searchText"
                                       asp-route-pageSize="@pageSize"
                                       asp-route-pageNumber="@Model.TotalPages">

                                        @Model.TotalPages

                                    </a>

                                </li>
                            }


                        @* ==============================
                               NEXT
                               ============================== *@

                        <li class="page-item
                                    @(Model.HasNext
                                                                ? ""
                                                                : "disabled")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-searchText="@searchText"
                           asp-route-pageSize="@pageSize"
                           asp-route-pageNumber="@(Model.PageNumber + 1)">

                                    Next

                                </a>

                            </li>

                        </ul>

                    </nav>
                        }


                @* =============================================
                   PAGE SIZE - BOTTOM RIGHT
                   ============================================= *@

                <form asp-action="Index"
                      method="get"
                      class="d-flex
                                 align-items-center
                                 gap-2
                                 ms-auto">

                    @* Preserve current search *@

                    <input type="hidden"
                           name="searchText"
                           value="@searchText" />


                    <label class="text-muted
                                      small
                                      text-nowrap
                                      mb-0">

                        Page Size

                    </label>


                    <select name="pageSize"
                            class="form-select form-select-sm"
                            style="width: 80px;"
                            onchange="this.form.submit()">

                        @if (pageSize == 10)
                        {
                            <option value="10" selected>
                                10
                            </option>
                        }
                        else
                        {
                            <option value="10">
                                10
                            </option>
                        }


                        @if (pageSize == 25)
                        {
                            <option value="25" selected>
                                25
                            </option>
                        }
                        else
                        {
                            <option value="25">
                                25
                            </option>
                        }


                        @if (pageSize == 50)
                        {
                            <option value="50" selected>
                                50
                            </option>
                        }
                        else
                        {
                            <option value="50">
                                50
                            </option>
                        }


                        @if (pageSize == 100)
                        {
                            <option value="100" selected>
                                100
                            </option>
                        }
                        else
                        {
                            <option value="100">
                                100
                            </option>
                        }

                    </select>

                </form>

            </div>

        </div>
    }

</div>