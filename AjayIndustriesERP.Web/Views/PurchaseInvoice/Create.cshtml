@model AjayIndustriesERP.Web.ViewModels.PurchaseInvoice.PurchaseInvoiceFormViewModel

@{
    ViewData["Title"] = "Create Purchase Invoice";
}

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Create Purchase Invoice
        </h2>

        <div class="text-muted">
            Create supplier bill against received GRN material.
        </div>

    </div>


    <div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back to List

        </a>

    </div>

</div>


<form asp-action="Create"
      method="post"
      autocomplete="off">

    @Html.AntiForgeryToken()

    <partial name="_Form"
             model="Model" />

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/purchase-invoice-form.js"
            asp-append-version="true">
    </script>
}