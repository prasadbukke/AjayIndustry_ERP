@model AjayIndustriesERP.Web.ViewModels.PurchaseInvoice.PurchaseInvoiceFormViewModel

@{
    ViewData["Title"] =
        "Create Purchase Invoice";
}


@* =========================================================
   PAGE HEADER
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Create Purchase Invoice
        </h2>

        <div class="text-muted">

            Record Supplier Invoice against received GRN material.

        </div>

    </div>


    <div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back to List

        </a>

    </div>

</div>


@* =========================================================
   CREATE FORM

   enctype="multipart/form-data" is REQUIRED because
   Supplier Invoice PDF can be uploaded.
   ========================================================= *@

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      autocomplete="off">

    @Html.AntiForgeryToken()


    @* =====================================================
       SHARED PURCHASE INVOICE FORM
       ===================================================== *@

    <partial name="_Form"
             model="Model" />

</form>


@* =========================================================
   PAGE SCRIPTS
   ========================================================= *@

@section Scripts
{
    @* Client-side ASP.NET validation *@

    <partial name="_ValidationScriptsPartial" />


    @* Purchase Invoice calculations / behaviour *@

    <script src="~/js/purchase-invoice-form.js"
            asp-append-version="true">
    </script>
}