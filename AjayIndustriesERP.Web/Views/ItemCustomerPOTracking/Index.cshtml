@*
=============================================================
File: Index.cshtml
Module: Item Customer PO Tracking
Layer: Web - View

Purpose:
Displays complete Item-wise Customer PO Tracking.

Tracking Information:
- Customer PO
- Customer
- PO Date
- Item
- Drawing
- Ordered Quantity
- Due Date
- Actual Production Completion Date
- Priority
- PO Status

Production Tracking:

1. Production Jobs
   Example:
   5 / 10 Completed

2. Production PO Status
   Pending
   In Progress
   Completed

3. Production Completion Date

Important:
- Production Job Progress and Production PO Status
  are displayed separately.
- Due Date uses effective Delivery Date.
- Completion Date is actual Production completion date.
- Pending / In Progress Production PO has no Completion Date.
- Read-only module.
- Excel receives same active filters.
- JavaScript remains in separate JS file.
=============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.ItemCustomerPOTracking.ItemCustomerPOTrackingIndexViewModel

@{
    ViewData["Title"] =
        "Item Customer PO Tracking";


    var results =
        Model.Results;


    var selectedPageSize =
        results.PageSize > 0
            ? results.PageSize
            : 10;


    string FormatDate(
        DateTime value)
    {
        return string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            "{0:dd-MM-yyyy}",
            value);
    }


    string FormatNullableDate(
        DateTime? value)
    {
        if (!value.HasValue)
        {
            return "-";
        }

        return string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            "{0:dd-MM-yyyy}",
            value.Value);
    }


    string FormatDateInput(
        DateTime? value)
    {
        if (!value.HasValue)
        {
            return string.Empty;
        }

        return string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            "{0:yyyy-MM-dd}",
            value.Value);
    }


    string FormatQuantity(
    decimal value)
    {
        return string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            "{0:N0}",
            value);
    }
}


@* =========================================================
   PAGE HEADER
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Item Customer PO Tracking
        </h2>

        <div class="text-muted">
            Customer PO, Item, Due Date and Production Tracking
        </div>

    </div>


    <a asp-action="ExportExcel"
       asp-route-itemId="@Model.ItemId"
       asp-route-itemSearchText="@Model.ItemSearchText"
       asp-route-customerPurchaseOrderId="@Model.CustomerPurchaseOrderId"
       asp-route-purchaseOrderNumber="@Model.PurchaseOrderNumber"
       asp-route-customerId="@Model.CustomerId"
       asp-route-priority="@Model.Priority"
       asp-route-purchaseOrderStatus="@Model.PurchaseOrderStatus"
       asp-route-productionPOStatus="@Model.ProductionPOStatus"
       asp-route-purchaseOrderDateFrom="@FormatDateInput(Model.PurchaseOrderDateFrom)"
       asp-route-purchaseOrderDateTo="@FormatDateInput(Model.PurchaseOrderDateTo)"
       asp-route-dueDateFrom="@FormatDateInput(Model.DueDateFrom)"
       asp-route-dueDateTo="@FormatDateInput(Model.DueDateTo)"
       asp-route-completionDateFrom="@FormatDateInput(Model.CompletionDateFrom)"
       asp-route-completionDateTo="@FormatDateInput(Model.CompletionDateTo)"
       class="btn btn-success">

        <i class="fa-solid fa-file-excel me-1"></i>

        Export Excel

    </a>

</div>


@* =========================================================
   FILTER CARD — STANDARD COMPACT ERP UI
   ========================================================= *@

@{
    var hasDateFilters =
        Model.PurchaseOrderDateFrom.HasValue
        || Model.PurchaseOrderDateTo.HasValue
        || Model.DueDateFrom.HasValue
        || Model.DueDateTo.HasValue
        || Model.CompletionDateFrom.HasValue
        || Model.CompletionDateTo.HasValue;
}


<style>
    #trackingFilterCard {
        border-radius: 14px;
        overflow: visible;
    }

        #trackingFilterCard .tracking-filter-header {
            border-bottom: 1px solid var(--bs-border-color);
            border-radius: 14px 14px 0 0;
        }

        #trackingFilterCard .tracking-filter-icon {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: var(--bs-primary-bg-subtle);
            color: var(--bs-primary);
            flex-shrink: 0;
        }

        #trackingFilterCard .tracking-filter-label {
            font-size: .78rem;
            font-weight: 600;
            color: var(--bs-secondary-color);
            margin-bottom: .35rem;
        }

        #trackingFilterCard .form-control,
        #trackingFilterCard .form-select,
        #trackingFilterCard .input-group-text {
            min-height: 36px;
            border-color: var(--bs-border-color);
        }

        #trackingFilterCard .form-control,
        #trackingFilterCard .form-select {
            border-radius: 8px;
            transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease;
        }

            #trackingFilterCard .form-control:focus,
            #trackingFilterCard .form-select:focus {
                border-color: var(--bs-primary);
                box-shadow: 0 0 0 .18rem rgba(var(--bs-primary-rgb), .10);
            }

        #trackingFilterCard .input-group > .form-control {
            border-radius: 0;
        }

            #trackingFilterCard .input-group > .form-control:first-child {
                border-radius: 8px 0 0 8px;
            }

            #trackingFilterCard .input-group > .form-control:last-child {
                border-radius: 0 8px 8px 0;
            }

        #trackingFilterCard .input-group-text {
            background: var(--bs-tertiary-bg);
            color: var(--bs-secondary-color);
        }

        #trackingFilterCard .tracking-date-panel {
            background: var(--bs-tertiary-bg);
            border: 1px solid var(--bs-border-color);
            border-radius: 10px;
        }

        #trackingFilterCard .tracking-action-bar {
            border-top: 1px solid var(--bs-border-color);
        }

        #trackingFilterCard .btn {
            border-radius: 8px;
            font-weight: 500;
        }

        #trackingFilterCard .tracking-date-toggle {
            border-radius: 8px;
        }
</style>


<div id="trackingFilterCard"
     class="card border-0 shadow-sm mb-4">

    @* =====================================================
       HEADER
       ===================================================== *@

    <div class="card-header
                bg-white
                tracking-filter-header
                px-4
                py-3">

        <div class="d-flex
                    justify-content-between
                    align-items-center
                    flex-wrap
                    gap-3">

            <div class="d-flex
                        align-items-center
                        gap-3">

                <div class="tracking-filter-icon">

                    <i class="fa-solid fa-filter"></i>

                </div>


                <div>

                    <div class="fw-semibold">
                        Search & Filters
                    </div>

                    <div class="small text-muted">
                        Find Customer PO tracking records
                    </div>

                </div>

            </div>


            <button type="button"
                    class="btn
                           btn-sm
                           btn-outline-secondary
                           tracking-date-toggle"
                    data-bs-toggle="collapse"
                    data-bs-target="#trackingDateFilters"
                    aria-expanded="@(hasDateFilters ? "true" : "false")"
                    aria-controls="trackingDateFilters">

                <i class="fa-regular fa-calendar me-1"></i>

                Date Filters

                @if (hasDateFilters)
                {
                    <span class="badge
                                     bg-primary
                                     ms-1">

                        Active

                    </span>
                }

                <i class="fa-solid
                          fa-chevron-down
                          ms-1
                          small">
                </i>

            </button>

        </div>

    </div>


    @* =====================================================
       BODY
       ===================================================== *@

    <div class="card-body px-4 py-3">

        <form asp-action="Index"
              method="get"
              id="itemCustomerPOTrackingFilterForm">

            <input type="hidden"
                   name="pageNumber"
                   value="1" />

            <input type="hidden"
                   name="pageSize"
                   value="@selectedPageSize" />


            @* =================================================
               AUTOCOMPLETE SELECTED IDS
               ================================================= *@

            <input type="hidden"
                   asp-for="ItemId"
                   id="itemCustomerPOTrackingItemId" />

            <input type="hidden"
                   asp-for="CustomerPurchaseOrderId"
                   id="itemCustomerPOTrackingPOId" />


            @* =================================================
               PRIMARY SEARCH ROW
               ================================================= *@

            <div class="row g-3">

                @* ITEM *@

                <div class="col-xl-4 col-lg-6">

                    <label asp-for="ItemSearchText"
                           class="tracking-filter-label">

                        Item Name / Code

                    </label>


                    <div class="position-relative">

                        <div class="input-group input-group-sm">

                            <span class="input-group-text">

                                <i class="fa-solid fa-box"></i>

                            </span>


                            <input asp-for="ItemSearchText"
                                   id="itemCustomerPOTrackingItemSearch"
                                   class="form-control"
                                   autocomplete="off"
                                   placeholder="Search item..." />

                        </div>


                        <div id="itemCustomerPOTrackingItemSuggestions"
                             class="list-group
                                    position-absolute
                                    w-100
                                    shadow
                                    d-none"
                             style="
                                 z-index:1050;
                                 max-height:280px;
                                 overflow-y:auto;">
                        </div>

                    </div>

                </div>


                @* CUSTOMER PO *@

                <div class="col-xl-4 col-lg-6">

                    <label asp-for="PurchaseOrderNumber"
                           class="tracking-filter-label">

                        Customer PO Number

                    </label>


                    <div class="position-relative">

                        <div class="input-group input-group-sm">

                            <span class="input-group-text">

                                <i class="fa-solid fa-file-lines"></i>

                            </span>


                            <input asp-for="PurchaseOrderNumber"
                                   id="itemCustomerPOTrackingPOSearch"
                                   class="form-control"
                                   autocomplete="off"
                                   placeholder="Search PO..." />

                        </div>


                        <div id="itemCustomerPOTrackingPOSuggestions"
                             class="list-group
                                    position-absolute
                                    w-100
                                    shadow
                                    d-none"
                             style="
                                 z-index:1050;
                                 max-height:280px;
                                 overflow-y:auto;">
                        </div>

                    </div>

                </div>


                @* CUSTOMER *@

                <div class="col-xl-4 col-lg-6">

                    <label asp-for="CustomerId"
                           class="tracking-filter-label">

                        Customer

                    </label>


                    <select asp-for="CustomerId"
                            asp-items="Model.Customers"
                            class="form-select form-select-sm">
                    </select>

                </div>


                @* PRIORITY *@

                <div class="col-xl-4 col-lg-6">

                    <label asp-for="Priority"
                           class="tracking-filter-label">

                        Priority

                    </label>


                    <select asp-for="Priority"
                            asp-items="Model.Priorities"
                            class="form-select form-select-sm">
                    </select>

                </div>


                @* PO STATUS *@

                <div class="col-xl-4 col-lg-6">

                    <label asp-for="PurchaseOrderStatus"
                           class="tracking-filter-label">

                        PO Status

                    </label>


                    <select asp-for="PurchaseOrderStatus"
                            asp-items="Model.PurchaseOrderStatuses"
                            class="form-select form-select-sm">
                    </select>

                </div>


                @* PRODUCTION STATUS *@

                <div class="col-xl-4 col-lg-6">

                    <label asp-for="ProductionPOStatus"
                           class="tracking-filter-label">

                        Production Status

                    </label>


                    <select asp-for="ProductionPOStatus"
                            asp-items="Model.ProductionPOStatuses"
                            class="form-select form-select-sm">
                    </select>

                </div>

            </div>


            @* =================================================
               DATE FILTERS
               ================================================= *@

            <div id="trackingDateFilters"
                 class="collapse @(hasDateFilters ? "show" : "")">

                <div class="tracking-date-panel
                            mt-3
                            p-3">

                    <div class="d-flex
                                align-items-center
                                gap-2
                                mb-3">

                        <i class="fa-regular
                                  fa-calendar-days
                                  text-primary">
                        </i>

                        <span class="small fw-semibold">
                            Date Range Filters
                        </span>

                    </div>


                    <div class="row g-3">

                        @* PO DATE *@

                        <div class="col-xl-4 col-lg-6">

                            <label class="tracking-filter-label">
                                PO Date
                            </label>


                            <div class="input-group input-group-sm">

                                <input type="date"
                                       name="PurchaseOrderDateFrom"
                                       value="@FormatDateInput(Model.PurchaseOrderDateFrom)"
                                       class="form-control"
                                       title="PO Date From" />


                                <span class="input-group-text">
                                    to
                                </span>


                                <input type="date"
                                       name="PurchaseOrderDateTo"
                                       value="@FormatDateInput(Model.PurchaseOrderDateTo)"
                                       class="form-control"
                                       title="PO Date To" />

                            </div>

                        </div>


                        @* DUE DATE *@

                        <div class="col-xl-4 col-lg-6">

                            <label class="tracking-filter-label">
                                Due Date
                            </label>


                            <div class="input-group input-group-sm">

                                <input type="date"
                                       name="DueDateFrom"
                                       value="@FormatDateInput(Model.DueDateFrom)"
                                       class="form-control"
                                       title="Due Date From" />


                                <span class="input-group-text">
                                    to
                                </span>


                                <input type="date"
                                       name="DueDateTo"
                                       value="@FormatDateInput(Model.DueDateTo)"
                                       class="form-control"
                                       title="Due Date To" />

                            </div>

                        </div>


                        @* COMPLETION DATE *@

                        <div class="col-xl-4 col-lg-6">

                            <label class="tracking-filter-label">
                                Completion Date
                            </label>


                            <div class="input-group input-group-sm">

                                <input type="date"
                                       name="CompletionDateFrom"
                                       value="@FormatDateInput(Model.CompletionDateFrom)"
                                       class="form-control"
                                       title="Completion Date From" />


                                <span class="input-group-text">
                                    to
                                </span>


                                <input type="date"
                                       name="CompletionDateTo"
                                       value="@FormatDateInput(Model.CompletionDateTo)"
                                       class="form-control"
                                       title="Completion Date To" />

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            @* =================================================
               ACTION BAR
               ================================================= *@

            <div class="tracking-action-bar
                        d-flex
                        justify-content-between
                        align-items-center
                        flex-wrap
                        gap-2
                        mt-3
                        pt-3">

                <div class="small text-muted">

                    <i class="fa-solid fa-circle-info me-1"></i>

                    Use filters to narrow tracking results.

                </div>


                <div class="d-flex gap-2">

                    <a asp-action="Index"
                       class="btn
                              btn-sm
                              btn-light
                              border
                              px-3">

                        <i class="fa-solid
                                  fa-rotate-left
                                  me-1">
                        </i>

                        Reset

                    </a>


                    <button type="submit"
                            class="btn
                                   btn-sm
                                   btn-primary
                                   px-4">

                        <i class="fa-solid
                                  fa-magnifying-glass
                                  me-1">
                        </i>

                        Search

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

@* =========================================================
   MAIN + PRIORITY SUMMARY
   ========================================================= *@

<div class="row g-3 mb-3">

    <div class="col-xl-2 col-md-4 col-sm-6">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body">

                <div class="text-muted small mb-1">
                    Customer POs
                </div>

                <div class="fs-4 fw-bold">
                    @Model.TotalPurchaseOrders
                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-2 col-md-4 col-sm-6">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body">

                <div class="text-muted small mb-1">
                    Total Ordered Qty
                </div>

                <div class="fs-4 fw-bold">
                    @FormatQuantity(Model.TotalOrderedQuantity)
                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-2 col-md-4 col-sm-6">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body">

                <div class="text-muted small mb-1">
                    Critical POs
                </div>

                <div class="fs-4 fw-bold text-danger">
                    @Model.CriticalPriorityPurchaseOrders
                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-2 col-md-4 col-sm-6">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body">

                <div class="text-muted small mb-1">
                    Urgent POs
                </div>

                <div class="fs-4 fw-bold text-warning">
                    @Model.UrgentPurchaseOrders
                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-2 col-md-4 col-sm-6">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body">

                <div class="text-muted small mb-1">
                    High POs
                </div>

                <div class="fs-4 fw-bold">
                    @Model.HighPriorityPurchaseOrders
                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-2 col-md-4 col-sm-6">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body">

                <div class="text-muted small mb-1">
                    Normal POs
                </div>

                <div class="fs-4 fw-bold">
                    @Model.NormalPriorityPurchaseOrders
                </div>

            </div>

        </div>

    </div>

</div>


@* =========================================================
   PRODUCTION PO SUMMARY
   ========================================================= *@

<div class="row g-3 mb-4">

    <div class="col-lg-4">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body
                        d-flex
                        justify-content-between
                        align-items-center">

                <div>

                    <div class="text-muted small mb-1">
                        Production Pending POs
                    </div>

                    <div class="fs-4 fw-bold text-warning">
                        @Model.ProductionPendingPurchaseOrders
                    </div>

                </div>


                <i class="fa-solid
                          fa-clock
                          fa-2x
                          text-muted">
                </i>

            </div>

        </div>

    </div>


    <div class="col-lg-4">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body
                        d-flex
                        justify-content-between
                        align-items-center">

                <div>

                    <div class="text-muted small mb-1">
                        Production In Progress POs
                    </div>

                    <div class="fs-4 fw-bold text-primary">
                        @Model.ProductionInProgressPurchaseOrders
                    </div>

                </div>


                <i class="fa-solid
                          fa-gears
                          fa-2x
                          text-muted">
                </i>

            </div>

        </div>

    </div>


    <div class="col-lg-4">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body
                        d-flex
                        justify-content-between
                        align-items-center">

                <div>

                    <div class="text-muted small mb-1">
                        Production Completed POs
                    </div>

                    <div class="fs-4 fw-bold text-success">
                        @Model.ProductionCompletedPurchaseOrders
                    </div>

                </div>


                <i class="fa-solid
                          fa-circle-check
                          fa-2x
                          text-muted">
                </i>

            </div>

        </div>

    </div>

</div>


@* =========================================================
   RESULT TABLE
   ========================================================= *@

<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-3">

        <div class="d-flex
                    justify-content-between
                    align-items-center
                    flex-wrap
                    gap-2">

            <div>

                <h5 class="fw-semibold mb-1">
                    Customer PO Item Tracking
                </h5>

                <div class="text-muted small">

                    Total Matching Rows:

                    <strong>
                        @results.TotalRecords
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="min-width:170px;">
                            Customer PO No.
                        </th>

                        <th style="min-width:170px;">
                            Customer
                        </th>

                        <th style="min-width:110px;">
                            PO Date
                        </th>

                        <th style="min-width:120px;">
                            Item Code
                        </th>

                        <th style="min-width:180px;">
                            Item
                        </th>

                        <th style="min-width:140px;">
                            Drawing No.
                        </th>

                        <th class="text-center"
                            style="min-width:110px;">
                            Drawing
                        </th>

                        <th class="text-end"
                            style="min-width:120px;">
                            Ordered Qty
                        </th>

                        <th style="min-width:120px;">
                            Due Date
                        </th>

                        <th style="min-width:140px;">
                            Completion Date
                        </th>

                        <th class="text-center"
                            style="min-width:105px;">
                            Priority
                        </th>

                        <th class="text-center"
                            style="min-width:110px;">
                            PO Status
                        </th>

                        <th class="text-center"
                            style="min-width:160px;">
                            Production Jobs
                        </th>

                        <th class="text-center"
                            style="min-width:150px;">
                            Production PO
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (results.Items == null ||
                                        results.Items.Count == 0)
                    {
                        <tr>

                            <td colspan="14"
                                class="text-center
                                           text-muted
                                           py-5">

                                <i class="fa-solid
                                              fa-box-open
                                              fa-2x
                                              d-block
                                              mb-3">
                                </i>

                                No Customer PO item records found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var item in results.Items)
                        {
                            <tr>

                                @* =================================
                                   CUSTOMER PO
                                   ================================= *@

                                <td>

                                    <a asp-controller="CustomerPurchaseOrder"
                                       asp-action="Details"
                                       asp-route-id="@item.CustomerPurchaseOrderId"
                                       class="fw-semibold
                                                      text-decoration-none">

                                        @item.PurchaseOrderNumber

                                    </a>

                                </td>


                                @* =================================
                                   CUSTOMER
                                   ================================= *@

                                <td>

                                    <span class="fw-semibold">
                                        @item.CustomerName
                                    </span>

                                </td>


                                @* =================================
                                   PO DATE
                                   ================================= *@

                                <td class="text-nowrap">
                                    @FormatDate(item.PurchaseOrderDate)
                                </td>


                                @* =================================
                                   ITEM CODE
                                   ================================= *@

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                                                item.ItemCode))
                                    {
                                        @item.ItemCode
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   ITEM NAME
                                   ================================= *@

                                <td>

                                    <span class="fw-semibold">
                                        @item.ItemName
                                    </span>

                                </td>


                                @* =================================
                                   DRAWING NUMBER
                                   ================================= *@

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                                                item.DrawingNumber))
                                    {
                                        <span class="fw-semibold">
                                            @item.DrawingNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   VIEW DRAWING
                                   ================================= *@

                                <td class="text-center">

                                    @if (!string.IsNullOrWhiteSpace(
                                                                item.DrawingFilePath))
                                    {
                                        <a href="@item.DrawingFilePath"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="btn
                                                              btn-sm
                                                              btn-outline-primary">

                                            <i class="fa-solid fa-eye me-1"></i>

                                            View

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   ORDERED QUANTITY
                                   ================================= *@

                                <td class="text-end
                                                   text-nowrap
                                                   fw-semibold">

                                    @FormatQuantity(
                                    item.OrderedQuantity)

                        </td>


                        @* =================================
                                   DUE DATE
                                   ================================= *@

                        <td class="text-nowrap">

                            @FormatDate(
                                                        item.DeliveryDate)

                        </td>


                        @* =================================
                                   COMPLETION DATE
                                   ================================= *@

                        <td class="text-nowrap">

                            @if (item.CompletionDate.HasValue)
                                    {
                                        <span class="fw-semibold text-success">

                                            @FormatNullableDate(
                                            item.CompletionDate)

                            </span>
                                                        }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   PRIORITY
                                   ================================= *@

                                <td class="text-center">

                                    @if (string.Equals(
                                                                item.Priority,
                                                                "Critical",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger">
                                            Critical
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.Priority,
                                    "Urgent",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge
                                                                 bg-warning
                                                                 text-dark">
                                            Urgent
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.Priority,
                                    "High",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-primary">
                                            High
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Normal
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   CUSTOMER PO STATUS
                                   ================================= *@

                                <td class="text-center">

                                    @if (string.Equals(
                                                                item.PurchaseOrderStatus,
                                                                "Confirmed",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">
                                            Confirmed
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.PurchaseOrderStatus,
                                    "Draft",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge
                                                                 bg-warning
                                                                 text-dark">
                                            Draft
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.PurchaseOrderStatus,
                                    "Closed",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-secondary">
                                            Closed
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.PurchaseOrderStatus,
                                    "Cancelled",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.PurchaseOrderStatus
                                        </span>
                                    }

                                </td>


                                @* =================================
                                   PRODUCTION JOB PROGRESS
                                   ================================= *@

                                <td class="text-center">

                                    @if (item.TotalProductionJobs <= 0)
                                    {
                                        <span class="text-muted">
                                            No Jobs
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="fw-semibold">

                                            @item.CompletedProductionJobs
                                            /
                                            @item.TotalProductionJobs
                                            Completed

                                        </div>


                                        @if (item.CompletedProductionJobs ==
                                                                    item.TotalProductionJobs)
                                        {
                                            <div class="small text-success">
                                                All Jobs Completed
                                            </div>
                                        }
                                        else
                                        {
                                            var remainingJobs =
                                            item.TotalProductionJobs -
                                            item.CompletedProductionJobs;

                                            <div class="small text-muted">

                                                @remainingJobs
                                                Remaining

                                            </div>
                                        }
                                    }

                                </td>


                                @* =================================
                                   PRODUCTION PO STATUS
                                   ================================= *@

                                <td class="text-center">

                                    @if (string.Equals(
                                                                item.ProductionPOStatus,
                                                                "Completed",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">

                                            <i class="fa-solid fa-check me-1"></i>

                                            Completed

                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.ProductionPOStatus,
                                    "In Progress",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-primary">

                                            <i class="fa-solid fa-gears me-1"></i>

                                            In Progress

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge
                                                                 bg-warning
                                                                 text-dark">

                                            <i class="fa-solid fa-clock me-1"></i>

                                            Pending

                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@* =========================================================
   PAGINATION
   ========================================================= *@

@if (results.TotalRecords > 0)
{
    <div class="d-flex
                    justify-content-between
                    align-items-center
                    flex-wrap
                    gap-3
                    mt-3">

        <div class="text-muted small">

            Page

            <strong>
                @results.PageNumber
            </strong>

            of

            <strong>
                @results.TotalPages
            </strong>

            &nbsp;•&nbsp;

            Total Records:

            <strong>
                @results.TotalRecords
            </strong>

        </div>


        <div class="d-flex
                        align-items-center
                        flex-wrap
                        gap-3">

            @if (results.TotalPages > 1)
            {
                <nav aria-label="Item Customer PO Tracking pagination">

                    <ul class="pagination
                                       pagination-sm
                                       mb-0">

                        @* =====================================
                           PREVIOUS
                           ===================================== *@

                        <li class="page-item
                                           @(results.HasPrevious ? "" : "disabled")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-itemId="@Model.ItemId"
                               asp-route-itemSearchText="@Model.ItemSearchText"
                               asp-route-customerPurchaseOrderId="@Model.CustomerPurchaseOrderId"
                               asp-route-purchaseOrderNumber="@Model.PurchaseOrderNumber"
                               asp-route-customerId="@Model.CustomerId"
                               asp-route-priority="@Model.Priority"
                               asp-route-purchaseOrderStatus="@Model.PurchaseOrderStatus"
                               asp-route-productionPOStatus="@Model.ProductionPOStatus"
                               asp-route-purchaseOrderDateFrom="@FormatDateInput(Model.PurchaseOrderDateFrom)"
                               asp-route-purchaseOrderDateTo="@FormatDateInput(Model.PurchaseOrderDateTo)"
                               asp-route-dueDateFrom="@FormatDateInput(Model.DueDateFrom)"
                               asp-route-dueDateTo="@FormatDateInput(Model.DueDateTo)"
                               asp-route-completionDateFrom="@FormatDateInput(Model.CompletionDateFrom)"
                               asp-route-completionDateTo="@FormatDateInput(Model.CompletionDateTo)"
                               asp-route-pageNumber="@(results.PageNumber - 1)"
                               asp-route-pageSize="@selectedPageSize">

                                Previous

                            </a>

                        </li>


                        @{
                            var startPage =
                            Math.Max(
                            1,
                            results.PageNumber - 2);

                            var endPage =
                            Math.Min(
                            results.TotalPages,
                            results.PageNumber + 2);
                        }


                        @for (var pageNo = startPage;
                                        pageNo <= endPage;
                                        pageNo++)
                        {
                            <li class="page-item
                                                   @(pageNo == results.PageNumber
                                                                           ? "active"
                                                                           : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-itemId="@Model.ItemId"
                       asp-route-itemSearchText="@Model.ItemSearchText"
                       asp-route-customerPurchaseOrderId="@Model.CustomerPurchaseOrderId"
                       asp-route-purchaseOrderNumber="@Model.PurchaseOrderNumber"
                       asp-route-customerId="@Model.CustomerId"
                       asp-route-priority="@Model.Priority"
                       asp-route-purchaseOrderStatus="@Model.PurchaseOrderStatus"
                       asp-route-productionPOStatus="@Model.ProductionPOStatus"
                       asp-route-purchaseOrderDateFrom="@FormatDateInput(Model.PurchaseOrderDateFrom)"
                       asp-route-purchaseOrderDateTo="@FormatDateInput(Model.PurchaseOrderDateTo)"
                       asp-route-dueDateFrom="@FormatDateInput(Model.DueDateFrom)"
                       asp-route-dueDateTo="@FormatDateInput(Model.DueDateTo)"
                       asp-route-completionDateFrom="@FormatDateInput(Model.CompletionDateFrom)"
                       asp-route-completionDateTo="@FormatDateInput(Model.CompletionDateTo)"
                       asp-route-pageNumber="@pageNo"
                       asp-route-pageSize="@selectedPageSize">

                                    @pageNo

                                </a>

                            </li>
                                }


                        @* =====================================
                           NEXT
                           ===================================== *@

                        <li class="page-item
                                           @(results.HasNext ? "" : "disabled")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-itemId="@Model.ItemId"
                               asp-route-itemSearchText="@Model.ItemSearchText"
                               asp-route-customerPurchaseOrderId="@Model.CustomerPurchaseOrderId"
                               asp-route-purchaseOrderNumber="@Model.PurchaseOrderNumber"
                               asp-route-customerId="@Model.CustomerId"
                               asp-route-priority="@Model.Priority"
                               asp-route-purchaseOrderStatus="@Model.PurchaseOrderStatus"
                               asp-route-productionPOStatus="@Model.ProductionPOStatus"
                               asp-route-purchaseOrderDateFrom="@FormatDateInput(Model.PurchaseOrderDateFrom)"
                               asp-route-purchaseOrderDateTo="@FormatDateInput(Model.PurchaseOrderDateTo)"
                               asp-route-dueDateFrom="@FormatDateInput(Model.DueDateFrom)"
                               asp-route-dueDateTo="@FormatDateInput(Model.DueDateTo)"
                               asp-route-completionDateFrom="@FormatDateInput(Model.CompletionDateFrom)"
                               asp-route-completionDateTo="@FormatDateInput(Model.CompletionDateTo)"
                               asp-route-pageNumber="@(results.PageNumber + 1)"
                               asp-route-pageSize="@selectedPageSize">

                                Next

                            </a>

                        </li>

                    </ul>

                </nav>
            }


            @* =================================================
               PAGE SIZE
               ================================================= *@

            <form asp-action="Index"
                  method="get"
                  class="d-flex
                             align-items-center
                             gap-2">

                <input type="hidden"
                       name="itemId"
                       value="@Model.ItemId" />

                <input type="hidden"
                       name="itemSearchText"
                       value="@Model.ItemSearchText" />

                <input type="hidden"
                       name="customerPurchaseOrderId"
                       value="@Model.CustomerPurchaseOrderId" />

                <input type="hidden"
                       name="purchaseOrderNumber"
                       value="@Model.PurchaseOrderNumber" />

                <input type="hidden"
                       name="customerId"
                       value="@Model.CustomerId" />

                <input type="hidden"
                       name="priority"
                       value="@Model.Priority" />

                <input type="hidden"
                       name="purchaseOrderStatus"
                       value="@Model.PurchaseOrderStatus" />

                <input type="hidden"
                       name="productionPOStatus"
                       value="@Model.ProductionPOStatus" />

                <input type="hidden"
                       name="purchaseOrderDateFrom"
                       value="@FormatDateInput(Model.PurchaseOrderDateFrom)" />

                <input type="hidden"
                       name="purchaseOrderDateTo"
                       value="@FormatDateInput(Model.PurchaseOrderDateTo)" />

                <input type="hidden"
                       name="dueDateFrom"
                       value="@FormatDateInput(Model.DueDateFrom)" />

                <input type="hidden"
                       name="dueDateTo"
                       value="@FormatDateInput(Model.DueDateTo)" />

                <input type="hidden"
                       name="completionDateFrom"
                       value="@FormatDateInput(Model.CompletionDateFrom)" />

                <input type="hidden"
                       name="completionDateTo"
                       value="@FormatDateInput(Model.CompletionDateTo)" />

                <input type="hidden"
                       name="pageNumber"
                       value="1" />


                <label for="itemCustomerPOTrackingPageSize"
                       class="small
                                  text-muted
                                  text-nowrap">

                    Page Size

                </label>


                <select id="itemCustomerPOTrackingPageSize"
                        name="pageSize"
                        class="form-select form-select-sm"
                        style="width:80px;">

                    @if (selectedPageSize == 10)
                    {
                        <option value="10" selected>10</option>
                    }
                    else
                    {
                        <option value="10">10</option>
                    }


                    @if (selectedPageSize == 25)
                    {
                        <option value="25" selected>25</option>
                    }
                    else
                    {
                        <option value="25">25</option>
                    }


                    @if (selectedPageSize == 50)
                    {
                        <option value="50" selected>50</option>
                    }
                    else
                    {
                        <option value="50">50</option>
                    }


                    @if (selectedPageSize == 100)
                    {
                        <option value="100" selected>100</option>
                    }
                    else
                    {
                        <option value="100">100</option>
                    }

                </select>


                <button type="submit"
                        class="btn
                                   btn-sm
                                   btn-outline-secondary">

                    Apply

                </button>

            </form>

        </div>

    </div>
}


@* =========================================================
   PAGE JAVASCRIPT
   ========================================================= *@

@section Scripts
{
    <script src="~/js/item-customer-po-tracking.js"
            asp-append-version="true">
    </script>
}