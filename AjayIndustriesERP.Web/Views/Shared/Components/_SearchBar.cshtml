@model string

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <form method="get">

            <div class="row">

                <div class="col-md-4">

                    <input type="text"
                           name="searchText"
                           value="@Model"
                           class="form-control"
                           placeholder="Search..." />

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-magnifying-glass"></i>

                        Search

                    </button>

                </div>

                <div class="col-md-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Reset

                    </a>

                </div>

            </div>

        </form>

    </div>

</div>