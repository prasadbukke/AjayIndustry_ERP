@*
==============================================================

File : _QuickAddMasterModal.cshtml

Purpose :
Provides a reusable Bootstrap modal shell for Quick Create
Master forms.

The modal body is loaded dynamically using AJAX.

==============================================================
*@

<div class="modal fade"
     id="quickAddMasterModal"
     tabindex="-1"
     aria-labelledby="quickAddMasterModalLabel"
     aria-hidden="true"
     data-bs-backdrop="static">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="quickAddMasterModalLabel">

                    Add Master

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body"
                 id="quickAddMasterModalBody">

                <div class="text-center py-5">

                    <div class="spinner-border text-primary"
                         role="status">

                        <span class="visually-hidden">
                            Loading...
                        </span>

                    </div>

                    <div class="text-muted mt-3">
                        Loading form...
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>