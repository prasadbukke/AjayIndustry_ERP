

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-left">
        <div class="branding-container">

            <div class="branding-logo">

                AJ

            </div>

            <h1 class="branding-title">

                Ajay Industries ERP

            </h1>

            <h5 class="branding-subtitle">

                Manufacturing ERP Solution

            </h5>

            <p class="branding-description">

                Streamline your manufacturing operations with a
                secure, scalable and production-ready ERP platform.

            </p>

            <div class="branding-image">

                <i class="bi bi-buildings"></i>

            </div>

            <div class="branding-version">

                Version 1.0

            </div>

        </div>
    </div>

    <div class="login-right">
        <div class="login-form-container">

            <div class="login-card">

                <h2 class="login-title">

                    Welcome Back 👋

                </h2>

                <p class="login-subtitle">

                    Sign in to your ERP account

                </p>

                <form>

                    <div class="mb-4">

                        <label class="form-label">

                            Email Address

                        </label>

                        <input type="email"
                               class="form-control erp-input"
                               placeholder="Enter your email" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

                            Password

                        </label>

                        <div class="input-group">

                            <input type="password"
                                   class="form-control erp-input"
                                   placeholder="Enter your password" />

                            <button class="btn btn-outline-secondary"
                                    type="button">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                    </div>

                    <div class="login-options">

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="checkbox" />

                            <label class="form-check-label">

                                Remember Me

                            </label>

                        </div>

                        <a href="#">

                            Forgot Password?

                        </a>

                    </div>

                    <button type="submit"
                            class="btn erp-login-btn">

                        Sign In

                    </button>

                </form>

                <div class="login-footer">

                    © 2026 Ajay Industries ERP

                </div>

            </div>

        </div>
    </div>

</div>