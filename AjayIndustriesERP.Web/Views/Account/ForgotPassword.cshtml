@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="login-page">

    <!-- Left Branding Panel -->
    <div class="login-left">

        <div class="branding-container">

            <div class="branding-logo">
                AJ
            </div>

            <h1 class="branding-title">
                Ajay Industries ERP
            </h1>

            <h5 class="branding-subtitle">
                Manufacturing ERP Solution
            </h5>

            <div class="branding-features">

                <div><i class="fa-solid fa-check"></i> Production Management</div>
                <div><i class="fa-solid fa-check"></i> Inventory Tracking</div>
                <div><i class="fa-solid fa-check"></i> Purchase & Sales</div>
                <div><i class="fa-solid fa-check"></i> Financial Reports</div>

            </div>

            <div class="branding-image">
                <i class="fa-solid fa-industry"></i>
            </div>

            <div class="branding-version">
                Version 1.0
            </div>

        </div>

    </div>

    <!-- Right Panel -->

    <div class="login-right">

        <div class="login-card">

            <h2 class="login-title">
                Forgot Password
            </h2>

            <p class="login-subtitle">
                Enter your registered email address.
                We will send you a password reset link.
            </p>

            <form>

                <div class="mb-4">

                    <label class="form-label">
                        Email Address
                    </label>

                    <input type="email"
                           class="form-control erp-input"
                           placeholder="Enter your email" />

                </div>

                <button class="btn erp-login-btn">

                    <i class="fa-solid fa-paper-plane"></i>

                    Send Reset Link

                </button>

                <div class="login-footer mt-4">

                    <a asp-action="Login"
                       asp-controller="Account">

                        <i class="fa-solid fa-arrow-left"></i>

                        Back to Login

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>