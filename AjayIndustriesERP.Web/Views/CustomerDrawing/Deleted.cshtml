@model List<AjayIndustriesERP.Domain.Entities.CustomerDrawing>

@*
==============================================================

File : Deleted.cshtml

Purpose :
Displays completely deleted Customer Drawings.

Final Rules :
- One row represents one deleted Customer Drawing identity.
- Customer Drawing identity is Customer + Drawing Number.
- Complete Revision History is restored together.
- Previously Current revision becomes Current again.
- Physical Drawing files remain preserved.
- Restore is blocked when the same Customer + Item
  already has another active Customer Drawing.

==============================================================
*@

@{
    ViewData["Title"] =
        "Deleted Customer Drawings";
}


<!-- =========================================================
     PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Customer Drawings
        </h2>

        <p class="text-muted mb-0">
            Restore deleted Customer Drawings and their Revision History.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid
                  fa-arrow-left
                  me-1">
        </i>

        Back to Customer Drawings

    </a>

</div>


<!-- =========================================================
     INFORMATION
========================================================== -->

<div class="alert alert-light border mb-4">

    <div class="d-flex gap-2">

        <i class="fa-solid
                  fa-circle-info
                  text-primary
                  mt-1">
        </i>

        <div>

            <div class="fw-semibold mb-1">
                Revision History is preserved
            </div>

            <div class="small text-muted">

                Restoring a Customer Drawing restores its complete
                Revision History. The revision that was Current
                before deletion will become Current again.

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     DELETED CUSTOMER DRAWING LIST
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th>
                            #
                        </th>

                        <th>
                            Customer
                        </th>

                        <th>
                            Item
                        </th>

                        <th>
                            Drawing Number
                        </th>

                        <th>
                            Drawing Name
                        </th>

                        <th>
                            Last Current Revision
                        </th>

                        <th>
                            Type
                        </th>

                        <th>
                            File
                        </th>

                        <th class="text-center">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                         Model.Any())
                    {
                        var serialNumber =
                            1;


                        foreach (var drawing
                            in Model)
                        {
                            <tr>


                                <!-- SERIAL NUMBER -->

                                <td>
                                    @serialNumber
                                </td>


                                <!-- CUSTOMER -->

                                <td>

                                    <span class="fw-semibold">

                                        @drawing.Customer.CustomerName

                                    </span>

                                </td>


                                <!-- ITEM -->

                                <td>

                                    <div class="fw-semibold">

                                        @drawing.Item.ItemCode

                                    </div>


                                    <div class="small text-muted">

                                        @drawing.Item.ItemName

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        drawing.Item.PartNumber))
                                    {
                                        <div class="small text-muted">

                                            Part:
                                            @drawing.Item.PartNumber

                                        </div>
                                    }

                                </td>


                                <!-- DRAWING NUMBER -->

                                <td>

                                    <span class="fw-semibold">

                                        @drawing.DrawingNumber

                                    </span>

                                </td>


                                <!-- DRAWING NAME -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        drawing.DrawingName))
                                    {
                                        @drawing.DrawingName
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- PREVIOUS CURRENT REVISION -->

                                <td>

                                    <span class="badge
                                                 bg-secondary">

                                        @drawing.RevisionNumber

                                    </span>

                                </td>


                                <!-- DRAWING TYPE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        drawing.DrawingType))
                                    {
                                        @drawing.DrawingType
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- FILE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        drawing.FilePath))
                                    {
                                        <a href="@drawing.FilePath"
                                           target="_blank"
                                           rel="noopener"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-primary">

                                            <i class="fa-solid
                                                      fa-file
                                                      me-1">
                                            </i>

                                            @(drawing.FileName
                                                ?? "View File")

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No File
                                        </span>
                                    }

                                </td>


                                <!-- RESTORE -->

                                <td class="text-center">

                                    <form asp-action="Restore"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="id"
                                               value="@drawing.CustomerDrawingId" />


                                        <button type="submit"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-success"
                                                onclick="return confirm(
                                                    'Restore Customer Drawing @drawing.DrawingNumber with complete Revision History?');">

                                            <i class="fa-solid
                                                      fa-rotate-left
                                                      me-1">
                                            </i>

                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9"
                                class="text-center
                                       text-muted
                                       py-5">

                                <i class="fa-solid
                                          fa-trash-can
                                          fa-2x
                                          mb-2">
                                </i>

                                <div class="fw-semibold">
                                    No Deleted Customer Drawings
                                </div>

                                <div class="small mt-1">
                                    Deleted Customer Drawings will appear here.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>