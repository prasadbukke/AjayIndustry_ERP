@model List<AjayIndustriesERP.Domain.Entities.CustomerDrawing>

@*
==============================================================

File : Index.cshtml

Purpose :
Displays Current Customer Drawings.

Features :
- Shared Search
- Shared Pagination
- Customer
- Item
- Drawing Number
- Drawing Name
- Current Revision
- Drawing Type
- Current Drawing File
- Details / Edit / Delete
- Deleted Customer Drawings

Important :
- Only Current revisions are shown here.
- Revision History is available through Details / Edit.
- Customer Drawing follows Drawing Master workflow.

==============================================================
*@

@{
    ViewData["Title"] =
        "Customer Drawing Management";
}


<!-- =========================================================
     PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Customer Drawing Management
        </h2>

        <p class="text-muted mb-0">
            Manage Customer-specific Drawing records.
        </p>

    </div>


    <div class="d-flex
                align-items-center
                gap-2
                flex-wrap">

        <a asp-action="Deleted"
           class="btn btn-outline-secondary">

            <i class="fa-solid
                      fa-trash-can
                      me-1">
            </i>

            Deleted Drawings

        </a>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid
                      fa-plus
                      me-1">
            </i>

            Add Customer Drawing

        </a>

    </div>

</div>


<!-- =========================================================
     SEARCH
========================================================== -->

<partial name="Components/_SearchBar"
         model='@(ViewBag.SearchText as string ?? "")' />


<!-- =========================================================
     CUSTOMER DRAWING LIST
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th>
                            #
                        </th>

                        <th>
                            Customer
                        </th>

                        <th>
                            Item
                        </th>

                        <th>
                            Drawing Number
                        </th>

                        <th>
                            Drawing Name
                        </th>

                        <th>
                            Revision
                        </th>

                        <th>
                            Type
                        </th>

                        <th>
                            File
                        </th>

                        <th class="text-center">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                         Model.Any())
                    {
                        var pageNumber =
                            (int)ViewBag.PageNumber;

                        var pageSize =
                            (int)ViewBag.PageSize;

                        var serialNumber =
                            ((pageNumber - 1) *
                             pageSize) + 1;


                        foreach (var drawing
                            in Model)
                        {
                            <tr>


                                <!-- SERIAL NUMBER -->

                                <td>
                                    @serialNumber
                                </td>


                                <!-- CUSTOMER -->

                                <td>

                                    <span class="fw-semibold">

                                        @drawing.Customer.CustomerName

                                    </span>

                                </td>


                                <!-- ITEM -->

                                <td>

                                    <div class="fw-semibold">

                                        @drawing.Item.ItemCode

                                    </div>


                                    <div class="small text-muted">

                                        @drawing.Item.ItemName

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        drawing.Item.PartNumber))
                                    {
                                        <div class="small text-muted">

                                            Part:
                                            @drawing.Item.PartNumber

                                        </div>
                                    }

                                </td>


                                <!-- DRAWING NUMBER -->

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@drawing.CustomerDrawingId"
                                       class="text-decoration-none
                                              fw-semibold">

                                        @drawing.DrawingNumber

                                    </a>

                                </td>


                                <!-- DRAWING NAME -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        drawing.DrawingName))
                                    {
                                        @drawing.DrawingName
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- CURRENT REVISION -->

                                <td>

                                    <span class="badge
                                                 bg-success">

                                        @drawing.RevisionNumber

                                    </span>

                                </td>


                                <!-- DRAWING TYPE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        drawing.DrawingType))
                                    {
                                        @drawing.DrawingType
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- FILE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        drawing.FilePath))
                                    {
                                        <a href="@drawing.FilePath"
                                           target="_blank"
                                           rel="noopener"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-primary">

                                            <i class="fa-solid
                                                      fa-file
                                                      me-1">
                                            </i>

                                            @(drawing.FileName
                                                ?? "View File")

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No File
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-center">

                                    <div class="d-flex
                                                justify-content-center
                                                gap-1">


                                        <!-- DETAILS -->

                                        <a asp-action="Details"
                                           asp-route-id="@drawing.CustomerDrawingId"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-info"
                                           title="View">

                                            <i class="fa-solid fa-eye">
                                            </i>

                                        </a>


                                        <!-- EDIT -->

                                        <a asp-action="Edit"
                                           asp-route-id="@drawing.CustomerDrawingId"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-warning"
                                           title="Edit">

                                            <i class="fa-solid fa-pen">
                                            </i>

                                        </a>


                                        <!-- DELETE -->

                                        <button type="button"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-danger"
                                                title="Delete"
                                                onclick="confirmDelete(
                                                    '@Url.Action(
                                                        "Delete",
                                                        "CustomerDrawing",
                                                        new
                                                        {
                                                            id =
                                                                drawing.CustomerDrawingId
                                                        })')">

                                            <i class="fa-solid fa-trash">
                                            </i>

                                        </button>

                                    </div>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9"
                                class="text-center
                                       text-muted
                                       py-5">

                                <i class="fa-solid
                                          fa-file-circle-xmark
                                          fa-2x
                                          mb-2">
                                </i>

                                <div>
                                    No Customer Drawing records found.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     PAGINATION
========================================================== -->

<partial name="Components/_Pagination"
         model='(
             (int)ViewBag.PageNumber,
             (int)ViewBag.PageSize
         )' />