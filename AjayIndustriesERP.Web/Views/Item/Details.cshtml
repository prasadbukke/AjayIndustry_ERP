@using AjayIndustriesERP.Domain.Entities

@model AjayIndustriesERP.Domain.Entities.Item

@*
==============================================================

File : Details.cshtml

Purpose :
Displays complete Item Master information.

Features :
- Clean 3-column Item Information
- Part Number
- Dynamic Specifications
- Current Drawing integration
- Drawing Number
- Current Revision
- Drawing Type
- Current Drawing File
- Add / Open Drawing actions
- Audit Information

==============================================================
*@

@{
    ViewData["Title"] = "Item Details";

    var currentDrawing =
        ViewBag.CurrentDrawing as Drawing;
}

<div class="container-fluid">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="d-flex
                justify-content-between
                align-items-center
                flex-wrap
                gap-3
                mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Item Details
            </h2>

            <p class="text-muted mb-0">
                View complete Item Master information.
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.ItemId"
               class="btn btn-warning">

                <i class="fa-solid fa-pen me-1"></i>

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="fa-solid fa-arrow-left me-1"></i>

                Back

            </a>

        </div>

    </div>

    <!-- =====================================================
         ITEM INFORMATION
    ====================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">

            <div class="fw-semibold">
                Item Information
            </div>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <!-- Item Code -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Item Code
                        </div>

                        <div class="fw-semibold">
                            @Model.ItemCode
                        </div>

                    </div>

                </div>

                <!-- Item Name -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Item Name
                        </div>

                        <div class="fw-semibold"
                             style="overflow-wrap:anywhere;">

                            @Model.ItemName

                        </div>

                    </div>

                </div>

                <!-- Part Number -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Part Number
                        </div>

                        <div class="fw-semibold"
                             style="overflow-wrap:anywhere;">

                            @(string.IsNullOrWhiteSpace(
                                Model.PartNumber)
                                ? "-"
                                : Model.PartNumber)

                        </div>

                    </div>

                </div>

                <!-- Category -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Category
                        </div>

                        <div>

                            @if (Model.ItemCategory != null)
                            {
                                <span>
                                    @Model.ItemCategory.CategoryCode
                                    -
                                    @Model.ItemCategory.CategoryName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <!-- Brand -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Brand
                        </div>

                        <div>

                            @if (Model.Brand != null)
                            {
                                <span>
                                    @Model.Brand.BrandCode
                                    -
                                    @Model.Brand.BrandName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <!-- UOM -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            UOM
                        </div>

                        <div>

                            @if (Model.Uom != null)
                            {
                                <span>
                                    @Model.Uom.UomCode
                                    -
                                    @Model.Uom.UomName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <!-- Shape -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Shape
                        </div>

                        <div>

                            @if (Model.Shape != null)
                            {
                                <span>
                                    @Model.Shape.ShapeCode
                                    -
                                    @Model.Shape.ShapeName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <!-- Status -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Status
                        </div>

                        <div>

                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <!-- Description -->

                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Description
                        </div>

                        <div style="white-space:normal;
                                    overflow-wrap:anywhere;">

                            @(string.IsNullOrWhiteSpace(
                                Model.Description)
                                ? "-"
                                : Model.Description)

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- =====================================================
         ITEM SPECIFICATIONS
    ====================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">

            <div class="d-flex
                        justify-content-between
                        align-items-center">

                <div>

                    <div class="fw-semibold">
                        Item Specifications
                    </div>

                    <div class="small text-muted">
                        Technical specifications assigned
                        to this Item.
                    </div>

                </div>

                @if (Model.ItemSpecifications.Any())
                {
                    <span class="badge bg-secondary">

                        @Model.ItemSpecifications.Count
                        Specification(s)

                    </span>
                }

            </div>

        </div>

        <div class="card-body p-0">

            @if (Model.ItemSpecifications.Any())
            {
                <div class="table-responsive">

                    <table class="table
                                  table-hover
                                  align-middle
                                  mb-0">

                        <thead class="table-light">

                            <tr>

                                <th style="width:70px;">
                                    #
                                </th>

                                <th>
                                    Specification
                                </th>

                                <th>
                                    Value
                                </th>

                                <th>
                                    UOM
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                var serialNumber = 1;
                            }

                            @foreach (var specification
                                in Model.ItemSpecifications
                                    .Where(x => !x.IsDeleted)
                                    .OrderBy(x => x.SortOrder))
                            {
                                <tr>

                                    <td>
                                        @serialNumber
                                    </td>

                                    <td>

                                        @if (specification.Specification != null)
                                        {
                                            <div class="fw-semibold">

                                                @(
                                                    specification
                                                        .Specification
                                                        .SpecificationName
                                                )

                                            </div>

                                            <div class="small text-muted">

                                                @(
                                                    specification
                                                        .Specification
                                                        .SpecificationCode
                                                )

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <td class="fw-semibold">

                                        @specification.SpecificationValue

                                    </td>

                                    <td>

                                        @if (specification.Uom != null)
                                        {
                                            <span>

                                                @(
                                                    specification
                                                        .Uom
                                                        .UomCode
                                                )
                                                -
                                                @(
                                                    specification
                                                        .Uom
                                                        .UomName
                                                )

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                </tr>

                                serialNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center
                            text-muted
                            py-5">

                    <i class="fa-solid
                              fa-sliders
                              fa-2x
                              mb-2">
                    </i>

                    <div>
                        No Specifications assigned to this Item.
                    </div>

                </div>
            }

        </div>

    </div>

    <!-- =====================================================
         DRAWING INFORMATION
    ====================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">

            <div class="d-flex
                        justify-content-between
                        align-items-center
                        flex-wrap
                        gap-2">

                <div>

                    <div class="fw-semibold">
                        Drawing Information
                    </div>

                    <div class="small text-muted">
                        Current engineering Drawing
                        linked to this Item.
                    </div>

                </div>

                @if (currentDrawing != null)
                {
                    <span class="badge bg-success">
                        Drawing Available
                    </span>
                }

            </div>

        </div>

        @if (currentDrawing != null)
        {
            <div class="card-body">

                <div class="row g-3">

                    <!-- Drawing Number -->

                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small
                                        text-muted
                                        mb-1">
                                Drawing Number
                            </div>

                            <div class="fw-semibold">

                                @currentDrawing.DrawingNumber

                            </div>

                        </div>

                    </div>

                    <!-- Current Revision -->

                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small
                                        text-muted
                                        mb-1">
                                Current Revision
                            </div>

                            <div>

                                <span class="badge bg-success fs-6">

                                    @currentDrawing.RevisionNumber

                                </span>

                            </div>

                        </div>

                    </div>

                    <!-- Drawing Type -->

                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small
                                        text-muted
                                        mb-1">
                                Drawing Type
                            </div>

                            <div style="overflow-wrap:anywhere;">

                                @(string.IsNullOrWhiteSpace(
                                    currentDrawing.DrawingType)
                                    ? "-"
                                    : currentDrawing.DrawingType)

                            </div>

                        </div>

                    </div>

                    <!-- Drawing Name -->

                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small
                                        text-muted
                                        mb-1">
                                Drawing Name
                            </div>

                            <div style="overflow-wrap:anywhere;">

                                @(string.IsNullOrWhiteSpace(
                                    currentDrawing.DrawingName)
                                    ? "-"
                                    : currentDrawing.DrawingName)

                            </div>

                        </div>

                    </div>

                    <!-- Drawing File -->

                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small
                                        text-muted
                                        mb-1">
                                Current Drawing File
                            </div>

                            <div>

                                @if (!string.IsNullOrWhiteSpace(
                                    currentDrawing.FilePath))
                                {
                                    <a href="@currentDrawing.FilePath"
                                       target="_blank"
                                       rel="noopener"
                                       class="btn
                                              btn-sm
                                              btn-outline-primary">

                                        <i class="fa-solid
                                                  fa-file
                                                  me-1">
                                        </i>

                                        @(string.IsNullOrWhiteSpace(
                                            currentDrawing.FileName)
                                            ? "View Drawing"
                                            : currentDrawing.FileName)

                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No File
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                    <!-- Drawing Details -->

                    <div class="col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small
                                        text-muted
                                        mb-2">
                                Drawing Details
                            </div>

                            <a asp-controller="Drawing"
                               asp-action="Details"
                               asp-route-id="@currentDrawing.DrawingId"
                               class="btn
                                      btn-sm
                                      btn-outline-info">

                                <i class="fa-solid
                                          fa-eye
                                          me-1">
                                </i>

                                Open Drawing Details

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="card-body">

                <div class="text-center py-4">

                    <div class="text-muted mb-3">

                        <i class="fa-solid
                                  fa-file-circle-xmark
                                  fa-2x
                                  mb-2">
                        </i>

                        <div>
                            No Drawing is available for this Item.
                        </div>

                    </div>

                    <a asp-controller="Drawing"
                       asp-action="Create"
                       asp-route-itemId="@Model.ItemId"
                       class="btn btn-primary">

                        <i class="fa-solid fa-plus me-1"></i>

                        Add Drawing

                    </a>

                </div>

            </div>
        }

    </div>

    <!-- =====================================================
         AUDIT INFORMATION
    ====================================================== -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-light">

            <div class="fw-semibold">
                Audit Information
            </div>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <!-- Created On -->

                <div class="col-md-3">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Created On
                        </div>

                        <div>

                            @(
                                Model.CreatedOn
                                    .ToLocalTime()
                                    .ToString(
                                        "dd-MMM-yyyy hh:mm tt")
                            )

                        </div>

                    </div>

                </div>

                <!-- Created By -->

                <div class="col-md-3">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Created By
                        </div>

                        <div>
                            @Model.CreatedBy
                        </div>

                    </div>

                </div>

                <!-- Modified On -->

                <div class="col-md-3">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Modified On
                        </div>

                        <div>

                            @if (Model.ModifiedOn.HasValue)
                            {
                                @(
                                    Model.ModifiedOn.Value
                                        .ToLocalTime()
                                        .ToString(
                                            "dd-MMM-yyyy hh:mm tt")
                                )
                            }
                            else
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <!-- Modified By -->

                <div class="col-md-3">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted mb-1">
                            Modified By
                        </div>

                        <div>

                            @(string.IsNullOrWhiteSpace(
                                Model.ModifiedBy)
                                ? "-"
                                : Model.ModifiedBy)

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>