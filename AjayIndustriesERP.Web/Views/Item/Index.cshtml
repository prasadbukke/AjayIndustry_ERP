@model List<AjayIndustriesERP.Domain.Entities.Item>

@*
==============================================================

File : Index.cshtml

Purpose :
Displays Item Master list.

Features :
- Search
- Pagination
- Part Number
- Category / Brand / UOM / Shape
- Compact Specification summary
- Status
- Details / Edit / Delete actions

==============================================================
*@

@{
    ViewData["Title"] = "Item Management";
}

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Item Management
        </h2>

        <p class="text-muted mb-0">
            Manage Item Master records.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="fa-solid fa-plus me-1"></i>

        Add Item

    </a>

</div>

<!-- =========================================================
     SEARCH
========================================================== -->

<partial name="Components/_SearchBar"
         model='@(ViewBag.SearchText as string ?? "")' />

<!-- =========================================================
     ITEM LIST
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th>#</th>

                        <th>
                            Code
                        </th>

                        <th>
                            Item Name
                        </th>

                        <th>
                            Part Number
                        </th>

                        <th>
                            Category
                        </th>

                        

                        <th>
                            UOM
                        </th>

                        <th>
                            Shape
                        </th>

                        <th>
                            Specifications
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-center"
                            style="width:160px;">

                            Actions

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        var pageNumber =
                            (int)ViewBag.PageNumber;

                        var pageSize =
                            (int)ViewBag.PageSize;

                        var serialNumber =
                            ((pageNumber - 1) *
                             pageSize) + 1;

                        foreach (var item in Model)
                        {
                            var specifications =
                                item.ItemSpecifications
                                    .Where(x =>
                                        !x.IsDeleted)
                                    .OrderBy(x =>
                                        x.SortOrder)
                                    .ToList();

                            <tr>

                                <!-- Serial Number -->

                                <td>
                                    @serialNumber
                                </td>

                                <!-- Item Code -->

                                <td>

                                    <span class="fw-semibold">
                                        @item.ItemCode
                                    </span>

                                </td>

                                <!-- Item Name -->

                                <td style="min-width:180px;">

                                    <a asp-action="Details"
                                       asp-route-id="@item.ItemId"
                                       class="text-decoration-none
                                              fw-semibold">

                                        @item.ItemName

                                    </a>

                                </td>

                                <!-- Part Number -->

                                <td style="min-width:130px;">

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.PartNumber))
                                    {
                                        <span>
                                            @item.PartNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>

                                <!-- Category -->

                                <td>

                                    @if (item.ItemCategory != null)
                                    {
                                        @item.ItemCategory.CategoryName
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>

                                <!-- Brand -->

                                

                                <!-- UOM -->

                                <td>

                                    @if (item.Uom != null)
                                    {
                                        @item.Uom.UomCode
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>

                                <!-- Shape -->

                                <td>

                                    @if (item.Shape != null)
                                    {
                                        @item.Shape.ShapeName
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>

                                <!-- Specifications -->

                                <!-- Specifications -->

<td style="min-width:260px;">

    @if (specifications.Any())
    {
        <div class="d-flex
                    flex-wrap
                    gap-1">

            @foreach (var specification
                in specifications.Take(3))
            {
                var specificationName =
                    specification.Specification != null
                        ? specification.Specification.SpecificationName
                        : "-";

                var uomText =
                    specification.Uom != null
                        ? $" {specification.Uom.UomCode}"
                        : string.Empty;

                var specificationText =
                    $"{specification.SpecificationValue}{uomText}";

                <span class="badge
                             bg-light
                             text-dark
                             border
                             fw-normal">

                    <strong>
                        @(specificationName):
                    </strong>

                    @specificationText

                </span>
            }

            @if (specifications.Count > 3)
            {
                <span class="badge bg-secondary">

                    +@(specifications.Count - 3) more

                </span>
            }

        </div>
    }
    else
    {
        <span class="text-muted">
            -
        </span>
    }

</td>

                                <!-- Status -->

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <!-- Actions -->

                                <td class="text-center">

                                    <div class="d-flex
                                                justify-content-center
                                                gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@item.ItemId"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-info"
                                           title="View">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ItemId"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-warning"
                                           title="Edit">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>

                                        <button type="button"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-danger"
                                                title="Delete"
                                                onclick="confirmDelete(
                                                    '@Url.Action(
                                                        "Delete",
                                                        "Item",
                                                        new
                                                        {
                                                            id = item.ItemId
                                                        })')">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>

                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="11"
                                class="text-center
                                       text-muted
                                       py-5">

                                <i class="fa-solid
                                          fa-box-open
                                          fa-2x
                                          mb-2">
                                </i>

                                <div>
                                    No Item records found.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- =========================================================
     PAGINATION
========================================================== -->

<partial name="Components/_Pagination"
         model='(
             (int)ViewBag.PageNumber,
             (int)ViewBag.PageSize
         )' />