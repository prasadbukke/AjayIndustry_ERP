@using AjayIndustriesERP.Domain.Entities
@model AjayIndustriesERP.Web.ViewModels.Item.ItemViewModel

@*
==============================================================

File : _Form.cshtml

Purpose :
Common Create/Edit form for Item Master.

Features :
- Item Code
- Item Name
- Optional Part Number
- Category / Brand / UOM / Shape
- Quick Add Masters
- Dynamic Specifications
- Similar Item warning
- Drawing summary during Edit
- Save-first Drawing message during Create

==============================================================
*@

@{
    var isEdit =
        Model.ItemId > 0;

    var currentDrawing =
        ViewBag.CurrentDrawing as Drawing;
}

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger"></div>

<input asp-for="ItemId"
       type="hidden" />

<input asp-for="ItemCode"
       type="hidden" />

<!-- =========================================================
     BASIC ITEM INFORMATION
========================================================== -->

<div class="card border mb-4">

    <div class="card-header bg-light">

        <div class="fw-semibold">
            Item Information
        </div>

    </div>

    <div class="card-body">

        <div class="row">

            @if (isEdit)
            {
                <!-- Item Code -->

                <div class="col-md-4 mb-3">

                    <label asp-for="ItemCode"
                           class="form-label"></label>

                    <input value="@Model.ItemCode"
                           class="form-control"
                           readonly />

                    <div class="form-text">
                        Permanent system-generated Item identity.
                    </div>

                </div>
            }

            <!-- Item Name -->

            <div class="@(isEdit
                            ? "col-md-4"
                            : "col-md-6") mb-3">

                <label asp-for="ItemName"
                       class="form-label"></label>

                <input asp-for="ItemName"
                       class="form-control"
                       autocomplete="off"
                       maxlength="150"
                       placeholder="Enter Item Name"
                       data-similar-url="@Url.Action(
                           "CheckSimilarName",
                           "Item")" />

                <span asp-validation-for="ItemName"
                      class="text-danger"></span>

                <div class="form-text">
                    Similar Item Names will appear while typing.
                </div>

            </div>

            <!-- Part Number -->

            <div class="@(isEdit
                            ? "col-md-4"
                            : "col-md-6") mb-3">

                <label asp-for="PartNumber"
                       class="form-label"></label>

                <input asp-for="PartNumber"
                       class="form-control"
                       maxlength="100"
                       autocomplete="off"
                       placeholder="Enter Part Number (Optional)" />

                <span asp-validation-for="PartNumber"
                      class="text-danger"></span>

                <div class="form-text">
                    Optional manufacturer/internal Part reference.
                </div>

            </div>

            <!-- Category -->

            <div class="col-md-3 mb-3">

                <label asp-for="ItemCategoryId"
                       class="form-label"></label>

                <select asp-for="ItemCategoryId"
                        asp-items="Model.Categories"
                        class="form-select js-master-select"
                        data-placeholder="-- Select Category --"
                        data-master-type="Category"
                        data-add-label="Add Category">

                    <option value=""></option>

                </select>

                <span asp-validation-for="ItemCategoryId"
                      class="text-danger"></span>

            </div>

            <!-- Brand -->

            <div class="col-md-3 mb-3">

                <label asp-for="BrandId"
                       class="form-label"></label>

                <select asp-for="BrandId"
                        asp-items="Model.Brands"
                        class="form-select js-master-select"
                        data-placeholder="-- Select Brand --"
                        data-master-type="Brand"
                        data-add-label="Add Brand">

                    <option value=""></option>

                </select>

                <span asp-validation-for="BrandId"
                      class="text-danger"></span>

            </div>

            <!-- Main UOM -->

            <div class="col-md-3 mb-3">

                <label asp-for="UomId"
                       class="form-label"></label>

                <select asp-for="UomId"
                        asp-items="Model.Uoms"
                        class="form-select js-master-select"
                        data-placeholder="-- Select UOM --"
                        data-master-type="Uom"
                        data-add-label="Add UOM">

                    <option value=""></option>

                </select>

                <span asp-validation-for="UomId"
                      class="text-danger"></span>

            </div>

            <!-- Shape -->

            <div class="col-md-3 mb-3">

                <label asp-for="ShapeId"
                       class="form-label"></label>

                <select asp-for="ShapeId"
                        asp-items="Model.Shapes"
                        class="form-select js-master-select"
                        data-placeholder="-- Select Shape (Optional) --"
                        data-master-type="Shape"
                        data-add-label="Add Shape">

                    <option value=""></option>

                </select>

                <span asp-validation-for="ShapeId"
                      class="text-danger"></span>

            </div>

            <!-- Description -->

            <div class="col-12 mb-3">

                <label asp-for="Description"
                       class="form-label"></label>

                <textarea asp-for="Description"
                          rows="3"
                          maxlength="500"
                          class="form-control"
                          placeholder="Enter optional description"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     ITEM SPECIFICATIONS
========================================================== -->

<div class="card border mb-4">

    <div class="card-header bg-light">

        <div class="d-flex
                    justify-content-between
                    align-items-center
                    gap-2">

            <div>

                <div class="fw-semibold">
                    Item Specifications
                </div>

                <div class="small text-muted">
                    Add dimensions, grade, hardness or
                    other technical specifications.
                </div>

            </div>

            <button type="button"
                    id="addItemSpecificationButton"
                    class="btn btn-sm btn-outline-primary">

                <i class="fa-solid fa-plus me-1"></i>

                Add Specification

            </button>

        </div>

    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          align-middle
                          mb-0"
                   id="itemSpecificationTable">

                <thead class="table-light">

                    <tr>

                        <th style="width:34%;">
                            Specification
                        </th>

                        <th style="width:32%;">
                            Value
                        </th>

                        <th style="width:24%;">
                            UOM
                        </th>

                        <th class="text-center"
                            style="width:10%;">
                            Remove
                        </th>

                    </tr>

                </thead>

                <tbody id="itemSpecificationRows">

                    @for (var i = 0;
                          i < Model.ItemSpecifications.Count;
                          i++)
                    {
                        var row =
                            Model.ItemSpecifications[i];

                        <tr class="item-specification-row">

                            <td>

                                <input type="hidden"
                                       name="ItemSpecifications.Index"
                                       value="@i" />

                                <input type="hidden"
                                       name="ItemSpecifications[@i].ItemSpecificationId"
                                       value="@row.ItemSpecificationId" />

                                <input type="hidden"
                                       name="ItemSpecifications[@i].SortOrder"
                                       value="@(i + 1)"
                                       class="js-spec-sort-order" />

                                <select name="ItemSpecifications[@i].SpecificationId"
                                        id="ItemSpecifications_@(i)_SpecificationId"
                                        class="form-select
                                               js-master-select
                                               js-specification-select"
                                        data-placeholder="-- Select Specification --"
                                        data-master-type="Specification"
                                        data-add-label="Add Specification"
                                        required>

                                    <option value=""></option>

                                    @foreach (var option
                                        in Model.SpecificationOptions)
                                    {
                                        if (option.Value ==
                                            row.SpecificationId.ToString())
                                        {
                                            <option value="@option.Value"
                                                    selected>
                                                @option.Text
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@option.Value">
                                                @option.Text
                                            </option>
                                        }
                                    }

                                </select>

                            </td>

                            <td>

                                <input type="text"
                                       name="ItemSpecifications[@i].SpecificationValue"
                                       value="@row.SpecificationValue"
                                       maxlength="200"
                                       class="form-control
                                              js-specification-value"
                                       placeholder="Enter value"
                                       required />

                            </td>

                            <td>

                                <select name="ItemSpecifications[@i].UomId"
                                        id="ItemSpecifications_@(i)_UomId"
                                        class="form-select
                                               js-master-select
                                               js-specification-uom-select"
                                        data-placeholder="-- Optional UOM --"
                                        data-master-type="Uom"
                                        data-add-label="Add UOM">

                                    <option value=""></option>

                                    @foreach (var option
                                        in Model.SpecificationUoms)
                                    {
                                        if (row.UomId.HasValue &&
                                            option.Value ==
                                            row.UomId.Value.ToString())
                                        {
                                            <option value="@option.Value"
                                                    selected>
                                                @option.Text
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@option.Value">
                                                @option.Text
                                            </option>
                                        }
                                    }

                                </select>

                            </td>

                            <td class="text-center">

                                <button type="button"
                                        class="btn
                                               btn-sm
                                               btn-outline-danger
                                               js-remove-specification"
                                        title="Remove Specification">

                                    <i class="fa-solid fa-trash"></i>

                                </button>

                            </td>

                        </tr>
                    }

                    <tr id="itemSpecificationEmptyRow"
                        class="@(Model.ItemSpecifications.Any()
                            ? "d-none"
                            : string.Empty)">

                        <td colspan="4"
                            class="text-center
                                   text-muted
                                   py-4">

                            No Specifications added.

                            <div class="small">
                                Click "Add Specification" to add one.
                            </div>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- =========================================================
     DYNAMIC SPECIFICATION TEMPLATE
========================================================== -->

<template id="itemSpecificationRowTemplate">

    <tr class="item-specification-row">

        <td>

            <input type="hidden"
                   name="ItemSpecifications.Index"
                   value="__KEY__" />

            <input type="hidden"
                   name="ItemSpecifications[__KEY__].ItemSpecificationId"
                   value="0" />

            <input type="hidden"
                   name="ItemSpecifications[__KEY__].SortOrder"
                   value="0"
                   class="js-spec-sort-order" />

            <select name="ItemSpecifications[__KEY__].SpecificationId"
                    id="ItemSpecifications___KEY___SpecificationId"
                    class="form-select
                           js-master-select
                           js-specification-select"
                    data-placeholder="-- Select Specification --"
                    data-master-type="Specification"
                    data-add-label="Add Specification"
                    required>

                <option value=""></option>

                @foreach (var option
                    in Model.SpecificationOptions)
                {
                    <option value="@option.Value">
                        @option.Text
                    </option>
                }

            </select>

        </td>

        <td>

            <input type="text"
                   name="ItemSpecifications[__KEY__].SpecificationValue"
                   maxlength="200"
                   class="form-control
                          js-specification-value"
                   placeholder="Enter value"
                   required />

        </td>

        <td>

            <select name="ItemSpecifications[__KEY__].UomId"
                    id="ItemSpecifications___KEY___UomId"
                    class="form-select
                           js-master-select
                           js-specification-uom-select"
                    data-placeholder="-- Optional UOM --"
                    data-master-type="Uom"
                    data-add-label="Add UOM">

                <option value=""></option>

                @foreach (var option
                    in Model.SpecificationUoms)
                {
                    <option value="@option.Value">
                        @option.Text
                    </option>
                }

            </select>

        </td>

        <td class="text-center">

            <button type="button"
                    class="btn
                           btn-sm
                           btn-outline-danger
                           js-remove-specification"
                    title="Remove Specification">

                <i class="fa-solid fa-trash"></i>

            </button>

        </td>

    </tr>

</template>

<!-- =========================================================
     DRAWING INFORMATION
========================================================== -->

<div class="card border mb-4">

    <div class="card-header bg-light">

        <div class="d-flex
                    justify-content-between
                    align-items-center
                    flex-wrap
                    gap-2">

            <div>

                <div class="fw-semibold">
                    Drawing Information
                </div>

                <div class="small text-muted">
                    Engineering Drawing linked to this Item.
                </div>

            </div>

            @if (isEdit &&
                 currentDrawing != null)
            {
                <span class="badge bg-success">
                    Drawing Available
                </span>
            }

        </div>

    </div>

    @if (!isEdit)
    {
        <!-- =================================================
             CREATE ITEM
        ================================================== -->

        <div class="card-body">

            <div class="alert alert-light
                        border
                        mb-0">

                <div class="d-flex
                            align-items-start
                            gap-3">

                    <div class="fs-4 text-primary">

                        <i class="fa-solid
                                  fa-file-circle-plus">
                        </i>

                    </div>

                    <div>

                        <div class="fw-semibold mb-1">
                            Drawing can be added after
                            the Item is created.
                        </div>

                        <div class="text-muted small">
                            Save this Item first.
                            After Save, Item Details will open
                            and you can add the Drawing from there.
                        </div>

                    </div>

                </div>

            </div>

        </div>
    }
    else if (currentDrawing != null)
    {
        <!-- =================================================
             EDIT ITEM - DRAWING EXISTS
        ================================================== -->

        <div class="card-body">

            <div class="row g-3">

                <!-- Drawing Number -->

                <div class="col-md-4">

                    <div class="border
                                rounded
                                p-3
                                h-100">

                        <div class="small
                                    text-muted
                                    mb-1">
                            Drawing Number
                        </div>

                        <div class="fw-semibold">
                            @currentDrawing.DrawingNumber
                        </div>

                    </div>

                </div>

                <!-- Current Revision -->

                <div class="col-md-4">

                    <div class="border
                                rounded
                                p-3
                                h-100">

                        <div class="small
                                    text-muted
                                    mb-1">
                            Current Revision
                        </div>

                        <span class="badge
                                     bg-success
                                     fs-6">

                            @currentDrawing.RevisionNumber

                        </span>

                    </div>

                </div>

                <!-- Drawing Type -->

                <div class="col-md-4">

                    <div class="border
                                rounded
                                p-3
                                h-100">

                        <div class="small
                                    text-muted
                                    mb-1">
                            Drawing Type
                        </div>

                        <div style="overflow-wrap:anywhere;">

                            @(string.IsNullOrWhiteSpace(
                                currentDrawing.DrawingType)
                                ? "-"
                                : currentDrawing.DrawingType)

                        </div>

                    </div>

                </div>

                <!-- Drawing Name -->

                <div class="col-md-4">

                    <div class="border
                                rounded
                                p-3
                                h-100">

                        <div class="small
                                    text-muted
                                    mb-1">
                            Drawing Name
                        </div>

                        <div style="overflow-wrap:anywhere;">

                            @(string.IsNullOrWhiteSpace(
                                currentDrawing.DrawingName)
                                ? "-"
                                : currentDrawing.DrawingName)

                        </div>

                    </div>

                </div>

                <!-- Current File -->

                <div class="col-md-4">

                    <div class="border
                                rounded
                                p-3
                                h-100">

                        <div class="small
                                    text-muted
                                    mb-2">
                            Current Drawing File
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            currentDrawing.FilePath))
                        {
                            <a href="@currentDrawing.FilePath"
                               target="_blank"
                               rel="noopener"
                               class="btn
                                      btn-sm
                                      btn-outline-primary">

                                <i class="fa-solid
                                          fa-file
                                          me-1">
                                </i>

                                @(string.IsNullOrWhiteSpace(
                                    currentDrawing.FileName)
                                    ? "View Drawing"
                                    : currentDrawing.FileName)

                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                No File
                            </span>
                        }

                    </div>

                </div>

                <!-- Drawing Actions -->

                <div class="col-md-4">

                    <div class="border
                                rounded
                                p-3
                                h-100">

                        <div class="small
                                    text-muted
                                    mb-2">
                            Drawing Details
                        </div>

                        <a asp-controller="Drawing"
                           asp-action="Details"
                           asp-route-id="@currentDrawing.DrawingId"
                           class="btn
                                  btn-sm
                                  btn-outline-info">

                            <i class="fa-solid
                                      fa-eye
                                      me-1">
                            </i>

                            Open Drawing Details

                        </a>

                    </div>

                </div>

            </div>

            <div class="form-text mt-3">
                Drawing Number and Revision History are managed
                from the Drawing module, not from Item Edit.
            </div>

        </div>
    }
    else
    {
        <!-- =================================================
             EDIT ITEM - NO DRAWING
        ================================================== -->

        <div class="card-body">

            <div class="d-flex
                        justify-content-between
                        align-items-center
                        flex-wrap
                        gap-3">

                <div>

                    <div class="fw-semibold mb-1">
                        No Drawing available
                    </div>

                    <div class="text-muted small">
                        No engineering Drawing is currently
                        linked to this Item.
                    </div>

                </div>

                <a asp-controller="Drawing"
                   asp-action="Create"
                   asp-route-itemId="@Model.ItemId"
                   class="btn btn-primary">

                    <i class="fa-solid
                              fa-plus
                              me-1">
                    </i>

                    Add Drawing

                </a>

            </div>

        </div>
    }

</div>

<!-- =========================================================
     SIMILAR ITEM WARNING
========================================================== -->

<div id="similarItemWarning"
     class="alert alert-warning
            @(Model.SimilarItemNames.Any()
                ? string.Empty
                : "d-none")">

    <div class="fw-semibold mb-2">

        <i class="fa-solid
                  fa-triangle-exclamation
                  me-1">
        </i>

        Similar Item Names Found

    </div>

    <p class="mb-2">
        Check whether the Item already exists or
        whether there is a spelling mistake.
    </p>

    <ul id="similarItemList"
        class="mb-3">

        @foreach (var itemName
            in Model.SimilarItemNames)
        {
            <li>
                @itemName
            </li>
        }

    </ul>

    <div id="itemExactDuplicateMessage"
         class="text-danger
                fw-semibold
                d-none
                mb-2">

        The same Item Name already exists.
        It may be a different Shape or Specification variant.

    </div>

    <div id="itemSimilarConfirmationContainer"
         class="form-check">

        <input asp-for="ConfirmSimilarItemName"
               class="form-check-input" />

        <label asp-for="ConfirmSimilarItemName"
               class="form-check-label">

            I checked the similar Items and still want
            to continue.

        </label>

    </div>

</div>

<!-- =========================================================
     STATUS
========================================================== -->

<div class="card border mb-4">

    <div class="card-header bg-light">

        <div class="fw-semibold">
            Status
        </div>

    </div>

    <div class="card-body">

        <div class="form-check form-switch">

            <input asp-for="IsActive"
                   class="form-check-input" />

            <label asp-for="IsActive"
                   class="form-check-label"></label>

        </div>

    </div>

</div>

<!-- =========================================================
     FORM ACTIONS
========================================================== -->

<div class="d-flex
            justify-content-end
            gap-2">

    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>

    <button type="submit"
            id="itemSaveButton"
            class="btn btn-primary">

        <i class="fa-solid
                  fa-floppy-disk
                  me-1">
        </i>

        @(isEdit
            ? "Update Item"
            : "Save Item")

    </button>

</div>