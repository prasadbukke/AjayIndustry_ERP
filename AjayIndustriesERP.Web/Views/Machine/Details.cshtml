@*
    ============================================================
    File: Details.cshtml

    Purpose:
    Displays complete read-only Machine Master information.

    Responsibilities:
    - Display Machine identification.
    - Display operational Machine Status.
    - Display manufacturer information.
    - Display capacity and location.
    - Display remarks.
    - Provide Edit and Delete actions.

    Important:
    - Machine Status is manually maintained.
    - Production Job / Production Step history will be added
      in the Production module later.
    - Delete uses the existing global confirmDelete() function.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.Machine.MachineDetailsViewModel

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] = "Machine Details";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Machine Details
        </h2>

        <p class="text-muted mb-0">
            @Model.Code
        </p>

    </div>


    <div class="d-flex
                gap-2
                flex-wrap">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">

            <i class="fa-solid fa-pen me-1"></i>
            Edit

        </a>


        <button type="button"
                class="btn btn-outline-danger"
                onclick="confirmDelete(
                    '@Url.Action(
                        "Delete",
                        "Machine",
                        new
                        {
                            id = Model.Id
                        })')">

            <i class="fa-solid fa-trash me-1"></i>
            Delete

        </button>


        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>
            Back

        </a>

    </div>

</div>


<!-- =========================================================
     REGION 2 — BASIC MACHINE INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-gears me-1"></i>

            Machine Information

        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Machine Code
                </div>

                <div class="fw-semibold">
                    @Model.Code
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Machine Name
                </div>

                <div class="fw-semibold">
                    @Model.MachineName
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Machine Type
                </div>

                <div class="fw-semibold">
                    @Model.MachineType
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Machine Status
                </div>

                <div>

                    @switch (Model.Status)
                    {
                        case MachineStatus.Available:

                            <span class="badge bg-success">
                                Available
                            </span>

                            break;


                        case MachineStatus.Running:

                            <span class="badge bg-primary">
                                Running
                            </span>

                            break;


                        case MachineStatus.Breakdown:

                            <span class="badge bg-danger">
                                Breakdown
                            </span>

                            break;


                        case MachineStatus.Maintenance:

                            <span class="badge bg-warning text-dark">
                                Maintenance
                            </span>

                            break;


                        case MachineStatus.Offline:

                            <span class="badge bg-secondary">
                                Offline
                            </span>

                            break;
                    }

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 3 — MANUFACTURER INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-industry me-1"></i>

            Manufacturer Information

        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Manufacturer
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.Manufacturer)
                        ? "-"
                        : Model.Manufacturer)
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Model
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.Model)
                        ? "-"
                        : Model.Model)
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Serial Number
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.SerialNumber)
                        ? "-"
                        : Model.SerialNumber)
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — CAPACITY AND LOCATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-ruler-combined me-1"></i>

            Capacity & Location

        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Capacity
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.Capacity)
                        ? "-"
                        : Model.Capacity)
                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="text-muted small mb-1">
                    Location
                </div>

                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.Location)
                        ? "-"
                        : Model.Location)
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 5 — REMARKS
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-note-sticky me-1"></i>

            Remarks

        </span>

    </div>


    <div class="card-body">

        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <div style="white-space: pre-wrap;">
                @Model.Remarks
            </div>
        }
        else
        {
            <span class="text-muted">
                No remarks.
            </span>
        }

    </div>

</div>


<!-- =========================================================
     REGION 6 — FUTURE PRODUCTION USAGE
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-diagram-project me-1"></i>

            Production Usage

        </span>

    </div>


    <div class="card-body">

        <div class="text-muted">

            Machine allocation, Production Jobs and Machine
            usage history will appear here after the Production
            module is implemented.

        </div>

    </div>

</div>