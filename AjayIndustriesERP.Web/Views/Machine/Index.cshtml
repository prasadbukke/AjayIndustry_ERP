@*
    ============================================================
    File: Index.cshtml

    Purpose:
    Displays active Machine Master records.

    Responsibilities:
    - Display non-deleted Machines only.
    - Provide shared Search.
    - Provide shared Pagination.
    - Display Machine operational Status.
    - Provide Details and Edit actions.
    - Provide soft-delete action.
    - Provide navigation to Deleted Machines.

    Important:
    - Deleted Machines do NOT appear on this page.
    - Deleted Machines are displayed in Deleted.cshtml.
    - Delete uses the existing global confirmDelete() function.
    - No module-specific Delete Modal or JavaScript is used.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.Machine>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] = "Machine Management";

    var pageNumber =
        (int)ViewBag.PageNumber;

    var pageSize =
        (int)ViewBag.PageSize;

    var totalRecords =
        (int)ViewBag.TotalRecords;

    var serialNumber =
        ((pageNumber - 1) * pageSize) + 1;
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Machine Management
        </h2>

        <p class="text-muted mb-0">
            Manage production Machines and their operational status.
        </p>

    </div>


    <div class="d-flex
                gap-2
                flex-wrap">

        <a asp-action="Deleted"
           class="btn btn-outline-secondary">

            <i class="fa-solid
                      fa-trash-can-arrow-up
                      me-1">
            </i>

            Deleted Machines

        </a>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus me-1"></i>
            Add Machine

        </a>

    </div>

</div>


<!-- =========================================================
     REGION 2 — SEARCH
========================================================== -->

<partial name="Components/_SearchBar"
         model='@(ViewBag.SearchText as string ?? "")' />


<!-- =========================================================
     REGION 3 — MACHINE TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0"
                   style="min-width: 1100px;">

                <thead class="table-light">

                    <tr>

                        <th style="width:55px;"
                            class="text-nowrap">
                            #
                        </th>


                        <th class="text-nowrap">
                            Machine Code
                        </th>


                        <th style="min-width:180px;">
                            Machine Name
                        </th>


                        <th class="text-nowrap">
                            Machine Type
                        </th>


                        <th class="text-nowrap">
                            Manufacturer
                        </th>


                        <th class="text-nowrap">
                            Model
                        </th>


                        <th class="text-nowrap">
                            Location
                        </th>


                        <th class="text-center text-nowrap">
                            Status
                        </th>


                        <th class="text-center"
                            style="min-width:150px;">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                         Model.Any())
                    {
                        @foreach (var machine in Model)
                        {
                            <tr>

                                <!-- =============================
                                     SERIAL NUMBER
                                ============================== -->

                                <td>
                                    @serialNumber
                                </td>


                                <!-- =============================
                                     MACHINE CODE
                                ============================== -->

                                <td class="text-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@machine.Id"
                                       class="fw-semibold
                                              text-decoration-none">

                                        @machine.Code

                                    </a>

                                </td>


                                <!-- =============================
                                     MACHINE NAME
                                ============================== -->

                                <td class="fw-semibold">
                                    @machine.MachineName
                                </td>


                                <!-- =============================
                                     MACHINE TYPE
                                ============================== -->

                                <td>
                                    @machine.MachineType
                                </td>


                                <!-- =============================
                                     MANUFACTURER
                                ============================== -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        machine.Manufacturer)
                                        ? "-"
                                        : machine.Manufacturer)

                                </td>


                                <!-- =============================
                                     MODEL
                                ============================== -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        machine.Model)
                                        ? "-"
                                        : machine.Model)

                                </td>


                                <!-- =============================
                                     LOCATION
                                ============================== -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        machine.Location)
                                        ? "-"
                                        : machine.Location)

                                </td>


                                <!-- =============================
                                     MACHINE STATUS
                                ============================== -->

                                <td class="text-center">

                                    @switch (machine.Status)
                                    {
                                        case MachineStatus.Available:

                                            <span class="badge bg-success">
                                                Available
                                            </span>

                                            break;


                                        case MachineStatus.Running:

                                            <span class="badge bg-primary">
                                                Running
                                            </span>

                                            break;


                                        case MachineStatus.Breakdown:

                                            <span class="badge bg-danger">
                                                Breakdown
                                            </span>

                                            break;


                                        case MachineStatus.Maintenance:

                                            <span class="badge
                                                         bg-warning
                                                         text-dark">

                                                Maintenance

                                            </span>

                                            break;


                                        case MachineStatus.Offline:

                                            <span class="badge bg-secondary">
                                                Offline
                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- =============================
                                     ACTIONS
                                ============================== -->

                                <td class="text-center">

                                    <div class="d-flex
                                                justify-content-center
                                                align-items-center
                                                gap-1">


                                        <!-- DETAILS -->

                                        <a asp-action="Details"
                                           asp-route-id="@machine.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-info"
                                           title="View Machine">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>


                                        <!-- EDIT -->

                                        <a asp-action="Edit"
                                           asp-route-id="@machine.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-warning"
                                           title="Edit Machine">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>


                                        <!-- DELETE -->

                                        <button type="button"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-danger"
                                                title="Delete Machine"
                                                onclick="confirmDelete(
                                                    '@Url.Action(
                                                        "Delete",
                                                        "Machine",
                                                        new
                                                        {
                                                            id = machine.Id
                                                        })')">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <!-- =============================
                             EMPTY STATE
                        ============================== -->

                        <tr>

                            <td colspan="9"
                                class="text-center
                                       py-5">

                                <div class="text-muted">

                                    <i class="fa-solid
                                              fa-gears
                                              fa-2x
                                              mb-3">
                                    </i>


                                    <div class="fw-semibold mb-1">

                                        No Machines Found

                                    </div>


                                    <div class="small">

                                        Add a Machine or change your search.

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — PAGINATION
========================================================== -->

@if (totalRecords > 0)
{
    <div class="mt-3">

        <partial name="Components/_Pagination"
                 model='(
                     (int)ViewBag.PageNumber,
                     (int)ViewBag.PageSize
                 )' />

    </div>
}