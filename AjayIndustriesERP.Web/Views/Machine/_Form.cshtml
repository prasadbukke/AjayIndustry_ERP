@*
    ============================================================
    File: _Form.cshtml

    Purpose:
    Reusable Machine Master form used by Create and Edit pages.

    Responsibilities:
    - Display Machine identity information.
    - Display manufacturer / model / serial information.
    - Display capacity and location information.
    - Display manually maintained Machine Status.
    - Display remarks.
    - Provide field-level validation messages.

    Important:
    - This partial DOES NOT contain a <form> element.
    - Create.cshtml and Edit.cshtml own the actual <form>.
    - Machine Code is system generated and read-only.
    - Machine Status is manually maintained by ERP users.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.Machine.MachineFormViewModel

@using AjayIndustriesERP.Domain.Enums

@{
    var isEditMode = Model.Id > 0;
}


<!-- =========================================================
     REGION 1 — MACHINE INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-gears me-1"></i>

            Machine Information

        </span>

    </div>


    <div class="card-body">

        <div class="row g-3">


            <!-- =============================================
                 MACHINE CODE
            ============================================== -->
            @if (isEditMode)
            {
                <div class="col-lg-4 col-md-6">

                    <label asp-for="Code"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Code"
                           class="form-control"
                           readonly />

                    <div class="form-text">
                        System generated Machine Code.
                    </div>

                </div>
            }


            <!-- =============================================
                 MACHINE NAME
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="MachineName"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="MachineName"
                       class="form-control"
                       maxlength="200"
                       autocomplete="off"
                       placeholder="Example: CNC-01" />

                <span asp-validation-for="MachineName"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 MACHINE TYPE
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="MachineType"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <input asp-for="MachineType"
                       class="form-control"
                       maxlength="100"
                       autocomplete="off"
                       placeholder="Example: CNC / VMC / Lathe" />

                <span asp-validation-for="MachineType"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 MACHINE STATUS
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="Status"
                       class="form-label fw-semibold">
                </label>

                <span class="text-danger">*</span>

                <select asp-for="Status"
                        asp-items="Html.GetEnumSelectList<MachineStatus>()"
                        class="form-select">
                </select>

                <span asp-validation-for="Status"
                      class="text-danger small">
                </span>

                <div class="form-text">
                    Manually maintained operational status.
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 2 — MANUFACTURER INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-industry me-1"></i>

            Manufacturer Information

        </span>

    </div>


    <div class="card-body">

        <div class="row g-3">


            <!-- =============================================
                 MANUFACTURER
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="Manufacturer"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="Manufacturer"
                       class="form-control"
                       maxlength="150"
                       placeholder="Enter manufacturer" />

                <span asp-validation-for="Manufacturer"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 MODEL
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="Model"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="Model"
                       class="form-control"
                       maxlength="150"
                       placeholder="Enter model" />

                <span asp-validation-for="Model"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 SERIAL NUMBER
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="SerialNumber"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="SerialNumber"
                       class="form-control text-uppercase"
                       maxlength="100"
                       placeholder="Enter serial number" />

                <span asp-validation-for="SerialNumber"
                      class="text-danger small">
                </span>

                <div class="form-text">
                    Optional. Must be unique when provided.
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 3 — CAPACITY AND LOCATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-ruler-combined me-1"></i>

            Capacity & Location

        </span>

    </div>


    <div class="card-body">

        <div class="row g-3">


            <!-- =============================================
                 CAPACITY
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="Capacity"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="Capacity"
                       class="form-control"
                       maxlength="250"
                       placeholder="Example: 500 mm Dia" />

                <span asp-validation-for="Capacity"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 LOCATION
            ============================================== -->

            <div class="col-lg-4 col-md-6">

                <label asp-for="Location"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="Location"
                       class="form-control"
                       maxlength="150"
                       placeholder="Example: CNC Section / Bay 2" />

                <span asp-validation-for="Location"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — REMARKS
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-note-sticky me-1"></i>

            Remarks

        </span>

    </div>


    <div class="card-body">

        <div class="row g-3">

            <div class="col-12">

                <label asp-for="Remarks"
                       class="form-label fw-semibold">
                </label>

                <textarea asp-for="Remarks"
                          class="form-control"
                          rows="3"
                          maxlength="1000"
                          placeholder="Enter remarks"></textarea>

                <span asp-validation-for="Remarks"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>