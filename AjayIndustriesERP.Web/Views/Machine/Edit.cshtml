@*
    ============================================================
    File: Edit.cshtml

    Purpose:
    Edits an existing Machine Master record.

    Responsibilities:
    - Own the Edit form.
    - Preserve Machine Id.
    - Render reusable Machine form fields.
    - Submit MachineFormViewModel correctly.
    - Enable client-side validation.

    Important:
    Machine Code remains read-only.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.Machine.MachineFormViewModel

@{
    ViewData["Title"] = "Edit Machine";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Edit Machine
        </h2>

        <p class="text-muted mb-0">
            @Model.Code
        </p>

    </div>


    <a asp-controller="Machine"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>
        Back

    </a>

</div>


<!-- =========================================================
     REGION 2 — EDIT FORM
========================================================== -->

<form asp-controller="Machine"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      id="machineForm">

    @Html.AntiForgeryToken()


    <input asp-for="Id"
           type="hidden" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <partial name="_Form"
             model="@Model" />


    <!-- =====================================================
         REGION 3 — ACTIONS
    ====================================================== -->

    <div class="d-flex
                justify-content-end
                gap-2
                mb-4">

        <a asp-controller="Machine"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-warning">

            <i class="fa-solid fa-floppy-disk me-1"></i>

            Update Machine

        </button>

    </div>

</form>


<!-- =========================================================
     REGION 4 — VALIDATION SCRIPTS
========================================================== -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}