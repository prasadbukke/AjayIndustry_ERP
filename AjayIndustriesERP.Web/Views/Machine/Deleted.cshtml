@*
    ============================================================
    File: Deleted.cshtml

    Purpose:
    Displays soft-deleted Machine Master records.

    Responsibilities:
    - Display deleted Machines separately from main Index.
    - Display original Machine operational Status.
    - Allow deleted Machines to be restored.
    - Preserve original Machine Code and Machine Status.

    Important:
    - Restore does not create a new Machine.
    - Original Machine record is reactivated.
    - Serial Number duplicate validation occurs in MachineService.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.Machine>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] = "Deleted Machines";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Machines
        </h2>

        <p class="text-muted mb-0">
            Restore previously deleted Machine Master records.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>
        Back to Machines

    </a>

</div>


<!-- =========================================================
     REGION 2 — DELETED MACHINE TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0"
                   style="min-width: 950px;">

                <thead class="table-light">

                    <tr>

                        <th style="width:55px;">
                            #
                        </th>


                        <th class="text-nowrap">
                            Machine Code
                        </th>


                        <th>
                            Machine Name
                        </th>


                        <th>
                            Machine Type
                        </th>


                        <th>
                            Manufacturer
                        </th>


                        <th>
                            Location
                        </th>


                        <th class="text-center">
                            Previous Status
                        </th>


                        <th class="text-center"
                            style="width:130px;">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                         Model.Any())
                    {
                        var serialNumber = 1;


                        @foreach (var machine in Model)
                        {
                            <tr>

                                <td>
                                    @serialNumber
                                </td>


                                <td class="fw-semibold
                                           text-nowrap">

                                    @machine.Code

                                </td>


                                <td>
                                    @machine.MachineName
                                </td>


                                <td>
                                    @machine.MachineType
                                </td>


                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        machine.Manufacturer)
                                        ? "-"
                                        : machine.Manufacturer)

                                </td>


                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        machine.Location)
                                        ? "-"
                                        : machine.Location)

                                </td>


                                <!-- =============================
                                     ORIGINAL MACHINE STATUS
                                ============================== -->

                                <td class="text-center">

                                    @switch (machine.Status)
                                    {
                                        case MachineStatus.Available:

                                            <span class="badge bg-success">
                                                Available
                                            </span>

                                            break;


                                        case MachineStatus.Running:

                                            <span class="badge bg-primary">
                                                Running
                                            </span>

                                            break;


                                        case MachineStatus.Breakdown:

                                            <span class="badge bg-danger">
                                                Breakdown
                                            </span>

                                            break;


                                        case MachineStatus.Maintenance:

                                            <span class="badge
                                                         bg-warning
                                                         text-dark">

                                                Maintenance

                                            </span>

                                            break;


                                        case MachineStatus.Offline:

                                            <span class="badge bg-secondary">
                                                Offline
                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- =============================
                                     RESTORE
                                ============================== -->

                                <td class="text-center">

                                    <form asp-action="Restore"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="id"
                                               value="@machine.Id" />


                                        <button type="submit"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-success"
                                                title="Restore Machine">

                                            <i class="fa-solid
                                                      fa-rotate-left
                                                      me-1">
                                            </i>

                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <!-- =============================
                             EMPTY STATE
                        ============================== -->

                        <tr>

                            <td colspan="8"
                                class="text-center
                                       py-5">

                                <div class="text-muted">

                                    <i class="fa-solid
                                              fa-trash-can
                                              fa-2x
                                              mb-3">
                                    </i>


                                    <div class="fw-semibold mb-1">

                                        No Deleted Machines

                                    </div>


                                    <div class="small">

                                        Deleted Machines will appear here.

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>