@*
    ============================================================
    File: _Form.cshtml
    Module: Inventory / Stock Management

    Purpose:
    Shared Stock Setting Create / Edit form.

    Important:
    - Item + Warehouse cannot be changed after creation.
    - No inline JavaScript or CSS.
    - Final validation remains in InventoryService.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.Inventory.StockSettingCreateViewModel


<input asp-for="Id"
       type="hidden" />


<!-- =========================================================
     ITEM / WAREHOUSE
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">

        <h5 class="fw-bold mb-0">

            <i class="fa-solid fa-boxes-stacked me-2"></i>

            Stock Setting

        </h5>

    </div>


    <div class="card-body">

        <div class="row g-3">


            <!-- ITEM -->

            <div class="col-md-6">

                <label asp-for="ItemId"
                       class="form-label fw-semibold">
                </label>


                @if (Model.Id > 0)
                {
                    <select asp-for="ItemId"
                            asp-items="ViewBag.Items"
                            class="form-select bg-light"
                            disabled>
                    </select>


                    <input asp-for="ItemId"
                           id="stockSettingItemIdHidden"
                           type="hidden" />


                    <div class="form-text">
                        Item cannot be changed after creation.
                    </div>
                }
                else
                {
                    <select asp-for="ItemId"
                            asp-items="ViewBag.Items"
                            class="form-select">

                        <option value="">
                            -- Select Item --
                        </option>

                    </select>
                }


                <span asp-validation-for="ItemId"
                      class="text-danger small">
                </span>

            </div>


            <!-- WAREHOUSE -->

            <div class="col-md-6">

                <label asp-for="WarehouseId"
                       class="form-label fw-semibold">
                </label>


                @if (Model.Id > 0)
                {
                    <select asp-for="WarehouseId"
                            asp-items="ViewBag.Warehouses"
                            class="form-select bg-light"
                            disabled>
                    </select>


                    <input asp-for="WarehouseId"
                           id="stockSettingWarehouseIdHidden"
                           type="hidden" />


                    <div class="form-text">
                        Warehouse cannot be changed after creation.
                    </div>
                }
                else
                {
                    <select asp-for="WarehouseId"
                            asp-items="ViewBag.Warehouses"
                            class="form-select">

                        <option value="">
                            -- Select Warehouse --
                        </option>

                    </select>
                }


                <span asp-validation-for="WarehouseId"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     STOCK LEVELS
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">

        <h5 class="fw-bold mb-0">

            <i class="fa-solid fa-sliders me-2"></i>

            Stock Levels

        </h5>

    </div>


    <div class="card-body">

        <div class="row g-3">


            <!-- MINIMUM -->

            <div class="col-lg-3 col-md-6">

                <label asp-for="MinimumStock"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="MinimumStock"
                       type="number"
                       min="0"
                       step="0.001"
                       class="form-control" />

                <span asp-validation-for="MinimumStock"
                      class="text-danger small">
                </span>

            </div>


            <!-- REORDER LEVEL -->

            <div class="col-lg-3 col-md-6">

                <label asp-for="ReorderLevel"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="ReorderLevel"
                       type="number"
                       min="0"
                       step="0.001"
                       class="form-control" />

                <span asp-validation-for="ReorderLevel"
                      class="text-danger small">
                </span>

            </div>


            <!-- MAXIMUM -->

            <div class="col-lg-3 col-md-6">

                <label asp-for="MaximumStock"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="MaximumStock"
                       type="number"
                       min="0"
                       step="0.001"
                       class="form-control" />

                <span asp-validation-for="MaximumStock"
                      class="text-danger small">
                </span>

            </div>


            <!-- REORDER QUANTITY -->

            <div class="col-lg-3 col-md-6">

                <label asp-for="ReorderQuantity"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="ReorderQuantity"
                       type="number"
                       min="0.001"
                       step="0.001"
                       class="form-control" />

                <span asp-validation-for="ReorderQuantity"
                      class="text-danger small">
                </span>

            </div>

        </div>


        <div class="alert alert-light border mt-4 mb-0">

            <div class="small text-muted">

                Stock level rule:

                <strong>
                    Minimum Stock ≤ Reorder Level ≤ Maximum Stock
                </strong>

                and Reorder Quantity must be greater than zero.

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     ACTIONS
========================================================== -->

<div class="d-flex justify-content-end gap-2 mb-4">

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-xmark me-1"></i>

        Cancel

    </a>


    @if (Model.Id > 0)
    {
        <button type="submit"
                class="btn btn-primary">

            <i class="fa-solid fa-floppy-disk me-1"></i>

            Update Stock Setting

        </button>
    }
    else
    {
        <button type="submit"
                class="btn btn-primary">

            <i class="fa-solid fa-floppy-disk me-1"></i>

            Save Stock Setting

        </button>
    }

</div>