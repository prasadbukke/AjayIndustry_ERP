@*
    ============================================================
    File: Create.cshtml
    Module: Inventory / Stock Management
    Purpose: Create Item + Warehouse Stock Setting.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.Inventory.StockSettingCreateViewModel

@{
    ViewData["Title"] = "Create Stock Setting";
}


<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Create Stock Setting
        </h2>

        <p class="text-muted mb-0">
            Configure minimum, reorder and maximum stock levels.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back

    </a>

</div>


<form asp-action="Create"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <partial name="_Form"
             model="Model" />

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}