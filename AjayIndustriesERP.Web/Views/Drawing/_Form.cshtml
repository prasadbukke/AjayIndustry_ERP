@model AjayIndustriesERP.Web.ViewModels.Drawing.DrawingViewModel

@*
==============================================================

File : _Form.cshtml

Purpose :
Common Create/Edit form for Drawing Master.

Rules :
- One Item = One Drawing Number
- Drawing Number is permanent
- Revision Number is system generated
- New Drawing starts from RV-01
- New revisions automatically receive next RV number
- Deleted Revision Numbers are never reused
- Existing revisions are read-only
- Previous revisions can be Activated or Soft Deleted

==============================================================
*@

@{
    var isEdit =
        Model.DrawingId > 0;

    var selectedItemText =
        Model.Items
            .FirstOrDefault(x =>
                x.Value ==
                Model.ItemId.ToString())
            ?.Text;

    var hasNumberSuggestions =
        Model.SimilarDrawingNumbers.Any();

    var hasNameSuggestions =
        Model.SimilarDrawingNames.Any();

    var drawingNumberErrors =
        ViewData.ModelState["DrawingNumber"]?
            .Errors
            .Select(x => x.ErrorMessage)
            .ToList()
        ?? new List<string>();

    var hasExactNumberError =
        drawingNumberErrors.Any(x =>
            x.Contains(
                "already exists",
                StringComparison.OrdinalIgnoreCase));
}

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger"></div>

<input asp-for="DrawingId"
       type="hidden" />

<!-- =========================================================
     DRAWING INFORMATION
========================================================== -->

<div class="card border mb-4">

    <div class="card-header bg-light">

        <div class="fw-semibold">
            Drawing Information
        </div>

    </div>

    <div class="card-body">

        <div class="row">

            <!-- Item -->

            <div class="col-12 mb-3">

                <label asp-for="ItemId"
                       class="form-label"></label>

                @if (!isEdit)
                {
                    <select asp-for="ItemId"
                            asp-items="Model.Items"
                            class="form-select js-drawing-item-select">

                        <option value="">
                            -- Select Item --
                        </option>

                    </select>

                    <div class="form-text">
                        One Item can have only one Drawing Number.
                    </div>
                }
                else
                {
                    <input asp-for="ItemId"
                           type="hidden" />

                    <input type="text"
                           value="@selectedItemText"
                           class="form-control"
                           readonly />

                    <div class="form-text">
                        Item cannot be changed after Drawing creation.
                    </div>
                }

                <span asp-validation-for="ItemId"
                      class="text-danger"></span>

            </div>

            <!-- Drawing Number -->

            <div class="col-md-6 mb-3">

                <label asp-for="DrawingNumber"
                       class="form-label"></label>

                @if (!isEdit)
                {
                    <input asp-for="DrawingNumber"
                           class="form-control text-uppercase"
                           maxlength="100"
                           autocomplete="off"
                           placeholder="Example: DRG-10025"
                           data-number-similar-url="@Url.Action(
                               "CheckSimilarNumber",
                               "Drawing")" />

                    <div class="form-text">
                        Permanent Drawing Number.
                        It cannot be changed after creation.
                    </div>
                }
                else
                {
                    <input asp-for="DrawingNumber"
                           type="hidden" />

                    <input type="text"
                           value="@Model.DrawingNumber"
                           class="form-control fw-semibold"
                           readonly />

                    <div class="form-text">
                        Drawing Number is permanent.
                    </div>
                }

                <span asp-validation-for="DrawingNumber"
                      class="text-danger"></span>

            </div>

            <!-- Drawing Name -->

            <div class="col-md-6 mb-3">

                <label asp-for="DrawingName"
                       class="form-label"></label>

                <input asp-for="DrawingName"
                       class="form-control"
                       maxlength="200"
                       autocomplete="off"
                       placeholder="Example: Main Shaft Drawing"
                       data-name-similar-url="@Url.Action(
                           "CheckSimilarName",
                           "Drawing")" />

                <span asp-validation-for="DrawingName"
                      class="text-danger"></span>

            </div>

            <!-- Drawing Type -->

            <div class="col-md-6 mb-3">

                <label asp-for="DrawingType"
                       class="form-label"></label>

                <input asp-for="DrawingType"
                       class="form-control"
                       maxlength="100"
                       autocomplete="off"
                       placeholder="Manufacturing / Inspection / Customer" />

                <span asp-validation-for="DrawingType"
                      class="text-danger"></span>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     DRAWING NUMBER WARNING
========================================================== -->

@if (!isEdit)
{
    <div id="drawingNumberWarning"
         class="alert alert-warning
                @(!hasNumberSuggestions
                    ? "d-none"
                    : string.Empty)">

        <div class="fw-semibold mb-2">

            <i class="fa-solid fa-triangle-exclamation me-1"></i>

            Similar Drawing Numbers Found

        </div>

        <div class="small mb-2">
            If this Drawing already exists,
            open it and add a Revision.
        </div>

        <div id="drawingNumberSuggestionList"
             class="list-group mb-2">

            @foreach (var drawing
                in Model.SimilarDrawingNumbers)
            {
                <div class="list-group-item">
                    @drawing
                </div>
            }

        </div>

        <div id="drawingNumberExactMessage"
             class="text-danger fw-semibold
                    @(!hasExactNumberError
                        ? "d-none"
                        : string.Empty)">

            This Drawing Number already exists.
            Open the existing Drawing and add a new Revision.

        </div>

    </div>
}

<!-- =========================================================
     DRAWING NAME WARNING
========================================================== -->

<div id="drawingNameWarning"
     class="alert alert-warning
            @(!hasNameSuggestions
                ? "d-none"
                : string.Empty)">

    <div class="fw-semibold mb-2">

        <i class="fa-solid fa-spell-check me-1"></i>

        Similar Drawing Names Found

    </div>

    <div class="small mb-2">
        Check whether this is the same Drawing
        or only a similar name.
    </div>

    <div id="drawingNameSuggestionList"
         class="list-group">

        @foreach (var drawing
            in Model.SimilarDrawingNames)
        {
            <div class="list-group-item">
                @drawing
            </div>
        }

    </div>

</div>

<!-- =========================================================
     CREATE - FIRST REVISION
========================================================== -->

@if (!isEdit)
{
    <div class="card border mb-4">

        <div class="card-header bg-light">

            <div class="fw-semibold">
                First Revision
            </div>

        </div>

        <div class="card-body">

            <div class="alert alert-light border">

                <div class="small text-muted">
                    Revision Number
                </div>

                <div class="fw-bold fs-5">
                    RV-01
                </div>

                <div class="small text-muted mt-1">
                    Automatically generated by the system.
                </div>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="DrawingFile"
                           class="form-label"></label>

                    <input asp-for="DrawingFile"
                           type="file"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png,.dwg,.dxf" />

                    <span asp-validation-for="DrawingFile"
                          class="text-danger"></span>

                    <div id="drawingSelectedFileName"
                         class="small text-muted mt-1">
                    </div>

                    <div class="form-text">
                        PDF, JPG, JPEG, PNG, DWG, DXF.
                        Maximum 25 MB.
                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Description"
                           class="form-label"></label>

                    <textarea asp-for="Description"
                              rows="3"
                              maxlength="500"
                              class="form-control"
                              placeholder="Optional revision remarks"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>

                </div>

            </div>

        </div>

    </div>
}

<!-- =========================================================
     EDIT - REVISION HISTORY
========================================================== -->

@if (isEdit)
{
    <div class="card border mb-4">

        <div class="card-header bg-light
                    d-flex
                    justify-content-between
                    align-items-center">

            <div>

                <div class="fw-semibold">
                    Revision History
                </div>

                <div class="small text-muted">
                    Revision Numbers are automatically generated.
                </div>

            </div>

            <button type="button"
                    id="addDrawingRevisionButton"
                    class="btn btn-sm btn-primary">

                <i class="fa-solid fa-plus me-1"></i>

                Add Revision

            </button>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover
                              align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Revision</th>
                            <th>File</th>
                            <th>Remarks</th>
                            <th>Status</th>
                            <th>Created On</th>
                            <th>Created By</th>

                            <th class="text-center"
                                style="min-width:190px;">
                                Actions
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.RevisionHistory.Any())
                        {
                            foreach (var revision
                                in Model.RevisionHistory)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @revision.RevisionNumber
                                    </td>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            revision.FilePath))
                                        {
                                            <a href="@revision.FilePath"
                                               target="_blank"
                                               rel="noopener"
                                               class="btn btn-sm
                                                      btn-outline-primary">

                                                <i class="fa-solid fa-file me-1"></i>

                                                @(revision.FileName
                                                    ?? "View File")

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No File
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            revision.Description)
                                            ? "-"
                                            : revision.Description)

                                    </td>

                                    <td>

                                        @if (revision.IsCurrent)
                                        {
                                            <span class="badge bg-success">
                                                Current
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @(
                                            revision.CreatedOn
                                                .ToLocalTime()
                                                .ToString(
                                                    "dd-MMM-yyyy hh:mm tt")
                                        )

                                    </td>

                                    <td>
                                        @revision.CreatedBy
                                    </td>

                                    <td class="text-center">

                                        @if (!revision.IsCurrent)
                                        {
                                            <div class="d-flex
                                                        justify-content-center
                                                        gap-1
                                                        flex-wrap">

                                                <!-- Activate -->

                                                <button type="submit"
                                                        class="btn btn-sm
                                                               btn-outline-success"
                                                        formaction="@Url.Action(
                                                            "ActivateRevision",
                                                            "Drawing",
                                                            new
                                                            {
                                                                id = revision.DrawingId,
                                                                returnAction = "Edit"
                                                            })"
                                                        formmethod="post"
                                                        formnovalidate
                                                        onclick="return confirm(
                                                            'Make revision @revision.RevisionNumber the Current revision?');">

                                                    <i class="fa-solid fa-check me-1"></i>

                                                    Activate

                                                </button>

                                                <!-- Delete -->

                                                <button type="submit"
                                                        class="btn btn-sm
                                                               btn-outline-danger"
                                                        formaction="@Url.Action(
                                                            "DeleteRevision",
                                                            "Drawing",
                                                            new
                                                            {
                                                                id = revision.DrawingId,
                                                                drawingId = Model.DrawingId,
                                                                returnAction = "Edit"
                                                            })"
                                                        formmethod="post"
                                                        formnovalidate
                                                        onclick="return confirm(
                                                            'Delete revision @revision.RevisionNumber?');">

                                                    <i class="fa-solid fa-trash"></i>

                                                </button>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">
                                                Current Revision
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center
                                           text-muted
                                           py-4">

                                    No revision history found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- =====================================================
         NEW REVISIONS
    ====================================================== -->

    <div id="newDrawingRevisionsSection"
         class="card border mb-4
                @(Model.NewRevisions.Any()
                    ? string.Empty
                    : "d-none")">

        <div class="card-header bg-light">

            <div class="fw-semibold">
                New Revisions
            </div>

            <div class="small text-muted">
                Revision Number will be generated automatically
                when the Drawing is saved.
            </div>

        </div>

        <div class="card-body">

            <div id="newDrawingRevisionsContainer">

                @for (var index = 0;
                      index < Model.NewRevisions.Count;
                      index++)
                {
                    var revision =
                        Model.NewRevisions[index];

                    var key =
                        index.ToString();

                    <div class="drawing-revision-row
                                border
                                rounded
                                p-3
                                mb-3"
                         data-revision-row>

                        <input type="hidden"
                               name="NewRevisions.Index"
                               value="@key" />

                        <div class="row">

                            <div class="col-md-2 mb-3">

                                <label class="form-label">
                                    Revision
                                </label>

                                <div class="form-control
                                            bg-light
                                            fw-semibold">

                                    Auto

                                </div>

                            </div>

                            <div class="col-md-5 mb-3">

                                <label class="form-label">
                                    Drawing File
                                </label>

                                <input type="file"
                                       name="NewRevisions[@key].DrawingFile"
                                       class="form-control
                                              js-revision-file"
                                       accept=".pdf,.jpg,.jpeg,.png,.dwg,.dxf" />

                                <div class="small
                                            text-muted
                                            mt-1
                                            js-revision-file-name">
                                </div>

                            </div>

                            <div class="col-md-4 mb-3">

                                <label class="form-label">
                                    Remarks
                                </label>

                                <input type="text"
                                       name="NewRevisions[@key].Description"
                                       value="@revision.Description"
                                       class="form-control"
                                       maxlength="500"
                                       placeholder="Optional remarks" />

                            </div>

                            <div class="col-md-1 mb-3
                                        d-flex
                                        align-items-end">

                                <button type="button"
                                        class="btn
                                               btn-outline-danger
                                               js-remove-revision">

                                    <i class="fa-solid fa-trash"></i>

                                </button>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

    <!-- Dynamic Template -->

    <template id="drawingRevisionRowTemplate">

        <div class="drawing-revision-row
                    border
                    rounded
                    p-3
                    mb-3"
             data-revision-row>

            <input type="hidden"
                   name="NewRevisions.Index"
                   value="__key__" />

            <div class="row">

                <div class="col-md-2 mb-3">

                    <label class="form-label">
                        Revision
                    </label>

                    <div class="form-control
                                bg-light
                                fw-semibold">

                        Auto

                    </div>

                </div>

                <div class="col-md-5 mb-3">

                    <label class="form-label">
                        Drawing File
                    </label>

                    <input type="file"
                           name="NewRevisions[__key__].DrawingFile"
                           class="form-control
                                  js-revision-file"
                           accept=".pdf,.jpg,.jpeg,.png,.dwg,.dxf" />

                    <div class="small
                                text-muted
                                mt-1
                                js-revision-file-name">
                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Remarks
                    </label>

                    <input type="text"
                           name="NewRevisions[__key__].Description"
                           class="form-control"
                           maxlength="500"
                           placeholder="Optional remarks" />

                </div>

                <div class="col-md-1 mb-3
                            d-flex
                            align-items-end">

                    <button type="button"
                            class="btn
                                   btn-outline-danger
                                   js-remove-revision">

                        <i class="fa-solid fa-trash"></i>

                    </button>

                </div>

            </div>

        </div>

    </template>
}

<hr />

<div class="d-flex justify-content-end gap-2">

    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>

    <button type="submit"
            id="drawingSaveButton"
            class="btn btn-primary">

        <i class="fa-solid fa-floppy-disk me-1"></i>

        @(isEdit
            ? "Update Drawing"
            : "Save Drawing")

    </button>

</div>