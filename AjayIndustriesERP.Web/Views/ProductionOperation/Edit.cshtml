@*
    ============================================================
    File: Edit.cshtml

    Purpose:
    Edits an existing Production Operation Master record.

    Responsibilities:
    - Own the Edit form.
    - Preserve Production Operation Id.
    - Render reusable Production Operation _Form partial.
    - Display Update and Cancel actions.
    - Enable client-side validation.

    Important:
    - Operation Code is immutable after creation.
    - Setup Time / Cycle Time / Machine assignment are handled
      outside Operation Master.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.ProductionOperation.ProductionOperationFormViewModel

@{
    ViewData["Title"] =
        "Edit Production Operation";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Edit Production Operation
        </h2>

        <p class="text-muted mb-0">
            @Model.Code
        </p>

    </div>


    <a asp-controller="ProductionOperation"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back

    </a>

</div>


<!-- =========================================================
     REGION 2 — EDIT FORM
========================================================== -->

<form asp-controller="ProductionOperation"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      id="productionOperationForm">

    @Html.AntiForgeryToken()


    <input asp-for="Id"
           type="hidden" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <partial name="_Form"
             model="@Model" />


    <!-- =====================================================
         REGION 3 — FORM ACTIONS
    ====================================================== -->

    <div class="d-flex
                justify-content-end
                gap-2
                mb-4">

        <a asp-controller="ProductionOperation"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-warning">

            <i class="fa-solid
                      fa-floppy-disk
                      me-1">
            </i>

            Update Operation

        </button>

    </div>

</form>


<!-- =========================================================
     REGION 4 — VALIDATION
========================================================== -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}