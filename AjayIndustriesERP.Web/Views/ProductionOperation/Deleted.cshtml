@*
    ============================================================
    File: Deleted.cshtml

    Purpose:
    Displays soft-deleted Production Operation records.

    Responsibilities:
    - Keep deleted Operations separate from main Index.
    - Display original Operation information.
    - Allow deleted Operations to be restored.

    Important:
    - Restore does not create a new Operation.
    - Original Operation Code is preserved.
    - Restore is blocked by Application Service if another
      active Operation already uses the same Operation Name.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.ProductionOperation>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] =
        "Deleted Production Operations";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Production Operations
        </h2>

        <p class="text-muted mb-0">
            Restore previously deleted Production Operations.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back to Operations

    </a>

</div>


<!-- =========================================================
     REGION 2 — DELETED OPERATION TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0"
                   style="min-width: 850px;">

                <thead class="table-light">

                    <tr>

                        <th style="width:55px;">
                            #
                        </th>


                        <th class="text-nowrap">
                            Operation Code
                        </th>


                        <th>
                            Operation Name
                        </th>


                        <th class="text-center">
                            Operation Type
                        </th>


                        <th>
                            Description
                        </th>


                        <th class="text-center"
                            style="width:130px;">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                         Model.Any())
                    {
                        var serialNumber = 1;


                        @foreach (var operation in Model)
                        {
                            <tr>

                                <td>
                                    @serialNumber
                                </td>


                                <td class="fw-semibold
                                           text-nowrap">

                                    @operation.Code

                                </td>


                                <td class="fw-semibold">
                                    @operation.OperationName
                                </td>


                                <td class="text-center">

                                    @switch (operation.OperationType)
                                    {
                                        case ProductionOperationType.Production:

                                            <span class="badge bg-primary">
                                                Production
                                            </span>

                                            break;


                                        case ProductionOperationType.Inspection:

                                            <span class="badge
                                                         bg-info
                                                         text-dark">

                                                Inspection

                                            </span>

                                            break;
                                    }

                                </td>


                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        operation.Description)
                                        ? "-"
                                        : operation.Description)

                                </td>


                                <td class="text-center">

                                    <form asp-action="Restore"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="id"
                                               value="@operation.Id" />


                                        <button type="submit"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-success"
                                                title="Restore Operation">

                                            <i class="fa-solid
                                                      fa-rotate-left
                                                      me-1">
                                            </i>

                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center
                                       py-5">

                                <div class="text-muted">

                                    <i class="fa-solid
                                              fa-trash-can
                                              fa-2x
                                              mb-3">
                                    </i>


                                    <div class="fw-semibold mb-1">

                                        No Deleted Operations

                                    </div>


                                    <div class="small">

                                        Deleted Operations will appear here.

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>