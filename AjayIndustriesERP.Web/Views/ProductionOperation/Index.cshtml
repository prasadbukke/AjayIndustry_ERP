@*
    ============================================================
    File: Index.cshtml

    Purpose:
    Displays active Production Operation Master records.

    Responsibilities:
    - Display non-deleted Operations only.
    - Provide shared Search.
    - Provide shared Pagination.
    - Display Operation Type.
    - Provide Details and Edit actions.
    - Provide soft-delete action.
    - Provide navigation to Deleted Operations.

    Important:
    - Deleted Operations do NOT appear on this page.
    - Deleted Operations are displayed separately.
    - Delete uses the existing global confirmDelete() function.
    - No module-specific Delete Modal or JavaScript is used.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.ProductionOperation>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] =
        "Production Operation Management";

    var pageNumber =
        (int)ViewBag.PageNumber;

    var pageSize =
        (int)ViewBag.PageSize;

    var totalRecords =
        (int)ViewBag.TotalRecords;

    var serialNumber =
        ((pageNumber - 1) * pageSize) + 1;
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Production Operations
        </h2>

        <p class="text-muted mb-0">
            Manage reusable manufacturing and inspection processes.
        </p>

    </div>


    <div class="d-flex
                gap-2
                flex-wrap">

        <a asp-action="Deleted"
           class="btn btn-outline-secondary">

            <i class="fa-solid
                      fa-trash-can-arrow-up
                      me-1">
            </i>

            Deleted Operations

        </a>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus me-1"></i>

            Add Operation

        </a>

    </div>

</div>


<!-- =========================================================
     REGION 2 — SEARCH
========================================================== -->

<partial name="Components/_SearchBar"
         model='@(ViewBag.SearchText as string ?? "")' />


<!-- =========================================================
     REGION 3 — OPERATION TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0"
                   style="min-width: 950px;">

                <thead class="table-light">

                    <tr>

                        <th style="width:55px;"
                            class="text-nowrap">
                            #
                        </th>


                        <th class="text-nowrap">
                            Operation Code
                        </th>


                        <th style="min-width:200px;">
                            Operation Name
                        </th>


                        <th class="text-center text-nowrap">
                            Operation Type
                        </th>


                        <th style="min-width:300px;">
                            Description
                        </th>


                        <th class="text-center"
                            style="min-width:150px;">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                         Model.Any())
                    {
                        @foreach (var operation in Model)
                        {
                            <tr>

                                <!-- SERIAL -->

                                <td>
                                    @serialNumber
                                </td>


                                <!-- OPERATION CODE -->

                                <td class="text-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@operation.Id"
                                       class="fw-semibold
                                              text-decoration-none">

                                        @operation.Code

                                    </a>

                                </td>


                                <!-- OPERATION NAME -->

                                <td class="fw-semibold">
                                    @operation.OperationName
                                </td>


                                <!-- OPERATION TYPE -->

                                <td class="text-center">

                                    @switch (operation.OperationType)
                                    {
                                        case ProductionOperationType.Production:

                                            <span class="badge bg-primary">
                                                Production
                                            </span>

                                            break;


                                        case ProductionOperationType.Inspection:

                                            <span class="badge
                                                         bg-info
                                                         text-dark">

                                                Inspection

                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- DESCRIPTION -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        operation.Description))
                                    {
                                        @operation.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-center">

                                    <div class="d-flex
                                                justify-content-center
                                                align-items-center
                                                gap-1">


                                        <!-- DETAILS -->

                                        <a asp-action="Details"
                                           asp-route-id="@operation.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-info"
                                           title="View Operation">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>


                                        <!-- EDIT -->

                                        <a asp-action="Edit"
                                           asp-route-id="@operation.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-warning"
                                           title="Edit Operation">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>


                                        <!-- DELETE -->

                                        <button type="button"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-danger"
                                                title="Delete Operation"
                                                onclick="confirmDelete(
                                                    '@Url.Action(
                                                        "Delete",
                                                        "ProductionOperation",
                                                        new
                                                        {
                                                            id = operation.Id
                                                        })')">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center
                                       py-5">

                                <div class="text-muted">

                                    <i class="fa-solid
                                              fa-gears
                                              fa-2x
                                              mb-3">
                                    </i>


                                    <div class="fw-semibold mb-1">

                                        No Production Operations Found

                                    </div>


                                    <div class="small">

                                        Add an Operation or change your search.

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — PAGINATION
========================================================== -->

@if (totalRecords > 0)
{
    <div class="mt-3">

        <partial name="Components/_Pagination"
                 model='(
                     (int)ViewBag.PageNumber,
                     (int)ViewBag.PageSize
                 )' />

    </div>
}