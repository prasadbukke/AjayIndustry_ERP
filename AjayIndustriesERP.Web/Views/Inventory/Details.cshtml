@*
    ============================================================
    File: Details.cshtml
    Module: Inventory / Stock Management

    Purpose:
    Displays complete read-only Stock Transaction information.

    Responsibilities:
    - Display Stock Transaction header information.
    - Display Transaction Code and Date.
    - Display Transaction Type.
    - Display Reference information when available.
    - Display Item / Warehouse stock lines.
    - Display Quantity In / Quantity Out.
    - Display optional Rate and Amount.
    - Display transaction and line-level remarks.

    Important:
    - This page is read-only.
    - Stock Transaction values displayed here are loaded from
      InventoryService / InventoryRepository.
    - No Inventory business logic exists in this View.
    ============================================================
*@

@model AjayIndustriesERP.Domain.Entities.StockTransaction

@{
    ViewData["Title"] = "Stock Transaction Details";

    var transaction = Model;
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Stock Transaction Details
        </h2>

        <p class="text-muted mb-0">
            @transaction.Code
        </p>

    </div>


    <div class="d-flex gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid
                      fa-arrow-left
                      me-1">
            </i>

            Back

        </a>

    </div>

</div>


<!-- =========================================================
     REGION 2 — TRANSACTION INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid
                      fa-boxes-stacked
                      me-1">
            </i>

            Transaction Information

        </span>

    </div>


    <div class="card-body">

        <div class="row g-4">


            <!-- TRANSACTION NUMBER -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Transaction Number
                </div>

                <div class="fw-semibold">
                    @transaction.Code
                </div>

            </div>


            <!-- TRANSACTION DATE -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Transaction Date
                </div>

                <div class="fw-semibold">
                    @transaction.TransactionDate.ToString("dd-MM-yyyy")
                </div>

            </div>


            <!-- TRANSACTION TYPE -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Transaction Type
                </div>

                <div class="fw-semibold">
                    @transaction.TransactionType
                </div>

            </div>


            <!-- REFERENCE TYPE -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Reference Type
                </div>

                <div class="fw-semibold">
                    @transaction.ReferenceType
                </div>

            </div>


            <!-- REFERENCE NUMBER -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Reference Number
                </div>

                <div class="fw-semibold">

                    @(
                                        string.IsNullOrWhiteSpace(
                                        transaction.ReferenceNumber)
                                        ? "-"
                                        : transaction.ReferenceNumber
                                        )

                </div>

            </div>


            <!-- TOTAL LINES -->

            <div class="col-lg-4 col-md-6">

                <div class="text-muted small">
                    Total Items
                </div>

                <div class="fw-semibold">
                    @transaction.Items.Count
                </div>

            </div>


        </div>

    </div>

</div>


<!-- =========================================================
     REGION 3 — STOCK ITEMS
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid
                      fa-box-open
                      me-1">
            </i>

            Stock Items

        </span>

    </div>


    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="width:50px;">
                            #
                        </th>

                        <th style="min-width:200px;">
                            Item
                        </th>

                        <th style="min-width:180px;">
                            Warehouse
                        </th>

                        <th class="text-end">
                            Quantity In
                        </th>

                        <th class="text-end">
                            Quantity Out
                        </th>

                        <th class="text-end">
                            Rate
                        </th>

                        <th class="text-end">
                            Amount
                        </th>

                        <th style="min-width:200px;">
                            Remarks
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @{
                        var itemNumber = 1;
                    }


                    @foreach (var item in transaction.Items)
                    {
                        <tr>


                            <!-- ===============================
                                 SERIAL NUMBER
                            ================================ -->

                            <td>
                                @itemNumber
                            </td>


                            <!-- ===============================
                                 ITEM
                            ================================ -->

                            <td>

                                <div class="fw-semibold">
                                    @(item.Item?.ItemName ?? "-")
                                </div>


                                @if (!string.IsNullOrWhiteSpace(
                                                            item.Item?.ItemCode))
                                {
                                    <div class="small text-muted">

                                        Code:
                                        @item.Item.ItemCode

                                    </div>
                                }

                            </td>


                            <!-- ===============================
                                 WAREHOUSE
                            ================================ -->

                            <td>

                                <div class="fw-semibold">
                                    @(item.Warehouse?.WarehouseName ?? "-")
                                </div>


                                @if (!string.IsNullOrWhiteSpace(
                                                            item.Warehouse?.WarehouseCode))
                                {
                                    <div class="small text-muted">

                                        Code:
                                        @item.Warehouse.WarehouseCode

                                    </div>
                                }

                            </td>


                            <!-- ===============================
                                 QUANTITY IN
                            ================================ -->

                            <td class="text-end text-nowrap">

                                @if (item.QuantityIn > 0)
                                {
                                    @item.QuantityIn.ToString("0.###")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </td>


                            <!-- ===============================
                                 QUANTITY OUT
                            ================================ -->

                            <td class="text-end text-nowrap">

                                @if (item.QuantityOut > 0)
                                {
                                    @item.QuantityOut.ToString("0.###")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </td>


                            <!-- ===============================
                                 RATE
                            ================================ -->

                            <td class="text-end text-nowrap">

                                @if (item.Rate.HasValue)
                                {
                                    @item.Rate.Value.ToString("0.####")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </td>


                            <!-- ===============================
                                 AMOUNT
                            ================================ -->

                            <td class="text-end text-nowrap">

                                @if (item.Amount.HasValue)
                                {
                                    @item.Amount.Value.ToString("0.00")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </td>


                            <!-- ===============================
                                 LINE REMARKS
                            ================================ -->

                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                                            item.Remarks))
                                {
                                    @item.Remarks
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </td>

                        </tr>


                        itemNumber++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — REMARKS
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid
                      fa-note-sticky
                      me-1">
            </i>

            Remarks

        </span>

    </div>


    <div class="card-body">

        @if (!string.IsNullOrWhiteSpace(
                transaction.Remarks))
        {
            <div>
                @transaction.Remarks
            </div>
        }
        else
        {
            <span class="text-muted">
                No remarks.
            </span>
        }

    </div>

</div>