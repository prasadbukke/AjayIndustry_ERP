@model List<AjayIndustriesERP.Domain.Entities.Uom>

@{
    ViewData["Title"] = "Unit Of Measure";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Unit Of Measure
            </h2>

            <p class="text-muted mb-0">
                Manage Unit Of Measure
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus"></i>

            Add UOM

        </a>

    </div>

    <partial name="Components/_SearchBar"
             model='@(ViewBag.SearchText as string ?? "")' />

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th width="70">#</th>

                        <th>Code</th>

                        <th>Name</th>

                        <th>Description</th>

                        <th>Status</th>

                        <th width="160">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        int srNo =
                        ((ViewBag.PageNumber - 1) * ViewBag.PageSize) + 1;

                        foreach (var uom in Model)
                        {
                            <tr>

                                <td>@srNo</td>

                                <td>@uom.UomCode</td>

                                <td>@uom.UomName</td>

                                <td>@uom.Description</td>

                                <td>

                                    @if (uom.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@uom.UomId"
                                       class="btn btn-sm btn-outline-info">

                                        <i class="fa-solid fa-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@uom.UomId"
                                       class="btn btn-sm btn-outline-warning">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="confirmDelete('@Url.Action("Delete","Uom",new{id=uom.UomId})')">

                                        <i class="fa-solid fa-trash"></i>

                                    </button>

                                </td>

                            </tr>

                            srNo++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center py-4">

                                No UOM Found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <partial name="Components/_Pagination"
             model='((int)ViewBag.PageNumber, (int)ViewBag.PageSize)' />

</div>