@model AjayIndustriesERP.Web.ViewModels.Uom.UomViewModel

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger">
</div>

<input asp-for="UomId" type="hidden" />

<div class="row">

    <div class="col-md-6 mb-3">

        <label asp-for="UomCode" class="form-label"></label>

        <input asp-for="UomCode"
               class="form-control" />

        <span asp-validation-for="UomCode"
              class="text-danger"></span>

    </div>

    <div class="col-md-6 mb-3">

        <label asp-for="UomName" class="form-label"></label>

        <input asp-for="UomName"
               class="form-control" />

        <span asp-validation-for="UomName"
              class="text-danger"></span>

    </div>

    <div class="col-12 mb-3">

        <label asp-for="Description"
               class="form-label"></label>

        <textarea asp-for="Description"
                  rows="3"
                  class="form-control"></textarea>

    </div>

    <div class="col-12 mb-4">

        <div class="form-check form-switch">

            <input asp-for="IsActive"
                   class="form-check-input" />

            <label asp-for="IsActive"
                   class="form-check-label"></label>

        </div>

    </div>

    <div class="col-12">

        <hr />

        <div class="d-flex justify-content-end">

            <a asp-action="Index"
               class="btn btn-secondary me-2">

                Cancel

            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="fa-solid fa-floppy-disk"></i>

                @(Model.UomId == 0 ? "Save UOM" : "Update UOM")

            </button>

        </div>

    </div>

</div>