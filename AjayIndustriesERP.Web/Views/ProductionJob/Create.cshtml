@*
    ============================================================
    File: Create.cshtml

    Purpose:
    Creates a Production Job from a confirmed Customer PO Item.

    Responsibilities:
    - Own the Create form.
    - Render Production Job _Form.
    - Submit Job Quantity and planning information.
    - Enable client-side validation.

    Important:
    - Released Routing is selected automatically.
    - Routing Steps are automatically copied into Job Steps.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.ProductionJob.ProductionJobFormViewModel

@{
    ViewData["Title"] =
        "Create Production Job";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Create Production Job
        </h2>

        <p class="text-muted mb-0">
            Convert a Customer PO Item into an executable Production Job.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back

    </a>

</div>


<!-- =========================================================
     REGION 2 — CREATE FORM
========================================================== -->

<form asp-controller="ProductionJob"
      asp-action="Create"
      method="post"
      id="productionJobForm">

    @Html.AntiForgeryToken()


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <partial name="_Form"
             model="@Model" />


    <!-- =====================================================
         REGION 3 — ACTIONS
    ====================================================== -->

    <div class="d-flex
                justify-content-end
                gap-2
                mb-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-primary">

            <i class="fa-solid
                      fa-gears
                      me-1">
            </i>

            Create Production Job

        </button>

    </div>

</form>


<!-- =========================================================
     REGION 4 — VALIDATION
========================================================== -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/production-job.js"
            asp-append-version="true">
    </script>
}