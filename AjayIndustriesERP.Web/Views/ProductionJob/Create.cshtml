@*
    ============================================================
    File: Create.cshtml

    Purpose:
    Creates one Production Job from a confirmed Customer PO.

    Production Structure:

    Customer Purchase Order
            ↓
    Production Job
            ↓
    Production Job Items
            ↓
    Production Job Steps

    Responsibilities:
    - Own the Create Production Job form.
    - Render shared Production Job _Form.
    - Allow Admin to select one confirmed Customer PO.
    - Load all Customer PO Items automatically.
    - Allow Item-wise Production Quantity planning.
    - Submit Production planning information.
    - Enable client-side validation.

    Important:
    - One Customer PO = One Production Job.
    - All active Customer PO Items are loaded automatically.
    - Ordered Quantity comes from Customer PO Item.
    - Production Quantity is planned by Admin.
    - Released Routing is resolved Item-wise.
    - Routing Steps are copied into each ProductionJobItem
      Pipeline when the Job is created.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.ProductionJob.ProductionJobFormViewModel

@{
    ViewData["Title"] =
        "Create Production Job";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Create Production Job
        </h2>

        <p class="text-muted mb-0">

            Create one Production Job for a confirmed
            Customer PO and plan Item-wise Production Quantity.

        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid
                  fa-arrow-left
                  me-1">
        </i>

        Back

    </a>

</div>


<!-- =========================================================
     REGION 2 — CREATE FORM
========================================================== -->

<form asp-controller="ProductionJob"
      asp-action="Create"
      method="post"
      id="productionJobForm">

    @Html.AntiForgeryToken()


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <partial name="_Form"
             model="@Model" />


    <!-- =====================================================
         REGION 3 — ACTIONS
    ====================================================== -->

    <div class="d-flex
                justify-content-end
                gap-2
                mb-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-primary">

            <i class="fa-solid
                      fa-gears
                      me-1">
            </i>

            Create Production Job

        </button>

    </div>

</form>


<!-- =========================================================
     REGION 4 — VALIDATION / PRODUCTION JOB SCRIPT
========================================================== -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script src="~/js/production-job.js"
            asp-append-version="true">
    </script>
}