@*
    ============================================================
    File: Deleted.cshtml

    Purpose:
    Displays soft-deleted Production Jobs.

    Production Structure:

    Customer Purchase Order
            ↓
    Production Job
            ↓
    Production Job Items
            ↓
    Production Job Steps

    Responsibilities:
    - Keep deleted Production Jobs separate from main Index.
    - Display Customer PO information.
    - Display all Items under the deleted Production Job.
    - Display Item production quantity summary.
    - Display original Production Job Status.
    - Restore deleted Production Jobs.

    Important:
    - Draft, Completed and Cancelled Jobs can be deleted.
    - One Customer PO = One Production Job identity.
    - Deleted Job must be restored instead of creating another
      Production Job for the same Customer PO.
    - Restore preserves original Job Code, Items,
      Pipelines and execution history.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.ProductionJob>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] =
        "Deleted Production Jobs";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Production Jobs
        </h2>

        <p class="text-muted mb-0">

            Restore previously deleted
            Production Jobs.

        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid
                  fa-arrow-left
                  me-1">
        </i>

        Back to Production Jobs

    </a>

</div>


<!-- =========================================================
     REGION 2 — DELETED JOB TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0"
                   style="min-width:1100px;">

                <thead class="table-light">

                    <tr>

                        <th style="width:55px;">
                            #
                        </th>


                        <th class="text-nowrap">
                            Job Code
                        </th>


                        <th style="min-width:190px;">
                            Customer PO
                        </th>


                        <th style="min-width:250px;">
                            Production Items
                        </th>


                        <th class="text-center text-nowrap">
                            Item Progress
                        </th>


                        <th class="text-center text-nowrap">
                            Original Status
                        </th>


                        <th class="text-center"
                            style="width:130px;">

                            Action

                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (
                        Model != null
                        &&
                        Model.Any())
                    {
                        var serialNumber = 1;


                        @foreach (var job in Model)
                        {
                            /*
                             * ProductionJobItems are also
                             * soft-deleted together with the Job.
                             *
                             * Therefore do NOT filter IsDeleted here.
                             */
                            var jobItems =
                                job.Items
                                    .OrderBy(x =>
                                        x.Id)
                                    .ToList();


                            var totalItems =
                                jobItems.Count;


                            var completedItems =
                                jobItems.Count(x =>
                                    x.IsProductionCompleted);


                            <tr>

                                <!-- =================================
                                     SERIAL NUMBER
                                ================================== -->

                                <td>
                                    @serialNumber
                                </td>


                                <!-- =================================
                                     JOB CODE
                                ================================== -->

                                <td class="fw-semibold
                                           text-nowrap">

                                    @job.Code

                                </td>


                                <!-- =================================
                                     CUSTOMER PO
                                ================================== -->

                                <td>

                                    <div class="fw-semibold">

                                        @(
                                            job.CustomerPurchaseOrder
                                                ?.CustomerPurchaseOrderNumber
                                            ?? "-"
                                        )

                                    </div>


                                    <div class="small text-muted">

                                        @(
                                            job.CustomerPurchaseOrder
                                                ?.CustomerName
                                            ?? "-"
                                        )

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        job.CustomerPurchaseOrder?.Code))
                                    {
                                        <div class="small text-muted">

                                            @job.CustomerPurchaseOrder.Code

                                        </div>
                                    }

                                </td>


                                <!-- =================================
                                     PRODUCTION ITEMS
                                ================================== -->

                                <td>

                                    @if (jobItems.Any())
                                    {
                                        <div class="d-flex
                                                    flex-column
                                                    gap-1">

                                            @foreach (var item
                                                in jobItems.Take(4))
                                            {
                                                <div>

                                                    <span class="fw-semibold">

                                                        @item.ItemCode

                                                    </span>


                                                    <span class="small
                                                                 text-muted
                                                                 ms-1">

                                                        @item.CompletedQuantity
                                                            .ToString("0.###")

                                                        /

                                                        @item.OrderedQuantity
                                                            .ToString("0.###")

                                                        @item.UnitName

                                                    </span>

                                                </div>
                                            }


                                            @if (jobItems.Count > 4)
                                            {
                                                <div class="small
                                                            text-muted">

                                                    +
                                                    @(jobItems.Count - 4)
                                                    more Item(s)

                                                </div>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- =================================
                                     ITEM PROGRESS
                                ================================== -->

                                <td class="text-center">

                                    @if (totalItems <= 0)
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="fw-semibold">

                                            @completedItems
                                            /
                                            @totalItems

                                        </div>

                                        <div class="small text-muted">
                                            Full Complete
                                        </div>
                                    }

                                </td>


                                <!-- =================================
                                     ORIGINAL STATUS
                                ================================== -->

                                <td class="text-center">

                                    @switch (job.Status)
                                    {
                                        case ProductionJobStatus.Draft:

                                            <span class="badge bg-secondary">
                                                Draft
                                            </span>

                                            break;


                                        case ProductionJobStatus.Ready:

                                            <span class="badge bg-primary">
                                                Ready
                                            </span>

                                            break;


                                        case ProductionJobStatus.InProgress:

                                            <span class="badge
                                                         bg-warning
                                                         text-dark">

                                                In Progress

                                            </span>

                                            break;


                                        case ProductionJobStatus.Completed:

                                            <span class="badge bg-success">
                                                Completed
                                            </span>

                                            break;


                                        case ProductionJobStatus.Cancelled:

                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- =================================
                                     RESTORE
                                ================================== -->

                                <td class="text-center">

                                    <form asp-action="Restore"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="id"
                                               value="@job.Id" />


                                        <button type="submit"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-success"
                                                title="Restore Production Job">

                                            <i class="fa-solid
                                                      fa-rotate-left
                                                      me-1">
                                            </i>

                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center
                                       py-5
                                       text-muted">

                                <i class="fa-solid
                                          fa-trash-can
                                          fa-2x
                                          mb-3">
                                </i>


                                <div class="fw-semibold mb-1">
                                    No Deleted Production Jobs
                                </div>


                                <div class="small">

                                    Deleted Production Jobs
                                    will appear here.

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>