@*
    ============================================================
    File: Deleted.cshtml

    Purpose:
    Displays soft-deleted Draft Production Jobs.

    Responsibilities:
    - Keep deleted Jobs separate from main Production Index.
    - Display Customer PO and Item information.
    - Display Job Quantity and Routing.
    - Restore deleted Draft Production Jobs.

    Important:
    - Only Draft Production Jobs can currently be deleted.
    - Restore preserves original Job Code, Routing and Steps.
    - Restore validates remaining Customer PO Quantity.
    ============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.ProductionJob>

@{
    ViewData["Title"] =
        "Deleted Production Jobs";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Deleted Production Jobs
        </h2>

        <p class="text-muted mb-0">
            Restore previously deleted Draft Production Jobs.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back to Production Jobs

    </a>

</div>


<!-- =========================================================
     REGION 2 — DELETED JOB TABLE
========================================================== -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0"
                   style="min-width:1050px;">

                <thead class="table-light">

                    <tr>

                        <th style="width:55px;">
                            #
                        </th>

                        <th>
                            Job Code
                        </th>

                        <th>
                            Customer PO
                        </th>

                        <th>
                            Item
                        </th>

                        <th class="text-end">
                            Job Qty
                        </th>

                        <th>
                            Routing
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                        <th class="text-center"
                            style="width:130px;">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null &&
                                        Model.Any())
                    {
                        var serialNumber = 1;


                        @foreach (var job in Model)
                        {
                            <tr>

                                <td>
                                    @serialNumber
                                </td>


                                <td class="fw-semibold text-nowrap">
                                    @job.Code
                                </td>


                                <td>

    <div class="fw-semibold">

        @(
            job.CustomerPurchaseOrderItem
                ?.CustomerPurchaseOrder
                ?.Code
            ?? "-"
        )

    </div>


    <div class="small text-muted">

        @(
            job.CustomerPurchaseOrderItem
                ?.CustomerPurchaseOrder
                ?.CustomerName
            ?? "-"
        )

    </div>

</td>


                                <td>

                                    <div class="fw-semibold">
                                        @job.ItemCode
                                    </div>

                                    <div class="small text-muted">
                                        @job.ItemName
                                    </div>

                                </td>


                                <td class="text-end text-nowrap">

                                    @(job.JobQuantity.ToString("0.###"))
                                    @job.UnitName

                                </td>


                                <td>

                                    <div class="fw-semibold">
                                        @job.RoutingCode
                                    </div>

                                    <div class="small text-muted">
                                        Rev @job.RoutingRevisionNumber
                                    </div>

                                </td>


                                <td class="text-center">

                                    <span class="badge bg-secondary">
                                        Draft
                                    </span>

                                </td>


                                <td class="text-center">

                                    <form asp-action="Restore"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="id"
                                               value="@job.Id" />


                                        <button type="submit"
                                                class="btn
                                                               btn-sm
                                                               btn-outline-success"
                                                title="Restore Production Job">

                                            <i class="fa-solid
                                                              fa-rotate-left
                                                              me-1">
                                            </i>

                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center
                                           py-5
                                           text-muted">

                                <i class="fa-solid
                                              fa-trash-can
                                              fa-2x
                                              mb-3">
                                </i>


                                <div class="fw-semibold mb-1">
                                    No Deleted Production Jobs
                                </div>

                                <div class="small">
                                    Deleted Draft Jobs will appear here.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>