@*
=============================================================
File: Index.cshtml
Module: Production
Layer: Web - View

Purpose:
Displays Production Jobs in compact Job-level format.

UI Structure:

Production Job
    ↓
Show / Hide Items
    ↓
Item-wise Production Progress

Main Job Status:
- Pending
- In Progress
- Completed
- Cancelled

Item Status:
- Pending
- In Progress
- Completed

Important:
- Main table remains compact even when one Job has many Items.
- Item list is collapsed by default.
- Item-wise quantity and status are visible on demand.
- Production Quantity is cumulative current Production plan.
- Completed Quantity is cumulative finished GOOD quantity.
=============================================================
*@

@model List<AjayIndustriesERP.Domain.Entities.ProductionJob>

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] =
        "Production Jobs";

    var pageNumber =
        (int)ViewBag.PageNumber;

    var pageSize =
        (int)ViewBag.PageSize;

    var totalRecords =
        (int)ViewBag.TotalRecords;

    var serialNumber =
        ((pageNumber - 1) * pageSize) + 1;
}


@* =========================================================
   SUCCESS / ERROR MESSAGE
   ========================================================= *@

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert
                alert-success
                alert-dismissible
                fade
                show"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert
                alert-danger
                alert-dismissible
                fade
                show"
         role="alert">

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@* =========================================================
   PAGE HEADER
   ========================================================= *@

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Production Jobs
        </h2>

        <p class="text-muted mb-0">
            Plan and track Customer PO production.
        </p>

    </div>


    <div class="d-flex
                align-items-center
                gap-2
                flex-wrap">

        <a asp-action="Deleted"
           class="btn btn-outline-secondary">

            <i class="fa-solid
                      fa-trash-can
                      me-1">
            </i>

            Deleted Jobs

        </a>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid
                      fa-plus
                      me-1">
            </i>

            Create Production Job

        </a>

    </div>

</div>


@* =========================================================
   SEARCH
   ========================================================= *@

<partial name="Components/_SearchBar"
         model='@(ViewBag.SearchText as string ?? "")' />


@* =========================================================
   PRODUCTION JOB TABLE
   ========================================================= *@

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="width:50px;">
                            #
                        </th>

                        <th style="min-width:220px;">
                            Job Code
                        </th>

                        <th style="min-width:210px;">
                            Customer PO
                        </th>

                        <th style="min-width:150px;">
                            Items
                        </th>

                        <th style="min-width:180px;">
                            Planning
                        </th>

                        <th class="text-center"
                            style="min-width:120px;">
                            Status
                        </th>

                        <th class="text-center"
                            style="width:170px;">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (
                        Model != null
                        &&
                        Model.Any()
                    )
                    {
                        foreach (var job in Model)
                        {
                            var activeItems =
                                job.Items
                                    .Where(item =>
                                        !item.IsDeleted
                                        &&
                                        item.IsActive)
                                    .OrderBy(item =>
                                        item.Id)
                                    .ToList();


                            var totalItems =
                                activeItems.Count;


                            var completedItems =
                                activeItems.Count(item =>
                                    item.OrderedQuantity > 0m
                                    &&
                                    item.CompletedQuantity >=
                                        item.OrderedQuantity);


                            /*
                             * Main Job Status
                             *
                             * Ready / Draft are intentionally
                             * presented as Pending on Index.
                             */
                            var jobStatusText =
                                job.Status switch
                                {
                                    ProductionJobStatus.Completed =>
                                        "Completed",

                                    ProductionJobStatus.InProgress =>
                                        "In Progress",

                                    ProductionJobStatus.Cancelled =>
                                        "Cancelled",

                                    _ =>
                                        "Pending"
                                };


                            var jobStatusClass =
                                job.Status switch
                                {
                                    ProductionJobStatus.Completed =>
                                        "bg-success",

                                    ProductionJobStatus.InProgress =>
                                        "bg-warning text-dark",

                                    ProductionJobStatus.Cancelled =>
                                        "bg-danger",

                                    _ =>
                                        "bg-secondary"
                                };


                            var canEdit =
                                job.Status !=
                                    ProductionJobStatus.Completed
                                &&
                                job.Status !=
                                    ProductionJobStatus.Cancelled;


                            /*
                             * In Progress Job has Production activity.
                             * Service requires Cancel before Delete.
                             */
                            var canDelete =
                                job.Status !=
                                    ProductionJobStatus.InProgress;


                            var collapseId =
                                $"production-job-items-{job.Id}";


                            var toggleId =
                                $"production-job-toggle-{job.Id}";


                            @* =====================================
                               MAIN JOB ROW
                               ===================================== *@

                            <tr>

                                <td class="text-nowrap">
                                    @serialNumber
                                </td>


                                @* =================================
                                   JOB CODE + SHOW ITEMS
                                   ================================= *@

                                <td>

                                    <a asp-action="Pipeline"
                                       asp-route-id="@job.Id"
                                       class="fw-semibold
                                              text-decoration-none
                                              text-nowrap">

                                        @job.Code

                                    </a>


                                    <div class="mt-1">

                                        <button type="button"
                                                id="@toggleId"
                                                class="btn
                                                       btn-sm
                                                       btn-link
                                                       text-decoration-none
                                                       p-0
                                                       job-items-toggle"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="false"
                                                aria-controls="@collapseId">

                                            <i class="fa-solid
                                                      fa-chevron-down
                                                      me-1
                                                      toggle-icon">
                                            </i>

                                            <span class="toggle-text">
                                                Show Items
                                            </span>

                                            <span class="text-muted">
                                                (@totalItems)
                                            </span>

                                        </button>

                                    </div>

                                </td>


                                @* =================================
   CUSTOMER PO
   ================================= *@

<td>

    <div class="fw-semibold">

        @(
            string.IsNullOrWhiteSpace(
                job.CustomerPurchaseOrder?
                    .CustomerPurchaseOrderNumber)
                ? "-"
                : job.CustomerPurchaseOrder
                    .CustomerPurchaseOrderNumber
        )

    </div>


    <div class="small text-muted">

        @(
            string.IsNullOrWhiteSpace(
                job.CustomerPurchaseOrder?
                    .CustomerName)
                ? "-"
                : job.CustomerPurchaseOrder
                    .CustomerName
        )

    </div>


    <div class="small text-muted">

        @(
            string.IsNullOrWhiteSpace(
                job.CustomerPurchaseOrder?
                    .Code)
                ? "-"
                : job.CustomerPurchaseOrder
                    .Code
        )

    </div>

</td>

                                @* =================================
                                   ITEM SUMMARY
                                   ================================= *@

                                <td>

                                    <div class="fw-semibold">

                                        @totalItems

                                        @(totalItems == 1
                                            ? "Item"
                                            : "Items")

                                    </div>


                                    @if (totalItems > 0)
                                    {
                                        <div class="small mt-1">

                                            <span class="text-success
                                                         fw-semibold">

                                                @completedItems

                                            </span>

                                            <span class="text-muted">
                                                /
                                                @totalItems
                                                Completed
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">
                                            No Items
                                        </div>
                                    }

                                </td>


                                @* =================================
                                   PLANNING
                                   ================================= *@

                                <td>

                                    <div class="small">

                                        <span class="text-muted">
                                            Start
                                        </span>

                                        <span class="ms-1 fw-semibold">

                                            @(
                                                job.PlannedStartOn.HasValue
                                                    ? job.PlannedStartOn.Value
                                                        .ToString("dd-MM-yyyy")
                                                    : "-"
                                            )

                                        </span>

                                    </div>


                                    <div class="small mt-1">

                                        <span class="text-muted">
                                            Completion
                                        </span>

                                        <span class="ms-1 fw-semibold">

                                            @(
                                                job.PlannedCompletionOn.HasValue
                                                    ? job.PlannedCompletionOn.Value
                                                        .ToString("dd-MM-yyyy")
                                                    : "-"
                                            )

                                        </span>

                                    </div>

                                </td>


                                @* =================================
                                   MAIN STATUS
                                   ================================= *@

                                <td class="text-center">

                                    <span class="badge @jobStatusClass">
                                        @jobStatusText
                                    </span>

                                </td>


                                @* =================================
                                   ACTIONS
                                   ================================= *@

                                <td class="text-center">

                                    <div class="d-flex
                                                justify-content-center
                                                align-items-center
                                                gap-1">


                                        @* PIPELINE *@

                                        <a asp-action="Pipeline"
                                           asp-route-id="@job.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-primary"
                                           title="Production Pipeline">

                                            <i class="fa-solid
                                                      fa-diagram-project">
                                            </i>

                                        </a>


                                        @* DETAILS *@

                                        <a asp-action="Details"
                                           asp-route-id="@job.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-info"
                                           title="Production Job Details">

                                            <i class="fa-solid
                                                      fa-circle-info">
                                            </i>

                                        </a>


                                        @* EDIT PLANNING *@

                                        @if (canEdit)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@job.Id"
                                               class="btn
                                                      btn-sm
                                                      btn-outline-warning"
                                               title="Edit Production Planning">

                                                <i class="fa-solid
                                                          fa-pen">
                                                </i>

                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn
                                                           btn-sm
                                                           btn-outline-warning"
                                                    disabled
                                                    title="Completed or Cancelled Job cannot be edited.">

                                                <i class="fa-solid
                                                          fa-pen">
                                                </i>

                                            </button>
                                        }


                                        @* DELETE *@

                                        @if (canDelete)
                                        {
                                            <form asp-action="Delete"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Delete this Production Job?');">

                                                @Html.AntiForgeryToken()


                                                <input type="hidden"
                                                       name="id"
                                                       value="@job.Id" />


                                                <button type="submit"
                                                        class="btn
                                                               btn-sm
                                                               btn-outline-danger"
                                                        title="Delete Production Job">

                                                    <i class="fa-solid
                                                              fa-trash">
                                                    </i>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn
                                                           btn-sm
                                                           btn-outline-danger"
                                                    disabled
                                                    title="Cancel this Production Job before deleting.">

                                                <i class="fa-solid
                                                          fa-trash">
                                                </i>

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>


                            @* =====================================
                               COLLAPSIBLE ITEM LIST ROW
                               ===================================== *@

                            <tr class="collapse
                                       bg-light
                                       job-items-collapse"
                                id="@collapseId"
                                data-toggle-button-id="@toggleId">

                                <td colspan="7"
                                    class="p-0">

                                    <div class="p-3
                                                border-top
                                                border-bottom">

                                        <div class="d-flex
                                                    justify-content-between
                                                    align-items-center
                                                    flex-wrap
                                                    gap-2
                                                    mb-3">

                                            <div>

                                                <div class="fw-semibold">

                                                    <i class="fa-solid
                                                              fa-boxes-stacked
                                                              me-1">
                                                    </i>

                                                    Production Items

                                                </div>

                                                <div class="small text-muted">
                                                    @job.Code
                                                </div>

                                            </div>


                                            <div class="small text-muted">

                                                @completedItems of
                                                @totalItems Items Completed

                                            </div>

                                        </div>


                                        @if (activeItems.Any())
                                        {
                                            <div class="table-responsive">

                                                <table class="table
                                                              table-sm
                                                              table-bordered
                                                              align-middle
                                                              bg-white
                                                              mb-0">

                                                    <thead class="table-light">

                                                        <tr>

                                                            <th style="width:45px;">
                                                                #
                                                            </th>

                                                            <th style="min-width:210px;">
                                                                Item
                                                            </th>

                                                            <th class="text-end"
                                                                style="min-width:160px;">
                                                                Completed / Ordered
                                                            </th>

                                                            <th class="text-end"
                                                                style="min-width:150px;">
                                                                Current Plan
                                                            </th>

                                                            <th class="text-end"
                                                                style="min-width:130px;">
                                                                Pending
                                                            </th>

                                                            <th style="min-width:150px;">
                                                                Routing
                                                            </th>

                                                            <th class="text-center"
                                                                style="min-width:120px;">
                                                                Status
                                                            </th>

                                                            <th class="text-center"
                                                                style="width:80px;">
                                                                Open
                                                            </th>

                                                        </tr>

                                                    </thead>


                                                    <tbody>

                                                        @{
                                                            var itemSerial =
                                                                1;
                                                        }


                                                        @foreach (
                                                            var item
                                                            in activeItems)
                                                        {
                                                            var pendingQuantity =
                                                                item.OrderedQuantity
                                                                -
                                                                item.CompletedQuantity;


                                                            if (pendingQuantity < 0m)
                                                            {
                                                                pendingQuantity =
                                                                    0m;
                                                            }


                                                            var productionPendingQuantity =
                                                                item.ProductionQuantity
                                                                -
                                                                item.CompletedQuantity;


                                                            if (
                                                                productionPendingQuantity
                                                                <
                                                                0m
                                                            )
                                                            {
                                                                productionPendingQuantity =
                                                                    0m;
                                                            }


                                                            var isItemCompleted =
                                                                item.OrderedQuantity > 0m
                                                                &&
                                                                item.CompletedQuantity >=
                                                                    item.OrderedQuantity;


                                                            /*
                                                             * Item Status shown on Index
                                                             * is based on finished output.
                                                             *
                                                             * Full Ordered Qty = Completed
                                                             * Some finished output = In Progress
                                                             * No finished output = Pending
                                                             */
                                                            var itemStatusText =
                                                                isItemCompleted
                                                                    ? "Completed"
                                                                    : item.CompletedQuantity > 0m
                                                                        ? "In Progress"
                                                                        : "Pending";


                                                            var itemStatusClass =
                                                                isItemCompleted
                                                                    ? "bg-success"
                                                                    : item.CompletedQuantity > 0m
                                                                        ? "bg-warning text-dark"
                                                                        : "bg-secondary";


                                                            var currentPlanCompleted =
                                                                item.ProductionQuantity > 0m
                                                                &&
                                                                item.CompletedQuantity >=
                                                                    item.ProductionQuantity;


                                                            <tr>

                                                                <td>
                                                                    @itemSerial
                                                                </td>


                                                                @* =========================
                                                                   ITEM
                                                                   ========================= *@

                                                                <td>

                                                                    <div class="fw-semibold">
                                                                        @item.ItemCode
                                                                    </div>


                                                                    @if (
                                                                        !string.IsNullOrWhiteSpace(
                                                                            item.ItemName)
                                                                    )
                                                                    {
                                                                        <div class="small
                                                                                    text-muted">
                                                                            @item.ItemName
                                                                        </div>
                                                                    }

                                                                </td>


                                                                @* =========================
                                                                   COMPLETED / ORDERED
                                                                   ========================= *@

                                                                <td class="text-end
                                                                           text-nowrap">

                                                                    <span class="fw-semibold">

                                                                        @(
                                                                            item.CompletedQuantity
                                                                                .ToString("0.###")
                                                                        )

                                                                    </span>

                                                                    <span class="text-muted">
                                                                        /
                                                                    </span>

                                                                    <span>

                                                                        @(
                                                                            item.OrderedQuantity
                                                                                .ToString("0.###")
                                                                        )

                                                                    </span>


                                                                    @if (
                                                                        !string.IsNullOrWhiteSpace(
                                                                            item.UnitName)
                                                                    )
                                                                    {
                                                                        <span class="text-muted ms-1">
                                                                            @item.UnitName
                                                                        </span>
                                                                    }

                                                                </td>


                                                                @* =========================
                                                                   CURRENT PLAN
                                                                   ========================= *@

                                                                <td class="text-end">

                                                                    @if (
                                                                        item.ProductionQuantity >
                                                                        0m
                                                                    )
                                                                    {
                                                                        <div class="text-nowrap">

                                                                            <span class="fw-semibold">

                                                                                @(
                                                                                    item.ProductionQuantity
                                                                                        .ToString("0.###")
                                                                                )

                                                                            </span>

                                                                            @if (
                                                                                !string.IsNullOrWhiteSpace(
                                                                                    item.UnitName)
                                                                            )
                                                                            {
                                                                                <span class="text-muted ms-1">
                                                                                    @item.UnitName
                                                                                </span>
                                                                            }

                                                                        </div>


                                                                        @if (
                                                                            currentPlanCompleted
                                                                            &&
                                                                            !isItemCompleted
                                                                        )
                                                                        {
                                                                            <div class="mt-1">

                                                                                <span class="badge
                                                                                             bg-warning
                                                                                             text-dark">

                                                                                    Plan Complete

                                                                                </span>

                                                                            </div>
                                                                        }
                                                                        else if (
                                                                            productionPendingQuantity >
                                                                            0m
                                                                        )
                                                                        {
                                                                            <div class="small text-muted mt-1">

                                                                                Plan Pending:

                                                                                @(
                                                                                    productionPendingQuantity
                                                                                        .ToString("0.###")
                                                                                )

                                                                            </div>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">
                                                                            Not Planned
                                                                        </span>
                                                                    }

                                                                </td>


                                                                @* =========================
                                                                   ORDER PENDING
                                                                   ========================= *@

                                                                <td class="text-end
                                                                           text-nowrap">

                                                                    <span class="fw-semibold">

                                                                        @(
                                                                            pendingQuantity
                                                                                .ToString("0.###")
                                                                        )

                                                                    </span>


                                                                    @if (
                                                                        !string.IsNullOrWhiteSpace(
                                                                            item.UnitName)
                                                                    )
                                                                    {
                                                                        <span class="text-muted ms-1">
                                                                            @item.UnitName
                                                                        </span>
                                                                    }

                                                                </td>


                                                                @* =========================
                                                                   ROUTING
                                                                   ========================= *@

                                                                <td>

                                                                    <div class="fw-semibold
                                                                                text-nowrap">

                                                                        @(
                                                                            string.IsNullOrWhiteSpace(
                                                                                item.RoutingCode)
                                                                                ? "-"
                                                                                : item.RoutingCode
                                                                        )

                                                                    </div>


                                                                    @if (
                                                                        !string.IsNullOrWhiteSpace(
                                                                            item.RoutingCode)
                                                                    )
                                                                    {
                                                                        <div class="small
                                                                                    text-muted">

                                                                            Rev
                                                                            @item.RoutingRevisionNumber

                                                                        </div>
                                                                    }

                                                                </td>


                                                                @* =========================
                                                                   ITEM STATUS
                                                                   ========================= *@

                                                                <td class="text-center">

                                                                    <span class="badge
                                                                                 @itemStatusClass">

                                                                        @itemStatusText

                                                                    </span>

                                                                </td>


                                                                @* =========================
                                                                   OPEN ITEM PIPELINE
                                                                   ========================= *@

                                                                <td class="text-center">

                                                                    <a asp-action="Pipeline"
                                                                       asp-route-id="@job.Id"
                                                                       asp-route-itemId="@item.Id"
                                                                       class="btn
                                                                              btn-sm
                                                                              btn-outline-primary"
                                                                       title="Open Item Pipeline">

                                                                        <i class="fa-solid
                                                                                  fa-arrow-right">
                                                                        </i>

                                                                    </a>

                                                                </td>

                                                            </tr>


                                                            itemSerial++;
                                                        }

                                                    </tbody>

                                                </table>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center
                                                        text-muted
                                                        py-3">

                                                No active Production Items.

                                            </div>
                                        }

                                    </div>

                                </td>

                            </tr>


                            serialNumber++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center
                                       py-5
                                       text-muted">

                                <i class="fa-solid
                                          fa-industry
                                          fa-2x
                                          mb-3">
                                </i>


                                <div class="fw-semibold mb-1">
                                    No Production Jobs Found
                                </div>


                                <div class="small">
                                    No matching Production Jobs are available.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@* =========================================================
   PAGINATION
   ========================================================= *@

@if (totalRecords > 0)
{
    <div class="mt-3">

        <partial name="Components/_Pagination"
                 model='(
                     (int)ViewBag.PageNumber,
                     (int)ViewBag.PageSize
                 )' />

    </div>
}


@* =========================================================
   SHOW / HIDE ITEM TEXT
   ========================================================= *@

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const collapses =
                document.querySelectorAll(
                    ".job-items-collapse"
                );


            collapses.forEach(
                function (collapseElement) {

                    const toggleButtonId =
                        collapseElement.dataset
                            .toggleButtonId;


                    const toggleButton =
                        document.getElementById(
                            toggleButtonId
                        );


                    if (!toggleButton) {
                        return;
                    }


                    const textElement =
                        toggleButton.querySelector(
                            ".toggle-text"
                        );


                    const iconElement =
                        toggleButton.querySelector(
                            ".toggle-icon"
                        );


                    collapseElement.addEventListener(
                        "show.bs.collapse",
                        function () {

                            if (textElement) {
                                textElement.textContent =
                                    "Hide Items";
                            }


                            if (iconElement) {

                                iconElement.classList.remove(
                                    "fa-chevron-down"
                                );

                                iconElement.classList.add(
                                    "fa-chevron-up"
                                );

                            }

                        }
                    );


                    collapseElement.addEventListener(
                        "hide.bs.collapse",
                        function () {

                            if (textElement) {
                                textElement.textContent =
                                    "Show Items";
                            }


                            if (iconElement) {

                                iconElement.classList.remove(
                                    "fa-chevron-up"
                                );

                                iconElement.classList.add(
                                    "fa-chevron-down"
                                );

                            }

                        }
                    );

                }
            );

        }
    );

</script>