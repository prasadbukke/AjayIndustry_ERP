@*
    ============================================================
    File: _Form.cshtml

    Purpose:
    Reusable Production Job form used by Create and Edit.

    Production Structure:

    Customer Purchase Order
            ↓
    Production Job
            ↓
    Production Job Items
            ↓
    Production Job Steps

    Responsibilities:
    - Select one confirmed Customer PO during Create.
    - Auto-load all Customer PO Items.
    - Display Customer PO information.
    - Display Item-wise Ordered Quantity.
    - Display Item-wise Completed / Pending Quantity.
    - Accept Item-wise Production Quantity from Admin.
    - Display Released Routing used by each Item.
    - Accept optional planning dates.
    - Accept optional Production Job remarks.

    Important:
    - This partial DOES NOT contain a <form>.
    - Create.cshtml / Edit.cshtml own the <form>.
    - One Customer PO = One Production Job.
    - Customer PO cannot be changed after Job creation.
    - Ordered Quantity comes from Customer PO.
    - Production Quantity is entered by Admin.
    - Fully completed Item Production Quantity is readonly.
    - Worker does not enter Production Quantity.
    - Routing is loaded automatically Item-wise.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.ProductionJob.ProductionJobFormViewModel

@{
    var isEditMode =
        Model.Id > 0;


    /*
     * Display formatting helpers.
     *
     * Keep formatting outside Razor markup so method calls
     * are never rendered as literal text in the browser.
     */

    string FormatQuantity(decimal value)
    {
        return string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            "{0:0.###}",
            value);
    }


    string FormatDate(DateTime? value)
    {
        if (!value.HasValue)
        {
            return "-";
        }

        return string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            "{0:dd-MMM-yyyy}",
            value.Value);
    }


    string FormatRevision(int? value)
    {
        if (!value.HasValue)
        {
            return "-";
        }

        return string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            "{0}",
            value.Value);
    }
}


<!-- =========================================================
     REGION 1 — CUSTOMER PO SOURCE
========================================================== -->

@if (!isEditMode)
{
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">

            <span class="fw-semibold">

                <i class="fa-solid fa-file-lines me-1"></i>

                Customer PO Source

            </span>

        </div>


        <div class="card-body">

            <div class="row g-3">

                <div class="col-12">

                    <label asp-for="CustomerPurchaseOrderId"
                           class="form-label fw-semibold">

                        Customer Purchase Order

                        <span class="text-danger">*</span>

                    </label>


                    <select asp-for="CustomerPurchaseOrderId"
                            id="customerPurchaseOrderSelect"
                            class="form-select js-production-po-select"
                            data-source-url="@Url.Action(
                                "GetCustomerPurchaseOrderSource",
                                "ProductionJob")">

                        <option value="">
                            -- Select Customer PO --
                        </option>


                        @foreach (var purchaseOrder
                            in Model.CustomerPurchaseOrders)
                        {
                            if (purchaseOrder.Selected)
                            {
                                <option value="@purchaseOrder.Value"
                                        selected>

                                    @purchaseOrder.Text

                                </option>
                            }
                            else
                            {
                                <option value="@purchaseOrder.Value">

                                    @purchaseOrder.Text

                                </option>
                            }
                        }

                    </select>


                    <span asp-validation-for="CustomerPurchaseOrderId"
                          class="text-danger small">
                    </span>


                    <div class="form-text">

                        Select one confirmed Customer PO.
                        All PO Items will be loaded automatically
                        under the same Production Job.

                    </div>

                </div>

            </div>

        </div>

    </div>
}
else
{
    <input asp-for="CustomerPurchaseOrderId"
           type="hidden" />


    <!-- =====================================================
         EDIT MODE — IMMUTABLE CUSTOMER PO SOURCE
    ====================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">

            <span class="fw-semibold">

                <i class="fa-solid fa-file-lines me-1"></i>

                Production Source

            </span>

        </div>


        <div class="card-body">

            <div class="row g-4">


                <!-- =========================================
                     PRODUCTION JOB
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        Production Job
                    </div>

                    <div class="fw-semibold">
                        @Model.Code
                    </div>

                </div>


                <!-- =========================================
                     CUSTOMER PO
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        Customer PO
                    </div>

                    <div class="fw-semibold">
                        @Model.CustomerPurchaseOrderCode
                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.CustomerPurchaseOrderNumber))
                    {
                        <div class="small text-muted">

                            PO No:
                            @Model.CustomerPurchaseOrderNumber

                        </div>
                    }

                </div>


                <!-- =========================================
                     CUSTOMER
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        Customer
                    </div>

                    <div class="fw-semibold">
                        @Model.CustomerName
                    </div>

                </div>


                <!-- =========================================
                     RECEIVED DATE
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        PO Received Date
                    </div>

                    <div class="fw-semibold">
                        @FormatDate(Model.ReceivedDate)
                    </div>

                </div>


                <!-- =========================================
                     REQUIRED DELIVERY
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        Required Delivery
                    </div>

                    <div class="fw-semibold">
                        @FormatDate(Model.RequiredDeliveryDate)
                    </div>

                </div>


                <!-- =========================================
                     STATUS
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        Status
                    </div>

                    <span class="badge bg-secondary">
                        @Model.Status
                    </span>

                </div>

            </div>


            <hr />


            <div class="small text-muted">

                <i class="fa-solid fa-lock me-1"></i>

                Customer PO and its source Items cannot be
                changed after Production Job creation.

            </div>

        </div>

    </div>
}


<!-- =========================================================
     REGION 2 — SELECTED CUSTOMER PO INFORMATION
========================================================== -->

@if (!isEditMode)
{
    var hideSourceSummary =
        Model.CustomerPurchaseOrderId <= 0;


    <div id="selectedPoSummaryCard"
         class="card shadow-sm border-0 mb-4
                @(hideSourceSummary ? "d-none" : "")">

        <div class="card-header bg-light">

            <span class="fw-semibold">

                <i class="fa-solid fa-circle-info me-1"></i>

                Customer PO Information

            </span>

        </div>


        <div class="card-body">

            <div class="row g-4">


                <!-- =========================================
                     CUSTOMER PO CODE
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        Customer PO
                    </div>

                    <div id="selectedPoCode"
                         class="fw-semibold">

                        @(string.IsNullOrWhiteSpace(
                            Model.CustomerPurchaseOrderCode)
                            ? "-"
                            : Model.CustomerPurchaseOrderCode)

                    </div>

                </div>


                <!-- =========================================
                     CUSTOMER PO NUMBER
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        Customer PO Number
                    </div>

                    <div id="selectedPoNumber"
                         class="fw-semibold">

                        @(string.IsNullOrWhiteSpace(
                            Model.CustomerPurchaseOrderNumber)
                            ? "-"
                            : Model.CustomerPurchaseOrderNumber)

                    </div>

                </div>


                <!-- =========================================
                     CUSTOMER
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        Customer
                    </div>

                    <div id="selectedPoCustomer"
                         class="fw-semibold">

                        @(string.IsNullOrWhiteSpace(
                            Model.CustomerName)
                            ? "-"
                            : Model.CustomerName)

                    </div>

                </div>


                <!-- =========================================
                     RECEIVED DATE
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        PO Received Date
                    </div>

                    <div id="selectedPoReceivedDate"
                         class="fw-semibold">

                        @FormatDate(Model.ReceivedDate)

                    </div>

                </div>


                <!-- =========================================
                     REQUIRED DELIVERY DATE
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        Required Delivery
                    </div>

                    <div id="selectedPoDeliveryDate"
                         class="fw-semibold">

                        @FormatDate(Model.RequiredDeliveryDate)

                    </div>

                </div>


                <!-- =========================================
                     TOTAL ITEMS
                ========================================== -->

                <div class="col-lg-4 col-md-6">

                    <div class="small text-muted mb-1">
                        PO Items
                    </div>

                    <div id="selectedPoItemCount"
                         class="fw-semibold">

                        @Model.Items.Count

                    </div>

                </div>

            </div>

        </div>

    </div>
}


<!-- =========================================================
     REGION 3 — ITEM-WISE PRODUCTION PLANNING
========================================================== -->

<div id="productionItemsCard"
     class="card shadow-sm border-0 mb-4
            @(
                !isEditMode &&
                Model.Items.Count == 0
                    ? "d-none"
                    : ""
            )">

    <div class="card-header bg-light">

        <div class="d-flex
                    justify-content-between
                    align-items-center
                    gap-2">

            <span class="fw-semibold">

                <i class="fa-solid fa-boxes-stacked me-1"></i>

                Item-wise Production Planning

            </span>


            <span id="productionItemsCount"
                  class="badge bg-secondary">

                @Model.Items.Count Item(s)

            </span>

        </div>

    </div>


    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="min-width: 220px;">
                            Item
                        </th>

                        <th class="text-end"
                            style="min-width: 120px;">
                            Ordered
                        </th>

                        <th class="text-end"
                            style="min-width: 120px;">
                            Completed
                        </th>

                        <th class="text-end"
                            style="min-width: 120px;">
                            Pending
                        </th>

                        <th style="min-width: 180px;">
                            Production Qty
                        </th>

                        <th style="min-width: 170px;">
                            Routing
                        </th>

                        <th style="min-width: 140px;">
                            Delivery
                        </th>

                    </tr>

                </thead>


                <tbody id="productionItemsBody">

                    @for (var i = 0;
                        i < Model.Items.Count;
                        i++)
                    {
                        var item =
                            Model.Items[i];


                        var isProductionFullyCompleted =
                            item.OrderedQuantity > 0m
                            &&
                            item.CompletedQuantity >=
                                item.OrderedQuantity;


                        <!-- =================================
                             HIDDEN TRUSTED SOURCE REFERENCES
                        ================================== -->

                        <input asp-for="Items[i].Id"
                               type="hidden" />

                        <input asp-for="Items[i].CustomerPurchaseOrderItemId"
                               type="hidden" />

                        <input asp-for="Items[i].ItemId"
                               type="hidden" />

                        <input asp-for="Items[i].ItemCode"
                               type="hidden" />

                        <input asp-for="Items[i].ItemName"
                               type="hidden" />

                        <input asp-for="Items[i].UnitName"
                               type="hidden" />

                        <input asp-for="Items[i].OrderedQuantity"
                               type="hidden" />

                        <input asp-for="Items[i].CompletedQuantity"
                               type="hidden" />

                        <input asp-for="Items[i].ItemProcessRoutingId"
                               type="hidden" />

                        <input asp-for="Items[i].RoutingCode"
                               type="hidden" />

                        <input asp-for="Items[i].RoutingRevisionNumber"
                               type="hidden" />

                        <input asp-for="Items[i].HasReleasedRouting"
                               type="hidden" />

                        <input asp-for="Items[i].RequiredDeliveryDate"
                               type="hidden" />


                        <tr data-production-item-row
                            data-item-index="@i">


                            <!-- =============================
                                 ITEM
                            ============================== -->

                            <td>

                                <div class="fw-semibold">
                                    @item.ItemCode
                                </div>

                                <div class="small text-muted">
                                    @item.ItemName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    item.UnitName))
                                {
                                    <div class="small text-muted mt-1">

                                        UOM:
                                        @item.UnitName

                                    </div>
                                }

                            </td>


                            <!-- =============================
                                 ORDERED QUANTITY
                            ============================== -->

                            <td class="text-end">

                                <span class="fw-semibold">
                                    @FormatQuantity(item.OrderedQuantity)
                                </span>

                                @if (!string.IsNullOrWhiteSpace(
                                    item.UnitName))
                                {
                                    <div class="small text-muted">
                                        @item.UnitName
                                    </div>
                                }

                            </td>


                            <!-- =============================
                                 COMPLETED QUANTITY
                            ============================== -->

                            <td class="text-end">

                                <span class="fw-semibold
                                             @(item.CompletedQuantity > 0m
                                                 ? "text-success"
                                                 : "")">

                                    @FormatQuantity(
                                        item.CompletedQuantity)

                                </span>

                            </td>


                            <!-- =============================
                                 PENDING ORDER QUANTITY
                            ============================== -->

                            <td class="text-end">

                                @if (item.PendingQuantity <= 0m)
                                {
                                    <span class="fw-semibold text-success">
                                        0
                                    </span>

                                    <div>
                                        <span class="badge bg-success">
                                            Complete
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <span class="fw-semibold">

                                        @FormatQuantity(
                                            item.PendingQuantity)

                                    </span>
                                }

                            </td>


                            <!-- =============================
                                 PRODUCTION QUANTITY
                            ============================== -->

                            <td>

                                @if (isProductionFullyCompleted)
                                {
                                    <input asp-for="Items[i].ProductionQuantity"
                                           type="number"
                                           step="0.001"
                                           class="form-control
                                                  production-quantity-input
                                                  bg-light"
                                           data-ordered-quantity="@item.OrderedQuantity"
                                           data-completed-quantity="@item.CompletedQuantity"
                                           readonly />


                                    <div class="small
                                                text-success
                                                mt-1
                                                fw-semibold">

                                        <i class="fa-solid
                                                  fa-circle-check
                                                  me-1">
                                        </i>

                                        Production completed

                                    </div>
                                }
                                else
                                {
                                    <input asp-for="Items[i].ProductionQuantity"
                                           type="number"
                                           min="@item.CompletedQuantity"
                                           max="@item.OrderedQuantity"
                                           step="0.001"
                                           class="form-control
                                                  production-quantity-input"
                                           placeholder="0.000"
                                           data-ordered-quantity="@item.OrderedQuantity"
                                           data-completed-quantity="@item.CompletedQuantity" />


                                    <div class="small text-muted mt-1">

                                        Cannot be less than completed
                                        quantity

                                        <span class="fw-semibold">
                                            @FormatQuantity(
                                                item.CompletedQuantity)
                                        </span>.

                                    </div>
                                }


                                <span asp-validation-for="Items[i].ProductionQuantity"
                                      class="text-danger small">
                                </span>

                            </td>


                            <!-- =============================
                                 ROUTING
                            ============================== -->

                            <td>

                                @if (item.HasReleasedRouting)
                                {
                                    <div class="fw-semibold text-success">
                                        @item.RoutingCode
                                    </div>

                                    <div class="small text-muted">

                                        Revision
                                        @FormatRevision(
                                            item.RoutingRevisionNumber)

                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Routing Missing
                                    </span>

                                    <div class="small text-danger mt-1">
                                        Released Routing required.
                                    </div>
                                }

                            </td>


                            <!-- =============================
                                 REQUIRED DELIVERY
                            ============================== -->

                            <td>

                                <span class="@(
                                    item.RequiredDeliveryDate.HasValue
                                        ? ""
                                        : "text-muted"
                                )">

                                    @FormatDate(
                                        item.RequiredDeliveryDate)

                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- =================================================
             EMPTY ITEM MESSAGE
        ================================================== -->

        <div id="productionItemsEmptyState"
             class="text-center
                    text-muted
                    py-5
                    @(Model.Items.Count > 0
                        ? "d-none"
                        : "")">

            <i class="fa-solid
                      fa-box-open
                      fa-2x
                      mb-3">
            </i>

            <div class="fw-semibold">
                No Production Items loaded
            </div>

            <div class="small">

                Select a Customer PO to load all
                PO Items.

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 4 — QUANTITY RULE INFORMATION
========================================================== -->

<div class="alert
            alert-light
            border
            d-flex
            align-items-start
            gap-2
            mb-4">

    <i class="fa-solid
              fa-circle-info
              text-primary
              mt-1">
    </i>


    <div>

        <div class="fw-semibold">
            Production Quantity
        </div>


        <div class="small text-muted">

            Production Quantity is the current cumulative target
            planned by Admin for each Item.

        </div>


        <div class="small text-muted mt-1">

            Example:
            Ordered 100 →
            Production Qty 50 →
            Complete 50 →
            later Admin may increase Production Qty to 100
            under the same Production Job.

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 5 — PRODUCTION JOB INFORMATION
========================================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

        <span class="fw-semibold">

            <i class="fa-solid fa-industry me-1"></i>

            Production Job Information

        </span>

    </div>


    <div class="card-body">

        <div class="row g-3">


            <!-- =============================================
                 PLANNED START
            ============================================== -->

            <div class="col-lg-6 col-md-6">

                <label asp-for="PlannedStartOn"
                       class="form-label fw-semibold">
                </label>


                <input asp-for="PlannedStartOn"
                       type="date"
                       class="form-control" />


                <span asp-validation-for="PlannedStartOn"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 PLANNED COMPLETION
            ============================================== -->

            <div class="col-lg-6 col-md-6">

                <label asp-for="PlannedCompletionOn"
                       class="form-label fw-semibold">
                </label>


                <input asp-for="PlannedCompletionOn"
                       type="date"
                       class="form-control" />


                <span asp-validation-for="PlannedCompletionOn"
                      class="text-danger small">
                </span>

            </div>


            <!-- =============================================
                 REMARKS
            ============================================== -->

            <div class="col-12">

                <label asp-for="Remarks"
                       class="form-label fw-semibold">
                </label>


                <textarea asp-for="Remarks"
                          class="form-control"
                          rows="3"
                          maxlength="1000"
                          placeholder="Optional Production Job remarks"></textarea>


                <span asp-validation-for="Remarks"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REGION 6 — PIPELINE INFORMATION
========================================================== -->

<div class="alert
            alert-light
            border
            d-flex
            align-items-start
            gap-2
            mb-4">

    @if (!isEditMode)
    {
        <i class="fa-solid
                  fa-diagram-project
                  text-primary
                  mt-1">
        </i>


        <div>

            <div class="fw-semibold">
                Production Pipelines are created automatically
            </div>


            <div class="small text-muted">

                When the Production Job is created, every Item's
                current Released Item Process Routing is copied
                into its own executable Production Pipeline.

            </div>


            <div class="small text-muted mt-1">

                All Items remain under the same Production Job ID.

            </div>

        </div>
    }
    else
    {
        <i class="fa-solid
                  fa-diagram-project
                  text-secondary
                  mt-1">
        </i>


        <div>

            <div class="fw-semibold">
                Production Pipeline remains Item-wise
            </div>


            <div class="small text-muted">

                Updating Production Quantity does not create
                another Production Job.

            </div>


            <div class="small text-muted mt-1">

                When a completed partial-production target is
                increased, the same Item Pipeline is reused for
                the remaining Production Quantity.

            </div>

        </div>
    }

</div>