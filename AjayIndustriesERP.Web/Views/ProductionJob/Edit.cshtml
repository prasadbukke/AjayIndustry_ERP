@*
    ============================================================
    File: Edit.cshtml

    Purpose:
    Edits Production planning for an existing Production Job.

    Production Structure:

    Customer Purchase Order
            ↓
    Production Job
            ↓
    Production Job Items
            ↓
    Production Job Steps

    Responsibilities:
    - Own the Edit form.
    - Display Customer PO source as read-only.
    - Display all Production Job Items.
    - Update Item-wise Production Quantity.
    - Update Production planning dates.
    - Update Production Job remarks.
    - Enable client-side validation.

    Important:
    - Customer PO cannot be changed after Job creation.
    - Production Job Items cannot be replaced.
    - Ordered Quantity comes from Customer PO and is read-only.
    - Production Quantity is maintained by Admin.
    - Existing Item Routing identity cannot be changed here.
    - Production Pipeline editing is handled separately.
    - Completed and Cancelled Jobs cannot be edited.
    - Ready / InProgress Jobs may still require Production
      Quantity planning for remaining Ordered Quantity.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.ProductionJob.ProductionJobFormViewModel

@using AjayIndustriesERP.Domain.Enums

@{
    ViewData["Title"] =
        "Edit Production Job";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Edit Production Job
        </h2>

        <div class="d-flex
                    align-items-center
                    gap-2
                    flex-wrap">

            <span class="text-muted">
                @Model.Code
            </span>


            @switch (Model.Status)
            {
                case ProductionJobStatus.Draft:

                    <span class="badge bg-secondary">
                        Draft
                    </span>

                    break;


                case ProductionJobStatus.Ready:

                    <span class="badge bg-primary">
                        Ready
                    </span>

                    break;


                case ProductionJobStatus.InProgress:

                    <span class="badge
                                 bg-warning
                                 text-dark">

                        In Progress

                    </span>

                    break;


                case ProductionJobStatus.Completed:

                    <span class="badge bg-success">
                        Completed
                    </span>

                    break;


                case ProductionJobStatus.Cancelled:

                    <span class="badge bg-danger">
                        Cancelled
                    </span>

                    break;
            }

        </div>

    </div>


    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-outline-secondary">

        <i class="fa-solid
                  fa-arrow-left
                  me-1">
        </i>

        Back to Details

    </a>

</div>


<!-- =========================================================
     REGION 2 — PLANNING INFORMATION
========================================================== -->

@if (Model.Status == ProductionJobStatus.InProgress)
{
    <div class="alert
                alert-light
                border
                mb-4">

        <div class="fw-semibold">

            <i class="fa-solid
                      fa-circle-info
                      me-1">
            </i>

            Production Planning

        </div>


        <div class="small text-muted mt-1">

            This Production Job is already In Progress.
            Production Quantity can be increased for remaining
            Customer PO quantity according to the current
            production state.

        </div>

    </div>
}


<!-- =========================================================
     REGION 3 — EDIT FORM
========================================================== -->

<form asp-controller="ProductionJob"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      id="productionJobForm">

    @Html.AntiForgeryToken()


    <!-- =====================================================
         REQUIRED IDENTIFIER
    ====================================================== -->

    <input asp-for="Id"
           type="hidden" />


    <!-- =====================================================
         VALIDATION SUMMARY
    ====================================================== -->

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <!-- =====================================================
         SHARED PRODUCTION JOB FORM
    ====================================================== -->

    <partial name="_Form"
             model="@Model" />


    <!-- =====================================================
         REGION 4 — ACTIONS
    ====================================================== -->

    <div class="d-flex
                justify-content-end
                gap-2
                mb-4">

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-warning">

            <i class="fa-solid
                      fa-floppy-disk
                      me-1">
            </i>

            Update Production Planning

        </button>

    </div>

</form>


<!-- =========================================================
     REGION 5 — VALIDATION / PRODUCTION JOB SCRIPT
========================================================== -->

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script src="~/js/production-job.js"
            asp-append-version="true">
    </script>
}