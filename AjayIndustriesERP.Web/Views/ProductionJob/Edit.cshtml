@*
    ============================================================
    File: Edit.cshtml

    Purpose:
    Edits a Draft Production Job.

    Responsibilities:
    - Own the Edit form.
    - Display Production source as read-only.
    - Update Job Quantity.
    - Update planning dates.
    - Update Job remarks.

    Important:
    - Only Draft Production Job can be edited.
    - Customer PO Item cannot be changed.
    - Item and Routing cannot be changed.
    - Production Steps remain unchanged.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.ProductionJob.ProductionJobFormViewModel

@{
    ViewData["Title"] =
        "Edit Production Job";
}


<!-- =========================================================
     REGION 1 — PAGE HEADER
========================================================== -->

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3
            mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Edit Production Job
        </h2>

        <p class="text-muted mb-0">
            @Model.Code
        </p>

    </div>


    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back to Details

    </a>

</div>


<!-- =========================================================
     REGION 2 — EDIT FORM
========================================================== -->

<form asp-controller="ProductionJob"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      id="productionJobForm">

    @Html.AntiForgeryToken()


    <input asp-for="Id"
           type="hidden" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <partial name="_Form"
             model="@Model" />


    <!-- =====================================================
         REGION 3 — ACTIONS
    ====================================================== -->

    <div class="d-flex
                justify-content-end
                gap-2
                mb-4">

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">

            Cancel

        </a>


        <button type="submit"
                class="btn btn-warning">

            <i class="fa-solid
                      fa-floppy-disk
                      me-1">
            </i>

            Update Production Job

        </button>

    </div>

</form>


<!-- =========================================================
     REGION 4 — VALIDATION
========================================================== -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/production-job.js"
            asp-append-version="true">
    </script>
}