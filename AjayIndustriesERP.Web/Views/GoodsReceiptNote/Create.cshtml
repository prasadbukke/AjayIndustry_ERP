@*
    ============================================================
    File: Create.cshtml
    Purpose:
    Displays the Create Goods Receipt Note page.

    Responsibilities:
    - Owns the HTML form.
    - Displays page header/navigation.
    - Displays validation summary for Web validation.
    - Renders reusable _Form.cshtml.
    - Loads client-side validation scripts.

    Important:
    Business validation errors are shown through the project's
    shared Toast Notification component.

    Actual GRN fields and dynamic PO receipt UI are maintained
    inside _Form.cshtml.
    ============================================================
*@

@model AjayIndustriesERP.Web.ViewModels.GoodsReceiptNote.GoodsReceiptNoteCreateViewModel

@{
    ViewData["Title"] = "Create GRN";
}


<div class="d-flex justify-content-between
            align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Create Goods Receipt Note
        </h2>

        <p class="text-muted mb-0">
            Receive material against a Purchase Order.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>
        Back

    </a>

</div>


<form asp-action="Create"
      method="post"
      id="grnForm">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <partial name="_Form"
             model="Model" />

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}